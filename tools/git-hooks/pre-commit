#!/bin/sh
# Refuse commits whose staged HolyC files are not formatted with tools/hcfmt.sh, or whose staged
# Warm files (.warm/.warmh) are not formatted with tools/warmfmt.
# Enabled by `git config core.hooksPath tools/git-hooks` (make hooks).
ROOT=$(git rev-parse --show-toplevel)
status=0
# Check the staged versions, not the working tree.
tmp=$(mktemp -d "${TMPDIR:-/tmp}/fmt-hook.XXXXXX")
trap 'rm -rf "$tmp"' EXIT INT TERM
stage() {
  for f in $1; do
    mkdir -p "$tmp/$(dirname "$f")"
    git show ":$f" > "$tmp/$f"
  done
}

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.cool' '*.coolh' |
  grep -v -e '^coolc/third_party/' -e '^coolc/Fmt/tests/')
if [ -n "$files" ]; then
  stage "$files"
  out=$(cd "$tmp" && "$ROOT/tools/hcfmt.sh" --check $files 2>&1)
  if [ $? -ne 0 ]; then
    echo "$out" | grep -v '^HCFMT OK' >&2
    echo "pre-commit: HolyC files are not formatted. Run:" >&2
    echo "  tools/hcfmt.sh" $files >&2
    status=1
  fi
fi

# The suites' expected diagnostics carry line and column numbers, so their layout stays as it is.
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.warm' '*.warmh' |
  grep -v -e '^warmc/test-programs/suites/' -e '^warmc/fmt-tests/')
if [ -n "$files" ]; then
  stage "$files"
  out=$(cd "$tmp" && "$ROOT/tools/warmfmt" --check $files 2>&1)
  if [ $? -ne 0 ]; then
    echo "$out" >&2
    echo "pre-commit: Warm files are not formatted. Run:" >&2
    echo "  tools/warmfmt" $files >&2
    status=1
  fi
fi

[ $status -eq 0 ] || echo "then stage the result (or commit with --no-verify to skip)." >&2
exit $status
