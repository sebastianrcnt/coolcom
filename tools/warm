#!/usr/bin/env python3
"""Warm's host command. See docs/toolchain.md for module and artifact rules."""
import argparse
import fcntl
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[1]
STD = ROOT / 'warmc/standard/src'
SUFFIXES = ('.warm', '.warmh', '.aum', '.aui')
# Ignore comments and literals when reading module headers and imports. Semantic
# parsing stays in warmc; discovery only needs the names of imported modules.
TOKENS = re.compile(r'--[^\n]*|""".*?"""|"(?:\\.|[^"\\])*"|\bmodule\s+(?:body\s+)?([A-Za-z_]\w*(?:\.\w+)*)\s+is\b|\bimport\s+([A-Za-z_]\w*(?:\.\w+)*)', re.S)


def metadata(path):
    name, imports = None, []
    for match in TOKENS.finditer(path.read_text()):
        if match.group(1):
            name = match.group(1)
        elif match.group(2):
            imports.append(match.group(2))
    return name, imports


def ensure(*targets):
    if os.environ.get('WARM_TOOLCHAIN_READY') == '1' and all((ROOT / t).exists() for t in targets):
        return
    if subprocess.run(['make', '-s', '-f', 'tools/toolchain.mk', '-q', *targets], cwd=ROOT, stdout=subprocess.DEVNULL).returncode == 0:
        return
    (ROOT / 'build').mkdir(exist_ok=True)
    with (ROOT / 'build/.warm.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        subprocess.run(['make', '-s', '-f', 'tools/toolchain.mk', *targets], cwd=ROOT, check=True, stdout=sys.stderr)


def environment():
    (ROOT / 'build/tmp').mkdir(parents=True, exist_ok=True)
    return dict(os.environ, TMPDIR=str(ROOT / 'build/tmp'),
                COOLC_COMPILER_BIN=str(ROOT / 'coolc/seed/Compiler.BIN'))


def invoke(args, **kwargs):
    subprocess.run(list(map(str, args)), env=environment(), check=True, **kwargs)


def compiler(args):
    ensure('build/warmc')
    invoke([ROOT / 'build/warmc', *args])


def native(source, output):
    ensure('build/coolc')
    p = subprocess.run([str(ROOT / 'build/coolc'), str(source), str(output)],
                       env=environment(), capture_output=True)
    if p.returncode or b'Errs:0 ' not in p.stdout:
        sys.stdout.buffer.write(p.stdout)
        sys.stderr.buffer.write(p.stderr)
        raise subprocess.CalledProcessError(p.returncode or 1, p.args)


def paths_in(directory):
    # Do not follow directory symlinks or pick up outputs/dependency checkouts.
    for base, dirs, files in os.walk(directory):
        dirs[:] = sorted(d for d in dirs if not d.startswith('.') and d not in ('build', 'vendor')
                         and not (Path(base) / d).is_symlink())
        for name in sorted(files):
            p = Path(base) / name
            if p.suffix in SUFFIXES:
                yield p.resolve()


def resolve(inputs, search, coolos=False):
    explicit, roots = [], []
    for group in inputs:
        for item in group.split(','):
            p = Path(item).resolve()
            if p.is_dir():
                roots.append(p)
                explicit.extend(paths_in(p))
            elif p.is_file():
                roots.append(p.parent)
                explicit.append(p)
                # A body automatically uses its sibling interface, if present.
                if p.suffix in ('.warm', '.aum'):
                    header = p.with_suffix('.warmh' if p.suffix == '.warm' else '.aui')
                    if header.exists():
                        explicit.append(header)
            else:
                raise ValueError(f'input does not exist: {item}')
    roots = list(dict.fromkeys([*roots, *(Path(p).resolve() for p in search), STD]))
    if coolos:
        roots.append(ROOT / 'os/Warm/standard/src')
    for root in roots:
        if not root.is_dir():
            raise ValueError(f'module search directory does not exist: {root}')
    index, info = {}, {}
    # Earlier roots win; two bodies or two interfaces within one root are an
    # error only when that module is used. Unrelated project files are ignored.
    for root in roots:
        local = {}
        for p in paths_in(root):
            if p not in info:
                info[p] = metadata(p)
            data = info[p]
            if data[0]:
                local.setdefault(data[0], {'body': [], 'header': []})[
                    'header' if p.suffix in ('.warmh', '.aui') else 'body'].append(p)
        for name, pair in local.items():
            index.setdefault(name, pair)
    # Explicit files override search roots, including header-only modules.
    chosen = {}
    for p in dict.fromkeys(explicit):
        if p not in info:
            info[p] = metadata(p)
        name = info[p][0]
        if not name:
            raise ValueError(f'no module declaration in {p}')
        chosen.setdefault(name, {'body': [], 'header': []})[
            'header' if p.suffix in ('.warmh', '.aui') else 'body'].append(p)
    output, visiting, done = [], set(), set()

    def visit(name):
        if name in done or name in ('Austral.Pervasive', 'Austral.Memory'):
            return
        if name.startswith('OS.CoolOS.') and not coolos:
            raise ValueError(f'{name} requires --coolos (CoolOS integration)')
        if name in visiting:
            # Interfaces may import each other (OS.File and OS.Dir): the compiler
            # reads every interface before any body, so the cycle is not an error.
            return
        pair = chosen.get(name, index.get(name))
        if pair is None:
            raise ValueError(f'cannot find module {name}; add its directory with -I')
        if any(len(files) > 1 for files in pair.values()):
            raise ValueError(f'ambiguous module {name}: ' + ', '.join(str(p) for files in pair.values() for p in files))
        visiting.add(name)
        files = pair['header'] + pair['body']
        for p in files:
            for dependency in info[p][1]:
                if dependency != name:
                    visit(dependency)
        visiting.remove(name)
        done.add(name)
        output.extend(files)

    for name in chosen:
        visit(name)
    bodies = [p for p in dict.fromkeys(explicit) if p.suffix in ('.warm', '.aum')]
    mains = [p for p in bodies if re.search(r'\bfunction\s+main\s*\(',
             re.sub(r'--[^\n]*|""".*?"""|"(?:\\.|[^"\\])*"', '', p.read_text(), flags=re.S))]
    entry = info[mains[-1] if mains else bodies[-1]][0] + ':main' if bodies else None
    if len(mains) > 1:
        entry = None  # require an explicit choice, rather than filesystem order
    return output, entry


def standalone(binary, output, work):
    header = work / 'Program.h'
    data = binary.read_bytes()
    header.write_text('static const unsigned char warm_program[] = {\n' +
                      ',\n'.join(','.join(str(b) for b in data[i:i+32]) for i in range(0, len(data), 32)) + '\n};\n')
    invoke(['clang', '-std=c11', '-Wall', '-Wextra', '-Werror', '-O2',
            '-fno-omit-frame-pointer', '-ffixed-x28',
            '-DWARM_PROGRAM_HEADER="' + str(header) + '"',
            ROOT / 'coolc/Host/native.c', ROOT / 'coolc/Host/except.S', '-o', work / 'executable'])
    with tempfile.NamedTemporaryFile(prefix='.' + output.name + '-', dir=output.parent, delete=False) as staged:
        staged_path = Path(staged.name)
        staged.write((work / 'executable').read_bytes())
    try:
        staged_path.chmod(0o755)
        staged_path.replace(output)
    finally:
        staged_path.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=('run', 'build', 'check', 'fmt', 'test', 'compile'))
    # compile preserves the compiler protocol for diagnostic/codegen tests and
    # explicit --kernel-module integration. All user commands discover imports.
    if len(sys.argv) > 1 and sys.argv[1] == 'compile':
        compiler(sys.argv[2:])
        return
    parser.add_argument('inputs', nargs='*')
    parser.add_argument('-o', '--output')
    parser.add_argument('-I', '--module-path', action='append', default=[])
    parser.add_argument('--entrypoint')
    parser.add_argument('--coolos', action='store_true', help='enable OS.CoolOS modules for integration checks')
    parser.add_argument('--check', action='store_true', help='fmt: report changes without rewriting')
    raw = sys.argv[1:]
    args_after = []
    if '--' in raw:
        at = raw.index('--')
        args_after, raw = raw[at + 1:], raw[:at]
    if raw and raw[0] == 'run':
        # Host options can precede/follow sources. The first other token starts
        # program arguments; -- always makes the boundary explicit.
        at, has_source = 1, False
        while at < len(raw):
            token = raw[at]
            if token in ('-h', '--help') and not has_source:
                at += 1
            elif token in ('-I', '--module-path', '--entrypoint'):
                at += 2
            elif token == '--coolos' or token.startswith(('--module-path=', '--entrypoint=')) or token.startswith('-I'):
                at += 1
            elif not token.startswith('-') and (not has_source or Path(token).suffix in SUFFIXES or ',' in token or Path(token).is_dir()):
                has_source = True
                at += 1
            else:
                args_after = raw[at:] + args_after
                raw = raw[:at]
                break
    args = parser.parse_args(raw)
    if args.command != 'run' and args_after:
        parser.error('program arguments are only accepted by run')
    if args.command == 'fmt':
        sources = []
        for item in args.inputs or ['.']:
            p = Path(item)
            sources.extend(paths_in(p) if p.is_dir() else [p])
        if not sources:
            raise ValueError('no Warm sources to format')
        ensure('build/warmfmt.BIN')
        invoke([ROOT / 'build/coolc', '--run', ROOT / 'build/warmfmt.BIN',
                *(['--check'] if args.check else []), *sources])
        return
    if args.command == 'test' and not args.inputs and Path.cwd() == ROOT:
        ensure('build/warmc', 'build/warmfmt.BIN')
        invoke(['make', '-s', '-C', ROOT, '-f', 'tools/toolchain.mk', 'warm-test'])
        return
    if args.command == 'test':
        sources, test_roots = set(), []
        for item in args.inputs or ['.']:
            path = Path(item).resolve()
            if path.is_file():
                if path.suffix in ('.warm', '.aum'):
                    sources.add(path)
                test_roots.append(path.parent)
            elif path.is_dir():
                test_roots.append(path)
                sources.update(p for p in paths_in(path) if p.suffix in ('.warm', '.aum')
                               and (p.stem == 'Test' or p.stem.endswith('Test')))
            else:
                raise ValueError(f'input does not exist: {item}')
        test_paths = list(dict.fromkeys([*test_roots, *args.module_path]))
        if not sources:
            raise ValueError('no Test.warm or *Test.warm test entrypoints found')
        for source in sorted(sources):
            invoke([ROOT / 'tools/warm', 'run', source,
                    *[v for directory in test_paths for v in ('-I', directory)],
                    *(['--coolos'] if args.coolos else [])])
            print(f'PASS {source}', flush=True)
        return
    inputs = args.inputs or (['.'] if args.command == 'check' else [])
    if not inputs:
        parser.error('a source file or project directory is required')
    if args.command == 'run' and len(inputs) == 1 and Path(inputs[0]).suffix == '.BIN':
        ensure('build/coolc')
        invoke([ROOT / 'build/coolc', '--run', Path(inputs[0]).resolve(), *args_after])
        return
    # Cool interop tests share the same native build path as Warm programs.
    if args.command == 'build' and len(inputs) == 1 and Path(inputs[0]).suffix == '.cool':
        if not args.output:
            parser.error('building Cool interop sources requires -o')
        output = Path(args.output).resolve()
        with tempfile.TemporaryDirectory(prefix='warm-') as tmp:
            binary = output if output.suffix == '.BIN' else Path(tmp) / 'program.BIN'
            native(Path(inputs[0]).resolve(), binary)
            if output != binary:
                standalone(binary, output, Path(tmp))
        return
    sources, entry = resolve(inputs, args.module_path, args.coolos)
    if args.command == 'check':
        compiler(['compile', *sources, '--check'])
        return
    entry = args.entrypoint or entry
    if not entry:
        raise ValueError('choose an entrypoint with --entrypoint=Module:main')
    with tempfile.TemporaryDirectory(prefix='warm-') as tmp:
        work = Path(tmp)
        source, binary = work / 'program.cool', work / 'program.BIN'
        compiler(['compile', *sources, '--entrypoint=' + entry, '--target-type=hc', '--output=' + str(source)])
        native(source, binary)
        if args.command == 'run':
            invoke([ROOT / 'build/coolc', '--run', binary, *args_after])
        else:
            output = Path(args.output or 'a.out').resolve()
            standalone(binary, output, work)


if __name__ == '__main__':
    try:
        main()
    except subprocess.CalledProcessError as error:
        raise SystemExit(error.returncode if error.returncode > 0 else 128 - error.returncode)
    except (OSError, ValueError) as error:
        print(f'warm: {error}', file=sys.stderr)
        raise SystemExit(2)
