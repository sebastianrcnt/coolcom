I64 Wkwrite(U8 *text, U64 size) {
    U8 *s = NULL; I64 result = -1;
    try {s = WkString(text, size); if (s) {PutS(s); result = 0;} else result = -2;} catch {Fs->catch_except = TRUE;}
    Free(s); return result;
}

I64 Wkdir(U8 *text, U64 size) {
