I64 WkfillRect(I64 x, I64 y, I64 w, I64 h, I64 color) {
    if (x < -32768 || x > 32767 || y < -32768 || y > 32767 || w < 0 || w > 32767 || h < 0 || h > 32767) return -2;
    I64 result = -1;
    try {FbFillRect(x, y, w, h, color); result = 0;} catch {Fs->catch_except = TRUE;}
    return result;
}

