// Shared runtime rules from ../lib/HCRuntime.ml. See ../LICENSE.
#define U8 U8i
#define I8 I8i
#define U16 U16i
#define I16 I16i
#define U32 U32i
#define I32 I32i
#define U64 U64i
#define I64 I64i
// Generated by Warm. Classes are packed; the ABI is private to this module.
#ifndef WARM_KERNEL
import U0 Print(U8 *fmt, ...);
import U8 *MAlloc(I64 size);
import U8 *CAlloc(I64 size);
import U0 Free(U8 *ptr);
import U8 *MemCpy(U8 *dst, U8 *src, I64 size);
import U8 *MemSet(U8 *dst, I64 value, I64 size);
import U0 NativeExit(I64 status);
import U0 NativeErrPutS(U8 *text);
import I64 NativeArgCount();
import I64 NativeGetChar();
import U8 *NativeArg(I64 index);
import I64 StrLen(U8 *text);
#else
U0 NativeErrPutS(U8 *text) {PutS(text);}
I64 NativeArgCount() {return 0;}
I64 NativeGetChar() {return -1;}
U8 *NativeArg(I64 index) {return NULL;}
#endif
class au_span_t {U8 *wh_data; U64 wh_size;};
I32 au_putchar(U8 c) {Print("%c", c); return c;}
I32 au_puts(U8 *s) {Print("%s\n", s); return 0;}
// C's stdio handles for foreign imports: a stream is 0 (stdin), 1 (stdout) or 2 (stderr).
U8 *au_stdin() {return 0;}
U8 *au_stdout() {return 1;}
U8 *au_stderr() {return 2;}
I32 fputc(I32 c, U8 *stream) {
    U8 text[2];
    if (stream(I64) == 2) {text[0] = c; text[1] = 0; NativeErrPutS(text);}
    else Print("%c", c);
    return c;
}
I32 fgetc(U8 *stream) {return NativeGetChar();}  // the next input byte, or -1 at the end of input
U32 au_rand_seed;
U0 srand(U32 seed) {au_rand_seed = seed;}  // C's, for foreign imports; there is no rand
U0 wh_abort(U8 *message) {
    NativeErrPutS(message);
    NativeErrPutS("\n");
    NativeExit(255);
}
U8 au_abort(au_span_t * message) {wh_abort(message->wh_data); return 0;}
U0 au_make_span(au_span_t * out, U8 *data, U64 size) {
    out->wh_data = data; out->wh_size = size;
}
U0 au_make_span_from_string(au_span_t * out, U8 *data, U64 size) {
    au_make_span(out, data, size);
}
U64 au_get_argc() {return NativeArgCount();}
U0 au_get_nth_arg(au_span_t * out, U64 n) {
    U8 *arg = NativeArg(n);
    if (!arg) wh_abort("Command line argument access out of bounds.");
    U64 len = StrLen(arg);
    if (len > 10240) wh_abort("Command line argument exceeds maximum length of 10 kibibytes.");
    au_make_span(out, arg, len);
}
U8 *au_array_index(au_span_t * sp, U64 index, U64 size) {
    if (index >= sp->wh_size) wh_abort("Array index out of bounds.");
    if (size && (index > (0xffffffffffffffff / size)))
        wh_abort("Multiplication overflow in array indexing operation.");
    return sp->wh_data + (index * size);
}
// A private size header allows realloc without depending on host heap metadata.
U8 *au_calloc(U64 size, U64 count) {
    U64 total = size * count;
    if (size && (count > ((0x7fffffffffffffff - 8) / size))) return 0;
    U64 *p = CAlloc(total + 8);
    if (!p) return 0;
    *p = total;
    return p(U8 *) + 8;
}
U8 au_free(U8 *p) {if (p) Free(p - 8); return 0;}
U8 *au_realloc(U8 *p, U64 size) {
    U8 *q = au_calloc(size, 1);
    U64 n;
    if (!q) return 0;
    if (p) {
        n = *(p - 8)(U64 *);
        if (size < n) n = size;
        MemCpy(q, p, n);
        au_free(p);
    }
    return q;
}
U8 *au_memcpy(U8 *d, U8 *s, U64 n) {MemCpy(d, s, n); return d;}
U8 *au_memmove(U8 *d, U8 *s, U64 n) {
    U64 i;
    if (d < s) {for (i = 0; i < n; i++) d[i] = s[i];}
    else {i = n; while (i) {i--; d[i] = s[i];}}
    return d;
}
// IEEE binary32 is carried as U32 bits. Round to nearest, ties to even.
// This avoids requiring an F32 register type from the HolyC frontend.
F64 wc_f32_to_f64(U32 value) {
    U64 sign = (value(U64) & 0x80000000) << 32;
    I64 exponent = (value >> 23) & 255;
    U64 fraction = value & 0x7fffff, bits;
    if (exponent == 255) bits = sign | 0x7ff0000000000000 | (fraction << 29);
    else if (!exponent && !fraction) bits = sign;
    else {
        if (!exponent) {
            exponent = -126;
            while (!(fraction & 0x800000)) {fraction <<= 1; exponent--;}
            fraction &= 0x7fffff;
        } else exponent -= 127;
        bits = sign | ((exponent + 1023) << 52) | (fraction << 29);
    }
    return bits(F64);
}
U32 wc_f64_to_f32(F64 value) {
    U64 bits = value(U64), sign = (bits >> 32) & 0x80000000;
    I64 exponent = ((bits >> 52) & 2047) - 1023, shift;
    U64 fraction = bits & 0xfffffffffffff, mantissa, remainder, half;
    if (exponent == 1024) {
        if (fraction) return sign | 0x7fc00000;
        return sign | 0x7f800000;
    }
    if (exponent > 127) return sign | 0x7f800000;
    if (exponent < -150) return sign;
    fraction |= 0x10000000000000;
    shift = 29;
    if (exponent < -126) shift = (-exponent) - 97;
    mantissa = fraction >> shift;
    remainder = fraction & ((1 << shift) - 1);
    half = 1 << (shift - 1);
    if (remainder > half || (remainder == half && (mantissa & 1))) mantissa++;
    if (exponent < -126) return sign | mantissa;
    if (mantissa == 0x1000000) {mantissa >>= 1; exponent++;}
    if (exponent > 127) return sign | 0x7f800000;
    return sign | ((exponent + 127) << 23) | (mantissa & 0x7fffff);
}
// Native Cool uses signed float-to-integer conversion. Split the upper half.
U64 wc_f64_to_u64(F64 value)
{
    I64 part;
    if (value >= 0x43e0000000000000(F64)) {
        part = value - 0x43e0000000000000(F64);
        return part(U64) + 0x8000000000000000;
    }
    part = value;
    return part(U64);
}
