I64 WgMeasure(U8 *text, U64 size) {return size * 8;}
I64 WgDither(I64 handle, I64 x, I64 y, I64 width, I64 height) {return -1;}
I64 WgPresent(I64 handle) {return -1;}
I64 WgPoll(I64 handle) {return -1;}
