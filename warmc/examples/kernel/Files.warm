import OS.File (Filesystem, Bytes, acquireFilesystem, releaseFilesystem, readAll, writeAll, size, nth, closeBytes);
import OS.Error (IoError);
module body Files is
    function main(initial: RootCapability): ExitCode is
        var root: RootCapability := initial;
        var fs: Filesystem := acquireFilesystem(&!root);
        var success: Bool := false;
        case writeAll(&!fs, "Warm.txt", "Warm FAT32\n") of
            when Ok(value as u: Unit) do
                case readAll(&!fs, "Warm.txt") of
                    when Ok(value as buffer: Bytes) do
                        success := size(&buffer) = 11 and nth(&buffer, 0) = 87;
                        closeBytes(buffer);
                    when Err(error as e: IoError) do skip;
                end case;
            when Err(error as e: IoError) do skip;
        end case;
        releaseFilesystem(fs); surrenderRoot(root);
        if success then printLn("WARM FILE PASS"); return ExitSuccess(); else return ExitFailure(); end if;
    end;
end module body.
