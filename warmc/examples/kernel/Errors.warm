import OS.File (Filesystem, Bytes, acquireFilesystem, releaseFilesystem, readAll, writeAll, closeBytes);
import OS.Dir (Dir, openRoot, closeDir);
import OS.Error (IoError, ioErrorCode);
module body Errors is
    function main(initial: RootCapability): ExitCode is
        var root: RootCapability := initial; var fs: Filesystem := acquireFilesystem(&!root); let dir: Dir := openRoot(&!fs);
        var failed: Bool := false; var missing: Bool := false;
        case writeAll(&dir, "Throw.txt", "test") of when Err(error as e: IoError) do failed := ioErrorCode(e) = -1; when Ok(value as u: Unit) do skip; end case;
        case readAll(&dir, "Absent.txt") of when Err(error as e: IoError) do missing := ioErrorCode(e) = -10; when Ok(value as b: Bytes) do closeBytes(b); end case;
        closeDir(dir); releaseFilesystem(fs); surrenderRoot(root);
        if failed and missing then printLn("WARM ERRORS PASS"); return ExitSuccess(); end if; return ExitFailure(); end;
end module body.
