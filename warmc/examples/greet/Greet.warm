import OS.Terminal (Input, Output, acquireInput, acquireOutput, releaseInput, releaseOutput, readLine, write, writeLine);
import OS.Error (IoError);
import Standard.String (String, destroyString, getSpan, length);
module body Example.Greet is
    function main(initial: RootCapability): ExitCode is
        var root: RootCapability := initial;
        var input: Input := acquireInput(&!root);
        var output: Output := acquireOutput(&!root);
        var success: Bool := false;
        case readLine(&!input) of
            when Ok(value as line: String) do
                write(&!output, "Hello, ");
                write(&!output, getSpan(&line, 0, length(&line) - 1));
                writeLine(&!output, "!");
                destroyString(line);
                success := true;
            when Err(error as e: IoError) do skip;
        end case;
        releaseInput(input); releaseOutput(output); surrenderRoot(root);
        if success then return ExitSuccess(); else return ExitFailure(); end if;
    end;
end module body.
