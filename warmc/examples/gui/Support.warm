import OS.Gui (Gui, Window, Event, Idle, Mouse, Key, Resize, Close, Menu, open, poll, text);
import OS.Error (IoError);
import Standard.String (String, length, nthByte, getSpan, destroyString);
import Standard.StringBuilder (StringBuilder, makeStringBuilder, writeByte, finalize);
module body GuiSupport is
    function openWindow(gui: &![Gui], title: Span[Nat8], width: Int64, height: Int64): Window is
        case open(&~gui, title, width, height) of when Ok(value as w: Window) do return w; when Err(error as e: IoError) do abort("GUI unavailable"); end case; end;
    function nextEvent(window: &![Window]): Event is
        case poll(&~window) of when Ok(value as event: Event) do return event; when Err(error as e: IoError) do abort("Window closed"); end case; end;
    function shouldClose(event: Event): Bool is
        case event of when Close do return true; when Menu(id as id: Int64) do return id = 0;
            when Idle do return false; when Mouse(x as x: Int64, y as y: Int64, buttons as buttons: Int64, wheel as wheel: Int64) do return false;
            when Key(code as code: Int64) do return code = 27;
            when Resize(width as width: Int64, height as height: Int64) do return false;
        end case; end;
    function drawString(window: &![Window], x: Int64, y: Int64, string: &[String]): Unit is
        let count: Index := length(string); if count > 0 then text(&~window, x, y, getSpan(string, 0, count - 1), 0); end if; return nil; end;
    private function digit(builder: &![StringBuilder], value: Int64): Unit is
        if value >= 10 then digit(&~builder, value / 10); end if;
        case toNat8(48 + value - (value / 10) * 10) of when Some(value as b: Nat8) do writeByte(&~builder, b); when None do skip; end case; return nil; end;
    function drawNumber(window: &![Window], x: Int64, y: Int64, value: Int64): Unit is
        var builder: StringBuilder := makeStringBuilder();
        if value < 0 then writeByte(&!builder, 45); digit(&!builder, 0 - value); else digit(&!builder, value); end if;
        let string: String := finalize(builder); drawString(&~window, x, y, &string); destroyString(string); return nil; end;
    function copy(bytes: Span[Nat8]): String is
        var builder: StringBuilder := makeStringBuilder(); var i: Index := 0;
        while i < spanLength(bytes) do writeByte(&!builder, bytes[i]); i := i + 1; end while; return finalize(builder); end;
    private function append(builder: &![StringBuilder], string: &[String], count: Index): Unit is
        var i: Index := 0; while i < count do writeByte(&~builder, nthByte(string, i)); i := i + 1; end while; return nil; end;
    function joinPath(parent: &[String], name: &[String]): String is
        var builder: StringBuilder := makeStringBuilder(); append(&!builder, parent, length(parent));
        if length(parent) > 0 then writeByte(&!builder, 47); end if; append(&!builder, name, length(name)); return finalize(builder); end;
    function parentPath(path: &[String]): String is
        var count: Index := length(path); while count > 0 and nthByte(path, count - 1) /= 47 do count := count - 1; end while;
        if count > 0 then count := count - 1; end if;
        var builder: StringBuilder := makeStringBuilder(); append(&!builder, path, count); return finalize(builder); end;
    function matches(name: &[String], filter: Span[Nat8]): Bool is
        let count: Index := length(name); let size: Index := spanLength(filter);
        if size = 0 then return true; end if; if size > count then return false; end if;
        var start: Index := 0; while start + size <= count do
            var i: Index := 0; var same: Bool := true;
            while i < size and same do same := nthByte(name, start + i) = filter[i]; i := i + 1; end while;
            if same then return true; end if; start := start + 1;
        end while; return false; end;
    function index64(value: Index): Int64 is case toInt64(value) of when Some(value as n: Int64) do return n; when None do abort("Index overflow"); end case; end;
end module body.
