import OS.Gui (Gui, Window, Event, Idle, Mouse, Key, Resize, Close, Menu, Rect, Button,
    acquireGui, releaseGui, close, fill, label, button, addMenu, addMenuItem, setScale, setFont);
import GuiSupport (openWindow, nextEvent, shouldClose);
import OS.Task (Tasks, acquireTasks, releaseTasks, sleep);
import OS.Error (IoError);
module body GuiSettings is
    function main(initial: RootCapability): ExitCode is
        var root: RootCapability := initial; var gui: Gui := acquireGui(&!root); let tasks: Tasks := acquireTasks(&!root);
        var w: Window := openWindow(&!gui, "Settings", 320, 220);
        var one: Button := Button(pressed => false); var two: Button := Button(pressed => false);
        var bitmap: Button := Button(pressed => false); var mono: Button := Button(pressed => false);
        case addMenu(&!w, "File") of when Ok(value as menu: Int64) do addMenuItem(&!w, menu, 0, "Close"); when Err(error as e: IoError) do skip; end case;
        var running: Bool := true; var first: Bool := true; var missing: Bool := false;
        while running do
            let e: Event := nextEvent(&!w); running := not shouldClose(e);
            var draw: Bool := true; case e of when Idle do draw := first; when Close do skip; when Menu(id as id: Int64) do skip;
                when Mouse(x as x: Int64, y as y: Int64, buttons as b: Int64, wheel as wheel: Int64) do skip;
                when Key(code as code: Int64) do skip; when Resize(width as width: Int64, height as height: Int64) do skip; end case;
            if draw then
                fill(&!w, Rect(x => 0, y => 0, width => 320, height => 220), 16777215);
                label(&!w, Rect(x => 16, y => 16, width => 288, height => 20), "Display scale");
                case button(&!w, &!one, Rect(x => 16, y => 44, width => 128, height => 28), "1x", e, true) of
                    when Ok(value as clicked: Bool) do if clicked then setScale(&!gui, 1); printLn("GUI SETTINGS SCALE1"); end if; when Err(error as error: IoError) do skip; end case;
                case button(&!w, &!two, Rect(x => 168, y => 44, width => 128, height => 28), "2x", e, false) of
                    when Ok(value as clicked: Bool) do if clicked then setScale(&!gui, 2); printLn("GUI SETTINGS SCALE2"); end if; when Err(error as error: IoError) do skip; end case;
                label(&!w, Rect(x => 16, y => 92, width => 288, height => 20), "Terminal font");
                case button(&!w, &!bitmap, Rect(x => 16, y => 120, width => 128, height => 28), "Bitmap", e, false) of
                    when Ok(value as clicked: Bool) do if clicked then setFont(&!gui, false, 14); missing := false; printLn("GUI SETTINGS BITMAP"); end if; when Err(error as error: IoError) do skip; end case;
                case button(&!w, &!mono, Rect(x => 168, y => 120, width => 128, height => 28), "System Mono", e, false) of
                    when Ok(value as clicked: Bool) do if clicked then case setFont(&!gui, true, 14) of when Ok(value as u: Unit) do missing := false; printLn("GUI SETTINGS MONO"); when Err(error as error: IoError) do missing := true; end case; end if;
                    when Err(error as error: IoError) do skip; end case;
                var message: Span[Nat8, Static] := "Chrome keeps its bitmap font."; if missing then message := "System Mono is unavailable."; end if;
                label(&!w, Rect(x => 16, y => 176, width => 288, height => 20), message);
                if first then first := false; printLn("GUI SETTINGS READY"); end if;
            end if; sleep(&tasks, 1);
        end while; close(w); releaseGui(gui); releaseTasks(tasks); surrenderRoot(root); printLn("GUI SETTINGS CLOSED"); return ExitSuccess(); end;
end module body.
