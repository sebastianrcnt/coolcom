import OS.Gui (Gui, Window, Event, Idle, Mouse, Key, Resize, Close, Menu, Rect, Button, List, TextInput,
    present, buttonNeedsRedraw, listSelection, listNeedsRedraw, textInputNeedsRedraw, acquireGui, releaseGui, close, fill, text, textClipped, button, listFrame, listItem, makeTextInput, destroyTextInput,
    inputText, textInput, addMenu, addMenuItem);
import GuiSupport (openWindow, nextEvent, shouldClose, drawString, drawNumber, copy, joinPath, parentPath, matches, index64);
import OS.File (Filesystem, Bytes, acquireFilesystem, releaseFilesystem, readAll, byteSize, nth, closeBytes);
import OS.Dir (Dir, Entries, Entry, openRoot, openDir, closeDir, entries, next, closeEntries, narrow, readOnly);
import OS.Task (Tasks, acquireTasks, releaseTasks, sleep);
import OS.Error (IoError);
import Standard.String (String, length, getSpan, nthByte, destroyString);
import Standard.Buffer (Buffer, allocateEmpty, insertBack, removeLast, destroyEmpty, destroyFree, length as bufferLength, slice as bufferSlice, nth as bufferNth);
import Standard.StringBuilder (StringBuilder, makeStringBuilder, writeByte, finalize);
module body GuiFiles is
    private function listing(dir: &[Dir]): Entries is
        case entries(dir) of when Ok(value as list: Entries) do return list; when Err(error as e: IoError) do abort("Directory listing failed"); end case; end;
    -- Own directory names and display titles until navigation. Filtering builds
    -- indices into this cache; scrolling touches only the eleven visible rows.
    record CachedRow: Linear is name: String; title: String; isDir: Bool; end;
    generic [R: Region]
    private function readCache(cache: &![Buffer[CachedRow], R]): &[Buffer[CachedRow], R] is return (cache: &[Buffer[CachedRow], R]); end;
    private function clearCache(cache: &![Buffer[CachedRow]]): Unit is
        while bufferLength(readCache(&~cache)) > 0 do
            let { name: String, title: String, isDir: Bool } := removeLast(&~cache);
            destroyString(name); destroyString(title);
        end while; return nil; end;
    private function loadCache(dir: &[Dir]): Buffer[CachedRow] is
        var cache: Buffer[CachedRow] := allocateEmpty(); var iterator: Entries := listing(dir); var more: Bool := true;
        while more do case next(&!iterator) of
                when Some(value as row: Entry) do
                    let { name: String, size: Index, isDir: Bool, modified: Int64 } := row;
                    let title: String := rowTitle(&name, isDir);
                    insertBack(&!cache, CachedRow(name => name, title => title, isDir => isDir));
                when None do more := false;
            end case; end while; closeEntries(iterator); return cache; end;
    generic [R: Region]
    private function filtered(cache: &[Buffer[CachedRow], R], filter: Span[Nat8]): Buffer[Index] is
        var result: Buffer[Index] := allocateEmpty();
        let items: Span[CachedRow, R] := bufferSlice(cache, 0, bufferLength(cache)); var i: Index := 0;
        while i < spanLength(items) do
            let row: &[CachedRow, R] := &(items[i]);
            if matches(&(row->name), filter) then insertBack(&!result, i); end if; i := i + 1;
        end while; return result; end;
    private function asIndex(value: Int64): Index is
        case toIndex(value) of when Some(value as i: Index) do return i; when None do abort("Invalid row"); end case; end;
    private function readPreview(bytes: &[Bytes]): String is
        var builder: StringBuilder := makeStringBuilder(); var at: Index := 0;
        while at < byteSize(bytes) and at < 1024 do
            let b: Nat8 := nth(bytes, at); if b >= 32 or b = 10 then writeByte(&!builder, b); else if b /= 13 then writeByte(&!builder, 46); end if; at := at + 1;
        end while; return finalize(builder); end;
    private function preview(window: &![Window], string: &[String]): Unit is
        var at: Index := 0; var row: Int64 := 0;
        while at < length(string) and row < 10 do
            let start: Index := at; var columns: Int64 := 0;
            while at < length(string) and columns < 28 and nthByte(string, at) /= 10 do at := at + 1; columns := columns + 1; end while;
            if at > start then textClipped(&~window, 272, 84 + row * 20, getSpan(string, start, at - 1), 0, Rect(x => 272, y => 84 + row * 20, width => 224, height => 20)); end if;
            if at < length(string) and nthByte(string, at) = 10 then at := at + 1; end if; row := row + 1;
        end while; return nil; end;
    private function rowTitle(name: &[String], isDir: Bool): String is
        var builder: StringBuilder := makeStringBuilder();
        if isDir then writeByte(&!builder, 91); writeByte(&!builder, 68); writeByte(&!builder, 93); writeByte(&!builder, 32); end if;
        var at: Index := 0; while at < length(name) do writeByte(&!builder, nthByte(name, at)); at := at + 1; end while; return finalize(builder); end;
    record Selection: Linear is name: String; isDir: Bool; end;
    generic [R: Region]
    private function choose(cache: &[Buffer[CachedRow], R], index: Index): Selection is
        let items: Span[CachedRow, R] := bufferSlice(cache, 0, bufferLength(cache));
        let row: &[CachedRow, R] := &(items[index]);
        return Selection(name => copy(getSpan(&(row->name), 0, length(&(row->name)) - 1)), isDir => row->isDir); end;
    generic [R: Region]
    private function paintRows(window: &![Window], rows: &![List], cache: &[Buffer[CachedRow], R], visible: &[Buffer[Index]], total: Int64, e: Event): Unit is
        let items: Span[CachedRow, R] := bufferSlice(cache, 0, bufferLength(cache)); var i: Int64 := rows->first;
        while i < total and i < rows->first + 11 do
            let row: &[CachedRow, R] := &(items[bufferNth(visible, asIndex(i))]);
            let y: Int64 := 79 + (i - rows->first) * 20;
            case listItem(&~window, &~rows, Rect(x => 13, y => y, width => 226, height => 20), i, getSpan(&(row->title), 0, length(&(row->title)) - 1), e) of
                when Ok(value as clicked: Bool) do skip;
                when Err(error as error: IoError) do skip;
            end case; i := i + 1;
        end while;
        return nil; end;
    function main(initial: RootCapability): ExitCode is
        var root: RootCapability := initial; var gui: Gui := acquireGui(&!root); let tasks: Tasks := acquireTasks(&!root);
        var fs: Filesystem := acquireFilesystem(&!root); let rootDir: Dir := narrow(openRoot(&!fs), readOnly()); var dir: Dir := narrow(openRoot(&!fs), readOnly());
        var path: String := copy(""); var selected: String := copy(""); var selectedDir: Bool := false; var content: String := copy(""); var fileBytes: Int64 := 0;
        var w: Window := openWindow(&!gui, "Files", 520, 340); var filter: TextInput := makeTextInput();
        var rows: List := List(selected => -1, first => 0); var up: Button := Button(pressed => false); var openButton: Button := Button(pressed => false);
        case addMenu(&!w, "File") of when Ok(value as menu: Int64) do addMenuItem(&!w, menu, 0, "Close"); when Err(error as e: IoError) do skip; end case;
        var cache: Buffer[CachedRow] := loadCache(&dir); var visible: Buffer[Index] := filtered(&cache, inputText(&filter));
        var running: Bool := true; var redraw: Bool := true; var reload: Bool := false;
        while running do
            let e: Event := nextEvent(&!w); running := not shouldClose(e);
            case e of when Resize(width as width: Int64, height as height: Int64) do redraw := true;
                when Idle do skip; when Mouse(x as x: Int64, y as y: Int64, buttons as buttons: Int64, wheel as wheel: Int64) do skip;
                when Key(code as code: Int64) do skip; when Close do skip; when Menu(id as id: Int64) do skip;
            end case;
            if reload then
                clearCache(&!cache); destroyEmpty(cache); cache := loadCache(&dir);
                destroyFree(visible); visible := filtered(&cache, inputText(&filter)); reload := false;
            end if;
            var total: Int64 := index64(bufferLength(&visible));
            let inputDraw: Bool := redraw or textInputNeedsRedraw(&filter, Rect(x => 72, y => 36, width => 232, height => 28), e);
            let upDraw: Bool := redraw or buttonNeedsRedraw(&up, Rect(x => 424, y => 36, width => 72, height => 28), e, false);
            let openDraw: Bool := redraw or buttonNeedsRedraw(&openButton, Rect(x => 336, y => 36, width => 72, height => 28), e, true);
            var listDraw: Bool := redraw or listNeedsRedraw(&rows, Rect(x => 12, y => 78, width => 244, height => 222), total, 226, e);
            let draw: Bool := running and (inputDraw or upDraw or openDraw or listDraw);
            if draw then
                if redraw then
                    fill(&!w, Rect(x => 0, y => 0, width => 520, height => 340), 16777215);
                    text(&!w, 12, 12, "C:/", 0); drawString(&!w, 36, 12, &path); text(&!w, 12, 42, "Filter", 0);
                end if;
                if inputDraw then
                    case textInput(&!w, &!filter, Rect(x => 72, y => 36, width => 232, height => 28), e) of
                        when Ok(value as changed: Bool) do if changed then
                                rows.first := 0; rows.selected := -1; destroyString(selected); selected := copy("");
                                destroyString(content); content := copy(""); fileBytes := 0;
                                fill(&!w, Rect(x => 272, y => 78, width => 224, height => 250), 16777215);
                                destroyFree(visible); visible := filtered(&cache, inputText(&filter)); total := index64(bufferLength(&visible));
                                listDraw := true; printLn("GUI FILES FILTER");
                            end if;
                        when Err(error as error: IoError) do skip;
                    end case;
                end if;
                if listDraw then
                    let previous: Int64 := rows.selected;
                    rows.selected := listSelection(&rows, Rect(x => 12, y => 78, width => 244, height => 222), total, 226, e);
                    if rows.selected /= previous and rows.selected >= 0 then
                        let { name: String, isDir: Bool } := choose(&cache, bufferNth(&visible, asIndex(rows.selected)));
                        destroyString(selected); selected := name; selectedDir := isDir; printLn("GUI FILES SELECTED");
                    end if;
                    listFrame(&!w, &!rows, Rect(x => 12, y => 78, width => 244, height => 222), total, e);
                    paintRows(&!w, &!rows, &cache, &visible, total, e);
                end if;
                if redraw or inputDraw then
                    fill(&!w, Rect(x => 12, y => 312, width => 240, height => 20), 16777215);
                    text(&!w, 12, 312, "Items", 0); drawNumber(&!w, 60, 312, total);
                end if;
                var goUp: Bool := false; var goOpen: Bool := false;
                if upDraw then case button(&!w, &!up, Rect(x => 424, y => 36, width => 72, height => 28), "Up", e, false) of
                        when Ok(value as clicked: Bool) do goUp := clicked; when Err(error as error: IoError) do skip; end case; end if;
                if openDraw then case button(&!w, &!openButton, Rect(x => 336, y => 36, width => 72, height => 28), "Open", e, true) of
                        when Ok(value as clicked: Bool) do goOpen := clicked; when Err(error as error: IoError) do skip; end case; end if;
                let fullPaint: Bool := redraw; redraw := false;
                if goUp then
                    var moved: Bool := false;
                    let parent: String := parentPath(&path);
                    if length(&parent) = 0 then
                        if length(&path) > 0 then closeDir(dir); dir := narrow(openRoot(&!fs), readOnly()); destroyString(path); path := parent; moved := true;
                        else destroyString(parent); end if;
                    else case openDir(&rootDir, getSpan(&parent, 0, length(&parent) - 1)) of
                            when Ok(value as nextDir: Dir) do closeDir(dir); dir := nextDir; destroyString(path); path := parent; moved := true;
                            when Err(error as error: IoError) do destroyString(parent);
                        end case; end if;
                    if moved then
                        rows.first := 0; rows.selected := -1; destroyString(selected); selected := copy(""); destroyTextInput(filter); filter := makeTextInput(); destroyString(content); content := copy(""); fileBytes := 0; redraw := true; reload := true; printLn("GUI FILES UP");
                    end if;
                else if goOpen and length(&selected) > 0 then
                    if selectedDir then
                        var moved: Bool := false;
                        let nextPath: String := joinPath(&path, &selected);
                        case openDir(&rootDir, getSpan(&nextPath, 0, length(&nextPath) - 1)) of
                            when Ok(value as nextDir: Dir) do closeDir(dir); dir := nextDir; destroyString(path); path := nextPath; moved := true;
                            when Err(error as error: IoError) do destroyString(nextPath);
                        end case;
                        if moved then
                            rows.first := 0; rows.selected := -1; destroyString(selected); selected := copy(""); destroyTextInput(filter); filter := makeTextInput(); destroyString(content); content := copy(""); fileBytes := 0; redraw := true; reload := true; printLn("GUI FILES DIRECTORY");
                        end if;
                    else
                        case readAll(&dir, getSpan(&selected, 0, length(&selected) - 1)) of
                            when Ok(value as bytes: Bytes) do destroyString(content); content := readPreview(&bytes); fileBytes := index64(byteSize(&bytes)); closeBytes(bytes); printLn("GUI FILES PREVIEW");
                            when Err(error as error: IoError) do destroyString(content); content := copy("Unable to read file"); fileBytes := 0;
                        end case;
                    end if;
                end if;
                if fullPaint or (goOpen and not selectedDir) then
                    fill(&!w, Rect(x => 272, y => 78, width => 224, height => 250), 16777215);
                    preview(&!w, &content); if fileBytes > 0 then text(&!w, 272, 312, "Bytes", 0); drawNumber(&!w, 320, 312, fileBytes); end if; end if;
                present(&!w); printLn("GUI FILES PAINTED");
            end if; case e of when Idle do if not redraw then sleep(&tasks, 1); end if;
                when Mouse(x as x: Int64, y as y: Int64, buttons as buttons: Int64, wheel as wheel: Int64) do skip;
                when Key(code as code: Int64) do skip; when Resize(width as width: Int64, height as height: Int64) do skip; when Close do skip; when Menu(id as id: Int64) do skip; end case;
        end while; clearCache(&!cache); destroyEmpty(cache); destroyFree(visible); destroyTextInput(filter); destroyString(path); destroyString(selected); destroyString(content); closeDir(dir); closeDir(rootDir); releaseFilesystem(fs);
        close(w); releaseGui(gui); releaseTasks(tasks); surrenderRoot(root); printLn("GUI FILES CLOSED"); return ExitSuccess(); end;
end module body.
