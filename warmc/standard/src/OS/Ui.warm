import Standard.Vector (Vector, make as vectorMake, push, pop, get, length, replace, borrowGet, destroyFree, destroyEmpty);
import Standard.String (String, length as stringLength, slice as stringSlice, destroyString, fromLiteral, nthByte);
import Standard.StringBuilder (StringBuilder, makeStringBuilder, writeByte, finalize);
import Standard.HashMap (HashMap);
import Standard.Eq (Eq);
import Standard.Hash (Hash);
import OS.Error (IoError);
import OS.Gui (Gui, Window, Rect, Size, Event, Idle, Mouse, Key, Resize, Close, Menu, open, close as closeWindow, size, poll, present,
    fill, pattern, setClip, clearClip, queued, wait, traceEnabled, traceLevel, micros, copyText, clipboardSerial, clipboardText, clipboardSize, setPointer,
    addMenu, resetMenus, addMenuEntry, popupChoice, popupClear, popupAdd, popupShow);
import OS.Ui.Text (TextEdit, replaceRange, codepointString);
import OS.Ui.Tree (Tree, Node, Geom, Damage, makeTree, destroyTree, open as openNode, close as closeNode, add, setText, appendText, appendNumber,
    setExtra, setFlag, setValue, setRange, setAux, setHandler, setHandler2, setSize, setMinSize, setGrow, setAlign, setChildAlign,
    setPadding, setSpacing, setColumns, setKey, keyOf, finishBuild, layout, props, geometry, textBytes, readVector,
    makeDamage, destroyDamage, clearDamage, damageRects, damageFull, addDamage, intersect, intersects, visibleRect, visible, within, topOverlay,
    toIndex64, toInt, parseKey, bits, mix, readDamage,
    kindColumn, kindRow, kindGrid, kindSplit, kindSpacer, kindGroup, kindLabel, kindButton, kindSeparator,
    kindCheckbox, kindRadio, kindSlider, kindProgress, kindImage, kindTextBox,
    kindList, kindTable, kindTreeView, kindTextView, kindScroll, kindListRow, kindHeader, kindCell, setFit,
    kindMenu, kindMenuItem, kindPopup, kindTabs, kindTabPage, kindDialog, kindToolbar, kindStatus,
    flagContext, flagChecked, flagDraggable, flagDropTarget, flagSeparator, setPayload, hashBytes, unite, tabIndexOf, selectedTab,
    kindShortcut, kindTimer, flagDisabled, flagDefault, flagCancel, flagWrap, flagPlain, flagHidden, flagCenter, flagOverlay, flagSecure);
import OS.Ui.Engine (State, Snapshot, Action, makeState, destroyState, makeSnapshot, destroySnapshot, invalidate, compareAndRecord,
    handle, prune, syncTimers, readState, setNow, pointerShape, current, setEphemeral, Ephemeral, actCopy, ListState, noList, listFix,
    actPopup, dragItem, dueTimer, timeout, splitPositions, focused, ephemeral,
    actNone, actRepaint, actRelayout, actFire, actFire2, actClose, actResize, actMenu, dragPress, dragNone);
import OS.Ui.Draw (paint, Picture, builtinFolder, builtinDocument, builtinNote, builtinCaution, builtinStop);
module body OS.Ui is
    -- Declarative UI: describe the whole window from the model in view,
    -- return messages from next, change the model in update. See
    -- docs/ui-framework.md.

    -- Cross-axis alignment (align, alignChildren).
    constant leading: Int64 := 0;
    constant centered: Int64 := 1;
    constant trailing: Int64 := 2;
    constant stretch: Int64 := 3;

    -- How a node turns an event into a message.
    union Handler[M: Free]: Free is
        case Send is message: M;
        case WithValue is make: Fn[Int64, M];
        case WithEdit is make: Fn[TextEdit, M];
        case WithList is make: Fn[ListState, M];
        case WithDrop is make: Fn[Drop, M];
        case ViaFile is wrap: Fn[FileEvent, M]; what: Int64;
    end;
    -- A drop: the dragged node's payload and the pointer inside the target.
    record Drop: Free is payload: Int64; x: Int64; y: Int64; end;
    -- What happens inside a file dialog (OS.Ui.Files): its list, a row opened,
    -- Up, Open/Save, Cancel, or an edit of the file name.
    union FileEvent: Free is
        case Rows is state: ListState;
        case Pick is index: Int64;
        case Up;
        case Choose;
        case Cancel;
        case Name is edit: TextEdit;
    end;

    record View[M: Free]: Linear is tree: Tree; handlers: Vector[Handler[M]]; end;

    record App[M: Free]: Linear is
        window: Window;
        state: State;
        trees: Vector[Tree];
        handlers: Vector[Handler[M]];
        shown: Snapshot;
        damage: Damage;
        width: Int64; height: Int64;
        running: Bool;
        frames: Int64;
        trace: Bool;
        traced: Nat64;
        returned: Int64;
        pictures: Vector[Picture];
        pointer: Int64;
        menus: Nat64;
        outline: Rect;
    end;
    -- An image registered with the App (or a built-in icon): views refer to it
    -- by this handle and never copy pixels.
    record Image: Free is id: Int64; width: Int64; height: Int64; end;

    ------------------------------------------------------------------ application

    generic [M: Free]
    function openApp(gui: &![Gui], title: Span[Nat8], width: Int64, height: Int64): Result[App[M], IoError] is
        case open(&~gui, title, width, height) of
            when Ok(value as window: Window) do
                var w: Int64 := width; var h: Int64 := height;
                case size(&window) of when Ok(value as s: Size) do w := s.width; h := s.height; when Err(error as e: IoError) do skip; end case;
                var trees: Vector[Tree] := vectorMake(); push(&!trees, makeTree());
                let hs: Vector[Handler[M]] := vectorMake();
                return Ok(value => App(window => window, state => makeState(), trees => trees, handlers => hs,
                    shown => makeSnapshot(), damage => makeDamage(), width => w, height => h, running => true, frames => 0, trace => traceEnabled(), traced => 0, returned => 0, pictures => noPictures(), pointer => 0, menus => 0, outline => Rect(x => 0, y => 0, width => 0, height => 0)));
            when Err(error as e: IoError) do return Err(error => e);
        end case;
    end;
    generic [M: Free]
    function closeApp(app: App[M]): Unit is
        let { window as w: Window, state as s: State, trees as ts: Vector[Tree], handlers as h: Vector[Handler[M]], shown as sh: Snapshot,
            damage as d: Damage, width as width: Int64, height as height: Int64, running as r: Bool, frames as f: Int64, trace as t: Bool, traced as tr: Nat64, returned as rt: Int64, pictures as ps: Vector[Picture], pointer as pt: Int64, menus as mn: Nat64, outline as ol: Rect } := app;
        var pictures: Vector[Picture] := ps;
        while length(&pictures) > 0 do
            case pop(&!pictures) of
                when Some(value as one: Picture) do
                    let { width as pw: Int64, height as ph: Int64, oneBit as ob: Bool, stride as st: Int64, pixels as px: Vector[Nat8] } := one;
                    destroyFree(px);
                when None do skip;
            end case;
        end while;
        destroyEmpty(pictures);
        var trees: Vector[Tree] := ts;
        var more: Bool := true;
        while more do case pop(&!trees) of when Some(value as tree: Tree) do destroyTree(tree); when None do more := false; end case; end while;
        destroyEmpty(trees); destroyFree(h); destroySnapshot(sh); destroyDamage(d); destroyState(s); closeWindow(w);
        return nil;
    end;
    generic [M: Free]
    function isOpen(app: &[App[M]]): Bool is return app->running; end;
    -- Frames painted so far (tests and diagnostics).
    generic [M: Free]
    function framesPainted(app: &[App[M]]): Int64 is return app->frames; end;

    -- Show a new view, then wait for input. Returns the next message, or
    -- None once the window has been closed. Input that only changes framework
    -- state (focus, a held button, a split bar) is handled here.
    generic [M: Free]
    function next(app: &![App[M]], v: View[M]): Option[M] is
        let entered: Int64 := micros();
        let { tree as fresh: Tree, handlers as hs: Vector[Handler[M]] } := v;
        install(&~app, hs);
        var tree: Tree := fresh;
        finishBuild(&!tree);
        layout(&!tree, app->width, app->height, splitPositions(readState(&(app->state))));
        borrow r: &[Tree, Q] := &tree do
            prune(&(app->state), textBytes(r), props(r), geometry(r));
            syncTimers(props(r), &(app->state), micros());
        end borrow;
        let old: Tree := replace(&(app->trees), 0, tree);
        destroyTree(old);
        if app->trace then
            print("UI CYCLE app="); print(entered - app->returned); print(" layout="); printLn(micros() - entered);
        end if;
        syncMenus(&~app);
        let fix: Action := listFix(geometryProps(&(app->trees)), geometry(treeOf(&(app->trees))), &(app->state));
        if fix.kind = actFire then
            case messageOf(&~app, fix.node, false, 0, noEdit(), fix.list) of
                when Some(value as m: M) do app->returned := micros(); return Some(value => m);
                when None do skip;
            end case;
        end if;
        while app->running do
            if queued(&(app->window)) = 0 then render(&~app); end if;
            -- Timers fire before waiting.
            let due: Index := dueTimer(props(treeOf(&(app->trees))), &(app->state), micros());
            if due /= 0 then
                case messageOf(&~app, due, false, 0, noEdit(), noList()) of
                    when Some(value as m: M) do return Some(value => m);
                    when None do skip;
                end case;
            end if;
            var event: Event := Idle();
            case poll(&(app->window)) of
                when Ok(value as e: Event) do event := e;
                when Err(error as e: IoError) do app->running := false; return None();
            end case;
            var action: Action := Action(kind => actNone, node => 0, value => 0, aux => 0, edit => noEdit(), list => noList());
            case event of
                when Idle do
                    -- Everything queued is handled: end the latency sample of input that changed nothing.
                    present(&(app->window));
                    let ms: Int64 := timeout(props(treeOf(&(app->trees))), readState(&(app->state)), micros(), 1000);
                    if ms > 0 then wait(&(app->window), ms); end if;
                when Mouse(x as x: Int64, y as y: Int64, buttons as b: Int64, wheel as wh: Int64) do action := handleEvent(&~app, event);
                when Key(code as c: Int64) do action := handleEvent(&~app, event);
                when Resize(width as w: Int64, height as h: Int64) do action := handleEvent(&~app, event);
                when Close do action := handleEvent(&~app, event);
                when Menu(id as id: Int64) do
                    if app->trace then print("UI MENU "); printLn(id); end if;
                    action := handleEvent(&~app, event);
            end case;
            if pointerShape(readState(&(app->state))) /= app->pointer then
                app->pointer := pointerShape(readState(&(app->state)));
                setPointer(&(app->window), app->pointer);
            end if;
            if action.kind = actCopy then copyRange(&~app, action.node, action.value, action.aux); end if;
            if action.kind = actPopup then openPopup(&~app, action.node, action.value, action.aux); end if;
            if action.kind = actMenu then action := menuAction(&~app, action.value); end if;
            if action.kind = actFire and action.aux = 1 then
                copyRange(&~app, action.node, widenIndex(action.edit.start), widenIndex(action.edit.finish));
            end if;
            if action.kind = actFire and action.edit.paste < 0 then action := withPaste(&~app, action); end if;
            if action.kind = actFire or action.kind = actFire2 then
                var edit: TextEdit := action.edit;
                if action.aux > 0 and action.edit.codepoint < 0 and dropping(props(treeOf(&(app->trees))), action.node) then
                    edit := TextEdit(start => 0, finish => 0, codepoint => action.aux, paste => 0);
                end if;
                case messageOf(&~app, action.node, action.kind = actFire2, action.value, edit, action.list) of
                    when Some(value as m: M) do app->returned := micros(); return Some(value => m);
                    when None do skip;
                end case;
            else if action.kind = actClose then
                app->running := false; return None();
            else if action.kind = actResize then
                case size(readWindow(&(app->window))) of
                    when Ok(value as s: Size) do app->width := s.width; app->height := s.height;
                    when Err(error as e: IoError) do skip;
                end case;
                relayout(&~app); invalidate(&(app->shown));
            else if action.kind = actRelayout then
                relayout(&~app);
            end if;
            if action.kind = actResize or action.kind = actRelayout then
                let refit: Action := listFix(geometryProps(&(app->trees)), geometry(treeOf(&(app->trees))), &(app->state));
                if refit.kind = actFire then
                    case messageOf(&~app, refit.node, false, 0, noEdit(), refit.list) of
                        when Some(value as m: M) do app->returned := micros(); return Some(value => m);
                        when None do skip;
                    end case;
                end if;
            end if;
        end while;
        return None();
    end;
    generic [R: Region]
    function readWindow(w: &![Window, R]): &[Window, R] is return (w: &[Window, R]); end;
    generic [R: Region]
    function treeOf(trees: &![Vector[Tree], R]): &[Tree, R] is return borrowGet(readVector(trees), 0); end;
    generic [R: Region]
    function geometryProps(trees: &![Vector[Tree], R]): Span[Node, R] is return props(treeOf(trees)); end;
    function handlerIndex(ps: Span[Node], node: Index, second: Bool): Int64 is
        if node >= spanLength(ps) then return -1; end if;
        if second then return ps[node].handler2; end if; return ps[node].handler;
    end;
    function noPictures(): Vector[Picture] is let v: Vector[Picture] := vectorMake(); return v; end;
    function noEdit(): TextEdit is return TextEdit(start => 0, finish => 0, codepoint => -1, paste => 0); end;
    generic [M: Free]
    function install(app: &![App[M]], hs: Vector[Handler[M]]): Unit is
        while length(readVector(&(app->handlers))) > 0 do pop(&(app->handlers)); end while;
        for i from 0 until length(&hs) do push(&(app->handlers), get(&hs, i)); end for;
        destroyFree(hs); return nil;
    end;
    generic [M: Free]
    function relayout(app: &![App[M]]): Unit is
        case pop(&(app->trees)) of
            when Some(value as t: Tree) do
                var tree: Tree := t;
                layout(&!tree, app->width, app->height, splitPositions(readState(&(app->state))));
                push(&(app->trees), tree);
            when None do skip;
        end case;
        return nil;
    end;
    function widenIndex(i: Index): Int64 is return toInt(i); end;
    function dropping(ps: Span[Node], node: Index): Bool is return (ps[node].flags & flagDropTarget) /= 0; end;

    ------------------------------------------------------------------ menus and pop-ups

    -- The menu bar part of the view (non-context menus and their items), as a hash.
    function menuSignature(all: Span[Nat8], ps: Span[Node]): Nat64 is
        var h: Nat64 := 3;
        for i from 1 until spanLength(ps) do
            if barItem(ps, i) or (ps[i].kind = kindMenu and (ps[i].flags & flagContext) = 0) then
                h := hashBytes(mix(h, bits(ps[i].kind)), sliceSpan(all, ps[i].text, ps[i].textEnd));
                h := hashBytes(mix(h, bits(ps[i].flags)), sliceSpan(all, ps[i].extra, ps[i].extraEnd));
            end if;
        end for;
        return h;
    end;
    function barItem(ps: Span[Node], i: Index): Bool is
        let p: Index := ps[i].parent;
        return ps[i].kind = kindMenuItem and ps[p].kind = kindMenu and (ps[p].flags & flagContext) = 0;
    end;
    function itemFlags(ps: Span[Node], i: Index): Int64 is
        var f: Int64 := 0;
        if (ps[i].flags & 1) /= 0 then f := f | 1; end if;
        if (ps[i].flags & flagChecked) /= 0 then f := f | 2; end if;
        if (ps[i].flags & flagSeparator) /= 0 then f := f | 4; end if;
        return f;
    end;
    -- Install the view's menus in the window when they change (ids: item ordinals).
    generic [M: Free]
    function syncMenus(app: &![App[M]]): Unit is
        let signature: Nat64 := menuSignature(textBytes(treeOf(&(app->trees))), props(treeOf(&(app->trees))));
        if signature = app->menus then return nil; end if;
        app->menus := signature;
        resetMenus(&(app->window));
        installMenus(&(app->window), textBytes(treeOf(&(app->trees))), props(treeOf(&(app->trees))));
        return nil;
    end;
    function installMenus(w: &![Window], all: Span[Nat8], ps: Span[Node]): Unit is
        var ordinal: Int64 := 0;
        for i from 1 until spanLength(ps) do
            if ps[i].kind = kindMenu and (ps[i].flags & flagContext) = 0 then
                case addMenu(&~w, sliceSpan(all, ps[i].text, ps[i].textEnd)) of
                    when Ok(value as menu: Int64) do
                        var c: Index := ps[i].first;
                        while c /= 0 do
                            if ps[c].kind = kindMenuItem then
                                addMenuEntry(&~w, menu, ordinal, sliceSpan(all, ps[c].text, ps[c].textEnd), sliceSpan(all, ps[c].extra, ps[c].extraEnd), itemFlags(ps, c));
                                ordinal := ordinal + 1;
                            end if;
                            c := ps[c].next;
                        end while;
                    when Err(error as e: IoError) do skip;
                end case;
            end if;
        end for;
        return nil;
    end;
    -- The menu-bar item with a given ordinal (0: none).
    function barItemAt(ps: Span[Node], ordinal: Int64): Index is
        var n: Int64 := 0;
        for i from 1 until spanLength(ps) do
            if barItem(ps, i) then if n = ordinal then return i; end if; n := n + 1; end if;
        end for;
        return 0;
    end;
    -- The index-th item of a pop-up button or context menu (0: none).
    function itemAt(ps: Span[Node], node: Index, index: Int64): Index is
        var n: Int64 := 0; var c: Index := ps[node].first;
        while c /= 0 do
            if ps[c].kind = kindMenuItem then if n = index then return c; end if; n := n + 1; end if;
            c := ps[c].next;
        end while;
        return 0;
    end;
    generic [M: Free]
    function openPopup(app: &![App[M]], node: Index, x: Int64, y: Int64): Unit is
        popupClear(&(app->window));
        let chosen: Int64 := fillPopup(&(app->window), textBytes(treeOf(&(app->trees))), props(treeOf(&(app->trees))), node);
        popupShow(&(app->window), x, y, chosen);
        return nil;
    end;
    function fillPopup(w: &![Window], all: Span[Nat8], ps: Span[Node], node: Index): Int64 is
        var c: Index := ps[node].first;
        while c /= 0 do
            if ps[c].kind = kindMenuItem then popupAdd(&~w, sliceSpan(all, ps[c].text, ps[c].textEnd), sliceSpan(all, ps[c].extra, ps[c].extraEnd), itemFlags(ps, c)); end if;
            c := ps[c].next;
        end while;
        if ps[node].kind = kindPopup then return ps[node].value; end if;
        return -1;
    end;
    -- A menu event: a menu-bar item fires its message (not while a dialog is open);
    -- a pop-up choice fires the pop-up button's handler or the context item's message.
    generic [M: Free]
    function menuAction(app: &![App[M]], id: Int64): Action is
        let none: Action := Action(kind => actNone, node => 0, value => 0, aux => 0, edit => noEdit(), list => noList());
        let popupId: Nat64 := app->state.popup;
        if id < 0 then app->state.popup := 0; return Action(kind => actRepaint, node => 0, value => 0, aux => 0, edit => noEdit(), list => noList()); end if;
        if id >= popupChoice then
            app->state.popup := 0;
            let node: Index := findNode(props(treeOf(&(app->trees))), popupId);
            return popupFire(props(treeOf(&(app->trees))), node, id - popupChoice);
        end if;
        return barFire(props(treeOf(&(app->trees))), id);
    end;
    function popupFire(ps: Span[Node], node: Index, index: Int64): Action is
        if node = 0 then return Action(kind => actRepaint, node => 0, value => 0, aux => 0, edit => noEdit(), list => noList()); end if;
        if ps[node].kind = kindPopup then return Action(kind => actFire, node => node, value => index, aux => 0, edit => noEdit(), list => noList()); end if;
        let item: Index := itemAt(ps, node, index);
        if item = 0 then return Action(kind => actRepaint, node => 0, value => 0, aux => 0, edit => noEdit(), list => noList()); end if;
        return Action(kind => actFire, node => item, value => 0, aux => 0, edit => noEdit(), list => noList());
    end;
    function barFire(ps: Span[Node], ordinal: Int64): Action is
        let item: Index := barItemAt(ps, ordinal);
        if item = 0 or topOverlay(ps) /= 0 or (ps[item].flags & 1) /= 0 then return Action(kind => actNone, node => 0, value => 0, aux => 0, edit => noEdit(), list => noList()); end if;
        return Action(kind => actFire, node => item, value => 0, aux => 0, edit => noEdit(), list => noList());
    end;
    function findNode(ps: Span[Node], ident: Nat64): Index is
        if ident = 0 then return 0; end if;
        for i from 1 until spanLength(ps) do if ps[i].ident = ident then return i; end if; end for;
        return 0;
    end;
    -- Copy bytes [start, finish) of a node's text to the clipboard.
    generic [M: Free]
    function copyRange(app: &![App[M]], node: Index, start: Int64, finish: Int64): Unit is
        copySlice(&(app->window), nodeTextOf(treeOf(&(app->trees)), node), start, finish); return nil;
    end;
    function copySlice(w: &![Window], bytes: Span[Nat8], start: Int64, finish: Int64): Unit is
        if start >= 0 and finish <= toInt(spanLength(bytes)) and start < finish then
            copyText(&~w, sliceSpan(bytes, toIndex64(start), toIndex64(finish)));
        end if;
        return nil;
    end;
    generic [R: Region]
    function nodeTextOf(t: &[Tree, R], node: Index): Span[Nat8, R] is
        let ps: Span[Node, R] := props(t);
        return sliceSpan(textBytes(t), ps[node].text, ps[node].textEnd);
    end;
    -- A paste names the clipboard snapshot of the keystroke; the caret goes
    -- after the pasted bytes.
    generic [M: Free]
    function withPaste(app: &![App[M]], action: Action): Action is
        let serial: Int64 := clipboardSerial();
        let pasted: Int64 := clipboardSize(serial);
        let edit: TextEdit := action.edit;
        let id: Nat64 := props(treeOf(&(app->trees)))[action.node].ident;
        let e: Ephemeral := current(&(app->state), id);
        let caret: Int64 := toInt(edit.start) + maxInt64(pasted, 0);
        setEphemeral(&(app->state), id, Ephemeral(a => caret, b => caret, c => e.c, d => e.d));
        return Action(kind => action.kind, node => action.node, value => action.value, aux => action.aux,
            edit => TextEdit(start => edit.start, finish => edit.finish, codepoint => -1, paste => serial), list => action.list);
    end;
    function maxInt64(a: Int64, b: Int64): Int64 is if a > b then return a; end if; return b; end;
    generic [M: Free]
    function handleEvent(app: &![App[M]], event: Event): Action is
        setNow(&(app->state), micros());
        return handle(textBytes(treeOf(&(app->trees))), props(treeOf(&(app->trees))), geometry(treeOf(&(app->trees))), &(app->state), event);
    end;
    generic [M: Free]
    function messageOf(app: &![App[M]], node: Index, second: Bool, value: Int64, edit: TextEdit, list: ListState): Option[M] is
        let index: Int64 := handlerIndex(props(treeOf(&(app->trees))), node, second);
        if index < 0 or toIndex64(index) >= length(readVector(&(app->handlers))) then return None(); end if;
        case get(readVector(&(app->handlers)), toIndex64(index)) of
            when Send(message as m: M) do return Some(value => m);
            when WithValue(make as f: Fn[Int64, M]) do return Some(value => f(value));
            when WithEdit(make as f: Fn[TextEdit, M]) do return Some(value => f(edit));
            when WithList(make as f: Fn[ListState, M]) do return Some(value => f(list));
            when WithDrop(make as f: Fn[Drop, M]) do return Some(value => f(Drop(payload => value, x => edit.codepoint / 65536, y => edit.codepoint % 65536)));
            when ViaFile(wrap as f: Fn[FileEvent, M], what as what: Int64) do
                if what = 0 then return Some(value => f(Rows(state => list))); end if;
                if what = 1 then return Some(value => f(Pick(index => value))); end if;
                return Some(value => f(Name(edit => edit)));
        end case;
    end;
    -- Compare with what is on screen and repaint only the damaged regions.
    generic [M: Free]
    function render(app: &![App[M]]): Unit is
        let started: Int64 := micros();
        clearDamage(&(app->damage));
        compareAndRecord(textBytes(treeOf(&(app->trees))), props(treeOf(&(app->trees))), geometry(treeOf(&(app->trees))), readState(&(app->state)), &(app->shown), &(app->damage));
        let count: Index := spanLength(props(treeOf(&(app->trees))));
        dragDamage(&~app);
        let painted: Bool := repaint(&(app->window), textBytes(treeOf(&(app->trees))), props(treeOf(&(app->trees))), geometry(treeOf(&(app->trees))), readState(&(app->state)), readDamage(&(app->damage)), app->width, app->height, readPictures(&(app->pictures)));
        if app->outline.width > 0 then grayBoxOver(&(app->window), app->outline); end if;
        -- An unchanged frame is not presented here: an empty present ends the kernel's
        -- input latency sample, which next() does only once the input has been handled
        -- (before it waits), not between an event and the message it produces.
        if painted or app->outline.width > 0 then present(&(app->window)); end if;
        if painted then
            app->frames := app->frames + 1;
            if app->trace then
                let elapsed: Int64 := micros() - started;
                let signature: Nat64 := layoutSignature(props(treeOf(&(app->trees))), geometry(treeOf(&(app->trees))));
                if signature /= app->traced and traceLevel() >= 2 then
                    app->traced := signature; traceNodes(textBytes(treeOf(&(app->trees))), props(treeOf(&(app->trees))), geometry(treeOf(&(app->trees))));
                end if;
                traceFrame(readDamage(&(app->damage)), app->frames, count, elapsed, app->width, app->height);
            end if;
        end if;
        return nil;
    end;
    -- While an item is dragged, a dotted outline of it follows the pointer.
    generic [M: Free]
    function dragDamage(app: &![App[M]]): Unit is
        let old: Rect := app->outline;
        let now: Rect := outlineOf(props(treeOf(&(app->trees))), geometry(treeOf(&(app->trees))), readState(&(app->state)));
        if old.width > 0 then addDamage(&(app->damage), old); end if;
        if now.width > 0 then addDamage(&(app->damage), now); end if;
        app->outline := now;
        return nil;
    end;
    function outlineOf(ps: Span[Node], gs: Span[Geom], state: &[State]): Rect is
        if state->drag /= dragItem or not state->inside then return Rect(x => 0, y => 0, width => 0, height => 0); end if;
        let i: Index := findNode(ps, state->target);
        if i = 0 then return Rect(x => 0, y => 0, width => 0, height => 0); end if;
        return Rect(x => gs[i].x + state->mouseX - state->startX, y => gs[i].y + state->mouseY - state->startY, width => gs[i].width, height => gs[i].height);
    end;
    function grayBoxOver(w: &![Window], r: Rect): Unit is
        pattern(&~w, Rect(x => r.x, y => r.y, width => r.width, height => 1), 12273903644374837845, 0, -1);
        pattern(&~w, Rect(x => r.x, y => r.y + r.height - 1, width => r.width, height => 1), 12273903644374837845, 0, -1);
        pattern(&~w, Rect(x => r.x, y => r.y, width => 1, height => r.height), 12273903644374837845, 0, -1);
        pattern(&~w, Rect(x => r.x + r.width - 1, y => r.y, width => 1, height => r.height), 12273903644374837845, 0, -1);
        return nil;
    end;
    generic [R: Region]
    function traceFrame(d: &[Damage, R], frame: Int64, nodes: Index, elapsed: Int64, width: Int64, height: Int64): Unit is
        print("UI FRAME "); print(frame); print(" nodes="); print(nodes); print(" us="); print(elapsed);
        if damageFull(d) then print(" full 0,0,"); print(width); print(","); print(height);
        else
            let rs: Span[Rect, R] := damageRects(d);
            for i from 0 until spanLength(rs) do
                print(" "); print(rs[i].x); print(","); print(rs[i].y); print(","); print(rs[i].width); print(","); print(rs[i].height);
            end for;
        end if;
        printLn(""); return nil;
    end;
    function layoutSignature(ps: Span[Node], gs: Span[Geom]): Nat64 is
        var h: Nat64 := 7;
        for i from 0 until spanLength(ps) do
            h := mix(h, ps[i].ident); h := mix(h, bits(gs[i].x)); h := mix(h, bits(gs[i].y)); h := mix(h, bits(gs[i].width)); h := mix(h, bits(gs[i].height));
        end for;
        return h;
    end;
    -- "UI NODE index kind x y width height text" for every visible node (tests locate controls by text).
    function traceNodes(all: Span[Nat8], ps: Span[Node], gs: Span[Geom]): Unit is
        for i from 1 until spanLength(ps) do
            if visible(ps, i) then
                print("UI NODE "); print(i); print(" "); print(ps[i].kind); print(" "); print(gs[i].x); print(" "); print(gs[i].y);
                print(" "); print(gs[i].width); print(" "); print(gs[i].height); print(" "); printLn(sliceSpan(all, ps[i].text, ps[i].textEnd));
            end if;
        end for;
        return nil;
    end;
    -- Paint every node intersecting each damaged rectangle; overlays last.
    generic [R: Region]
    function repaint(w: &![Window], all: Span[Nat8], ps: Span[Node], gs: Span[Geom], state: &[State], d: &[Damage, R], width: Int64, height: Int64, pictures: &[Vector[Picture]]): Bool is
        var any: Bool := false;
        if damageFull(d) then
            paintRegion(&~w, all, ps, gs, state, Rect(x => 0, y => 0, width => width, height => height), pictures); any := true;
        else
            let rs: Span[Rect, R] := damageRects(d);
            for k from 0 until spanLength(rs) do
                let region: Rect := intersect(rs[k], Rect(x => 0, y => 0, width => width, height => height));
                if region.width > 0 and region.height > 0 then paintRegion(&~w, all, ps, gs, state, region, pictures); any := true; end if;
            end for;
        end if;
        clearClip(&~w);
        return any;
    end;
    function paintRegion(w: &![Window], all: Span[Nat8], ps: Span[Node], gs: Span[Geom], state: &[State], region: Rect, pictures: &[Vector[Picture]]): Unit is
        setClip(&~w, region);
        fill(&~w, region, 16777215);
        for layer from 0 until 2 do
            for i from 1 until spanLength(ps) do
                let overlay: Bool := inOverlay(ps, i);
                if (layer = 0 and not overlay) or (layer = 1 and overlay) then
                    if visible(ps, i) then
                        let area: Rect := intersect(region, visibleRect(ps, gs, i));
                        if area.width > 0 and area.height > 0 then
                            let clip: Rect := intersect(region, Rect(x => gs[i].clipX, y => gs[i].clipY, width => gs[i].clipWidth, height => gs[i].clipHeight));
                            setClip(&~w, clip);
                            let id: Nat64 := ps[i].ident;
                            let pressed: Bool := state->target = id and state->drag /= dragNone and state->inside;
                            paint(&~w, all, ps, gs, i, pressed, focused(state) = id, state->keyboard, state, clip, pictures);
                        end if;
                    end if;
                end if;
            end for;
        end for;
        return nil;
    end;
    function inOverlay(ps: Span[Node], i: Index): Bool is
        var p: Index := i;
        while p /= 0 do if (ps[p].flags & flagOverlay) /= 0 then return true; end if; p := ps[p].parent; end while;
        return false;
    end;

    ------------------------------------------------------------------ building a view

    generic [R: Region]
    function readPictures(v: &![Vector[Picture], R]): &[Vector[Picture], R] is return (v: &[Vector[Picture], R]); end;

    ------------------------------------------------------------------ text values

    -- Apply a text box edit to the model's text (consumes it, returns the new
    -- text). A paste inserts exactly the clipboard snapshot it names, or nothing
    -- if the clipboard changed since the keystroke.
    function applyEdit(text: String, edit: TextEdit): String is
        if edit.codepoint >= 0 then
            let insert: String := codepointString(edit.codepoint);
            let result: String := replaceRange(&text, edit.start, edit.finish, stringSlice(&insert, 0, stringLength(&insert)));
            destroyString(insert); destroyString(text); return result;
        end if;
        if edit.paste > 0 then
            case clipboardText(edit.paste) of
                when Some(value as insert: String) do
                    let result: String := replaceRange(&text, edit.start, edit.finish, stringSlice(&insert, 0, stringLength(&insert)));
                    destroyString(insert); destroyString(text); return result;
                when None do return text;
            end case;
        end if;
        let result: String := replaceRange(&text, edit.start, edit.finish, "");
        destroyString(text); return result;
    end;

    ------------------------------------------------------------------ images

    -- One-bit image (most significant bit first, stride = ceil(width / 8)); set bits are black.
    generic [M: Free]
    function oneBitImage(app: &![App[M]], width: Int64, height: Int64, data: Span[Nat8]): Image is
        return addPicture(&~app, width, height, true, (width + 7) / 8, data);
    end;
    -- BGRA pixels, 4 bytes each, rows of width pixels.
    generic [M: Free]
    function colorImage(app: &![App[M]], width: Int64, height: Int64, bgra: Span[Nat8]): Image is
        return addPicture(&~app, width, height, false, width * 4, bgra);
    end;
    generic [M: Free]
    function addPicture(app: &![App[M]], width: Int64, height: Int64, oneBit: Bool, stride: Int64, data: Span[Nat8]): Image is
        var pixels: Vector[Nat8] := vectorMake();
        let needed: Int64 := stride * height;
        for i from 0 until spanLength(data) do if toInt(i) < needed then push(&!pixels, data[i]); end if; end for;
        while toInt(length(&pixels)) < needed do push(&!pixels, 0); end while;
        let id: Int64 := toInt(length(readPictureVector(&(app->pictures))));
        push(&(app->pictures), Picture(width => width, height => height, oneBit => oneBit, stride => stride, pixels => pixels));
        return Image(id => id, width => width, height => height);
    end;
    generic [R: Region]
    function readPictureVector(v: &![Vector[Picture], R]): &[Vector[Picture], R] is return (v: &[Vector[Picture], R]); end;
    -- Built-in classic icons: 16x16 folder and document, 32x32 alert icons.
    function iconFolder(): Image is return Image(id => builtinFolder, width => 16, height => 16); end;
    function iconDocument(): Image is return Image(id => builtinDocument, width => 16, height => 16); end;
    function iconNote(): Image is return Image(id => builtinNote, width => 32, height => 32); end;
    function iconCaution(): Image is return Image(id => builtinCaution, width => 32, height => 32); end;
    function iconStop(): Image is return Image(id => builtinStop, width => 32, height => 32); end;

    ------------------------------------------------------------------ building a view

    generic [M: Free]
    function newView(): View[M] is let hs: Vector[Handler[M]] := vectorMake(); return View(tree => makeTree(), handlers => hs); end;
    generic [M: Free]
    function handler(v: &![View[M]], h: Handler[M]): Int64 is
        push(&(v->handlers), h); return toInt(length(readVector(&(v->handlers)))) - 1;
    end;
    -- Containers: children follow until done.
    generic [M: Free]
    function column(v: &![View[M]]): Unit is openNode(&(v->tree), kindColumn); return nil; end;
    generic [M: Free]
    function row(v: &![View[M]]): Unit is openNode(&(v->tree), kindRow); return nil; end;
    generic [M: Free]
    function grid(v: &![View[M]], columns: Int64): Unit is openNode(&(v->tree), kindGrid); setColumns(&(v->tree), columns); return nil; end;
    -- Two panes and a draggable bar; firstSize <= 0 splits evenly.
    generic [M: Free]
    function split(v: &![View[M]], vertical: Bool, firstSize: Int64): Unit is
        openNode(&(v->tree), kindSplit); if vertical then setValue(&(v->tree), 1); end if; setRange(&(v->tree), firstSize, 0); return nil;
    end;
    -- A titled frame around its children.
    generic [M: Free]
    function group(v: &![View[M]], title: Span[Nat8]): Unit is
        openNode(&(v->tree), kindGroup); setText(&(v->tree), title); setPadding(&(v->tree), 8); return nil;
    end;
    generic [M: Free]
    function done(v: &![View[M]]): Unit is closeNode(&(v->tree)); return nil; end;
    generic [M: Free]
    function spacer(v: &![View[M]]): Unit is add(&(v->tree), kindSpacer); setGrow(&(v->tree), 1); return nil; end;

    -- Modifiers of the most recent node (for a container: right after it opens).
    generic [M: Free]
    function padding(v: &![View[M]], amount: Int64): Unit is setPadding(&(v->tree), amount); return nil; end;
    generic [M: Free]
    function spacing(v: &![View[M]], amount: Int64): Unit is setSpacing(&(v->tree), amount); return nil; end;
    generic [M: Free]
    function grow(v: &![View[M]], weight: Int64): Unit is setGrow(&(v->tree), weight); return nil; end;
    generic [M: Free]
    function fixedWidth(v: &![View[M]], pixels: Int64): Unit is setSize(&(v->tree), pixels, -1); return nil; end;
    generic [M: Free]
    function fixedHeight(v: &![View[M]], pixels: Int64): Unit is setSize(&(v->tree), -1, pixels); return nil; end;
    generic [M: Free]
    function minimumSize(v: &![View[M]], w: Int64, h: Int64): Unit is setMinSize(&(v->tree), w, h); return nil; end;
    generic [M: Free]
    function align(v: &![View[M]], alignment: Int64): Unit is setAlign(&(v->tree), alignment); return nil; end;
    generic [M: Free]
    function alignChildren(v: &![View[M]], alignment: Int64): Unit is setChildAlign(&(v->tree), alignment); return nil; end;
    generic [M: Free]
    function disabled(v: &![View[M]], off: Bool): Unit is setFlag(&(v->tree), flagDisabled, off); return nil; end;
    generic [M: Free]
    function hidden(v: &![View[M]], gone: Bool): Unit is setFlag(&(v->tree), flagHidden, gone); return nil; end;
    -- Stable identity for framework state (focus, carets) of a moving item.
    generic [M: Free]
    function key(v: &![View[M]], name: Span[Nat8]): Unit is setKey(&(v->tree), keyOf(name)); return nil; end;
    generic [M: Free]
    function keyNumber(v: &![View[M]], n: Int64): Unit is setKey(&(v->tree), bits(n)); return nil; end;

    -- Text in the bold system font; plain switches to the regular face.
    generic [M: Free]
    function label(v: &![View[M]], text: Span[Nat8]): Unit is add(&(v->tree), kindLabel); setText(&(v->tree), text); return nil; end;
    -- Wrapped text whose height follows its width.
    generic [M: Free]
    function paragraph(v: &![View[M]], text: Span[Nat8]): Unit is
        add(&(v->tree), kindLabel); setText(&(v->tree), text); setFlag(&(v->tree), flagWrap, true); setFlag(&(v->tree), flagPlain, true); return nil;
    end;
    generic [M: Free]
    function plain(v: &![View[M]]): Unit is setFlag(&(v->tree), flagPlain, true); return nil; end;
    generic [M: Free]
    function centerText(v: &![View[M]]): Unit is setFlag(&(v->tree), flagCenter, true); return nil; end;
    -- Extend the most recent node's text.
    generic [M: Free]
    function append(v: &![View[M]], text: Span[Nat8]): Unit is appendText(&(v->tree), text); return nil; end;
    generic [M: Free]
    function appendInt(v: &![View[M]], n: Int64): Unit is appendNumber(&(v->tree), n); return nil; end;

    generic [M: Free]
    function button(v: &![View[M]], title: Span[Nat8], message: M): Unit is
        add(&(v->tree), kindButton); setText(&(v->tree), title);
        let h: Int64 := handler(&~v, Send(message => message)); setHandler(&(v->tree), h); return nil;
    end;
    -- Return activates the default button; Escape the cancel button.
    generic [M: Free]
    function defaultButton(v: &![View[M]]): Unit is setFlag(&(v->tree), flagDefault, true); return nil; end;
    generic [M: Free]
    function cancelButton(v: &![View[M]]): Unit is setFlag(&(v->tree), flagCancel, true); return nil; end;
    generic [M: Free]
    function separator(v: &![View[M]]): Unit is add(&(v->tree), kindSeparator); return nil; end;

    -- A checkbox: message is sent when the user toggles it (the model flips its value).
    generic [M: Free]
    function checkbox(v: &![View[M]], title: Span[Nat8], checked: Bool, message: M): Unit is
        add(&(v->tree), kindCheckbox); setText(&(v->tree), title); if checked then setValue(&(v->tree), 1); end if;
        let h: Int64 := handler(&~v, Send(message => message)); setHandler(&(v->tree), h); return nil;
    end;
    -- A radio button: message is sent when it is chosen.
    generic [M: Free]
    function radio(v: &![View[M]], title: Span[Nat8], selected: Bool, message: M): Unit is
        add(&(v->tree), kindRadio); setText(&(v->tree), title); if selected then setValue(&(v->tree), 1); end if;
        let h: Int64 := handler(&~v, Send(message => message)); setHandler(&(v->tree), h); return nil;
    end;
    -- A horizontal slider over [low, high] in steps; onChange gets each new value while dragging.
    generic [M: Free]
    function slider(v: &![View[M]], value: Int64, low: Int64, high: Int64, step: Int64, onChange: Fn[Int64, M]): Unit is
        add(&(v->tree), kindSlider); setValue(&(v->tree), value); setRange(&(v->tree), low, high); setAux(&(v->tree), step);
        let h: Int64 := handler(&~v, WithValue(make => onChange)); setHandler(&(v->tree), h); return nil;
    end;
    -- A progress bar; total <= 0 shows an indeterminate (striped) bar.
    generic [M: Free]
    function progress(v: &![View[M]], value: Int64, total: Int64): Unit is
        add(&(v->tree), kindProgress); setValue(&(v->tree), value); setRange(&(v->tree), 0, total); return nil;
    end;
    -- A single-line text field showing text; every change arrives as onEdit(edit),
    -- to be applied to the model's String with applyEdit.
    generic [M: Free]
    function textBox(v: &![View[M]], text: Span[Nat8], onEdit: Fn[TextEdit, M]): Unit is
        add(&(v->tree), kindTextBox); setText(&(v->tree), text);
        let h: Int64 := handler(&~v, WithEdit(make => onEdit)); setHandler(&(v->tree), h); return nil;
    end;
    -- A text field showing bullets; copying is disabled.
    generic [M: Free]
    function password(v: &![View[M]], text: Span[Nat8], onEdit: Fn[TextEdit, M]): Unit is
        textBox(&~v, text, onEdit); setFlag(&(v->tree), flagSecure, true); return nil;
    end;
    -- Dimmed text shown in an empty, unfocused text field.
    generic [M: Free]
    function placeholder(v: &![View[M]], text: Span[Nat8]): Unit is setExtra(&(v->tree), text); return nil; end;
    generic [M: Free]
    function image(v: &![View[M]], picture: Image): Unit is
        add(&(v->tree), kindImage); setValue(&(v->tree), picture.id); setRange(&(v->tree), picture.width, picture.height); return nil;
    end;
    ------------------------------------------------------------------ data views

    -- An empty list state; the framework fills in the rows that fit.
    function listState(): ListState is return ListState(first => 0, selected => -1, fit => 0, sort => -1, descending => false); end;
    generic [M: Free]
    function openList(v: &![View[M]], kind: Int64, state: ListState, rowCount: Int64, onState: Fn[ListState, M]): Unit is
        openNode(&(v->tree), kind); setValue(&(v->tree), state.first); setRange(&(v->tree), rowCount, state.selected); setFit(&(v->tree), state.fit);
        var sort: Int64 := -1; if state.sort >= 0 then sort := state.sort * 2; if state.descending then sort := sort + 1; end if; end if;
        setAux(&(v->tree), sort);
        let h: Int64 := handler(&~v, WithList(make => onState)); setHandler(&(v->tree), h); return nil;
    end;
    -- A list of rowCount rows. Emit listRow for rows [state.first, state.first + state.fit];
    -- scrolling, selection and size changes arrive as onState(new state).
    generic [M: Free]
    function listView(v: &![View[M]], state: ListState, rowCount: Int64, onState: Fn[ListState, M]): Unit is
        openList(&~v, kindList, state, rowCount, onState); return nil;
    end;
    -- A table: tableColumn headers, then tableRow + cell per visible row. Clicking a
    -- sortable header sets state.sort / state.descending.
    generic [M: Free]
    function tableView(v: &![View[M]], state: ListState, rowCount: Int64, onState: Fn[ListState, M]): Unit is
        openList(&~v, kindTable, state, rowCount, onState); return nil;
    end;
    -- A tree shown as its visible rows (flattened by the model): treeRow per row.
    generic [M: Free]
    function treeView(v: &![View[M]], state: ListState, rowCount: Int64, onState: Fn[ListState, M]): Unit is
        openList(&~v, kindTreeView, state, rowCount, onState); return nil;
    end;
    -- Double click or Return on a row (lists, tables): onOpen(row index).
    generic [M: Free]
    function onOpen(v: &![View[M]], opened: Fn[Int64, M]): Unit is
        let h: Int64 := handler(&~v, WithValue(make => opened)); setHandler2(&(v->tree), h); return nil;
    end;
    -- A tree's disclosure triangle, Return, Left/Right: onToggle(row index).
    generic [M: Free]
    function onToggle(v: &![View[M]], toggled: Fn[Int64, M]): Unit is
        let h: Int64 := handler(&~v, WithValue(make => toggled)); setHandler2(&(v->tree), h); return nil;
    end;
    generic [M: Free]
    function tableColumn(v: &![View[M]], title: Span[Nat8], width: Int64, sortable: Bool): Unit is
        add(&(v->tree), kindHeader); setText(&(v->tree), title); setValue(&(v->tree), width);
        if sortable then setRange(&(v->tree), 1, 0); end if; return nil;
    end;
    generic [M: Free]
    function listRow(v: &![View[M]], index: Int64, text: Span[Nat8]): Unit is
        add(&(v->tree), kindListRow); setValue(&(v->tree), index); setText(&(v->tree), text); keyNumber(&~v, index); return nil;
    end;
    -- A small (16x16) icon before the most recent row's text.
    generic [M: Free]
    function rowIcon(v: &![View[M]], picture: Image): Unit is setAux(&(v->tree), picture.id + 1000); return nil; end;
    generic [M: Free]
    function tableRow(v: &![View[M]], index: Int64): Unit is
        openNode(&(v->tree), kindListRow); setValue(&(v->tree), index); keyNumber(&~v, index); return nil;
    end;
    generic [M: Free]
    function cell(v: &![View[M]], text: Span[Nat8]): Unit is add(&(v->tree), kindCell); setText(&(v->tree), text); return nil; end;
    generic [M: Free]
    function treeRow(v: &![View[M]], index: Int64, depth: Int64, children: Bool, expanded: Bool, text: Span[Nat8]): Unit is
        add(&(v->tree), kindListRow); setValue(&(v->tree), index); setText(&(v->tree), text); keyNumber(&~v, index);
        var flags: Int64 := 0; if children then flags := 1; end if; if expanded then flags := flags | 2; end if;
        setRange(&(v->tree), depth, flags); return nil;
    end;
    -- A scrolled viewport around one child (usually a column); the framework keeps the offset.
    generic [M: Free]
    function scrollView(v: &![View[M]]): Unit is openNode(&(v->tree), kindScroll); return nil; end;
    -- A multi-line text editor; changes arrive as onEdit(edit) like textBox. Lines wrap unless noWrap.
    generic [M: Free]
    function textView(v: &![View[M]], text: Span[Nat8], onEdit: Fn[TextEdit, M]): Unit is
        add(&(v->tree), kindTextView); setText(&(v->tree), text); setFlag(&(v->tree), flagWrap, true);
        let h: Int64 := handler(&~v, WithEdit(make => onEdit)); setHandler(&(v->tree), h); return nil;
    end;
    generic [M: Free]
    function noWrap(v: &![View[M]]): Unit is setFlag(&(v->tree), flagWrap, false); return nil; end;
    ------------------------------------------------------------------ window parts

    -- "Ctrl+S" shown as the Mac's modifier symbols: control, option, shift.
    function displayKeys(keys: Span[Nat8]): String is
        var b: StringBuilder := makeStringBuilder(); var at: Index := 0;
        while at < spanLength(keys) do
            if prefixAt(keys, at, "Ctrl+") then putText(&!b, "\u{2303}"); at := at + 5;
            else if prefixAt(keys, at, "Alt+") then putText(&!b, "\u{2325}"); at := at + 4;
            else if prefixAt(keys, at, "Shift+") then putText(&!b, "\u{21E7}"); at := at + 6;
            else
                var c: Nat8 := keys[at];
                if at + 1 = spanLength(keys) and c >= 97 and c <= 122 then c := c - 32; end if;
                writeByte(&!b, c); at := at + 1;
            end if;
        end while;
        return finalize(b);
    end;
    function putText(b: &![StringBuilder], value: Span[Nat8]): Unit is
        for i from 0 until spanLength(value) do writeByte(&~b, value[i]); end for; return nil;
    end;
    function prefixAt(value: Span[Nat8], at: Index, prefix: Span[Nat8]): Bool is
        if spanLength(value) - at < spanLength(prefix) then return false; end if;
        for i from 0 until spanLength(prefix) do if value[at + i] /= prefix[i] then return false; end if; end for;
        return true;
    end;
    -- A menu in the menu bar: menuItem, menuSeparator ... done.
    generic [M: Free]
    function menu(v: &![View[M]], title: Span[Nat8]): Unit is openNode(&(v->tree), kindMenu); setText(&(v->tree), title); return nil; end;
    -- Items shown when the parent node (or an ancestor) is clicked with the right button.
    generic [M: Free]
    function contextMenu(v: &![View[M]]): Unit is openNode(&(v->tree), kindMenu); setFlag(&(v->tree), flagContext, true); return nil; end;
    -- A menu item with an optional shortcut ("" for none), shown as the Mac's symbols.
    generic [M: Free]
    function menuItem(v: &![View[M]], title: Span[Nat8], keys: Span[Nat8], message: M): Unit is
        add(&(v->tree), kindMenuItem); setText(&(v->tree), title); setValue(&(v->tree), parseKey(keys));
        let shown: String := displayKeys(keys); setExtra(&(v->tree), stringSlice(&shown, 0, stringLength(&shown))); destroyString(shown);
        let h: Int64 := handler(&~v, Send(message => message)); setHandler(&(v->tree), h); return nil;
    end;
    generic [M: Free]
    function menuSeparator(v: &![View[M]]): Unit is add(&(v->tree), kindMenuItem); setFlag(&(v->tree), flagSeparator, true); return nil; end;
    -- A check mark on the most recent menu item.
    generic [M: Free]
    function checkMark(v: &![View[M]], on: Bool): Unit is setFlag(&(v->tree), flagChecked, on); return nil; end;
    -- A classic pop-up menu button showing item selected; popupItem per choice ... done.
    generic [M: Free]
    function popupButton(v: &![View[M]], selected: Int64, onChoose: Fn[Int64, M]): Unit is
        openNode(&(v->tree), kindPopup); setValue(&(v->tree), selected); setFlag(&(v->tree), 8, true);
        let h: Int64 := handler(&~v, WithValue(make => onChoose)); setHandler(&(v->tree), h); return nil;
    end;
    generic [M: Free]
    function popupItem(v: &![View[M]], title: Span[Nat8]): Unit is add(&(v->tree), kindMenuItem); setText(&(v->tree), title); return nil; end;
    -- A modal dialog over the window (classic double frame); children follow until done.
    generic [M: Free]
    function dialog(v: &![View[M]]): Unit is
        openNode(&(v->tree), kindDialog); setFlag(&(v->tree), flagOverlay, true); setPadding(&(v->tree), 16); setSpacing(&(v->tree), 12); return nil;
    end;
    -- An alert: an icon, a message and one default button.
    generic [M: Free]
    function alert(v: &![View[M]], icon: Image, message: Span[Nat8], okTitle: Span[Nat8], ok: M): Unit is
        dialog(&~v); fixedWidth(&~v, 360);
        row(&~v); spacing(&~v, 12); alignChildren(&~v, leading);
        image(&~v, icon); paragraph(&~v, message); grow(&~v, 1);
        done(&~v);
        row(&~v); spacer(&~v); button(&~v, okTitle, ok); defaultButton(&~v); done(&~v);
        done(&~v); return nil;
    end;
    -- A question: Cancel (Escape) and a default button (Return).
    generic [M: Free]
    function confirm(v: &![View[M]], icon: Image, message: Span[Nat8], cancelTitle: Span[Nat8], cancel: M, okTitle: Span[Nat8], ok: M): Unit is
        dialog(&~v); fixedWidth(&~v, 380);
        row(&~v); spacing(&~v, 12); alignChildren(&~v, leading);
        image(&~v, icon); paragraph(&~v, message); grow(&~v, 1);
        done(&~v);
        row(&~v); spacing(&~v, 10); spacer(&~v);
        button(&~v, cancelTitle, cancel); cancelButton(&~v);
        button(&~v, okTitle, ok); defaultButton(&~v);
        done(&~v);
        done(&~v); return nil;
    end;
    -- Tabs: tab(title) pages ... done; only page selected is shown.
    generic [M: Free]
    function tabs(v: &![View[M]], selected: Int64, onSelect: Fn[Int64, M]): Unit is
        openNode(&(v->tree), kindTabs); setValue(&(v->tree), selected); setPadding(&(v->tree), 8); setFlag(&(v->tree), 8, true);
        let h: Int64 := handler(&~v, WithValue(make => onSelect)); setHandler(&(v->tree), h); return nil;
    end;
    generic [M: Free]
    function tab(v: &![View[M]], title: Span[Nat8]): Unit is
        let shown: Bool := tabIndexOf(&(v->tree)) = selectedTab(&(v->tree));
        openNode(&(v->tree), kindTabPage); setText(&(v->tree), title); setGrow(&(v->tree), 1); setSpacing(&(v->tree), 8);
        setFlag(&(v->tree), flagHidden, not shown); return nil;
    end;
    -- A row of tool buttons above the content, with a rule below.
    generic [M: Free]
    function toolbar(v: &![View[M]]): Unit is openNode(&(v->tree), kindToolbar); setPadding(&(v->tree), 4); setSpacing(&(v->tree), 4); return nil; end;
    -- A row of plain status text below the content, with a rule above.
    generic [M: Free]
    function statusBar(v: &![View[M]]): Unit is openNode(&(v->tree), kindStatus); setPadding(&(v->tree), 3); setSpacing(&(v->tree), 12); return nil; end;
    -- The most recent node can be dragged; payload identifies it to the drop target.
    generic [M: Free]
    function draggable(v: &![View[M]], payload: Int64): Unit is setFlag(&(v->tree), flagDraggable, true); setPayload(&(v->tree), payload); return nil; end;
    -- The most recent node accepts drops (its frame thickens while an item is over it).
    generic [M: Free]
    function dropTarget(v: &![View[M]], onDrop: Fn[Drop, M]): Unit is
        setFlag(&(v->tree), flagDropTarget, true);
        let h: Int64 := handler(&~v, WithDrop(make => onDrop)); setHandler(&(v->tree), h); return nil;
    end;
    -- For OS.Ui.Files: a list and a text box whose events go through a file dialog's wrapper.
    generic [M: Free]
    function fileList(v: &![View[M]], state: ListState, rowCount: Int64, wrap: Fn[FileEvent, M]): Unit is
        openNode(&(v->tree), kindList); setValue(&(v->tree), state.first); setRange(&(v->tree), rowCount, state.selected); setFit(&(v->tree), state.fit);
        setAux(&(v->tree), -1);
        let h: Int64 := handler(&~v, ViaFile(wrap => wrap, what => 0)); setHandler(&(v->tree), h);
        let h2: Int64 := handler(&~v, ViaFile(wrap => wrap, what => 1)); setHandler2(&(v->tree), h2); return nil;
    end;
    generic [M: Free]
    function fileName(v: &![View[M]], text: Span[Nat8], wrap: Fn[FileEvent, M]): Unit is
        add(&(v->tree), kindTextBox); setText(&(v->tree), text);
        let h: Int64 := handler(&~v, ViaFile(wrap => wrap, what => 2)); setHandler(&(v->tree), h); return nil;
    end;
    -- A keyboard shortcut such as "Ctrl+S", "Alt+Left", "F5" or "Ctrl+Shift+Z".
    generic [M: Free]
    function shortcut(v: &![View[M]], keys: Span[Nat8], message: M): Unit is
        add(&(v->tree), kindShortcut); setValue(&(v->tree), parseKey(keys)); setText(&(v->tree), keys);
        let h: Int64 := handler(&~v, Send(message => message)); setHandler(&(v->tree), h); return nil;
    end;
    -- A message every interval while this node is in the view.
    generic [M: Free]
    function every(v: &![View[M]], milliseconds: Int64, message: M): Unit is
        add(&(v->tree), kindTimer); setValue(&(v->tree), milliseconds);
        let h: Int64 := handler(&~v, Send(message => message)); setHandler(&(v->tree), h); return nil;
    end;
end module body.
