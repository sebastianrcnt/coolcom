import OS.Error (IoError);
import Standard.String (String);
module OS.Gui is
    -- Acquire from RootCapability; one window per task, created on core 0.
    type Gui: Linear;
    type Window: Linear;
    record Rect: Free is x: Int64; y: Int64; width: Int64; height: Int64; end;
    record Layout: Free is x: Int64; y: Int64; width: Int64; gap: Int64; end;
    record Size: Free is width: Int64; height: Int64; end;
    union Event: Free is
        case Idle;
        case Mouse is x: Int64; y: Int64; buttons: Int64; wheel: Int64;
        case Key is code: Int64;
        case Resize is width: Int64; height: Int64;
        case Close;
        case Menu is id: Int64;
    end;
    record Button: Free is pressed: Bool; end;
    record List: Free is selected: Int64; first: Int64; end;
    type TextInput: Linear;
    function acquireGui(root: &![RootCapability]): Gui;
    function releaseGui(gui: Gui): Unit;
    function open(gui: &![Gui], title: Span[Nat8], width: Int64, height: Int64): Result[Window, IoError];
    function close(window: Window): Unit;
    function size(window: &[Window]): Result[Size, IoError];
    -- Commit the completed back-buffer frame; poll also commits before reading events.
    function present(window: &![Window]): Result[Unit, IoError];
    -- Fold queued consecutive mouse motion / same-direction wheel: summed line
    -- delta and last position. Button edges and all other events stay ordered.
    function poll(window: &![Window]): Result[Event, IoError];
    function fill(window: &![Window], rect: Rect, color: Int64): Result[Unit, IoError];
    function line(window: &![Window], x0: Int64, y0: Int64, x1: Int64, y1: Int64, color: Int64): Result[Unit, IoError];
    function text(window: &![Window], x: Int64, y: Int64, value: Span[Nat8], color: Int64): Result[Unit, IoError];
    function textClipped(window: &![Window], x: Int64, y: Int64, value: Span[Nat8], color: Int64, clip: Rect): Result[Unit, IoError];
    function measure(value: Span[Nat8]): Int64;
    function label(window: &![Window], rect: Rect, value: Span[Nat8]): Result[Unit, IoError];
    function vertical(x: Int64, y: Int64, width: Int64, gap: Int64): Layout;
    function nextRow(layout: &![Layout], height: Int64): Rect;
    function button(window: &![Window], state: &![Button], rect: Rect, value: Span[Nat8], event: Event, defaultButton: Bool): Result[Bool, IoError];
    function scrollBar(window: &![Window], rect: Rect, first: Int64, count: Int64, page: Int64, event: Event): Result[Int64, IoError];
    function listFrame(window: &![Window], state: &![List], rect: Rect, count: Int64, event: Event): Result[Unit, IoError];
    function listItem(window: &![Window], state: &![List], rect: Rect, index: Int64, value: Span[Nat8], event: Event): Result[Bool, IoError];
    function makeTextInput(): TextInput;
    function destroyTextInput(input: TextInput): Unit;
    generic [R: Region]
    function inputText(input: &[TextInput, R]): Span[Nat8, R];
    generic [R: Region]
    function textInput(window: &![Window], input: &![TextInput, R], rect: Rect, event: Event): Result[Bool, IoError];
    -- Detect widget state changes or activation before repainting an event.
    function buttonNeedsRedraw(state: &[Button], rect: Rect, event: Event, defaultButton: Bool): Bool;
    -- Resolve selection before painting rows so the old selection is erased in the same frame.
    function listSelection(state: &[List], rect: Rect, count: Int64, rowWidth: Int64, event: Event): Int64;
    function listNeedsRedraw(state: &[List], rect: Rect, count: Int64, rowWidth: Int64, event: Event): Bool;
    function textInputNeedsRedraw(input: &[TextInput], rect: Rect, event: Event): Bool;
    function addMenu(window: &![Window], title: Span[Nat8]): Result[Int64, IoError];
    function addMenuItem(window: &![Window], menu: Int64, id: Int64, value: Span[Nat8]): Result[Unit, IoError];
    -- Desktop authority changes terminal fonts; chrome remains bitmap art.
    function setScale(gui: &![Gui], scale: Int64): Result[Unit, IoError];
    function setFont(gui: &![Gui], systemMono: Bool, pointSize: Int64): Result[Unit, IoError];
    -- Drawing support for OS.Ui. Every Gr operation honours the clip rectangle.
    function setClip(window: &![Window], rect: Rect): Result[Unit, IoError];
    function clearClip(window: &![Window]): Result[Unit, IoError];
    -- An 8x8 one-bit pattern aligned to client coordinates: byte (y mod 8),
    -- bit 7 is column (x mod 8) = 0. A negative background is transparent.
    function pattern(window: &![Window], rect: Rect, bits: Nat64, foreground: Int64, background: Int64): Result[Unit, IoError];
    -- Exchange black and white inside rect.
    function invert(window: &![Window], rect: Rect): Result[Unit, IoError];
    -- Style bits: 1 bitmap bold, 2 dimmed (50% gray mask), 4 underline. Returns the advance.
    function styledText(window: &![Window], x: Int64, y: Int64, value: Span[Nat8], color: Int64, style: Int64): Result[Int64, IoError];
    -- One-bit image, most significant bit first; set bits are drawn in color.
    function bitmap(window: &![Window], rect: Rect, bits: Span[Nat8], stride: Int64, color: Int64): Result[Unit, IoError];
    -- BGRA pixels with a byte stride, at logical size.
    function blit(window: &![Window], rect: Rect, pixels: Span[Nat8], stride: Int64): Result[Unit, IoError];
    -- Queued input events, including one held back by poll's folding.
    function queued(window: &![Window]): Int64;
    -- Sleep until an event is queued or the time elapses.
    function wait(window: &![Window], milliseconds: Int64): Result[Unit, IoError];
    -- Kernel test switch (gui_trace) and a monotonic microsecond clock.
    function traceEnabled(): Bool;
    function micros(): Int64;
    -- The system clipboard, shared with terminal windows (Ctrl+Shift+C/V there).
    -- copyText replaces it and returns its new serial number; clipboardText
    -- returns the bytes of one snapshot, None once it has been replaced.
    function copyText(window: &![Window], value: Span[Nat8]): Result[Int64, IoError];
    function clipboardSerial(): Int64;
    function clipboardText(serial: Int64): Option[String];
    -- Byte size of snapshot serial, or -1 once it has been replaced.
    function clipboardSize(serial: Int64): Int64;
    -- The pointer over this window's client area: 0 arrow, 1 I-beam.
    function setPointer(window: &![Window], shape: Int64): Result[Unit, IoError];
end module.
