import OS.Raw (Terminal);
module OS.CoolOS.Framebuffer is
    generic [R: Region]
    function clear(cap: &![Terminal, R]): Int64;
    generic [R: Region]
    function cursorHide(cap: &![Terminal, R]): Int64;
    generic [R: Region]
    function cursorShow(cap: &![Terminal, R]): Int64;
    generic [R: Region]
    function fillRect(cap: &![Terminal, R], x: Int64, y: Int64, w: Int64, h: Int64, color: Int64): Int64;
    generic [R: Region]
    function scroll(cap: &![Terminal, R]): Int64;
    generic [R: Region]
    function screenCodepoint(cap: &![Terminal, R], value: Int64): Int64;
    generic [R: Region]
    function alternate(cap: &![Terminal, R], on: Int64): Int64;
    function ansiColor(n: Int64): Int64;
end module.
