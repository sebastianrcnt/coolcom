pragma Unsafe_Module;

import Austral.Memory (Address, Pointer, spanToPointer);

module body Warm.Kernel is

record Filesystem: Linear is
end;

generic [R: Region]
function acquireFilesystem(root: &![RootCapability, R]): Filesystem is
return Filesystem();
end;

function releaseFilesystem(cap: Filesystem): Unit is
let {} := cap;
return nil;
end;

record Terminal: Linear is
end;

generic [R: Region]
function acquireTerminal(root: &![RootCapability, R]): Terminal is
return Terminal();
end;

function releaseTerminal(cap: Terminal): Unit is
let {} := cap;
return nil;
end;

record Tasks: Linear is
end;

generic [R: Region]
function acquireTasks(root: &![RootCapability, R]): Tasks is
return Tasks();
end;

function releaseTasks(cap: Tasks): Unit is
let {} := cap;
return nil;
end;

record Buffer: Linear is
handle: Address[Nat8];
end;

pragma Foreign_Import(External_Name => "Wknow");

function rawnow(): Int64 is
end;

function now(): Int64 is
return rawnow();
end;

pragma Foreign_Import(External_Name => "WkunixNow");

function rawunixNow(): Int64 is
end;

function unixNow(): Int64 is
return rawunixNow();
end;

pragma Foreign_Import(External_Name => "Wkticks");

function rawticks(): Int64 is
end;

function ticks(): Int64 is
return rawticks();
end;

pragma Foreign_Import(External_Name => "WkticksHP");

function rawticksHP(): Int64 is
end;

function ticksHP(): Int64 is
return rawticksHP();
end;

pragma Foreign_Import(External_Name => "WkputByte");

function rawputByte(value: Int64): Int64 is
end;

generic [R: Region]
function putByte(cap: &![Terminal, R], value: Int64): Int64 is
return rawputByte(value);
end;

pragma Foreign_Import(External_Name => "WkputCodepoint");

function rawputCodepoint(value: Int64): Int64 is
end;

generic [R: Region]
function putCodepoint(cap: &![Terminal, R], value: Int64): Int64 is
return rawputCodepoint(value);
end;

pragma Foreign_Import(External_Name => "WkgetKey");

function rawgetKey(): Int64 is
end;

generic [R: Region]
function getKey(cap: &![Terminal, R]): Int64 is
return rawgetKey();
end;

pragma Foreign_Import(External_Name => "WkkeyPending");

function rawkeyPending(): Int64 is
end;

generic [R: Region]
function keyPending(cap: &![Terminal, R]): Int64 is
return rawkeyPending();
end;

pragma Foreign_Import(External_Name => "WkkeyPop");

function rawkeyPop(): Int64 is
end;

generic [R: Region]
function keyPop(cap: &![Terminal, R]): Int64 is
return rawkeyPop();
end;

pragma Foreign_Import(External_Name => "Wkclear");

function rawclear(): Int64 is
end;

generic [R: Region]
function clear(cap: &![Terminal, R]): Int64 is
return rawclear();
end;

pragma Foreign_Import(External_Name => "WkcursorHide");

function rawcursorHide(): Int64 is
end;

generic [R: Region]
function cursorHide(cap: &![Terminal, R]): Int64 is
return rawcursorHide();
end;

pragma Foreign_Import(External_Name => "WkcursorShow");

function rawcursorShow(): Int64 is
end;

generic [R: Region]
function cursorShow(cap: &![Terminal, R]): Int64 is
return rawcursorShow();
end;

pragma Foreign_Import(External_Name => "WksetColor");

function rawsetColor(fg: Int64, bg: Int64): Int64 is
end;

generic [R: Region]
function setColor(cap: &![Terminal, R], fg: Int64, bg: Int64): Int64 is
return rawsetColor(fg, bg);
end;

pragma Foreign_Import(External_Name => "WkfillRect");

function rawfillRect(x: Int64, y: Int64, w: Int64, h: Int64, color: Int64): Int64 is
end;

generic [R: Region]
function fillRect(cap: &![Terminal, R], x: Int64, y: Int64, w: Int64, h: Int64, color: Int64): Int64 is
return rawfillRect(x, y, w, h, color);
end;

pragma Foreign_Import(External_Name => "Wkscroll");

function rawscroll(): Int64 is
end;

generic [R: Region]
function scroll(cap: &![Terminal, R]): Int64 is
return rawscroll();
end;

pragma Foreign_Import(External_Name => "WkscreenCodepoint");

function rawscreenCodepoint(value: Int64): Int64 is
end;

generic [R: Region]
function screenCodepoint(cap: &![Terminal, R], value: Int64): Int64 is
return rawscreenCodepoint(value);
end;

pragma Foreign_Import(External_Name => "Wkalternate");

function rawalternate(on: Int64): Int64 is
end;

generic [R: Region]
function alternate(cap: &![Terminal, R], on: Int64): Int64 is
return rawalternate(on);
end;

pragma Foreign_Import(External_Name => "WkyieldTask");

function rawyieldTask(): Int64 is
end;

generic [R: Region]
function yieldTask(cap: &![Tasks, R]): Int64 is
return rawyieldTask();
end;

pragma Foreign_Import(External_Name => "Wksleep");

function rawsleep(ms: Int64): Int64 is
end;

generic [R: Region]
function sleep(cap: &![Tasks, R], ms: Int64): Int64 is
return rawsleep(ms);
end;

pragma Foreign_Import(External_Name => "WksleepUntil");

function rawsleepUntil(tick: Int64): Int64 is
end;

generic [R: Region]
function sleepUntil(cap: &![Tasks, R], tick: Int64): Int64 is
return rawsleepUntil(tick);
end;

pragma Foreign_Import(External_Name => "WktaskReport");

function rawtaskReport(): Int64 is
end;

generic [R: Region]
function taskReport(cap: &![Tasks, R]): Int64 is
return rawtaskReport();
end;

pragma Foreign_Import(External_Name => "WkisSilent");

function rawisSilent(): Int64 is
end;

generic [R: Region]
function isSilent(cap: &![Tasks, R]): Int64 is
return rawisSilent();
end;

pragma Foreign_Import(External_Name => "WkkeyChar");

function rawkeyChar(event: Int64): Int64 is
end;

function keyChar(event: Int64): Int64 is
return rawkeyChar(event);
end;

pragma Foreign_Import(External_Name => "Wkutf8Width");

function rawutf8Width(cp: Int64): Int64 is
end;

function utf8Width(cp: Int64): Int64 is
return rawutf8Width(cp);
end;

pragma Foreign_Import(External_Name => "WkansiColor");

function rawansiColor(n: Int64): Int64 is
end;

function ansiColor(n: Int64): Int64 is
return rawansiColor(n);
end;

pragma Foreign_Import(External_Name => "WkdateToUnix");

function rawdateToUnix(date: Int64): Int64 is
end;

function dateToUnix(date: Int64): Int64 is
return rawdateToUnix(date);
end;

pragma Foreign_Import(External_Name => "WkunixToDate");

function rawunixToDate(stamp: Int64): Int64 is
end;

function unixToDate(stamp: Int64): Int64 is
return rawunixToDate(stamp);
end;

pragma Foreign_Import(External_Name => "Wkwrite");

function rawwrite(text: Pointer[Nat8], size: Index): Int64 is
end;

generic [R: Region, S: Region]
function write(cap: &![Terminal, R], text: Span[Nat8, S]): Int64 is
return rawwrite(spanToPointer(text), spanLength(text));
end;

pragma Foreign_Import(External_Name => "Wkdir");

function rawdir(text: Pointer[Nat8], size: Index): Int64 is
end;

generic [R: Region, S: Region]
function dir(cap: &![Filesystem, R], text: Span[Nat8, S]): Int64 is
return rawdir(spanToPointer(text), spanLength(text));
end;

pragma Foreign_Import(External_Name => "Wkmkdir");

function rawmkdir(text: Pointer[Nat8], size: Index): Int64 is
end;

generic [R: Region, S: Region]
function mkdir(cap: &![Filesystem, R], text: Span[Nat8, S]): Int64 is
return rawmkdir(spanToPointer(text), spanLength(text));
end;

pragma Foreign_Import(External_Name => "Wkcd");

function rawcd(text: Pointer[Nat8], size: Index): Int64 is
end;

generic [R: Region, S: Region]
function cd(cap: &![Filesystem, R], text: Span[Nat8, S]): Int64 is
return rawcd(spanToPointer(text), spanLength(text));
end;

pragma Foreign_Import(External_Name => "Wkexists");

function rawexists(text: Pointer[Nat8], size: Index): Int64 is
end;

generic [R: Region, S: Region]
function exists(cap: &![Filesystem, R], text: Span[Nat8, S]): Int64 is
return rawexists(spanToPointer(text), spanLength(text));
end;

pragma Foreign_Import(External_Name => "Wkdelete");

function rawdelete(text: Pointer[Nat8], size: Index): Int64 is
end;

generic [R: Region, S: Region]
function delete(cap: &![Filesystem, R], text: Span[Nat8, S]): Int64 is
return rawdelete(spanToPointer(text), spanLength(text));
end;

pragma Foreign_Import(External_Name => "WkvalidName");

function rawvalidName(text: Pointer[Nat8], size: Index): Int64 is
end;

generic [R: Region, S: Region]
function validName(cap: &![Filesystem, R], text: Span[Nat8, S]): Int64 is
return rawvalidName(spanToPointer(text), spanLength(text));
end;

pragma Foreign_Import(External_Name => "Wkallocate");

function rawallocate(size: Int64): Address[Nat8] is
end;

function allocate(size: Int64): Buffer is
return Buffer(handle => rawallocate(size));
end;

pragma Foreign_Import(External_Name => "WkreadFile");

function rawreadFile(path: Pointer[Nat8], size: Index): Address[Nat8] is
end;

generic [R: Region, S: Region]
function readFile(cap: &![Filesystem, R], path: Span[Nat8, S]): Buffer is
return Buffer(handle => rawreadFile(spanToPointer(path), spanLength(path)));
end;

pragma Foreign_Import(External_Name => "WkwriteFile");

function rawwriteFile(path: Pointer[Nat8], size: Index, data: Pointer[Nat8], count: Index): Int64 is
end;

generic [R: Region, S: Region, T: Region]
function writeFile(cap: &![Filesystem, R], path: Span[Nat8, S], data: Span[Nat8, T]): Int64 is
return rawwriteFile(spanToPointer(path), spanLength(path), spanToPointer(data), spanLength(data));
end;

pragma Foreign_Import(External_Name => "WkbufferSize");

function rawbufferSize(handle: Address[Nat8]): Int64 is
end;

generic [R: Region]
function bufferSize(buffer: &![Buffer, R]): Int64 is
return rawbufferSize(buffer->handle);
end;

pragma Foreign_Import(External_Name => "WkbufferError");

function rawbufferError(handle: Address[Nat8]): Int64 is
end;

generic [R: Region]
function bufferError(buffer: &![Buffer, R]): Int64 is
return rawbufferError(buffer->handle);
end;

pragma Foreign_Import(External_Name => "WkreadByte");

function rawreadByte(handle: Address[Nat8], index: Int64): Int64 is
end;

generic [R: Region]
function readByte(buffer: &![Buffer, R], index: Int64): Int64 is
return rawreadByte(buffer->handle, index);
end;

pragma Foreign_Import(External_Name => "WkstoreByte");

function rawstoreByte(handle: Address[Nat8], index: Int64, value: Int64): Int64 is
end;

generic [R: Region]
function storeByte(buffer: &![Buffer, R], index: Int64, value: Int64): Int64 is
return rawstoreByte(buffer->handle, index, value);
end;

pragma Foreign_Import(External_Name => "Wkfill");

function rawfill(handle: Address[Nat8], value: Int64): Int64 is
end;

generic [R: Region]
function fill(buffer: &![Buffer, R], value: Int64): Int64 is
return rawfill(buffer->handle, value);
end;

pragma Foreign_Import(External_Name => "Wkclose");

function rawclose(handle: Address[Nat8]): Int64 is
end;

function close(buffer: Buffer): Unit is
let {handle: Address[Nat8]} := buffer;
rawclose(handle);
return nil;
end;

pragma Foreign_Import(External_Name => "WkstringLength");
function rawstringLength(text: Pointer[Nat8], size: Index): Int64 is
end;

generic [R: Region]
function stringLength(text: Span[Nat8, R]): Int64 is
    return rawstringLength(spanToPointer(text), spanLength(text));
end;

pragma Foreign_Import(External_Name => "WkstringCompare");
function rawstringCompare(left: Pointer[Nat8], leftSize: Index,
                          right: Pointer[Nat8], rightSize: Index): Int64 is
end;

generic [R: Region, S: Region]
function stringCompare(left: Span[Nat8, R], right: Span[Nat8, S]): Int64 is
    return rawstringCompare(spanToPointer(left), spanLength(left),
                            spanToPointer(right), spanLength(right));
end;

pragma Foreign_Import(External_Name => "WkcopyBytes");
function rawcopyBytes(handle: Address[Nat8], data: Pointer[Nat8], size: Index): Int64 is
end;

generic [R: Region, S: Region]
function copyBytes(buffer: &![Buffer, R], data: Span[Nat8, S]): Int64 is
    return rawcopyBytes(buffer->handle, spanToPointer(data), spanLength(data));
end;

end module body.
