import Standard.String (String, slice, length);

module Standard.Eq is
    typeclass Eq(T: Type) is
        generic [R: Region, S: Region]
        method eq(a: &[T, R], b: &[T, S]): Bool;
    end;
    instance Eq(Nat8);
    instance Eq(Nat16);
    instance Eq(Nat32);
    instance Eq(Nat64);
    instance Eq(Int8);
    instance Eq(Int16);
    instance Eq(Int32);
    instance Eq(Int64);
    instance Eq(Index);
    instance Eq(ByteSize);
    instance Eq(Bool);
    instance Eq(Unit);
    instance Eq(String);
    generic [T: Type(Eq), P: Region]
    instance Eq(Span[T, P]);
end module.
