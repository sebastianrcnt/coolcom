import Standard.Eq (Eq);
import Standard.Hash (Hash);
import Standard.HashMap (HashMap, make as mapMake, destroyFree as mapDestroy);
import OS.Gui (Rect, Event, Mouse, Key, Idle);
import OS.Ui.Text (width as textWidth, lineCount, wrapLine, Line, previous, following, offsetAt, wordStart, wordEnd);
import OS.Ui.Tree (Tree, Node, Geom, Damage, makeTree, destroyTree, open, close, add, setText, appendText, appendNumber, setFlag, setGrow,
    setPadding, setSpacing, setColumns, setChildAlign, setRange, setValue, setKey, setHandler, setSize, keyOf, finishBuild, layout, props,
    geometry, textBytes, nodeText, nextFocus, parseKey, makeDamage, destroyDamage, addDamage, damageRects, damageFull, readDamage,
    kindColumn, kindRow, kindGrid, kindSplit, kindLabel, kindButton, kindSpacer, kindTextBox, kindShortcut, kindSlider, kindCheckbox, setAux,
    kindTable, kindTreeView, kindListRow, kindHeader, kindCell, kindScroll, kindTextView, setFit, setHandler2, toInt,
    flagDisabled, flagDefault, flagCancel, alignCenter, keyCtrl, keyAlt, keyShift, keyLeft, keyRight, keyEnd, keyEscape, keyEnter, keyDown);
import OS.Ui.Engine (State, Snapshot, Action, Ephemeral, makeState, destroyState, makeSnapshot, destroySnapshot, compareAndRecord, handle,
    readState, prune, current, setNow, actNone, actRepaint, actFire, actFire2, actRelayout, actCopy, listFix, ListState, scrollOffset, splitPositions);
import OS.Ui.Text (TextEdit, replaceRange);
import OS.Ui (applyEdit);
import Standard.String (String, fromLiteral, length as stringLength, slice as stringSlice, destroyString);
module body UiTest is
    function check(ok: Bool, what: Span[Nat8, Static]): Unit is
        if not ok then print("UI TEST FAILED: "); printLn(what); abort("UI TEST FAILED"); end if;
        return nil;
    end;
    function rectOf(t: &[Tree], i: Index): Rect is return rectIn(geometry(t), i); end;
    function rectIn(g: Span[Geom], i: Index): Rect is
        return Rect(x => g[i].x, y => g[i].y, width => g[i].width, height => g[i].height);
    end;
    function onlyRect(rs: Span[Rect], x: Int64, w: Int64): Bool is
        return spanLength(rs) = 1 and rs[0].x = x and rs[0].width = w;
    end;
    function rectCount(rs: Span[Rect]): Index is return spanLength(rs); end;
    function twoRects(rs: Span[Rect]): Bool is
        -- The overlapping pair merges; the far one stays separate.
        return spanLength(rs) = 2 and ((rs[0].width = 15 and rs[1].x = 100) or (rs[1].width = 15 and rs[0].x = 100));
    end;
    function same(r: Rect, x: Int64, y: Int64, w: Int64, h: Int64): Bool is
        return r.x = x and r.y = y and r.width = w and r.height = h;
    end;
    function lay(t: &![Tree], w: Int64, h: Int64): Unit is
        let splits: HashMap[Nat64, Int64] := mapMake();
        finishBuild(&~t); layout(&~t, w, h, &splits); mapDestroy(splits); return nil;
    end;

    -- column(padding 10, spacing 8): label, row(OK, spacer, Cancel)
    function dialogTree(extra: Bool): Tree is
        var t: Tree := makeTree();
        open(&!t, kindColumn); setPadding(&!t, 10); setSpacing(&!t, 8);
        if extra then add(&!t, kindLabel); setText(&!t, "Extra"); end if;
        add(&!t, kindLabel); setText(&!t, "Hello");
        open(&!t, kindRow); setSpacing(&!t, 4);
        add(&!t, kindButton); setText(&!t, "OK"); setFlag(&!t, flagDefault, true); setHandler(&!t, 0);
        add(&!t, kindSpacer); setGrow(&!t, 1);
        add(&!t, kindButton); setText(&!t, "Cancel"); setFlag(&!t, flagCancel, true); setHandler(&!t, 1);
        add(&!t, kindButton); setText(&!t, "Off"); setFlag(&!t, flagDisabled, true);
        close(&!t);
        close(&!t);
        add(&!t, kindShortcut); setValue(&!t, parseKey("Ctrl+S")); setHandler(&!t, 2);
        return t;
    end;

    function layoutTests(): Unit is
        var t: Tree := dialogTree(false);
        lay(&!t, 300, 200);
        check(same(rectOf(&t, 1), 0, 0, 300, 200), "root child fills the window");
        check(same(rectOf(&t, 2), 10, 10, 41, 16), "label: text width + 1, start aligned");
        check(same(rectOf(&t, 3), 10, 34, 280, 32), "row stretches across the column");
        check(same(rectOf(&t, 4), 10, 34, 72, 32), "default button includes its ring");
        check(rectOf(&t, 5).width = 280 - 72 - 72 - 64 - 3 * 4, "spacer takes the extra width");
        check(rectOf(&t, 6).x = 300 - 10 - 64 - 4 - 72, "buttons after the spacer are pushed right");
        check(rectOf(&t, 6).y = 34 + 4, "row children are centered vertically");
        destroyTree(t);

        -- Grid: two columns, the second grows; rows are as tall as their tallest cell.
        var g: Tree := makeTree();
        open(&!g, kindGrid); setColumns(&!g, 2); setSpacing(&!g, 6);
        add(&!g, kindLabel); setText(&!g, "Name");
        add(&!g, kindTextBox); setGrow(&!g, 1);
        add(&!g, kindLabel); setText(&!g, "Longer");
        add(&!g, kindLabel); setText(&!g, "x");
        close(&!g);
        lay(&!g, 300, 100);
        check(same(rectOf(&g, 2), 0, 4, 33, 16), "grid label centered in its row");
        check(same(rectOf(&g, 3), 55, 0, 245, 24), "growing column takes the rest");
        check(rectOf(&g, 4).y = 30 and rectOf(&g, 5).x = 55, "second row");
        destroyTree(g);

        -- Split: first pane at its initial size, the bar, then the rest.
        var s: Tree := makeTree();
        open(&!s, kindSplit); setRange(&!s, 100, 0);
        add(&!s, kindLabel); setText(&!s, "A");
        add(&!s, kindLabel); setText(&!s, "B");
        close(&!s);
        lay(&!s, 300, 100);
        check(same(rectOf(&s, 2), 0, 0, 100, 100), "split first pane");
        check(same(rectOf(&s, 3), 106, 0, 194, 100), "split second pane after the bar");
        destroyTree(s);

        -- Centered children, wrapped paragraphs.
        var c: Tree := makeTree();
        open(&!c, kindColumn); setChildAlign(&!c, alignCenter);
        add(&!c, kindLabel); setText(&!c, "Mid");
        add(&!c, kindLabel); setText(&!c, "one two three four five"); setFlag(&!c, 32, true);
        close(&!c);
        lay(&!c, 101, 100);
        check(rectOf(&c, 2).x = (101 - 25) / 2, "centered child");
        check(rectOf(&c, 3).height = 48, "wrapped text grows to three lines in 100 px");
        destroyTree(c);
        printLn("UI LAYOUT PASS"); return nil;
    end;

    function identityTests(): Unit is
        var a: Tree := dialogTree(false); var b: Tree := dialogTree(true);
        lay(&!a, 300, 200); lay(&!b, 300, 200);
        -- The OK button keeps its identity when a label is inserted before it.
        check(props(&a)[4].ident = props(&b)[5].ident, "identity follows kind ordinal");
        check(props(&a)[2].ident /= props(&b)[3].ident, "a label shifted by an inserted label changes identity");
        destroyTree(a); destroyTree(b);
        var k1: Tree := makeTree(); var k2: Tree := makeTree();
        add(&!k1, kindLabel); setKey(&!k1, keyOf("x")); add(&!k1, kindLabel); setKey(&!k1, keyOf("y"));
        add(&!k2, kindLabel); setKey(&!k2, keyOf("y")); add(&!k2, kindLabel); setKey(&!k2, keyOf("x"));
        lay(&!k1, 10, 10); lay(&!k2, 10, 10);
        check(props(&k1)[1].ident = props(&k2)[2].ident, "keyed identity is independent of order");
        destroyTree(k1); destroyTree(k2);
        printLn("UI IDENTITY PASS"); return nil;
    end;

    function keyTests(): Unit is
        check(parseKey("Ctrl+S") = 115 | keyCtrl, "Ctrl+S");
        check(parseKey("ctrl+shift+Z") = 122 | keyCtrl, "character keys drop Shift");
        check(parseKey("Alt+Left") = keyLeft | keyAlt, "Alt+Left");
        check(parseKey("Shift+Left") = keyLeft | keyShift, "special keys keep Shift");
        check(parseKey("F5") = 1114133, "F5");
        check(parseKey("Escape") = keyEscape and parseKey("Enter") = keyEnter, "names");
        check(parseKey("Ctrl+Nope") = 0, "unknown");
        printLn("UI KEYS PASS"); return nil;
    end;

    function damageTests(): Unit is
        var d: Damage := makeDamage();
        addDamage(&!d, Rect(x => 0, y => 0, width => 10, height => 10));
        addDamage(&!d, Rect(x => 5, y => 5, width => 10, height => 10));
        addDamage(&!d, Rect(x => 100, y => 100, width => 10, height => 10));
        check(twoRects(damageRects(&d)), "overlapping damage merges, distant damage stays apart");
        destroyDamage(d);
        printLn("UI DAMAGE PASS"); return nil;
    end;

    function interactionTests(): Unit is
        var t: Tree := dialogTree(false);
        lay(&!t, 300, 200);
        var state: State := makeState();
        var shown: Snapshot := makeSnapshot();
        var d: Damage := makeDamage();
        borrow r: &[Tree, Q] := &t do
            let all: Span[Nat8, Q] := textBytes(r); let ps: Span[Node, Q] := props(r); let gs: Span[Geom, Q] := geometry(r);
            compareAndRecord(all, ps, gs, readState(&!state), &!shown, &!d);
            check(damageFull(&d), "the first frame is a full paint");
            -- Tab focuses OK (Cancel next; Off is disabled and skipped).
            var a: Action := handle(all, ps, gs, &!state, Key(code => 9));
            check(a.kind = actRepaint and state.focus = ps[4].ident, "Tab focuses the first button");
            a := handle(all, ps, gs, &!state, Key(code => 9));
            check(state.focus = ps[6].ident, "Tab moves to Cancel");
            a := handle(all, ps, gs, &!state, Key(code => 9));
            check(state.focus = ps[4].ident, "Tab skips the disabled button and wraps");
            a := handle(all, ps, gs, &!state, Key(code => 9 | keyShift));
            check(state.focus = ps[6].ident, "Shift+Tab goes back");
            -- Return and Escape press the default and cancel buttons.
            a := handle(all, ps, gs, &!state, Key(code => keyEnter));
            check(a.kind = actFire and a.node = 4, "Return presses the default button");
            a := handle(all, ps, gs, &!state, Key(code => keyEscape));
            check(a.kind = actFire and a.node = 6, "Escape presses the cancel button");
            a := handle(all, ps, gs, &!state, Key(code => 115 | keyCtrl));
            check(a.kind = actFire and a.node = 8, "declared shortcut");
            -- Space presses the focused button.
            a := handle(all, ps, gs, &!state, Key(code => 32));
            check(a.kind = actFire and a.node = 6, "Space presses the focused button");
            -- Mouse: press inside, leave, return, release inside fires.
            let x: Int64 := gs[4].x + 10; let y: Int64 := gs[4].y + 10;
            a := handle(all, ps, gs, &!state, Mouse(x => x, y => y, buttons => 1, wheel => 0));
            check(a.kind = actRepaint and state.inside, "press tracks the button");
            a := handle(all, ps, gs, &!state, Mouse(x => 299, y => 199, buttons => 1, wheel => 0));
            check(a.kind = actRepaint and not state.inside, "leaving releases the inverted state");
            a := handle(all, ps, gs, &!state, Mouse(x => x, y => y, buttons => 1, wheel => 0));
            a := handle(all, ps, gs, &!state, Mouse(x => x, y => y, buttons => 0, wheel => 0));
            check(a.kind = actFire and a.node = 4, "release inside fires");
            a := handle(all, ps, gs, &!state, Mouse(x => x, y => y, buttons => 1, wheel => 0));
            a := handle(all, ps, gs, &!state, Mouse(x => 299, y => 199, buttons => 0, wheel => 0));
            check(a.kind /= actFire, "release outside does not fire");
            -- A disabled button ignores the mouse.
            a := handle(all, ps, gs, &!state, Mouse(x => gs[7].x + 5, y => gs[7].y + 5, buttons => 1, wheel => 0));
            check(a.kind = actNone, "disabled");
            a := handle(all, ps, gs, &!state, Mouse(x => gs[7].x + 5, y => gs[7].y + 5, buttons => 0, wheel => 0));
            -- An unchanged frame has no damage; a pressed button damages only itself.
            var d2: Damage := makeDamage();
            compareAndRecord(all, ps, gs, readState(&!state), &!shown, &!d2);
            check(not damageFull(&d2), "later frames are partial");
            check(rectCount(damageRects(&d2)) >= 1, "later frames have damage");
            destroyDamage(d2);
            var d3: Damage := makeDamage();
            compareAndRecord(all, ps, gs, readState(&!state), &!shown, &!d3);
            check(rectCount(damageRects(&d3)) = 0, "no change, no damage");
            destroyDamage(d3);
            a := handle(all, ps, gs, &!state, Mouse(x => x, y => y, buttons => 1, wheel => 0));
            var d4: Damage := makeDamage();
            compareAndRecord(all, ps, gs, readState(&!state), &!shown, &!d4);
            check(onlyRect(damageRects(&d4), gs[4].x, gs[4].width), "pressing damages the button only");
            destroyDamage(d4);
        end borrow;
        destroyDamage(d); destroySnapshot(shown); destroyState(state); destroyTree(t);
        printLn("UI INTERACTION PASS"); return nil;
    end;

    function textTests(): Unit is
        check(textWidth("abc") = 24 and textWidth("가나") = 32, "cell widths");
        let l: Line := wrapLine("hello world foo", 0, 80);
        check(l.finish = 5 and l.resume = 6, "wrap at the last space");
        check(lineCount("a\nb\n", 80) = 3, "newlines");
        check(previous("a가", 4) = 1 and following("a가", 1) = 4, "UTF-8 stepping");
        check(offsetAt("abcd", 13) = 2, "pixel to offset");
        check(wordStart("foo bar", 6) = 4 and wordEnd("foo bar", 0) = 3, "words");
        printLn("UI TEXT PASS"); return nil;
    end;

    function sameText(s: &[String], expected: Span[Nat8]): Bool is return sameBytes(stringSlice(s, 0, stringLength(s)), expected); end;
    function sameBytes(bytes: Span[Nat8], expected: Span[Nat8]): Bool is
        if spanLength(bytes) /= spanLength(expected) then return false; end if;
        for i from 0 until spanLength(bytes) do if bytes[i] /= expected[i] then return false; end if; end for;
        return true;
    end;
    function edit(start: Index, finish: Index, cp: Int64): TextEdit is
        return TextEdit(start => start, finish => finish, codepoint => cp, paste => 0);
    end;
    function editTests(): Unit is
        var t: String := fromLiteral("hello");
        t := applyEdit(t, edit(1, 3, 65)); check(sameText(&t, "hAlo"), "replace a range with a code point");
        t := applyEdit(t, edit(4, 4, 44032)); check(sameText(&t, "hAlo\u{AC00}"), "insert Hangul at the end");
        t := applyEdit(t, edit(4, 7, -1)); check(sameText(&t, "hAlo"), "delete a code point");
        t := applyEdit(t, edit(9, 20, 33)); check(sameText(&t, "hAlo!"), "ranges are clamped");
        let r: String := replaceRange(&t, 0, 1, "Oh, h"); check(sameText(&r, "Oh, hAlo!"), "replaceRange");
        destroyString(r); destroyString(t);
        printLn("UI EDIT PASS"); return nil;
    end;
    -- A text box and a slider, focused by clicks; keys edit and step.
    function controlTree(text: Span[Nat8]): Tree is
        var t: Tree := makeTree();
        open(&!t, kindColumn); setPadding(&!t, 10); setSpacing(&!t, 8);
        add(&!t, kindTextBox); setText(&!t, text); setHandler(&!t, 0);
        add(&!t, kindSlider); setValue(&!t, 40); setRange(&!t, 0, 100); setAux(&!t, 5); setHandler(&!t, 1);
        add(&!t, kindCheckbox); setText(&!t, "Check"); setHandler(&!t, 2);
        close(&!t);
        return t;
    end;
    function textBoxTests(): Unit is
        var t: Tree := controlTree("hello world");
        lay(&!t, 300, 200);
        var state: State := makeState();
        borrow r: &[Tree, Q] := &t do
            let all: Span[Nat8, Q] := textBytes(r); let ps: Span[Node, Q] := props(r); let gs: Span[Geom, Q] := geometry(r);
            let box: Index := 2;
            let id: Nat64 := ps[box].ident;
            -- Click after "hel" (x inset 4, 8 px per character): focus and caret.
            var a: Action := handle(all, ps, gs, &!state, Mouse(x => gs[box].x + 4 + 24 + 2, y => gs[box].y + 5, buttons => 1, wheel => 0));
            a := handle(all, ps, gs, &!state, Mouse(x => gs[box].x + 4 + 24 + 2, y => gs[box].y + 5, buttons => 0, wheel => 0));
            let e1: Ephemeral := current(&!state, id);
            check(state.focus = id and e1.a = 3, "click focuses and places the caret");
            a := handle(all, ps, gs, &!state, Key(code => 88));
            check(a.kind = actFire and a.node = box and a.edit.start = 3 and a.edit.finish = 3 and a.edit.codepoint = 88, "typing inserts");
            let e2: Ephemeral := current(&!state, id);
            check(e2.a = 4, "caret after the insertion");
            a := handle(all, ps, gs, &!state, Key(code => 8));
            check(a.kind = actFire and a.edit.start = 3 and a.edit.finish = 4 and a.edit.codepoint = -1, "Backspace deletes before the caret");
            -- (The model has not changed the text in this test: the caret is at 3.)
            a := handle(all, ps, gs, &!state, Key(code => keyLeft | keyShift));
            a := handle(all, ps, gs, &!state, Key(code => keyLeft | keyShift));
            let e3: Ephemeral := current(&!state, id);
            check(e3.a = 1 and e3.b = 3, "Shift+Left extends the selection");
            a := handle(all, ps, gs, &!state, Key(code => 99 | keyCtrl));
            check(a.kind = actCopy and a.value = 1 and a.aux = 3, "Ctrl+C copies the selection");
            a := handle(all, ps, gs, &!state, Key(code => 120 | keyCtrl));
            check(a.kind = actFire and a.aux = 1 and a.edit.start = 1 and a.edit.finish = 3, "Ctrl+X copies and deletes");
            a := handle(all, ps, gs, &!state, Key(code => 97 | keyCtrl));
            let e4: Ephemeral := current(&!state, id);
            check(e4.a = 11 and e4.b = 0, "Ctrl+A selects everything");
            a := handle(all, ps, gs, &!state, Key(code => 118 | keyCtrl));
            check(a.kind = actFire and a.edit.start = 0 and a.edit.finish = 11 and a.edit.paste = -1, "Ctrl+V pastes over the selection");
            a := handle(all, ps, gs, &!state, Key(code => keyEnter));
            check(a.kind = actNone, "Return is not consumed by a text box without a default button");
            a := handle(all, ps, gs, &!state, Key(code => keyLeft | keyCtrl));
            let e5: Ephemeral := current(&!state, id);
            check(e5.a = 0, "Ctrl+Left moves by words");
            -- Double click selects the word under the pointer.
            setNow(&!state, 1000000);
            a := handle(all, ps, gs, &!state, Mouse(x => gs[box].x + 4 + 8 * 7, y => gs[box].y + 5, buttons => 1, wheel => 0));
            a := handle(all, ps, gs, &!state, Mouse(x => gs[box].x + 4 + 8 * 7, y => gs[box].y + 5, buttons => 0, wheel => 0));
            setNow(&!state, 1100000);
            a := handle(all, ps, gs, &!state, Mouse(x => gs[box].x + 4 + 8 * 7, y => gs[box].y + 5, buttons => 1, wheel => 0));
            let e6: Ephemeral := current(&!state, id);
            check(e6.b = 6 and e6.a = 11, "double click selects a word");
            a := handle(all, ps, gs, &!state, Mouse(x => gs[box].x + 4 + 8 * 7, y => gs[box].y + 5, buttons => 0, wheel => 0));
            -- Slider: click on the thumb focuses; keys step and clamp.
            let sl: Index := 3;
            let thumb: Int64 := gs[sl].x + (gs[sl].width - 11) * 40 / 100 + 5;
            a := handle(all, ps, gs, &!state, Mouse(x => thumb, y => gs[sl].y + 10, buttons => 1, wheel => 0));
            check(state.focus = ps[sl].ident, "clicking the slider focuses it");
            a := handle(all, ps, gs, &!state, Mouse(x => thumb + (gs[sl].width - 11) / 2, y => gs[sl].y + 10, buttons => 1, wheel => 0));
            check(a.kind = actFire and a.value = 90, "dragging the thumb by half the track adds half the range");
            a := handle(all, ps, gs, &!state, Mouse(x => thumb + (gs[sl].width - 11) / 2, y => gs[sl].y + 10, buttons => 0, wheel => 0));
            a := handle(all, ps, gs, &!state, Key(code => keyRight));
            check(a.kind = actFire and a.value = 45, "Right steps by the step");
            a := handle(all, ps, gs, &!state, Key(code => keyEnd));
            check(a.kind = actFire and a.value = 100, "End goes to the maximum");
            -- Checkbox: release inside reports the toggled state.
            let cb: Index := 4;
            a := handle(all, ps, gs, &!state, Mouse(x => gs[cb].x + 3, y => gs[cb].y + 3, buttons => 1, wheel => 0));
            a := handle(all, ps, gs, &!state, Mouse(x => gs[cb].x + 3, y => gs[cb].y + 3, buttons => 0, wheel => 0));
            check(a.kind = actFire and a.node = cb and a.value = 1, "checkbox toggles");
        end borrow;
        -- A shorter text from the model clamps the caret.
        var shorter: Tree := controlTree("hi");
        lay(&!shorter, 300, 200);
        borrow r: &[Tree, Q] := &shorter do
            prune(&!state, textBytes(r), props(r), geometry(r));
            let e7: Ephemeral := current(&!state, props(r)[2].ident);
            check(e7.a = 2 and e7.b = 2, "carets are clamped to the model's text");
        end borrow;
        destroyTree(shorter); destroyState(state); destroyTree(t);
        printLn("UI TEXT BOX PASS"); return nil;
    end;

    -- A 1000-row table showing rows 10.. with two columns.
    function tableTree(): Tree is
        var t: Tree := makeTree();
        open(&!t, kindTable); setValue(&!t, 10); setRange(&!t, 1000, 12); setAux(&!t, -1); setHandler(&!t, 0); setHandler2(&!t, 1);
        add(&!t, kindHeader); setText(&!t, "Name"); setValue(&!t, 100); setRange(&!t, 1, 0);
        add(&!t, kindHeader); setText(&!t, "Size"); setValue(&!t, 80); setRange(&!t, 1, 0);
        for r from 10 until 21 do
            open(&!t, kindListRow); setValue(&!t, toInt(r));
            add(&!t, kindCell); setText(&!t, "name");
            add(&!t, kindCell); setText(&!t, "size");
            close(&!t);
        end for;
        close(&!t);
        return t;
    end;
    function dataTests(): Unit is
        var t: Tree := tableTree();
        lay(&!t, 300, 200);
        var state: State := makeState();
        borrow r: &[Tree, Q] := &t do
            let all: Span[Nat8, Q] := textBytes(r); let ps: Span[Node, Q] := props(r); let gs: Span[Geom, Q] := geometry(r);
            check(same(rectIn(gs, 2), 2, 2, 100, 19) and same(rectIn(gs, 3), 102, 2, 180, 19), "headers: widths, the last reaches the scroll bar");
            check(same(rectIn(gs, 4), 2, 22, 280, 18) and same(rectIn(gs, 7), 2, 40, 280, 18), "rows by index under the header");
            check(same(rectIn(gs, 5), 2, 22, 100, 18) and same(rectIn(gs, 6), 102, 22, 180, 18), "cells under their columns");
            -- The framework corrects the rows that fit (176 px of body: 10 rows) once.
            var a: Action := listFix(ps, gs, &!state);
            check(a.kind = actFire and a.list.fit = 10 and a.list.first = 10 and a.list.selected = 12, "fit correction");
            a := listFix(ps, gs, &!state);
            check(a.kind = actNone, "the correction is sent once");
            -- Wheel: three rows a line.
            a := handle(all, ps, gs, &!state, Mouse(x => 50, y => 60, buttons => 0, wheel => -1));
            check(a.kind = actFire and a.list.first = 13, "wheel scrolls three rows");
            -- Click a row: focus and selection.
            a := handle(all, ps, gs, &!state, Mouse(x => 50, y => 22 + 18 * 3 + 5, buttons => 1, wheel => 0));
            check(a.kind = actFire and a.list.selected = 13 and state.focus = ps[1].ident, "click selects row first + 3");
            a := handle(all, ps, gs, &!state, Mouse(x => 50, y => 22 + 18 * 3 + 5, buttons => 0, wheel => 0));
            -- Keys (the tree still shows selected 12): Down selects 13, End the last row.
            a := handle(all, ps, gs, &!state, Key(code => keyDown));
            check(a.kind = actFire and a.list.selected = 13, "Down");
            a := handle(all, ps, gs, &!state, Key(code => keyEnd));
            check(a.kind = actFire and a.list.selected = 999 and a.list.first = 1000 - 9, "End keeps the selection visible");
            a := handle(all, ps, gs, &!state, Key(code => keyEnter));
            check(a.kind = actFire2 and a.value = 12, "Return opens the selected row");
            -- Header: sort by Size.
            a := handle(all, ps, gs, &!state, Mouse(x => 150, y => 10, buttons => 1, wheel => 0));
            check(a.kind = actFire and a.list.sort = 1 and not a.list.descending and a.list.first = 0, "header click sorts");
            a := handle(all, ps, gs, &!state, Mouse(x => 150, y => 10, buttons => 0, wheel => 0));
            -- Scroll bar: a click below the thumb pages down; the thumb drags.
            a := handle(all, ps, gs, &!state, Mouse(x => 290, y => 150, buttons => 1, wheel => 0));
            check(a.kind = actFire and a.list.first = 10 + 9, "track click pages");
            a := handle(all, ps, gs, &!state, Mouse(x => 290, y => 150, buttons => 0, wheel => 0));
            -- Dragging the Name rule resizes the column (framework state, relayout).
            a := handle(all, ps, gs, &!state, Mouse(x => 101, y => 10, buttons => 1, wheel => 0));
            a := handle(all, ps, gs, &!state, Mouse(x => 131, y => 10, buttons => 1, wheel => 0));
            check(a.kind = actRelayout, "column rule drag relayouts");
            a := handle(all, ps, gs, &!state, Mouse(x => 131, y => 10, buttons => 0, wheel => 0));
        end borrow;
        layout(&!t, 300, 200, splitPositions(&state));
        borrow r: &[Tree, Q] := &t do
            check(rectIn(geometry(r), 2).width = 129 and rectIn(geometry(r), 3).x = 131, "column widths are kept by the framework");
        end borrow;
        destroyTree(t);
        -- Trees: the triangle toggles; Right opens a closed row.
        var tree: Tree := makeTree();
        open(&!tree, kindTreeView); setValue(&!tree, 0); setRange(&!tree, 3, 0); setAux(&!tree, -1); setFit(&!tree, 10); setHandler(&!tree, 0); setHandler2(&!tree, 1);
        add(&!tree, kindListRow); setValue(&!tree, 0); setText(&!tree, "Folder"); setRange(&!tree, 0, 1);
        add(&!tree, kindListRow); setValue(&!tree, 1); setText(&!tree, "Open"); setRange(&!tree, 0, 3);
        add(&!tree, kindListRow); setValue(&!tree, 2); setText(&!tree, "Child"); setRange(&!tree, 1, 0);
        close(&!tree);
        lay(&!tree, 300, 200);
        borrow r: &[Tree, Q] := &tree do
            let all: Span[Nat8, Q] := textBytes(r); let ps: Span[Node, Q] := props(r); let gs: Span[Geom, Q] := geometry(r);
            var a: Action := handle(all, ps, gs, &!state, Mouse(x => 2 + 2 + 8, y => 2 + 9, buttons => 1, wheel => 0));
            check(a.kind = actFire2 and a.value = 0, "triangle toggles row 0");
            a := handle(all, ps, gs, &!state, Mouse(x => 2 + 2 + 8, y => 2 + 9, buttons => 0, wheel => 0));
            a := handle(all, ps, gs, &!state, Key(code => keyRight));
            check(a.kind = actFire2 and a.value = 0, "Right opens the selected closed row");
            a := handle(all, ps, gs, &!state, Key(code => keyLeft));
            check(a.kind = actNone, "Left on a closed row does nothing");
        end borrow;
        destroyTree(tree);
        -- Scroll view: the wheel moves the content (framework offset, relayout).
        var sv: Tree := makeTree();
        open(&!sv, kindScroll);
        open(&!sv, kindColumn);
        for k from 0 until 30 do add(&!sv, kindLabel); setText(&!sv, "line"); end for;
        close(&!sv);
        close(&!sv);
        lay(&!sv, 300, 200);
        borrow r: &[Tree, Q] := &sv do
            let all: Span[Nat8, Q] := textBytes(r); let ps: Span[Node, Q] := props(r); let gs: Span[Geom, Q] := geometry(r);
            check(rectIn(gs, 2).height = 480 and rectIn(gs, 2).y = 1, "content at its preferred height");
            let a: Action := handle(all, ps, gs, &!state, Mouse(x => 50, y => 50, buttons => 0, wheel => -1));
            check(a.kind = actRelayout and scrollOffset(&!state, ps[1].ident) = 54, "wheel scrolls three rows of pixels");
        end borrow;
        layout(&!sv, 300, 200, splitPositions(&state));
        check(rectOf(&sv, 2).y = 1 - 54, "scrolled content");
        destroyTree(sv);
        -- Text view: lines, Down keeps the column, Return inserts a newline.
        var tv: Tree := makeTree();
        add(&!tv, kindTextView); setText(&!tv, "one\ntwo words\nthree"); setHandler(&!tv, 0);
        lay(&!tv, 300, 200);
        borrow r: &[Tree, Q] := &tv do
            let all: Span[Nat8, Q] := textBytes(r); let ps: Span[Node, Q] := props(r); let gs: Span[Geom, Q] := geometry(r);
            var a: Action := handle(all, ps, gs, &!state, Mouse(x => 2 + 4 + 8 * 2 + 2, y => 2 + 3, buttons => 1, wheel => 0));
            a := handle(all, ps, gs, &!state, Mouse(x => 2 + 4 + 8 * 2 + 2, y => 2 + 3, buttons => 0, wheel => 0));
            let e1: Ephemeral := current(&!state, ps[1].ident);
            check(e1.a = 2, "click in the first line");
            a := handle(all, ps, gs, &!state, Key(code => keyDown));
            let e2: Ephemeral := current(&!state, ps[1].ident);
            check(e2.a = 6, "Down keeps the column");
            a := handle(all, ps, gs, &!state, Key(code => keyDown));
            let e3: Ephemeral := current(&!state, ps[1].ident);
            check(e3.a = 16, "Down again");
            a := handle(all, ps, gs, &!state, Key(code => keyEnter));
            check(a.kind = actFire and a.edit.codepoint = 10 and a.edit.start = 16, "Return inserts a newline");
        end borrow;
        destroyTree(tv);
        destroyState(state);
        printLn("UI DATA PASS"); return nil;
    end;

    function main(): ExitCode is
        dataTests(); editTests(); textBoxTests();
        textTests(); layoutTests(); identityTests(); keyTests(); damageTests(); interactionTests();
        printLn("UI HOST PASS");
        return ExitSuccess();
    end;
end module body.
