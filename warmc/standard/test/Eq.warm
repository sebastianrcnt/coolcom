import Standard.Eq (Eq, eq);
import Standard.Hash (Hash, hash);
import Standard.Ord (Ord, Ordering, Less, Equal, Greater, compare);
import Standard.String (String, fromLiteral, destroyString);
import Standard.Vector (Vector, make, push, slice, destroyFree, pop, destroyEmpty);
import Standard.Test.GeneralSupport (check);
module body Standard.Test.Eq is
    function eqTestSuite(): Unit is
        let scalar0: Nat8 := 1;
        check(eq(&scalar0, &scalar0)); check(hash(&scalar0) = hash(&scalar0));
        case compare(&scalar0, &scalar0) of when Equal do skip; when Less do abort("reflexive order"); when Greater do abort("reflexive order"); end case;
        let scalar1: Nat16 := 1;
        check(eq(&scalar1, &scalar1)); check(hash(&scalar1) = hash(&scalar1));
        case compare(&scalar1, &scalar1) of when Equal do skip; when Less do abort("reflexive order"); when Greater do abort("reflexive order"); end case;
        let scalar2: Nat32 := 1;
        check(eq(&scalar2, &scalar2)); check(hash(&scalar2) = hash(&scalar2));
        case compare(&scalar2, &scalar2) of when Equal do skip; when Less do abort("reflexive order"); when Greater do abort("reflexive order"); end case;
        let scalar3: Nat64 := 1;
        check(eq(&scalar3, &scalar3)); check(hash(&scalar3) = hash(&scalar3));
        case compare(&scalar3, &scalar3) of when Equal do skip; when Less do abort("reflexive order"); when Greater do abort("reflexive order"); end case;
        let scalar4: Int8 := 1;
        check(eq(&scalar4, &scalar4)); check(hash(&scalar4) = hash(&scalar4));
        case compare(&scalar4, &scalar4) of when Equal do skip; when Less do abort("reflexive order"); when Greater do abort("reflexive order"); end case;
        let scalar5: Int16 := 1;
        check(eq(&scalar5, &scalar5)); check(hash(&scalar5) = hash(&scalar5));
        case compare(&scalar5, &scalar5) of when Equal do skip; when Less do abort("reflexive order"); when Greater do abort("reflexive order"); end case;
        let scalar6: Int32 := 1;
        check(eq(&scalar6, &scalar6)); check(hash(&scalar6) = hash(&scalar6));
        case compare(&scalar6, &scalar6) of when Equal do skip; when Less do abort("reflexive order"); when Greater do abort("reflexive order"); end case;
        let scalar7: Int64 := 1;
        check(eq(&scalar7, &scalar7)); check(hash(&scalar7) = hash(&scalar7));
        case compare(&scalar7, &scalar7) of when Equal do skip; when Less do abort("reflexive order"); when Greater do abort("reflexive order"); end case;
        let scalar8: Index := 1;
        check(eq(&scalar8, &scalar8)); check(hash(&scalar8) = hash(&scalar8));
        case compare(&scalar8, &scalar8) of when Equal do skip; when Less do abort("reflexive order"); when Greater do abort("reflexive order"); end case;
        let scalar9: ByteSize := sizeof(Nat8);
        check(eq(&scalar9, &scalar9)); check(hash(&scalar9) = hash(&scalar9));
        case compare(&scalar9, &scalar9) of when Equal do skip; when Less do abort("reflexive order"); when Greater do abort("reflexive order"); end case;
        let scalar10: Unit := nil;
        check(eq(&scalar10, &scalar10)); check(hash(&scalar10) = hash(&scalar10));
        case compare(&scalar10, &scalar10) of when Equal do skip; when Less do abort("reflexive order"); when Greater do abort("reflexive order"); end case;
        let a: Int64 := minimum_int64;
        let b: Int64 := maximum_int64;
        check(eq(&a, &a)); check(not eq(&a, &b));
        case compare(&a, &b) of when Less do skip; when Equal do abort("order"); when Greater do abort("order"); end case;
        let one: Nat64 := maximum_nat64;
        check(hash(&one) = maximum_nat64);
        let no: Bool := false; let yes: Bool := true;
        check(not eq(&no, &yes));
        case compare(&no, &yes) of when Less do skip; when Equal do abort("bool order"); when Greater do abort("bool order"); end case;
        let x: String := fromLiteral("abc"); let y: String := fromLiteral("abc"); let z: String := fromLiteral("abcd");
        check(eq(&x, &y)); check(hash(&x) = hash(&y)); check(not eq(&x, &z));
        case compare(&x, &z) of when Less do skip; when Equal do abort("string order"); when Greater do abort("string order"); end case;
        destroyString(x); destroyString(y); destroyString(z);
        let p: Span[Nat8, Static] := "abc";
        let q: Span[Nat8, Static] := "abc";
        check(eq(&p, &q)); check(hash(&p) = hash(&q));
        let empty: Span[Nat8, Static] := "";
        check(eq(&empty, &empty));
        case compare(&empty, &p) of when Less do skip; when Equal do abort("span order"); when Greater do abort("span order"); end case;
        var numbers: Vector[Index] := make(); push(&!numbers, 1); push(&!numbers, 2); push(&!numbers, 1); push(&!numbers, 2);
        borrow read: &[Vector[Index], R] := &numbers do
            let left: Span[Index, R] := slice(read, 0, 2); let right: Span[Index, R] := slice(read, 2, 4);
            check(eq(&left, &right)); check(hash(&left) = hash(&right));
            case compare(&left, &right) of when Equal do skip; when Less do abort("generic span order"); when Greater do abort("generic span order"); end case;
        end borrow;
        destroyFree(numbers);
        var texts: Vector[String] := make(); push(&!texts, fromLiteral("same")); push(&!texts, fromLiteral("same"));
        borrow read: &[Vector[String], R] := &texts do
            let left: Span[String, R] := slice(read, 0, 1); let right: Span[String, R] := slice(read, 1, 2);
            check(eq(&left, &right)); check(hash(&left) = hash(&right));
            case compare(&left, &right) of when Equal do skip; when Less do abort("linear span order"); when Greater do abort("linear span order"); end case;
        end borrow;
        while true do case pop(&!texts) of when Some(value: String) do destroyString(value); when None do break; end case; end while;
        destroyEmpty(texts);
        printLn("STDLIB EQ HASH ORD PASS");
        return nil;
    end;
end module body.
