import OS.Terminal (Output);
import OS.Error (IoError);
module OS.CoolOS.Framebuffer is
    function clear(output: &![Output]): Result[Unit, IoError];
    function cursorHide(output: &![Output]): Result[Unit, IoError];
    function cursorShow(output: &![Output]): Result[Unit, IoError];
    function fillRect(output: &![Output], x: Int64, y: Int64, w: Int64, h: Int64, color: Nat32): Result[Unit, IoError];
    function scroll(output: &![Output]): Result[Unit, IoError];
    function screenCodepoint(output: &![Output], value: Nat32): Result[Unit, IoError];
    function alternate(output: &![Output], on: Bool): Result[Unit, IoError];
end module.
