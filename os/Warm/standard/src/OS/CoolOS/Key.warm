import OS.Terminal (Input, Key, decodeKey);
import OS.Error (IoError, fromCode);
module body OS.CoolOS.Key is
    pragma Foreign_Import(External_Name => "WkkeyPending");
    private function rawPending(): Int64 is end;
    pragma Foreign_Import(External_Name => "WkkeyPop");
    private function rawPop(): Int64 is end;
    function keyPending(input: &![Input]): Result[Bool, IoError] is
        let n: Int64 := rawPending(); if n < 0 then return Err(error => fromCode(n)); end if; return Ok(value => n /= 0); end;
    function keyPop(input: &![Input]): Result[Option[Key], IoError] is
        let n: Int64 := rawPop(); if n = 0 then return Ok(value => None()); end if;
        case decodeKey(n) of when Ok(value as k: Key) do return Ok(value => Some(value => k)); when Err(error as e: IoError) do return Err(error => e); end case; end;
end module body.
