-- The network stack's parser for received packets, in Warm (docs/networking.md). It
-- checks the Ethernet, ARP, IPv4, ICMP, UDP and TCP headers of a frame or of an IPv4
-- packet (lengths, versions, checksums, the TCP options) and returns a Packet whose
-- offsets and lengths all lie inside the input. It never reads outside the span: every
-- index is checked by Warm, so a mistake here aborts (a dropped packet in the kernel)
-- instead of reading or writing kernel memory. It is all safe Warm: the two exports take
-- the frame as a span (a pointer and a length on the Cool side) and return the Packet as
-- the Cool class CNetPkt (Export_Layout). os/Kernel/Net.cool acts on the result; the build
-- turns this file into os/Kernel/NetParse.cool (warmc --kernel-module=NetParse).
module body NetParse is
    -- Packet kinds: what was received, or why it is dropped (NP_* in Net.cool).
    constant kindArp: Nat64 := 1;
    constant kindIcmp: Nat64 := 2;
    constant kindUdp: Nat64 := 3;
    constant kindTcp: Nat64 := 4;
    constant kindIp: Nat64 := 5;          -- another IP protocol
    constant kindOther: Nat64 := 6;       -- another ethertype
    constant dropRunt: Nat64 := 16;       -- shorter than an Ethernet header
    constant dropArp: Nat64 := 17;        -- not an Ethernet/IPv4 ARP packet
    constant dropIp: Nat64 := 18;         -- bad IPv4 version or lengths
    constant dropFragment: Nat64 := 19;
    constant dropIpSum: Nat64 := 20;
    constant dropL4: Nat64 := 21;         -- bad ICMP, UDP or TCP lengths
    constant dropL4Sum: Nat64 := 22;

    """
    A received packet, which Cool sees as class CNetPkt with these fields (U64). Offsets
    count from the start of the input. For a drop in ICMP, UDP or TCP (dropL4, dropL4Sum)
    the IPv4 fields are set.
    """
    pragma Export_Layout(Name => "CNetPkt");
    record Packet: Free is
        kind: Nat64;
        op: Nat64;        -- ARP: the operation
        sha: Nat64;       -- ARP: the offset of the sender's MAC address
        src: Nat64;       -- IPv4 source (ARP: sender) address
        dst: Nat64;       -- IPv4 destination (ARP: target) address
        ttl: Nat64;
        proto: Nat64;
        l4: Nat64;        -- the offset and length of the ICMP message, UDP datagram or TCP segment
        l4len: Nat64;
        sport: Nat64;     -- UDP, TCP
        dport: Nat64;
        data: Nat64;      -- the offset and length of the UDP or TCP payload
        dlen: Nat64;
        seq: Nat64;       -- TCP
        ack: Nat64;
        flags: Nat64;
        win: Nat64;
        mss: Nat64;       -- the MSS option of a SYN, 0 when absent
        itype: Nat64;     -- ICMP: type, code, and the echo identifier and sequence number
        icode: Nat64;
        iid: Nat64;
        iseq: Nat64;
    end;

    private function blank(kind: Nat64): Packet is
        return Packet(kind => kind, op => 0, sha => 0, src => 0, dst => 0, ttl => 0, proto => 0,
            l4 => 0, l4len => 0, sport => 0, dport => 0, data => 0, dlen => 0, seq => 0, ack => 0,
            flags => 0, win => 0, mss => 0, itype => 0, icode => 0, iid => 0, iseq => 0);
    end;

    private function byte(f: Span[Nat8], at: Index): Nat64 is
        return widenToNat64(f[at]);
    end;

    private function get16(f: Span[Nat8], at: Index): Nat64 is
        return byte(f, at) << 8 | byte(f, at + 1);
    end;

    private function get32(f: Span[Nat8], at: Index): Nat64 is
        return get16(f, at) << 16 | get16(f, at + 2);
    end;

    """
    The ones'-complement sum of len bytes at off as big-endian 16-bit words, added to
    initial, not folded (NetSum in Net.cool).
    """
    private function sum(f: Span[Nat8], off: Index, len: Index, initial: Nat64): Nat64 is
        -- The high and the low bytes are added up apart (no call or shift per word).
        var high: Nat64 := 0;
        var low: Nat64 := 0;
        var i: Index := off;
        let even: Index := off + (len & ~1);
        while i < even do
            high := high + widenToNat64(f[i]);
            low := low + widenToNat64(f[i + 1]);
            i := i + 2;
        end while;
        if i < off + len then
            high := high + widenToNat64(f[i]);
        end if;
        return initial + (high << 8) + low;
    end;

    """
    True when a sum over a packet, with its checksum field in it, verifies.
    """
    private function sumOk(initial: Nat64): Bool is
        var s: Nat64 := initial;
        while s > #xFFFF do
            s := (s & #xFFFF) + (s >> 16);
        end while;
        return s = #xFFFF;
    end;

    private function pseudo(src: Nat64, dst: Nat64, proto: Nat64, len: Index): Nat64 is
        return (src >> 16) + (src & #xFFFF) + (dst >> 16) + (dst & #xFFFF) + proto + widenToNat64(len);
    end;

    private function parseArp(f: Span[Nat8], off: Index, len: Index): Packet is
        if len < 28 then
            return blank(dropArp);
        end if;
        if get16(f, off) /= 1 or get16(f, off + 2) /= #x0800 then
            return blank(dropArp);
        end if;
        if byte(f, off + 4) /= 6 or byte(f, off + 5) /= 4 then
            return blank(dropArp);
        end if;
        var p: Packet := blank(kindArp);
        p.op := get16(f, off + 6);
        p.sha := widenToNat64(off + 8);
        p.src := get32(f, off + 14);
        p.dst := get32(f, off + 24);
        return p;
    end;

    private function parseIcmp(f: Span[Nat8], p: &![Packet]): Unit is
        let off: Index := widenToIndex(p->l4);
        let len: Index := widenToIndex(p->l4len);
        if len < 8 then
            p->kind := dropL4;
            return nil;
        end if;
        if not sumOk(sum(f, off, len, 0)) then
            p->kind := dropL4Sum;
            return nil;
        end if;
        p->kind := kindIcmp;
        p->itype := byte(f, off);
        p->icode := byte(f, off + 1);
        p->iid := get16(f, off + 4);
        p->iseq := get16(f, off + 6);
        return nil;
    end;

    private function parseUdp(f: Span[Nat8], p: &![Packet]): Unit is
        let off: Index := widenToIndex(p->l4);
        let len: Index := widenToIndex(p->l4len);
        if len < 8 then
            p->kind := dropL4;
            return nil;
        end if;
        let ul: Index := widenToIndex(get16(f, off + 4));
        if ul < 8 or ul > len then
            p->kind := dropL4;
            return nil;
        end if;
        if get16(f, off + 6) /= 0 then
            if not sumOk(sum(f, off, ul, pseudo(p->src, p->dst, p->proto, ul))) then
                p->kind := dropL4Sum;
                return nil;
            end if;
        end if;
        p->kind := kindUdp;
        p->l4len := widenToNat64(ul);
        p->sport := get16(f, off);
        p->dport := get16(f, off + 2);
        p->data := widenToNat64(off + 8);
        p->dlen := widenToNat64(ul - 8);
        return nil;
    end;

    """
    The MSS option among the TCP options at off .. off + len - 1; 0 when there is none.
    """
    private function tcpMss(f: Span[Nat8], off: Index, len: Index): Nat64 is
        var i: Index := 0;
        while i < len do
            let kind: Nat64 := byte(f, off + i);
            if kind = 0 then
                return 0;
            else if kind = 1 then
                i := i + 1;
            else
                if i + 1 >= len then
                    return 0;
                end if;
                let olen: Index := widenToIndex(f[off + i + 1]);
                if olen < 2 then
                    return 0;
                end if;
                if kind = 2 and olen = 4 and i + 4 <= len then
                    return get16(f, off + i + 2);
                end if;
                i := i + olen;
            end if;
        end while;
        return 0;
    end;

    private function parseTcp(f: Span[Nat8], p: &![Packet]): Unit is
        let off: Index := widenToIndex(p->l4);
        let len: Index := widenToIndex(p->l4len);
        if len < 20 then
            p->kind := dropL4;
            return nil;
        end if;
        if not sumOk(sum(f, off, len, pseudo(p->src, p->dst, p->proto, len))) then
            p->kind := dropL4Sum;
            return nil;
        end if;
        let hl: Index := (widenToIndex(f[off + 12]) >> 4) * 4;
        if hl < 20 or hl > len then
            p->kind := dropL4;
            return nil;
        end if;
        p->kind := kindTcp;
        p->sport := get16(f, off);
        p->dport := get16(f, off + 2);
        p->seq := get32(f, off + 4);
        p->ack := get32(f, off + 8);
        p->flags := byte(f, off + 13);
        p->win := get16(f, off + 14);
        p->data := widenToNat64(off + hl);
        p->dlen := widenToNat64(len - hl);
        if p->flags & 2 /= 0 then  -- SYN
            p->mss := tcpMss(f, off + 20, hl - 20);
        end if;
        return nil;
    end;

    """
    An IPv4 packet of len bytes at off (after the Ethernet header, or a looped-back one).
    """
    private function parseIpAt(f: Span[Nat8], off: Index, len: Index): Packet is
        if len < 20 then
            return blank(dropIp);
        end if;
        let first: Index := widenToIndex(f[off]);
        if first >> 4 /= 4 then
            return blank(dropIp);
        end if;
        let hl: Index := (first & 15) * 4;
        let tl: Index := widenToIndex(get16(f, off + 2));
        if hl < 20 or tl < hl or tl > len then
            return blank(dropIp);
        end if;
        if not sumOk(sum(f, off, hl, 0)) then
            return blank(dropIpSum);
        end if;
        if get16(f, off + 6) & #x3FFF /= 0 then
            return blank(dropFragment);
        end if;
        var p: Packet := blank(kindIp);
        p.src := get32(f, off + 12);
        p.dst := get32(f, off + 16);
        p.ttl := byte(f, off + 8);
        p.proto := byte(f, off + 9);
        p.l4 := widenToNat64(off + hl);
        p.l4len := widenToNat64(tl - hl);
        if p.proto = 1 then
            parseIcmp(f, &!p);
        else if p.proto = 17 then
            parseUdp(f, &!p);
        else if p.proto = 6 then
            parseTcp(f, &!p);
        end if;
        return p;
    end;

    """
    An IPv4 packet (from the loopback queue). In Cool:
    U0 NetParsePacket(CNetPkt *out, U8 *data, I64 size).
    """
    pragma Foreign_Export(External_Name => "NetParsePacket");
    function parseIp(packet: Span[Nat8]): Packet is
        return parseIpAt(packet, 0, spanLength(packet));
    end;

    """
    An Ethernet frame. In Cool: U0 NetParseFrame(CNetPkt *out, U8 *data, I64 size).
    """
    pragma Foreign_Export(External_Name => "NetParseFrame");
    function parseFrame(frame: Span[Nat8]): Packet is
        let n: Index := spanLength(frame);
        if n < 14 then
            return blank(dropRunt);
        end if;
        let ethertype: Nat64 := get16(frame, 12);
        if ethertype = #x0806 then
            return parseArp(frame, 14, n - 14);
        else if ethertype = #x0800 then
            return parseIpAt(frame, 14, n - 14);
        end if;
        return blank(kindOther);
    end;
end module body.
