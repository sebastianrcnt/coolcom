// Secondary cores are released through m1n1 spin-table words.
#define CORES_MAX     8

// HolyC classes are packed (no padding): atomics need 8-byte alignment, so keep
// the size a multiple of 8 for arrays of CCPU and I64s ahead of smaller members.
class CCPU
{
    I64 num;
    I64 lock;           // guards this core's task ring
    CTask *seth_task,   // the core's first task, never exits
            *cur_task,
            *dying;       // exited task waiting to be freed
    Bool online;        // (Bool is a U64)
    I64 acct_from;      // counter value since which cur_task has run (CPU time accounting, Yield)
    I64 tickless;       // in IdleWait with the tick off: another core must send an IPI to wake it
};

CCPU cpu_structs[CORES_MAX];
I64 mp_cnt = 1;  // cores online

CCPU *Gs()
{//This core's CCPU.
    return ArchTpidr;
}

U0 CoreInit(I64 num)
{//Common per-core init, runs on the core itself.
    CCPU *c = &cpu_structs[num];
    c->num = num;
    c->acct_from = ArchCntVct;
    ArchTpidrSet(c);
    IntcCpuInit;
}

U0 MPStart(I64 cnt)
{
    I64 i, t;
    CCPU *c;
    for (i = 1; i < cnt && i < fdt_ncpu && i < CORES_MAX; i++) {
        if (!fdt_cpu[i].release && !(fdt_cpu[i].psci && fdt_psci))
            goto mp_next;
        c = &cpu_structs[i];
        if (fdt_cpu[i].psci && fdt_psci) {
            t = ArchPsci(0xC4000003, fdt_cpu[i].mpidr, ArchApEntry(I64), 0, fdt_psci);
            if (t) {"Core %d: PSCI CPU_ON failed (%d)\n", i, t; goto mp_next;}
        } else ArchSpinRelease(fdt_cpu[i].release, ArchApEntry);
        t = ArchCntVct + ArchCntFrq;
        while (!c->online && ArchCntVct < t)
            ArchWfe;
        if (!c->online)
            "Core %d: no response\n", i;
mp_next:
    }
}
