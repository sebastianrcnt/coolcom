extern class CVTerm;
extern U0 VtBind(CTask *t, CVTerm *v);
extern U0 VtTaskGone(CTask *t);
// Tasks and cooperative scheduling, TempleOS style: every core has its own
// ring of tasks and switches only when the running task calls Yield.
// Tasks are TempleOS CTasks (KernelA.coolh): next_task/last_task link this core's
// ring, gs is the core, stk..stack_end the usable stack, and
// context_save_area[0] the stack pointer saved while switched out.
#define TASK_STACK_SIZE (128*1024)

// Tickless idle: a core whose tasks all sleep does not tick. IdleWait (the idle loops and
// Yield's "nothing ready" wait) sets its timer for the nearest wake_jiffy (or console
// frame) and waits for any interrupt. So everything that makes a task ready must wake
// the core it is on: TaskWake and CoreKick send it an IPI. A task waiting for input
// uses an event wait (TaskEventArm/TaskEventSleep, GetKey): any device interrupt or key
// push (TaskEventWake) makes it ready.
//
// CPU time: Yield adds the counter ticks a task ran between two switches to its
// task_ticks (CTask.user_data, which nothing else uses). A core's first task (Adam, Seth)
// is the idle task: it runs when the others sleep. Top reads these.
#define task_ticks user_data

I64 task_num;
CHashTable *adam_hash;  // every task's hash_table (defines, frame pointers)

CTask *Fs()
{//The running task.
    return Gs->cur_task;
}

U0 TaskNew(CTask *t, CCPU *c)
{
    t->addr = t;
    t->task_signature = TASK_SIGNATURE_VAL;
    t->gs = c;
    t->task_num = ArchAdd(&task_num, 1);
    t->hash_table = adam_hash;
    t->rand_seed = t->task_num * 0x9E3779B97F4A7C15;
    QueInit(&t->next_except);
    QueInit(&t->next_cc);
}

U0 TaskInitCur()
{//Turn what this core is running into its first task: Adam on core 0, Seth on the others.
    CCPU *c = Gs;
    CTask *t = CAlloc(sizeof(CTask));
    if (!adam_hash)
        adam_hash = HashTableNew(TASK_HASH_TABLE_SIZE);
    TaskNew(t, c);
    t->next_task = t->last_task = t;
    if (c->num)
        StrPrint(t->task_name, "Seth%d", c->num);
    else {
        StrCpy(t->task_name, "Adam");
        adam_task = t;
    }
    t->stack_guard = ArchBootGuard(c->num);
    t->stk = t->stack_guard + 16384;
    t->stack_end = t->stack_guard + 131072;
    if (!c->num)
        t->stack_end = t->stk + 65536;
    c->seth_task = c->cur_task = t;
}

Bool TaskReady(CTask *t)
{
    if (Bt(&t->task_flags, TASKf_KILL_TASK) || Bt(&t->task_flags, TASKf_SUSPENDED))
        return FALSE;
    return t->wake_jiffy <= jiffies;
}

// All DRAM L3 tables exist before the MMU and secondary cores start.
U0 StackPage(U8 *page, Bool present)
{
    I64 *l2 = ArchL2Table, *l3 = l2[page(I64) >> 25] & ~16383;
    I64 i = (page(I64) >> 14) & 2047;
    l3[i] = 0;
    ArchTlbFlush;
    if (present) {
        l3[i] = page(I64) | 3 | (1 << 2) | (3 << 8) | (1 << 10);
        ArchTlbFlush;
    }
}

Bool TaskStackFault(CTask *t, CExceptFrame *f)
{
    return t && t->stack_guard &&
            (t->stack_guard <= f->far < t->stk ||
             t->stack_guard <= f->sp < t->stk);
}

U0 TaskFree(CTask *t)
{
    t->addr = NULL;
    t->task_signature = 0;
    if (t->stack_guard)
        StackPage(t->stack_guard, TRUE);
    Free(t->stack_alloc);
    Free(t->cur_dir);
    VtTaskGone(t);
    Free(t->key_history);
    Free(t->shell_ctx);
    Free(t);
}

U0 TaskReap(CCPU *c)
{//Free a task that exited; can't be done on its own stack.
    CTask *t = c->dying;
    if (t) {
        c->dying = NULL;
        TaskFree(t);
    }
}

#define TASKf_EVENT_WAIT TASKf_AWAITING_MSG  // in an event wait: TaskEventWake makes it ready
#define JIFFY_NEVER      0x7FFFFFFFFFFFFFFF
#define IDLE_MAX_JIFFIES 1000  // a tickless core looks at its tasks at least once a second

extern I64 FbNextJiffy();  // Fb.cool: when the console renderer next needs the core-0 tick

U0 CoreKick(CCPU *c)
{//Make core c look at its tasks now: it may be in IdleWait with its tick off.
    CCPU *me = Gs;
    if (me && c != me && (!c->num || c->online))
        IntcSendIpi(fdt_cpu[c->num].mpidr);
}

U0 TaskWake(CTask *t)
{//Make a sleeping task ready now, on whichever core it is.
    ArchStoreRel(&t->wake_jiffy, 0);
    CoreKick(t->gs);
}

U0 TaskEventWake()
{//An interrupt or a key: every task in an event wait looks again.
    I64 i, daif;
    CCPU *c;
    CTask *t;
    Bool woke;
    for (i = 0; i < mp_cnt; i++) {
        c = &cpu_structs[i];
        if (c->seth_task) {
            woke = FALSE;
            daif = SpinLockIrq(&c->lock);
            t = c->seth_task;
            do {
                if (LBtr(&t->task_flags, TASKf_EVENT_WAIT)) {
                    t->wake_jiffy = 0;
                    woke = TRUE;
                }
                t = t->next_task;
            } while (t != c->seth_task);
            SpinUnlockIrq(&c->lock, daif);
            if (woke)
                CoreKick(c);
        }
    }
}

U0 TaskEventArm(I64 ms = -1)
{//Begin an event wait of at most ms (-1: no limit). Check what you wait for after this
    //and before TaskEventSleep: an event from now on ends the wait.
    CTask *t = Fs;
    I64 wake = JIFFY_NEVER;
    if (ms >= 0)
        wake = TimerJiffies + 1 + ms * JIFFY_FREQ / 1000;
    ArchStoreRel(&t->wake_jiffy, wake);  // before the flag: an event in between is seen by the check
    LBts(&t->task_flags, TASKf_EVENT_WAIT);
}

U0 TaskEventCancel()
{
    CTask *t = Fs;
    LBtr(&t->task_flags, TASKf_EVENT_WAIT);
    t->wake_jiffy = 0;
}

extern U0 Yield();

U0 TaskEventSleep()
{//Give the core away until an event (TaskEventWake), the time limit or a break.
    Yield;
    TaskEventCancel;
}

U0 IdleWait()
{//Wait for an interrupt. With nothing ready on this core the tick stops until the
    //nearest deadline: the earliest wake_jiffy, the console's next frame, at most
    //IDLE_MAX_JIFFIES; an interrupt or IPI ends the wait sooner.
    CCPU *c = Gs;
    CTask *t, *cur;
    I64 daif = ArchDaif, now, next, w;
    Bool busy = FALSE;
    if (!c || !cnts_per_jiffy) {
        ArchWfi;
        return;
    }
    ArchIrqOff;
    ArchXchg(&c->tickless, 1);
    now = TimerJiffies;
    next = now + IDLE_MAX_JIFFIES;
    cur = c->cur_task;
    SpinLock(&c->lock);
    t = cur;
    do {
        if (!Bt(&t->task_flags, TASKf_SUSPENDED)) {
            w = t->wake_jiffy;
            if (w > now) {
                if (w < next)
                    next = w;
            } else if (t != cur || Bt(&t->task_flags, TASKf_KILL_TASK))
                busy = TRUE;  // ready: keep ticking (the idle task itself does not count)
        }
        t = t->next_task;
    } while (t != cur);
    SpinUnlock(&c->lock);
    if (!c->num && (w = FbNextJiffy) < next)
        next = w;
    if (busy || next <= now + 1) {
        c->tickless = 0;
        ArchWfi;  // until the next tick
        ArchIntRestore(daif);
        return;
    }
    TimerArm(next);
    ArchWfi;
    c->tickless = 0;
    TimerArm(TimerJiffies + 1);
    JiffiesUpdate;
    ArchIntRestore(daif);
}

U8 *task_break_hook;  // U0 (*)(): runs on a task that returns from Yield with TASKf_PENDING_BREAK set (the shell)

U0 TaskBreakCheck(CTask *t)
{
    U0 (*hook)();
    if (LBtr(&t->task_flags, TASKf_PENDING_BREAK)) {
        hook = task_break_hook;
        if (hook)
            (*hook)();
    }
}

U0 Yield()
{//Run the next ready task on this core; returns when we are picked again.
    CCPU *c = Gs;
    CTask *cur = c->cur_task, *t, *dead;
    I64 daif, now;
    TaskReap(c);
    while (TRUE) {
        daif = SpinLockIrq(&c->lock);
        t = cur->next_task;
        while (t != cur && !TaskReady(t)) {
            if (Bt(&t->task_flags, TASKf_KILL_TASK) && t != c->seth_task) {
                // Killed while switched out (Kill): it never runs again.
                dead = t;
                t = t->next_task;
                dead->last_task->next_task = t;
                t->last_task = dead->last_task;
                TaskFree(dead);
            } else
                t = t->next_task;
        }
        if (t != cur || TaskReady(cur))
            break;
        SpinUnlockIrq(&c->lock, daif);
        IdleWait;  // nothing ready: until an interrupt or the nearest deadline
    }
    if (t == cur) {
        SpinUnlockIrq(&c->lock, daif);
        TaskBreakCheck(cur);
        return;
    }
    if (Bt(&cur->task_flags, TASKf_KILL_TASK) && cur != c->seth_task) {
        cur->last_task->next_task = cur->next_task;
        cur->next_task->last_task = cur->last_task;
        c->dying = cur;
    }
    now = ArchCntVct;
    cur->task_ticks += now - c->acct_from;
    c->acct_from = now;
    c->cur_task = t;
    t->swap_cnter++;
    SpinUnlockIrq(&c->lock, daif);
    ArchCtxSwitch(&cur->context_save_area[0], t->context_save_area[0]);
    TaskReap(Gs);
    TaskBreakCheck(cur);
}

U0 Exit()
{//End the running task. Tasks also end by returning from their function.
    CTask *t = Fs;
    if (t == Gs->seth_task) {
        "Exit: %s can't exit\n", t->task_name;
        return;
    }
    LBts(&t->task_flags, TASKf_KILL_TASK);
    Yield;
}

U0 Sleep(I64 mS)
{//Not for power-saving.  It is to make a program pause without hogging the CPU.
    CTask *t = Fs;
    t->wake_jiffy = jiffies + mS * JIFFY_FREQ / 1000;
    while (jiffies < t->wake_jiffy)
        Yield;
    TaskBreakCheck(t);  // a break that cleared wake_jiffy after Yield's check
}

U0 SleepUntil(I64 wake_jiffy)
{
    CTask *t = Fs;
    t->wake_jiffy = wake_jiffy;
    while (jiffies < t->wake_jiffy)
        Yield;
    TaskBreakCheck(t);
}

I64 spawn_next_cpu;

CTask *Spawn(U0 (*fp_start_addr)(U8 *data), U8 *data = NULL, U8 *task_name = NULL, I64 target_cpu = -1,
             CTask *parent = NULL, I64 stk_size = TASK_STACK_SIZE)
{//Start fp_start_addr(data) as a new task on core target_cpu (-1: round robin).
    CTask *t = CAlloc(sizeof(CTask));
    CCtxFrame *f;
    CCPU *c;
    I64 daif;
    if (target_cpu < 0)
        target_cpu = ArchAdd(&spawn_next_cpu, 1) % mp_cnt;
    c = &cpu_structs[target_cpu];
    if (!t)
        return NULL;
    TaskNew(t, c);
    if (!parent)
        parent = Fs;
    t->parent_task = parent;
    VtBind(t, parent->terminal);
    if (parent->cur_dir) {
        t->cur_dv = parent->cur_dv;
        t->cur_dir = StrNew(parent->cur_dir);
    }
    if (stk_size < 16384)
        stk_size = 16384;
    if (stk_size > sys_heap.total - 49152) {
        TaskFree(t);
        return NULL;
    }
    stk_size = (stk_size + 16383) & ~16383;
    t->stack_alloc = MAlloc(stk_size + 32768);
    if (!t->stack_alloc) {
        TaskFree(t);
        return NULL;
    }
    t->stack_guard = (t->stack_alloc(I64) + 16383) & ~16383;
    t->stk = t->stack_guard + 16384;
    t->stack_end = t->stk + stk_size;
    StackPage(t->stack_guard, FALSE);
    f = t->stack_end - sizeof(CCtxFrame);
    MemSet(f, 0, sizeof(CCtxFrame));
    f->x19 = fp_start_addr;
    f->x20 = data;
    f->x30 = ArchTaskStartAddr;
    t->context_save_area[0] = f;
    if (task_name)
        StrCpy(t->task_name, task_name);
    else
        StrPrint(t->task_name, "Task%d", t->task_num);
    daif = SpinLockIrq(&c->lock);
    t->next_task = c->seth_task;  // append at the end of the ring
    t->last_task = c->seth_task->last_task;
    t->last_task->next_task = t;
    c->seth_task->last_task = t;
    SpinUnlockIrq(&c->lock, daif);
    CoreKick(c);
    return t;
}

U0 TaskRep()
{//List every core's tasks.
    I64 i, daif;
    CCPU *c;
    CTask *t;
    for (i = 0; i < mp_cnt; i++) {
        c = &cpu_structs[i];
        daif = SpinLockIrq(&c->lock);
        t = c->seth_task;
        do {
            "  core %d  #%-3d %-12s %08X switches=%d\n", i, t->task_num, t->task_name, t, t->swap_cnter;
            t = t->next_task;
        } while (t != c->seth_task);
        SpinUnlockIrq(&c->lock, daif);
    }
}

Bool IsSilent()
{//Return StdOut turned-off? (Silent(), KMisc.cool; FALSE before there are tasks.)
    CCPU *c = Gs;
    return c && c->cur_task && Bt(&c->cur_task->display_flags, DISPLAYf_SILENT);
}

// ---- From TempleOS KTask.cool (Aiwnios e155e87) ----

Bool TaskValidate(CTask *task)
{//return TRUE if task looks valid.
    if (!IsValidPtr(task))
        return FALSE;
    if (!task || task->addr != task || task->task_signature != TASK_SIGNATURE_VAL)
        return FALSE;
    else
        return TRUE;
}

Bool Kill(CTask *task, Bool wait = TRUE, Bool just_break = FALSE)
{//Terminate other task. (just_break: stop what it is running, the shell's statement.)
    I64 i;
    if (TaskValidate(task)) {
        if (just_break) {
            LBts(&task->task_flags, TASKf_PENDING_BREAK);
            TaskWake(task);
            return TRUE;
        }
        for (i = 0; i < mp_cnt; i++)
            if (task == cpu_structs[i].seth_task)
                return FALSE;
        LBts(&task->task_flags, TASKf_KILL_TASK);
        TaskWake(task);
        if (task == Fs)
            Yield;  // doesn't return
        if (wait)
            while (TaskValidate(task))
                Yield;
        return TRUE;
    }
    return FALSE;
}

Bool Suspend(CTask *task = NULL, Bool state = TRUE)
{//Tell scheduler to skip task.
    Bool was;
    if (!task)
        task = Fs;
    if (TaskValidate(task)) {
        if (state)
            return LBts(&task->task_flags, TASKf_SUSPENDED);
        was = LBtr(&task->task_flags, TASKf_SUSPENDED);
        CoreKick(task->gs);
        return was;
    }
    return FALSE;
}

Bool IsSuspended(CTask *task = NULL)
{
    if (!task)
        task = Fs;
    if (TaskValidate(task))
        return Bt(&task->task_flags, TASKf_SUSPENDED);
    else
        return FALSE;
}
