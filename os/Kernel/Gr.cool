// Immediate-mode drawing into the calling task's BGRA back buffer.
// Coordinates and damage are logical pixels. The compositor owns the chrome.
CGuiWindow *GrWindow() {CGuiWindow *w = Fs->gui_window; if (Gs->num || !w || w->owner != Fs || w->closed || !w->pixel) return NULL; return w;}
// The clip rectangle (GrClip) bounds every operation and its damage.
I64 GrClipX0(CGuiWindow *w) {if (w->clip_x1 < 0) return 0; return MaxI64(0, w->clip_x0);}
I64 GrClipY0(CGuiWindow *w) {if (w->clip_x1 < 0) return 0; return MaxI64(0, w->clip_y0);}
I64 GrClipX1(CGuiWindow *w) {if (w->clip_x1 < 0) return w->w; return MinI64(w->w, w->clip_x1);}
I64 GrClipY1(CGuiWindow *w) {if (w->clip_x1 < 0) return w->h; return MinI64(w->h, w->clip_y1);}
U0 GrDamage(CGuiWindow *w, I64 x, I64 y, I64 width, I64 height)
{
    I64 x0 = MaxI64(x, GrClipX0(w)), y0 = MaxI64(y, GrClipY0(w)), x1 = MinI64(x + width, GrClipX1(w)), y1 = MinI64(y + height, GrClipY1(w));
    x = x0; y = y0; width = x1 - x0; height = y1 - y0;
    if (width <= 0 || height <= 0) return;
    if (!w->pending) {w->dirty_x0 = x; w->dirty_y0 = y; w->dirty_x1 = x + width; w->dirty_y1 = y + height;}
    else {w->dirty_x0 = MinI64(w->dirty_x0, x); w->dirty_y0 = MinI64(w->dirty_y0, y);
        w->dirty_x1 = MaxI64(w->dirty_x1, x + width); w->dirty_y1 = MaxI64(w->dirty_y1, y + height);}
    w->pending = TRUE;
}
U0 GrRect(I64 x, I64 y, I64 width, I64 height, I64 color)
{
    CGuiWindow *w = GrWindow;
    if (!w || x < -32768 || x > 32767 || y < -32768 || y > 32767 || width < 0 || width > 32767 || height < 0 || height > 32767) return;
    I64 x0 = MaxI64(x, GrClipX0(w)), y0 = MaxI64(y, GrClipY0(w)), x1 = MinI64(x + width, GrClipX1(w)), y1 = MinI64(y + height, GrClipY1(w));
    x = x0; y = y0; width = x1 - x0; height = y1 - y0;
    if (width <= 0 || height <= 0) return;
    GuiFill(w->back + (GUI_TITLE + GUI_PAD) * w->scale * w->pw + (1 + GUI_PAD) * w->scale, w->pw, w->h * w->scale, w->scale, x, y, width, height, (color & 0xFFFFFF) | 0xFF000000);
    GrDamage(w, x, y, width, height);
}
U32 *GrPixels(I64 *stride = NULL)
{
    CGuiWindow *w = GrWindow; if (!w) return NULL;
    if (stride) *stride = w->pw * 4;
    return w->back + (GUI_TITLE + GUI_PAD) * w->scale * w->pw + (1 + GUI_PAD) * w->scale;
}
Bool GuiVulkanPresent(I64 device, I64 view, I64 width, I64 height, U32 *mirror = NULL, I64 stride = 0)
{// Publish an app-owned sampled image after its producer fence has completed.
    // Image layout is SHADER_READ_ONLY_OPTIMAL; lifetime ends only after detach.
    // GrPixels is a transparent BGRA overlay. The optional mirror supports CPU.
    CGuiWindow *w = GrWindow; I64 row;
    if (!w || Gs->num || !fb.venus || !view || !device || device != gui.vk_device || width != w->w * w->scale || height != w->h * w->scale || (mirror && (stride < width * 4 || stride > 0x7FFFFFFF))) return FALSE;
    if (mirror && !w->vk_mirror) {w->vk_mirror = CAlloc(width * height * 4); if (!w->vk_mirror) return FALSE;}
    if (mirror) for (row = 0; row < height; row++) MemCpy(w->vk_mirror + row * width, mirror(U8 *) + row * stride, width * 4);
    else {Free(w->vk_mirror); w->vk_mirror = NULL;}
    w->vk_device = device; w->vk_view = view; w->vk_w = width; w->vk_h = height;
    GrDamage(w, 0, 0, w->w, w->h); return GuiPresent;
}
U0 GrPoint(CGuiWindow *w, I64 x, I64 y, I64 color)
{
    if (GrClipX0(w) <= x < GrClipX1(w) && GrClipY0(w) <= y < GrClipY1(w))
        GuiFill(w->back + (GUI_TITLE + GUI_PAD) * w->scale * w->pw + (1 + GUI_PAD) * w->scale, w->pw, w->h * w->scale, w->scale, x, y, 1, 1, (color & 0xFFFFFF) | 0xFF000000);
}
U0 GrLine(I64 x0, I64 y0, I64 x1, I64 y1, I64 color)
{
    CGuiWindow *w = GrWindow; I64 dx, dy, sx = 1, sy = 1, err, twice, minx, miny, width, height;
    if (!w || x0 < -32768 || x0 > 32767 || y0 < -32768 || y0 > 32767 || x1 < -32768 || x1 > 32767 || y1 < -32768 || y1 > 32767) return;
    minx = MinI64(x0, x1); miny = MinI64(y0, y1); width = AbsI64(x1 - x0) + 1; height = AbsI64(y1 - y0) + 1;
    dx = AbsI64(x1 - x0); dy = -AbsI64(y1 - y0); if (x0 > x1) sx = -1; if (y0 > y1) sy = -1; err = dx + dy;
    while (TRUE) {
        GrPoint(w, x0, y0, color); if (x0 == x1 && y0 == y1) break;
        twice = 2 * err; if (twice >= dy) {err += dy; x0 += sx;} if (twice <= dx) {err += dx; y0 += sy;}
    }
    GrDamage(w, minx, miny, width, height);
}
U0 GrTextClip(I64 x, I64 y, U8 *text, I64 color, I64 cx, I64 cy, I64 width, I64 height)
{//UTF-8 Unifont, transparent background, integer physical scale.
    CGuiWindow *w = GrWindow; U8 *glyph; I64 cp, len, cells, row, col, bits, start = x;
    if (!w || !text || x < -32768 || x > 32767 || y < -32768 || y > 32767) return;
    while (*text && x < w->w) {
        len = Utf8Len(*text); if (!len) len = 1;
        for (row = 1; row < len; row++) if (!text[row]) {len = 1; break;}
        cp = Utf8Cp(text, len); text += len; glyph = FontGlyph(cp, &cells);
        if (glyph) for (row = 0; row < 16; row++) {
                bits = glyph[row]; if (cells == 2) bits = glyph[row * 2] << 8 | glyph[row * 2 + 1];
                for (col = 0; col < cells * 8; col++) if ((bits & (1 << (cells * 8 - col - 1))) && cx <= x + col < cx + width && cy <= y + row < cy + height) GrPoint(w, x + col, y + row, color);
            }
        if (!glyph) cells = 1; x += cells * 8;
    }
    GrDamage(w, start, y, x - start, 16);
}
U0 GrText(I64 x, I64 y, U8 *text, I64 color = 0) {CGuiWindow *w = GrWindow; if (w) GrTextClip(x, y, text, color, 0, 0, w->w, w->h);}
U0 GrBlit(I64 x, I64 y, I64 width, I64 height, U32 *source, I64 source_stride)
{//BGRA, source stride in bytes; input is logical-sized, copied at integer scale.
    CGuiWindow *w = GrWindow; I64 i, j;
    if (!w || !source || width < 0 || width > 32767 || height < 0 || height > 32767 || source_stride < width * 4 || source_stride > 0x7FFFFFFF) return;
    for (j = MaxI64(0, -y); j < height && j < w->h - y; j++)
        for (i = MaxI64(0, -x); i < width && i < w->w - x; i++) GrPoint(w, x + i, y + j, *(source(U8 *) + j * source_stride + i * 4)(U32 *));
    GrDamage(w, x, y, width, height);
}
U0 GrDirty(I64 x, I64 y, I64 width, I64 height) {CGuiWindow *w = GrWindow; if (w) GrDamage(w, x, y, width, height);}

U0 GrDither(I64 x, I64 y, I64 width, I64 height)
{
    CGuiWindow *w = GrWindow; I64 i, j;
    if (!w || x < -32768 || x > 32767 || y < -32768 || y > 32767 || width < 0 || width > 32767 || height < 0 || height > 32767) return;
    for (j = MaxI64(0, y); j < MinI64(w->h, y + height); j++)
        for (i = MaxI64(0, x); i < MinI64(w->w, x + width); i++) GrPoint(w, i, j, ((i ^ j) & 1) * GUI_WHITE);
    GrDamage(w, x, y, width, height);
}
I64 GrMeasure(U8 *text)
{
    I64 width = 0, len, cp, i;
    while (*text) {len = Utf8Len(*text); if (!len) len = 1; for (i = 1; i < len; i++) if (!text[i]) {len = 1; break;} cp = Utf8Cp(text, len); width += Utf8Width(cp) * 8; text += len;}
    return width;
}

// ---- OS.Ui support: clip, patterns, inversion, styled text, one-bit images, waiting ----
U0 GrClip(I64 x, I64 y, I64 width, I64 height)
{//Restrict later Gr drawing to a logical client rectangle; a negative width restores the whole client.
    CGuiWindow *w = GrWindow; if (!w) return;
    if (width < 0) {w->clip_x1 = -1; return;}
    w->clip_x0 = ClampI64(x, -32768, 32767); w->clip_y0 = ClampI64(y, -32768, 32767);
    w->clip_x1 = MaxI64(w->clip_x0, ClampI64(x + MaxI64(0, width), -32768, 65535));
    w->clip_y1 = MaxI64(w->clip_y0, ClampI64(y + MaxI64(0, height), -32768, 65535));
}
U0 GrSpan(CGuiWindow *w, I64 x0, I64 x1, I64 y, U32 color)
{//One clipped logical row segment [x0, x1) at the window's integer scale.
    I64 s = w->scale, i, j, end; U32 *row;
    x0 = MaxI64(x0, GrClipX0(w)); x1 = MinI64(x1, GrClipX1(w));
    if (x0 >= x1 || y < GrClipY0(w) || y >= GrClipY1(w)) return;
    end = x1 * s;
    for (j = 0; j < s; j++) {
        row = w->back + ((GUI_TITLE + GUI_PAD + y) * s + j) * w->pw + (1 + GUI_PAD) * s;
        for (i = x0 * s; i < end; i++) row[i] = color;
    }
}
U0 GrPattern(I64 x, I64 y, I64 width, I64 height, U64 pattern, I64 fg, I64 bg = -1)
{//8x8 one-bit pattern aligned to client coordinates: byte (y & 7), bit 7 is x & 7 == 0. bg < 0: transparent.
    CGuiWindow *w = GrWindow; I64 i, j, bits, x0, x1; U32 f, b;
    if (!w || width < 0 || height < 0 || width > 32767 || height > 32767) return;
    f = (fg & 0xFFFFFF) | 0xFF000000; b = (bg & 0xFFFFFF) | 0xFF000000;
    x0 = MaxI64(x, GrClipX0(w)); x1 = MinI64(x + width, GrClipX1(w));
    for (j = MaxI64(y, GrClipY0(w)); j < MinI64(y + height, GrClipY1(w)); j++) {
        bits = (pattern >> ((j & 7) * 8)) & 0xFF;
        if (bits == 0xFF) GrSpan(w, x0, x1, j, f);
        else if (!bits) {if (bg >= 0) GrSpan(w, x0, x1, j, b);}
        else for (i = x0; i < x1; i++) {
                if (bits & (0x80 >> (i & 7))) GrSpan(w, i, i + 1, j, f);
                else if (bg >= 0) GrSpan(w, i, i + 1, j, b);
            }
    }
    GrDamage(w, x, y, width, height);
}
U0 GrInvert(I64 x, I64 y, I64 width, I64 height)
{//Exchange black and white (XOR the colour bits) inside the clip.
    CGuiWindow *w = GrWindow; I64 i, j, s, x0, y0, x1, y1; U32 *row;
    if (!w || width <= 0 || height <= 0) return;
    s = w->scale;
    x0 = MaxI64(x, GrClipX0(w)); y0 = MaxI64(y, GrClipY0(w)); x1 = MinI64(x + width, GrClipX1(w)); y1 = MinI64(y + height, GrClipY1(w));
    for (j = y0 * s; j < y1 * s; j++) {
        row = w->back + ((GUI_TITLE + GUI_PAD) * s + j) * w->pw + (1 + GUI_PAD) * s;
        for (i = x0 * s; i < x1 * s; i++) row[i] ^= 0xFFFFFF;
    }
    GrDamage(w, x, y, width, height);
}
#define GR_BOLD 1
#define GR_DIM 2
#define GR_UNDERLINE 4
I64 GrTextStyle(I64 x, I64 y, U8 *text, I64 size, I64 color, I64 flags)
{//size bytes of UTF-8 in Unifont; bitmap bold, 50% gray mask (disabled), underline. Returns the advance.
    CGuiWindow *w = GrWindow; U8 *glyph, *end = text + size; I64 cp, len, cells, row, col, bits, start = x, run, px, width;
    U32 c = (color & 0xFFFFFF) | 0xFF000000;
    if (!w || !text || size < 0 || x < -32768 || x > 32767 || y < -32768 || y > 32767) return 0;
    while (text < end && x < GrClipX1(w)) {
        len = Utf8Len(*text); if (!len || text + len > end) len = 1;
        cp = Utf8Cp(text, len); if (len == 1 && *text >= 0x80) cp = 0xFFFD;
        text += len; glyph = FontGlyph(cp, &cells);
        // Advance like GrMeasure (and OS.Ui's measurement): terminal width of the code point.
        width = cells * 8; if (!Utf8Width(cp)) glyph = NULL;
        if (glyph && x + width + 1 > GrClipX0(w) && y + 16 > GrClipY0(w) && y < GrClipY1(w))
            for (row = 0; row < 16; row++) {
                bits = glyph[row]; if (cells == 2) bits = glyph[row * 2] << 8 | glyph[row * 2 + 1];
                bits <<= 1; // bit 0 is one column past the glyph cell, for bold
                if (flags & GR_BOLD) bits |= bits >> 1;
                for (col = 0; col <= width; col += run) {
                    run = 1;
                    if (bits & (1 << (width - col))) {
                        while (col + run <= width && (bits & (1 << (width - col - run)))) run++;
                        if (flags & GR_DIM) {for (px = x + col; px < x + col + run; px++) if (!((px + y + row) & 1)) GrSpan(w, px, px + 1, y + row, c);}
                        else GrSpan(w, x + col, x + col + run, y + row, c);
                    }
                }
            }
        x += Utf8Width(cp) * 8;
    }
    if (flags & GR_UNDERLINE) GrSpan(w, start, x, y + 15, c);
    GrDamage(w, start, y, x - start + 1, 16);
    return x - start;
}
U0 GrBits(I64 x, I64 y, I64 width, I64 height, U8 *bits, I64 stride, I64 color)
{//One-bit bitmap, most significant bit first, stride in bytes; 1 bits are drawn in color.
    CGuiWindow *w = GrWindow; I64 i, j; U32 c = (color & 0xFFFFFF) | 0xFF000000;
    if (!w || !bits || width < 0 || height < 0 || width > 4096 || height > 4096 || stride < (width + 7) / 8) return;
    for (j = 0; j < height; j++) for (i = 0; i < width; i++)
            if (bits[j * stride + i / 8] & (0x80 >> (i & 7))) GrSpan(w, x + i, x + i + 1, y + j, c);
    GrDamage(w, x, y, width, height);
}
I64 GuiPending()
{//Events queued for the calling task's window.
    CGuiWindow *w = Fs->gui_window;
    if (!w || Gs->num) return 0;
    return (w->event_tail - w->event_head + GUI_EVENTS) % GUI_EVENTS + w->event_lost;
}
U0 GuiWait(I64 ms)
{//Block until an event is queued for this task's window or ms elapse (GuiEventPush wakes it).
    CTask *t = Fs; CGuiWindow *w = t->gui_window;
    if (!w || Gs->num || ms <= 0 || GuiPending) return;
    // A frame presented while input was still queued did not wake the compositor.
    if (w->revision != w->presented && gui.task) {gui.present_wake = TRUE; TaskWake(gui.task);}
    t->wake_jiffy = jiffies + ms * JIFFY_FREQ / 1000;
    while (jiffies < t->wake_jiffy && !GuiPending) Yield;
    TaskBreakCheck(t);
}
