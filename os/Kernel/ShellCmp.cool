// Ahead-of-time compiling and loading from the shell (TempleOS Cmp, ExeFile,
// Load). Cmp and ExeFile call the running shell's compiler module (Shell.cool);
// Load loads a BIN with BinLoad and adds its exports to the shell as system
// symbols, so an `extern` declaration in the shell binds to them. The prelude
// declares these three like every kernel function, so they need a shell task.

U8 *ShellCmpFun(U8 *name)
{//Export name of this shell's compiler, NULL (with a message) off a shell.
    U8 *f = NULL;
    if (ShellCur && ShellCur->cmp)
        f = BinSymFind(ShellCur->cmp, name);
    if (!f)
        PrintErr("%s needs a shell's compiler\n", name);
    return f;
}

I64 Cmp(U8 *src, U8 *bin = NULL)
{//AOT-compile src (.cool by default) to the BIN file bin (default src with
    //.BIN). #include names are relative to src's directory, as with coolc on the
    //host. Returns the error count. TempleOS's is Cmp(filename, map, out_name).
    I64 (*cmp)(U8 *filename, U8 *map_name, U8 *out_name, I64 drv_let);
    U8 *s, *b, *dir, *old;
    I64 res;
    if (!(cmp = ShellCmpFun("Cmp")))
        return 1;
    if (!DrvCur) {
        PrintErr("Cmp: no drive\n");
        return 1;
    }
    dir = RtCoolExt(src);
    s = FileNameAbs(dir);
    Free(dir);
    if (bin) {
        dir = RtExtDft(bin, "BIN");
        b = FileNameAbs(dir);
        Free(dir);
    } else
        b = RtExtChg(s, "BIN");
    old = DirCur;
    dir = StrNew(s);
    StrLastRem(dir, "/");
    Cd(dir);
    res = (*cmp)(s, NULL, b, 0);
    Cd(old);
    Free(old);
    Free(dir);
    Free(s);
    Free(b);
    return res;
}

I64 ExeFile(U8 *name)
{//JIT-compile and run the file name (.cool by default) in this shell; returns the
    //value of its last statement. Its statements nest inside the caller's.
    I64 (*exe)(U8 *name, I64 ccf_flags);
    I64 res, ctx[32], daif;
    U8 *file, *cleanup;
    Bool in_stmt;
    if (!(exe = ShellCmpFun("ExeFile")))
        return 0;
    // ShellExeCmdLine keeps one statement context per shell: keep the caller's.
    MemCpy(ctx, ShellCur->fault_ctx, sizeof(ctx));
    daif = ShellCur->fault_daif;
    in_stmt = ShellCur->in_stmt;
    cleanup = ShellCur->stmt_cleanup;
    ShellCur->stmt_cleanup = NULL;
    file = RtCoolExt(name);
    res = (*exe)(file, 0);
    Free(file);
    MemCpy(ShellCur->fault_ctx, ctx, sizeof(ctx));
    ShellCur->fault_daif = daif;
    ShellCur->in_stmt = in_stmt;
    ShellCur->stmt_cleanup = cleanup;
    return res;
}

I64 LoadFind(U8 *name)
{//Imports of a Loaded BIN: kernel symbols, earlier Loads, shell functions.
    CHash *h;
    I64 *val;
    if (h = HashFind(name, ShellCur->hash, HTT_EXPORT_SYS_SYM)) {
        val = h(U8 *) + HASH_EXPORT_VAL;
        return *val;
    }
    if ((h = HashFind(name, ShellCur->hash, HTT_FUN)) && h(CHashFun *)->exe_addr)
        return h(CHashFun *)->exe_addr;
    return KSymFind(name);
}

CBinMod *Load(U8 *filename)
{//Load a BIN (.BIN by default) made by Cmp and run its top-level code. Its
    //exports become system symbols of this shell: declare one with extern
    //to call it. Returns NULL on error.
    CBinMod *m;
    U8 *name, *bin;
    I64 i, size;
    if (!ShellCur || !ShellCur->hash) {
        PrintErr("Load needs a shell\n");
        return NULL;
    }
    name = RtExtDft(filename, "BIN");
    bin = FileRead(name, &size);
    if (!bin) {
        PrintErr("Load: cannot read %s\n", name);
        Free(name);
        return NULL;
    }
    m = BinLoad(bin, size, NULL, 0, &LoadFind);
    Free(bin);
    Free(name);
    if (m)
        for (i = 0; i < m->nsyms; i++)
            ShellSym(m->syms[i].name, m->syms[i].val);
    return m;
}
