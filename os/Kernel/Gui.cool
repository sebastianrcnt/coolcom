// Task-owned surfaces and desktop. Structural operations run on core 0;
// terminal producers on other cores use terminal locks. Pixel frames stay on core 0.
#define GUI_WINDOWS 16
#define GUI_TITLE 22
#define GUI_MENU 22
#define GUI_PAD 3
#define GUI_FOOTER 12
#define GUI_WHITE 0xFFFFFF
#define GUI_EVENT_MOUSE 1
#define GUI_EVENT_KEY 2
#define GUI_EVENT_RESIZE 3
#define GUI_EVENT_CLOSE 4
#define GUI_EVENT_MENU 5
#define GUI_INPUT 1024
#define GUI_MENUS 8
#define GUI_MENU_ITEMS 24
class CGuiMenuItem {I64 id, flags; U8 label[64], keys[24];};
class CGuiMenu {U8 title[32]; I64 count; CGuiMenuItem items[GUI_MENU_ITEMS];};
#define GUI_EVENTS GUI_INPUT // one complete compositor input backlog fits a window
class CGuiEvent {I64 type, key, x, y, buttons, wheel, timestamp, vct;};
#define GUI_LATENCY 512
class CGuiWindow
{
    CTask *owner;
    CVTerm *term;
    // pixels is the committed front; only Gr* writes the pixel-app back buffer.
    U32 *pixels, *back, *vk_mirror;
    Bool pending; I64 dirty_x0, dirty_y0, dirty_x1, dirty_y1;
    I64 vk_device, vk_view, vk_w, vk_h;
    I64 x, y, w, h, pw, ph, scale, serial, revision, presented, lock;
    I64 cursor_x, cursor_y, cursor_w;
    Bool closed, dirty, zoomed, pixel;
    CGuiEvent events[GUI_EVENTS];
    I64 event_head, event_tail; Bool event_lost;
    CGuiEvent last_event;
    CGuiMenu menus[GUI_MENUS]; I64 menu_count, id, close_deadline; Bool closing;
    I64 restore_x, restore_y, restore_w, restore_h;
    U8 title[64];
    // Gr clip rectangle in logical client pixels (clip_x1 < 0: whole client).
    I64 clip_x0, clip_y0, clip_x1, clip_y1;
    // Input-to-composition latency: counter stamps of the oldest event dequeued
    // since the last present, and of the presented revision awaiting composition.
    I64 input_vct, present_vct;
    I64 pointer_shape; // 0 arrow, 1 I-beam: the pointer over this pixel window's client
    CGuiMenu popup; I64 popup_x, popup_y; // pop-up list opened by the app (GuiPopupShow)
    // Terminal windows: a mouse selection of cells (anchor and end, columns and rows).
    I64 sel_x0, sel_y0, sel_x1, sel_y1; Bool selecting, selected;
};
class CGui
{
    CGuiWindow *windows[GUI_WINDOWS], *focus, *drag, *capture;
    I64 count, scale, w, h, mx, my, buttons, dx, dy, action;
    Bool resizing, damage, input_wake;
    Bool present_wake; // a present arrived while the compositor was running: compose again before sleeping
    I64 x0, y0, x1, y1, clock_minute;
    U32 *desktop, *canvas, *overlay, pointer[12 * 18], ibeam[9 * 16], cursor[32 * 32];
    I64 shape; // pointer shape last applied for a window (0: the arrow or a custom shape)
    I64 cursor_w, cursor_h, hot_x, hot_y; Bool cursor_visible;
    CTask *task;
    U8 *frame_hook, *stop_hook;
    I64 compose_ticks, frames, raster_rows, desktop_revision, overlay_revision, wheel, vk_device;
    Bool menu_open; I64 menu_index, menu_hover; CGuiWindow *menu_window;
    CGuiEvent input[GUI_INPUT];
    I64 input_head, input_tail, input_lock; Bool input_lost;
    I64 input_vct, latency[GUI_LATENCY], latency_count, presented_at[GUI_LATENCY], present_count;
    I64 last_present_vct, wake_gap, wake_gaps;
    Bool shot_pending; I64 shots, trace; // trace: OS.Ui prints frame and layout traces (tests)
};
CGui gui;
I64 gui_window_id;
extern U0 GuiEventPush(CGuiWindow *w, CGuiEvent *e);
extern U0 GuiDesktop();
extern U0 GuiMenuDismiss();
extern Bool GuiMenuMouse(I64 x, I64 y, I64 buttons);
extern U0 GuiMenuSelect(I64 item);
extern U0 GuiMenuPaint();
extern I64 GuiMenuCount();
extern CTask *GuiDraw();
extern CTask *GuiCubeUnavailable();
extern I64 GuiLatency(Bool reset = FALSE);
extern U0 GuiTermPaste(CGuiWindow *w);
extern I64 GuiTextWidth(U8 *text);
extern U0 GuiMenuStep(I64 delta);
U8 *gui_start_hook; // resident Venus renderer, installed by Terminal.cool

U0 GuiDamage(I64 x, I64 y, I64 w, I64 h)
{
    if (!gui.damage) {gui.x0 = x; gui.y0 = y; gui.x1 = x + w; gui.y1 = y + h;}
    else {if (x < gui.x0) gui.x0 = x; if (y < gui.y0) gui.y0 = y;
        if (x + w > gui.x1) gui.x1 = x + w; if (y + h > gui.y1) gui.y1 = y + h;}
    gui.damage = TRUE;
}
U0 GuiWinDamage(CGuiWindow *w) {GuiDamage(w->x, w->y, w->w + 2 * GUI_PAD + 3, w->h + 2 * GUI_PAD + GUI_TITLE + GUI_FOOTER + 3);}
U0 GuiFill(U32 *p, I64 pw, I64 ph, I64 scale, I64 x, I64 y, I64 w, I64 h, I64 color)
{//Logical rectangles, clipped before any pointer arithmetic.
    I64 i, j;
    x *= scale; y *= scale; w *= scale; h *= scale;
    if (x < 0) {w += x; x = 0;} if (y < 0) {h += y; y = 0;}
    if (w > pw - x) w = pw - x; if (h > ph - y) h = ph - y;
    if (w <= 0 || h <= 0) return;
    for (j = y; j < y + h; j++) for (i = x; i < x + w; i++) p[j * pw + i] = color;
}
U0 GuiBox(U32 *p, I64 pw, I64 ph, I64 scale, I64 x, I64 y, I64 w, I64 h)
{
    GuiFill(p, pw, ph, scale, x, y, w, 1, 0); GuiFill(p, pw, ph, scale, x, y + h - 1, w, 1, 0);
    GuiFill(p, pw, ph, scale, x, y, 1, h, 0); GuiFill(p, pw, ph, scale, x + w - 1, y, 1, h, 0);
}
U0 GuiText(U32 *p, I64 pw, I64 ph, I64 scale, I64 x, I64 y, U8 *text)
{//Open-license Unifont for chrome; independent of the terminal's TrueType choice.
    U8 *glyph; I64 row, col, bits, cells, len, cp, i;
    while (*text && x + 8 <= pw / scale) {
        // UTF-8 (menu shortcuts use the Mac's modifier symbols); wide glyphs take 16 pixels.
        len = Utf8Len(*text); if (!len) len = 1; for (i = 1; i < len; i++) if (!text[i]) {len = 1; break;}
        cp = Utf8Cp(text, len); text += len;
        glyph = FontGlyph(cp, &cells);
        if (glyph) for (row = 0; row < 16; row++) {
                bits = glyph[row]; if (cells == 2) bits = glyph[row * 2] << 8 | glyph[row * 2 + 1];
                bits |= bits >> 1; // bitmap bold, no proprietary font
                for (col = 0; col < cells * 8; col++) if (bits & (1 << (cells * 8 - 1 - col))) GuiFill(p, pw, ph, scale, x + col, y + row, 1, 1, 0);
            }
        x += Utf8Width(cp) * 8;
    }
}
U0 GuiDecorate(CGuiWindow *w)
{
    I64 i, s = w->scale, pw = w->pw, ph = w->ph;
    I64 bw = w->w + 2 * GUI_PAD, bh = w->h + 2 * GUI_PAD + GUI_FOOTER;
    // White client insets separate the black frame from ANSI-black terminal cells.
    GuiFill(w->pixels, pw, ph, s, 1, GUI_TITLE, bw, GUI_PAD, GUI_WHITE);
    GuiFill(w->pixels, pw, ph, s, 1, GUI_TITLE + GUI_PAD, GUI_PAD, w->h, GUI_WHITE);
    GuiFill(w->pixels, pw, ph, s, 1 + GUI_PAD + w->w, GUI_TITLE + GUI_PAD, GUI_PAD, w->h, GUI_WHITE);
    GuiFill(w->pixels, pw, ph, s, 1, GUI_TITLE + GUI_PAD + w->h, bw, GUI_PAD + GUI_FOOTER + 1, GUI_WHITE);
    GuiFill(w->pixels, pw, ph, s, 0, 0, bw + 2, GUI_TITLE, GUI_WHITE);
    if (gui.focus == w) for (i = 4; i < GUI_TITLE - 3; i += 3) GuiFill(w->pixels, pw, ph, s, 4, i, bw - 6, 1, 0);
    i = StrLen(w->title) * 8;
    GuiFill(w->pixels, pw, ph, s, (bw - i) / 2 - 3, 1, i + 6, GUI_TITLE - 2, GUI_WHITE);
    GuiText(w->pixels, pw, ph, s, (bw - i) / 2, 3, w->title);
    if (gui.focus == w) {
        GuiFill(w->pixels, pw, ph, s, 7, 6, 10, 10, GUI_WHITE); GuiBox(w->pixels, pw, ph, s, 7, 6, 10, 10);
        GuiFill(w->pixels, pw, ph, s, bw - 16, 6, 10, 10, GUI_WHITE); GuiBox(w->pixels, pw, ph, s, bw - 16, 6, 10, 10);
        GuiBox(w->pixels, pw, ph, s, bw - 10, bh + GUI_TITLE - 10, 11, 11);
        for (i = 0; i < 7; i += 2) GuiFill(w->pixels, pw, ph, s, bw - 7 + i, bh + GUI_TITLE - 7, 1, 7, 0);
    }
    GuiFill(w->pixels, pw, ph, s, 0, GUI_TITLE - 1, bw + 2, 1, 0);
    GuiBox(w->pixels, pw, ph, s, 0, 0, bw + 2, bh + GUI_TITLE + 2);
    GuiFill(w->pixels, pw, ph, s, bw + 2, 1, 1, bh + GUI_TITLE + 2, 0);
    GuiFill(w->pixels, pw, ph, s, 1, bh + GUI_TITLE + 2, bw + 2, 1, 0);
    w->revision++; GuiWinDamage(w);
}
U0 GuiFocus(CGuiWindow *w)
{
    I64 i, j; CGuiWindow *old = gui.focus;
    if (old == w) return;
    if (gui.menu_open) GuiMenuDismiss;
    gui.focus = w;
    if (old) GuiDecorate(old);
    if (w) {
        for (i = 0; i < gui.count; i++) if (gui.windows[i] == w) {
                for (j = i; j < gui.count - 1; j++) gui.windows[j] = gui.windows[j + 1];
                gui.windows[gui.count - 1] = w; break;
            }
        GuiDecorate(w);
    }
    GuiDesktop;
}
U0 GuiVulkanDetach(CGuiWindow *w)
{// The compositor finishes every sampling submission before yielding on core 0.
    if (!w) return;
    w->vk_view = w->vk_device = w->vk_w = w->vk_h = 0;
    Free(w->vk_mirror); w->vk_mirror = NULL;
    w->revision++; GuiWinDamage(w);
}
Bool GuiResize(CGuiWindow *w, I64 width, I64 height)
{
    U32 *pixels, *back = NULL; I64 cols, rows, bytes;
    if (!w || width < 160 || height < 64 || width > 4096 || height > 4096) return FALSE;
    cols = width * gui.scale / font.cw; rows = height * gui.scale / font.ch;
    if (!w->pixel) {width = cols * font.cw / gui.scale; height = rows * font.ch / gui.scale;}
    bytes = (width + 2 * GUI_PAD + 3) * (height + 2 * GUI_PAD + GUI_TITLE + GUI_FOOTER + 3) * gui.scale * gui.scale * 4;
    // CPU backing needs virtual contiguity only; MAlloc uses the large region.
    pixels = MAlloc(bytes); if (!pixels) return FALSE;
    if (w->pixel) {back = MAlloc(bytes); if (!back) {Free(pixels); return FALSE;}}
    MemSet(pixels, 0xFF, bytes); if (back) MemSet(back, 0xFF, bytes);
    GuiWinDamage(w); GuiVulkanDetach(w); Free(w->pixels); Free(w->back);
    w->pixels = pixels; w->back = back; w->pending = FALSE;
    w->w = width; w->h = height; w->scale = gui.scale;
    w->pw = (width + 2 * GUI_PAD + 3) * gui.scale; w->ph = (height + 2 * GUI_PAD + GUI_TITLE + GUI_FOOTER + 3) * gui.scale;
    w->serial = font.serial; w->cursor_w = 0; w->clip_x1 = -1;
    if (w->term) VtResize(w->term, cols, rows);
    GuiDecorate(w); w->dirty = TRUE;
    if (w->pixel && w->owner && w->owner->gui_window == w) {
        CGuiEvent e; MemSet(&e, 0, sizeof(e)); e.type = GUI_EVENT_RESIZE; GuiEventPush(w, &e);
    }
    return TRUE;
}
// Pixel producers and the compositor run cooperatively on core 0. This copy
// never yields: neither CPU composition nor Venus upload can see a partial frame.
Bool GuiPresent(Bool explicit = FALSE)
{//explicit: the app finished handling its dequeued input (OS.Gui.present).
    CGuiWindow *w = Fs->gui_window; I64 x, y, width, s;
    if (!gui_active || Gs->num || !w || w->owner != Fs || w->closed || !w->pixel) return FALSE;
    if (!w->pending) {if (explicit) w->input_vct = 0; return TRUE;}
    if (!w->present_vct) w->present_vct = w->input_vct;
    if (w->input_vct) gui.presented_at[gui.present_count++ % GUI_LATENCY] = ArchCntVct - w->input_vct;
    if (!gui.last_present_vct) gui.last_present_vct = ArchCntVct;
    w->input_vct = 0;
    s = w->scale; x = (1 + GUI_PAD + w->dirty_x0) * s;
    width = (w->dirty_x1 - w->dirty_x0) * s;
    for (y = (GUI_TITLE + GUI_PAD + w->dirty_y0) * s; y < (GUI_TITLE + GUI_PAD + w->dirty_y1) * s; y++)
        MemCpy(w->pixels + y * w->pw + x, w->back + y * w->pw + x, width * 4);
    w->revision++;
    GuiDamage(w->x + 1 + GUI_PAD + w->dirty_x0, w->y + GUI_TITLE + GUI_PAD + w->dirty_y0,
              w->dirty_x1 - w->dirty_x0, w->dirty_y1 - w->dirty_y0);
    w->pending = FALSE;
    // Compose promptly once the app has drained its input; during a burst the
    // compositor's own cadence batches the frames.
    if (gui.task && w->event_head == w->event_tail) {gui.present_wake = TRUE; TaskWake(gui.task);}
    return TRUE;
}
U0 GuiMove(CGuiWindow *w, I64 x, I64 y)
{
    if (!w) return;
    if (x < 0) x = 0; if (x > gui.w - 40) x = gui.w - 40;
    if (y < GUI_MENU) y = GUI_MENU; if (y > gui.h - GUI_TITLE) y = gui.h - GUI_TITLE;
    GuiWinDamage(w); w->x = x; w->y = y; GuiWinDamage(w);
}
U0 GuiZoom(CGuiWindow *w)
{
    if (!w) return;
    if (w->zoomed) {GuiMove(w, w->restore_x, w->restore_y); GuiResize(w, w->restore_w, w->restore_h);}
    else {
        w->restore_x = w->x; w->restore_y = w->y; w->restore_w = w->w; w->restore_h = w->h;
        GuiMove(w, 0, GUI_MENU); GuiResize(w, gui.w - 2 * GUI_PAD - 3, gui.h - GUI_MENU - GUI_TITLE - 2 * GUI_PAD - GUI_FOOTER - 3);
    }
    w->zoomed = !w->zoomed;
}
U0 GuiStopWindow(CGuiWindow *w)
{
    if (!w || w->closed) return;
    w->closed = TRUE;
    if (w->term) VtStop(w->term);
}
U0 GuiClose(CGuiWindow *w)
{
    if (!w || w->closed || w->closing) return;
    if (!w->pixel) {GuiStopWindow(w); return;}
    CGuiEvent e; MemSet(&e, 0, sizeof(e)); e.type = GUI_EVENT_CLOSE;
    w->closing = TRUE; w->close_deadline = TimerJiffies + 1000; GuiEventPush(w, &e);
}
U0 GuiTaskGone(CTask *t)
{
    CGuiWindow *w = t->gui_window;
    if (w) {GuiVulkanDetach(w); w->owner = NULL; w->closed = TRUE; t->gui_window = NULL;}
}
U0 GuiShellSink(CVTerm *v, U8 c) {no_warn v; UartPut(c);}
CGuiWindow *GuiNew(U8 *title, I64 width = 480, I64 height = 256, Bool pixel = FALSE)
{
    CGuiWindow *w; I64 i;
    if (!gui_active || Gs->num || gui.count >= GUI_WINDOWS || Fs->gui_window) return NULL;
    w = CAlloc(sizeof(CGuiWindow)); if (!w) return NULL;
    for (i = 0; i < 63 && title[i]; i++) w->title[i] = title[i]; w->owner = Fs; w->pixel = pixel; w->id = ++gui_window_id;
    w->term = VtNew(1, 1); w->term->owner = Fs; w->term->sink = &GuiShellSink;
    if (!GuiResize(w, width, height)) {VtRelease(w->term); Free(w); return NULL;}
    w->x = 20 + gui.count * 24; w->y = GUI_MENU + 12 + gui.count * 24;
    VtBind(Fs, w->term); Fs->gui_window = w;
    gui.windows[gui.count++] = w; GuiFocus(w);
    return w;
}
U0 GuiLog(U8 *text) {while (*text) UartPut(*text++);}
U0 GuiShellTask(U8 *data)
{
    no_warn data;
    if (GuiNew("Shell")) {GuiLog("GUI SHELL OPEN\n"); GuiLog("GUI WINDOWS READY\n"); ShellTask(-1);}
}
CTask *GuiShell() {return Spawn(&GuiShellTask, NULL, "GUI Shell", 0, adam_task, SHELL_STACK);}
class CGuiProgram {U8 *program, *entry;};
U0 GuiProgramTask(CGuiProgram *app)
{// Each JIT compiler and its application live until the task exits.
    CVTerm *v = VtNew(80, 24); U8 *modules, *paths, *command;
    VtBind(Fs, v); v->owner = Fs; v->sink = &GuiShellSink; VtRelease(v);
    ShellTask(0);
    // The installer writes each example's library imports to C:/<EntryModule>Modules.txt;
    // other programs (and older disks) compile the whole OS library list.
    U8 *name = StrNew(app->entry), *colon = StrFirstOcc(name, ":"), *list;
    modules = NULL;
    if (colon) *colon = 0;
    list = MStrPrint("C:/%sModules.txt", name);
    if (FileFind(list)) modules = FileRead(list);
    Free(list); Free(name);
    if (!modules) modules = FileRead("C:/GuiModules.txt");
    if (modules) {
        paths = MStrPrint("%s,%s", modules, app->program);
        command = MStrPrint("WarmRun(\"%s\", \"%s\");", paths, app->entry);
        ShellExe(command); Free(command); Free(paths); Free(modules);
    } else GuiLog("GUI APP: missing GuiModules.txt\n");
    Free(app->program); Free(app->entry); Free(app);
}
CTask *GuiRun(U8 *program, U8 *entry)
{
    CGuiProgram *app; CTask *task;
    if (!gui_active || Gs->num || !program || !entry) return NULL;
    app = CAlloc(sizeof(CGuiProgram)); app->program = StrNew(program); app->entry = StrNew(entry);
    task = Spawn(&GuiProgramTask, app, "GUI App", 0, adam_task, SHELL_STACK);
    if (!task) {Free(app->program); Free(app->entry); Free(app);} return task;
}
CTask *GuiWidgets() {return GuiRun("C:/Warm/Examples/gui/Widgets.warm", "Widgets:main");}
CTask *GuiApp(U8 *name, U8 *entry)
{
    U8 *paths = MStrPrint("C:/Warm/Examples/gui/Support.warmh,C:/Warm/Examples/gui/Support.warm,C:/Warm/Examples/gui/%s.warm", name);
    CTask *task = GuiRun(paths, entry); Free(paths); return task;
}
CTask *GuiFiles() {return GuiApp("Files", "GuiFiles:main");}
CTask *GuiTop() {return GuiApp("Top", "GuiTop:main");}
CTask *GuiSettings() {return GuiApp("Settings", "GuiSettings:main");}
CTask *GuiGallery() {return GuiRun("C:/Warm/Examples/gui/Gallery.warm", "Gallery:main");}
U0 GuiCubeTask(U8 *data)
{
    no_warn data;
    if (!fb.venus) {GuiLog("Cube needs the Venus terminal.\n"); GuiCubeUnavailable; return;}
    CVTerm *v = VtNew(80, 24);
    VtBind(Fs, v); v->owner = Fs; v->sink = &GuiShellSink; VtRelease(v); ShellTask(0);
    ShellExe("#include \"C:/Cube.cool\"\nCubeWindow;");
}
CTask *GuiCube() {if (!gui_active) return NULL; return Spawn(&GuiCubeTask, NULL, "GUI Cube", 0, adam_task, SHELL_STACK);}
Bool GuiDispatchKey(I64 ev, I64 timestamp)
{//Called by the compositor in input order, after preceding mouse focus changes.
    Bool shortcut = TRUE;
    if (!gui_active) return FALSE;
    if ((ev & (KF_CTRL | KF_ALT)) == (KF_CTRL | KF_ALT)) {
        if ((ev & KEY_CODE) == 'n') gui.action = 1;
        else if ((ev & KEY_CODE) == 'q') gui.action = 2;
        else if ((ev & KEY_CODE) == KEY_LEFT) gui.action = 3;
        else if ((ev & KEY_CODE) == KEY_RIGHT) gui.action = 4;
        else if ((ev & KEY_CODE) == KEY_UP) gui.action = 5;
        else if ((ev & KEY_CODE) == KEY_TAB) {if (gui.count) GuiFocus(gui.windows[0]);}
        else if ((ev & KEY_CODE) == 'p') gui.shot_pending = TRUE;
        else if ((ev & KEY_CODE) == 'l') GuiLatency(TRUE);
        else if ((ev & KEY_CODE) == 'v' && gui.focus && !gui.focus->pixel) GuiTermPaste(gui.focus); // selecting copies
        else shortcut = FALSE;
        if (shortcut) return TRUE;
    }
    // An open menu takes the remaining keys (the global keys above still work, e.g. screenshots).
    if (gui.menu_open) {
        if (ev == KEY_ESC) GuiMenuDismiss;
        else if (ev == KEY_UP || ev == KEY_DOWN) {
            I64 delta = 1; if (ev == KEY_UP) delta = -1;
            GuiMenuStep(delta);
        } else if (ev == KEY_ENTER) GuiMenuSelect(gui.menu_hover);
        return TRUE;
    }
    if (gui.focus && !gui.focus->closed) {
        if (gui.focus->pixel) {
            CGuiEvent e; MemSet(&e, 0, sizeof(e)); e.type = GUI_EVENT_KEY; e.key = ev; e.timestamp = timestamp;
            GuiEventPush(gui.focus, &e);
        } else VtKeyPush(gui.focus->term, ev);
    }
    return TRUE;
}
U0 GuiEventPush(CGuiWindow *w, CGuiEvent *e)
{
    I64 next = (w->event_tail + 1) % GUI_EVENTS;
    if (!e->vct) e->vct = gui.input_vct;
    if (next == w->event_head) w->event_lost = TRUE;
    else {MemCpy(&w->events[w->event_tail], e, sizeof(CGuiEvent)); w->event_tail = next;}
    if (w->owner) {TaskWake(w->owner); if (w->pixel) gui.input_wake = TRUE;}
}
U0 GuiInputPush(CGuiEvent *e)
{
    e->timestamp = TimerJiffies; e->vct = ArchCntVct;
    I64 daif = SpinLockIrq(&gui.input_lock), next = (gui.input_tail + 1) % GUI_INPUT;
    if (next == gui.input_head) gui.input_lost = TRUE;
    else {MemCpy(&gui.input[gui.input_tail], e, sizeof(CGuiEvent)); gui.input_tail = next;}
    SpinUnlockIrq(&gui.input_lock, daif);
    if (gui.task) TaskWake(gui.task);
}
Bool GuiInputPop(CGuiEvent *e)
{
    I64 daif = SpinLockIrq(&gui.input_lock); Bool found = gui.input_head != gui.input_tail;
    if (found) {MemCpy(e, &gui.input[gui.input_head], sizeof(CGuiEvent)); gui.input_head = (gui.input_head + 1) % GUI_INPUT;}
    SpinUnlockIrq(&gui.input_lock, daif); return found;
}
Bool GuiKey(I64 ev)
{
    CGuiEvent e; if (!gui_active) return FALSE;
    MemSet(&e, 0, sizeof(e)); e.type = GUI_EVENT_KEY; e.key = ev; GuiInputPush(&e); return TRUE;
}
U0 GuiMouseInput(I64 x, I64 y, I64 buttons, I64 wheel)
{
    CGuiEvent e; MemSet(&e, 0, sizeof(e)); e.type = GUI_EVENT_MOUSE;
    e.x = x; e.y = y; e.buttons = buttons; e.wheel = wheel; GuiInputPush(&e);
}
Bool GuiPoll(CGuiEvent *e)
{
    CGuiWindow *w = Fs->gui_window; I64 key;
    if (!w || !e || Gs->num) return FALSE;
    GuiPresent; // Legacy event loops commit the preceding drawing before polling.
    MemSet(e, 0, sizeof(CGuiEvent));
    if (w->event_lost) {w->event_lost = FALSE; e->type = GUI_EVENT_KEY; e->key = KEY_INPUT_LOST; return TRUE;}
    if (w->event_head != w->event_tail) {
        MemCpy(e, &w->events[w->event_head], sizeof(CGuiEvent)); w->event_head = (w->event_head + 1) % GUI_EVENTS;
        if (!w->input_vct) w->input_vct = e->vct;
        return TRUE;
    }
    if (key = KeyPop) {e->type = GUI_EVENT_KEY; e->key = key; if (key == KEY_RESIZE) e->type = GUI_EVENT_RESIZE; return TRUE;}
    return FALSE;
}
CGuiWindow *GuiNewPixel(U8 *title, I64 width = 480, I64 height = 256)
{
    CGuiWindow *w = GuiNew(title, width, height, TRUE);
    if (w) {w->pixel = TRUE; GuiFill(w->pixels, w->pw, w->ph, w->scale, 1 + GUI_PAD, GUI_TITLE + GUI_PAD, w->w, w->h, GUI_WHITE); GuiDecorate(w);}
    return w;
}
Bool GuiTermSelected(CGuiWindow *w, I64 x, I64 y)
{//Cells from the earlier to the later end, in reading order.
    I64 a = w->sel_y0 * 4096 + w->sel_x0, b = w->sel_y1 * 4096 + w->sel_x1, c = y * 4096 + x;
    if (a > b) {I64 t = a; a = b; b = t;}
    return w->selected && a <= c <= b;
}
U0 GuiTermInvertRow(CGuiWindow *w, I64 y)
{
    CVTerm *v = w->term; I64 x, j, i, s = w->scale, cw = font.cw, ch = font.ch; U32 *p;
    for (x = 0; x < v->cols; x++) if (GuiTermSelected(w, x, y))
            for (j = 0; j < ch; j++) {
                p = w->pixels + ((GUI_TITLE + GUI_PAD) * s + y * ch + j) * w->pw + (1 + GUI_PAD) * s + x * cw;
                for (i = 0; i < cw; i++) p[i] ^= 0xFFFFFF;
            }
}
U0 GuiTermCopy(CGuiWindow *w)
{//The selected cells as UTF-8 text on the clipboard; rows end in newlines, trailing blanks dropped.
    CVTerm *v = w->term; I64 x, y, n = 0, end, daif; U8 *buf; CVtCell *c;
    if (!v || !w->selected) return;
    buf = MAlloc(v->rows * (v->cols * 4 + 1) + 1); if (!buf) return;
    daif = SpinLockIrq(&v->lock);
    for (y = 0; y < v->rows; y++) {
        end = n;
        for (x = 0; x < v->cols; x++) if (GuiTermSelected(w, x, y)) {
                c = &v->cells[y * v->cols + x];
                if (c->width || !x) { // the right half of a wide glyph adds nothing
                    if (c->cp > 32) {n += Utf8Enc(buf + n, c->cp); end = n;} else buf[n++] = ' ';
                }
            }
        n = end;
        if (GuiTermSelected(w, v->cols - 1, y) && GuiTermSelected(w, 0, y + 1)) buf[n++] = '\n';
    }
    SpinUnlockIrq(&v->lock, daif);
    ClipboardSet(buf, n); Free(buf);
}
U0 GuiTermPaste(CGuiWindow *w)
{//Type the clipboard into the terminal (up to its key queue: 200 code points).
    I64 n = ClipboardSize, i = 0, len, typed = 0; U8 *s;
    if (!w->term || n <= 0) return;
    s = ClipboardText;
    while (s[i] && typed < 200) {
        len = Utf8Len(s[i]); if (!len) len = 1;
        if (s[i] != '\r') {VtKeyPush(w->term, Utf8Cp(s + i, len)); typed++;}
        i += len;
    }
    Free(s);
}
U0 GuiTermMouse(CGuiWindow *w, I64 x, I64 y, I64 buttons)
{//Drag in a terminal window selects cells; releasing copies them to the clipboard.
    CVTerm *v = w->term; I64 col, row;
    Bool down = (buttons & 1) && !(gui.buttons & 1), up = !(buttons & 1) && (gui.buttons & 1);
    if (!v) return;
    col = ClampI64((x - w->x - 1 - GUI_PAD) * gui.scale / font.cw, 0, v->cols - 1);
    row = ClampI64((y - w->y - GUI_TITLE - GUI_PAD) * gui.scale / font.ch, 0, v->rows - 1);
    if (down) {
        if (w->selected) w->dirty = TRUE;
        w->selecting = TRUE; w->selected = FALSE; w->sel_x0 = w->sel_x1 = col; w->sel_y0 = w->sel_y1 = row;
    } else if (w->selecting && (buttons & 1) && (col != w->sel_x1 || row != w->sel_y1)) {
        w->sel_x1 = col; w->sel_y1 = row; w->selected = w->sel_x0 != w->sel_x1 || w->sel_y0 != w->sel_y1; w->dirty = TRUE;
    } else if (up && w->selecting) {
        w->selecting = FALSE;
        if (w->selected) GuiTermCopy(w);
    }
}
U0 GuiRaster(CGuiWindow *w)
{//Only dirty terminal rows are rasterized into this window's BGRA texture backing.
    CVTerm *v = w->term; CVtCell *c; U32 *p;
    I64 daif, x, y, n, fg, bg, cw = font.cw, ch = font.ch, s = w->scale;
    if (!v || w->pixel) return;
    daif = SpinLockIrq(&v->lock);
    if (v->dirty || w->dirty) {
        for (y = 0; y < v->rows; y++) if (v->row_dirty[y] || w->dirty || y == w->cursor_y || y == v->cy) {
                for (x = 0; x < v->cols; x += n) {
                    c = &v->cells[y * v->cols + x]; n = 1;
                    if (c->width == 2 && x + 1 < v->cols) n = 2;
                    VtCellColors(c, &fg, &bg); p = w->pixels + ((GUI_TITLE + GUI_PAD) * s + y * ch) * w->pw + (1 + GUI_PAD) * s + x * cw;
                    FbGlyph(p, w->pw * 4, c->cp, n, FbRgb(fg), FbRgb(bg), c->attr & VT_ATTR_BOLD);
                }
                if (w->selected) GuiTermInvertRow(w, y);
                v->row_dirty[y] = 0; gui.raster_rows++;
            }
        if (!v->cursor_off && 0 <= v->cx < v->cols && 0 <= v->cy < v->rows) {
            x = v->cx; y = v->cy; n = v->cells[y * v->cols + x].width;
            if (!n || x + n > v->cols) n = 1;
            for (fg = 0; fg < ch; fg++) {
                p = w->pixels + ((GUI_TITLE + GUI_PAD) * s + y * ch + fg) * w->pw + (1 + GUI_PAD) * s + x * cw;
                for (bg = 0; bg < n * cw; bg++) p[bg] ^= 0xFFFFFF;
            }
        }
        w->cursor_x = v->cx; w->cursor_y = v->cy;
        v->dirty = FALSE; v->scrolled = 0; w->dirty = FALSE;
        GuiDecorate(w);
    }
    SpinUnlockIrq(&v->lock, daif);
}
U0 GuiDesktop()
{
    I64 x, y, s = gui.scale, pw = gui.w * s, ph = gui.h * s;
    U8 clock[32]; I64 i, left = 68;
    for (y = 0; y < ph; y++) for (x = 0; x < pw; x++) gui.desktop[y * pw + x] = ((x / s ^ y / s) & 1) * GUI_WHITE;
    GuiFill(gui.desktop, pw, ph, s, 0, 0, gui.w, GUI_MENU, GUI_WHITE);
    GuiFill(gui.desktop, pw, ph, s, 0, GUI_MENU - 1, gui.w, 1, 0);
    GuiText(gui.desktop, pw, ph, s, 8, 3, "System");
    if (gui.focus) for (i = 0; i < gui.focus->menu_count; i++) {GuiText(gui.desktop, pw, ph, s, left + 8, 3, gui.focus->menus[i].title); left += GuiTextWidth(gui.focus->menus[i].title) + 16;}
    StrPrint(clock, "%T", Now); clock[5] = 0;
    GuiText(gui.desktop, pw, ph, s, gui.w - 52, 3, clock);
    gui.desktop_revision++; gui.clock_minute = Now / (60 * CDATE_FREQ); GuiDamage(0, 0, gui.w, gui.h);
}
Bool GuiPointerApply()
{
    if (!gui.cursor_visible || !fb.gpu) return FALSE;
    return GpuPointerSet(gui.cursor, gui.cursor_w, gui.cursor_h, gui.scale, gui.hot_x, gui.hot_y, gui.mx * gui.scale, gui.my * gui.scale);
}
Bool GuiPointerSet(U32 *pixels, I64 width, I64 height, I64 hot_x = 0, I64 hot_y = 0)
{// Shape pixels are BGRA with alpha; geometry and hotspot are logical pixels.
    if (!gui_active || Gs->num || !pixels || width < 1 || height < 1 || width > 32 || height > 32 || hot_x < 0 || hot_y < 0 || hot_x >= width || hot_y >= height) return FALSE;
    MemCpy(gui.cursor, pixels, width * height * 4); gui.cursor_w = width; gui.cursor_h = height;
    gui.hot_x = hot_x; gui.hot_y = hot_y; gui.cursor_visible = TRUE; return GuiPointerApply;
}
U0 GuiPointerHide() {if (gui_active && !Gs->num) {gui.cursor_visible = FALSE; if (fb.gpu) GpuCursorHide;}}
Bool GuiPointerShow() {if (!gui_active || Gs->num || !gui.cursor_w) return FALSE; gui.cursor_visible = TRUE; return GuiPointerApply;}
U0 GuiPointerShape(I64 shape)
{//Show the arrow (0) or the I-beam (1) for the window under the pointer. A shape set
    //with GuiPointerSet stays until a window asks for another one.
    if (shape == gui.shape) return;
    gui.shape = shape;
    if (shape == 1) GuiPointerSet(gui.ibeam, 9, 16, 4, 8);
    else GuiPointerSet(gui.pointer, 12, 18);
}
U0 GuiPointerOver(I64 x, I64 y)
{//The focused pixel window chooses the pointer over its client area.
    CGuiWindow *w = gui.focus; I64 shape = 0;
    if (w && w->pixel && !w->closed && w->x + 1 + GUI_PAD <= x < w->x + 1 + GUI_PAD + w->w &&
            w->y + GUI_TITLE + GUI_PAD <= y < w->y + GUI_TITLE + GUI_PAD + w->h) shape = w->pointer_shape;
    if (shape || gui.shape) GuiPointerShape(shape);
}
U0 GuiPointerInit()
{//The classic arrow, 12 columns a row: B black, W white, space clear.
    U8 *arrow =
            "B           "
            "BB          "
            "BWB         "
            "BWWB        "
            "BWWWB       "
            "BWWWWB      "
            "BWWWWWB     "
            "BWWWWWWB    "
            "BWWWWWWWB   "
            "BWWWWWWWWB  "
            "BWWWWWBBBBB "
            "BWWBWWB     "
            "BWB BWWB    "
            "BB  BWWB    "
            "B    BWWB   "
            "     BWWB   "
            "      BB    ";
    // I-beam, 9x16: B black; a white halo keeps it visible on black.
    U8 *beam =
            "BB BB    "
            "  B      "
            "  B      "
            "  B      "
            "  B      "
            "  B      "
            "  B      "
            "  B      "
            "  B      "
            "  B      "
            "  B      "
            "  B      "
            "  B      "
            "  B      "
            "  B      "
            "BB BB    ";
    I64 i, x, y, dx, dy;
    for (i = 0; i < 9 * 16; i++) gui.ibeam[i] = 0;
    for (y = 0; y < 16; y++) for (x = 0; x < 9; x++) if (beam[y * 9 + x] == 'B')
                for (dy = -1; dy <= 1; dy++) for (dx = -1; dx <= 1; dx++)
                        if (0 <= x + dx + 2 < 9 && 0 <= y + dy < 16 && !gui.ibeam[(y + dy) * 9 + x + dx + 2]) gui.ibeam[(y + dy) * 9 + x + dx + 2] = 0xFF000000 | GUI_WHITE;
    for (y = 0; y < 16; y++) for (x = 0; x < 9; x++) if (beam[y * 9 + x] == 'B') gui.ibeam[y * 9 + x + 2] = 0xFF000000;
    gui.shape = 0;
    for (i = 0; i < 12 * 18; i++) {
        gui.pointer[i] = 0;
        if (i < 12 * 17 && arrow[i] == 'B') gui.pointer[i] = 0xFF000000;
        if (i < 12 * 17 && arrow[i] == 'W') gui.pointer[i] = 0xFF000000 | GUI_WHITE;
    }
}
U0 GuiCompose()
{
    I64 started = ArchCntVct, x, y, i, sx, s = gui.scale, pw = fb.w;
    if (gui.last_present_vct) {gui.wake_gap += started - gui.last_present_vct; gui.wake_gaps++; gui.last_present_vct = 0;}
    I64 x0 = MaxI64(0, gui.x0) * s, y0 = MaxI64(0, gui.y0) * s;
    I64 x1 = MinI64(gui.w, gui.x1) * s, y1 = MinI64(gui.h, gui.y1) * s;
    CGuiWindow *w; U0 (*frame)(); U32 *src, *dst; I64 cy, cx; U32 p;
    // A partial logical pixel at an odd physical screen edge still needs drawing.
    if (gui.x1 >= gui.w) x1 = fb.w; if (gui.y1 >= gui.h) y1 = fb.h;
    for (y = y0; y < y1; y++) MemCpy(gui.canvas + y * pw + x0, gui.desktop + y * pw + x0, (x1 - x0) * 4);
    for (i = 0; i < gui.count; i++) {
        w = gui.windows[i];
        for (y = MaxI64(y0, w->y * s); y < MinI64(y1, w->y * s + w->ph); y++) {
            x = MaxI64(x0, w->x * s); sx = MinI64(x1, w->x * s + w->pw);
            if (sx > x) {
                src = w->pixels + (y - w->y * s) * w->pw + x - w->x * s; dst = gui.canvas + y * pw + x;
                MemCpy(dst, src, (sx - x) * 4);
                if (w->vk_view) {
                    cy = y - (w->y + GUI_TITLE + GUI_PAD) * s;
                    if (0 <= cy < w->vk_h) for (cx = x; cx < sx; cx++) {
                            I64 local_x = cx - (w->x + 1 + GUI_PAD) * s;
                            if (0 <= local_x < w->vk_w) {
                                p = src[cx - x]; dst[cx - x] = GUI_WHITE;
                                if (w->vk_mirror) dst[cx - x] = w->vk_mirror[cy * w->vk_w + local_x];
                                if (p >> 24) dst[cx - x] = p;
                            }
                        }
                }
            }
        }
    }
    for (y = y0; y < y1; y++) for (x = x0; x < x1; x++) if (gui.overlay[y * pw + x] >> 24) gui.canvas[y * pw + x] = gui.overlay[y * pw + x];
    if (frame = gui.frame_hook) (*frame)();
    else {
        for (y = y0; y < y1; y++) MemCpy(fb.back + y * fb.stride + x0 * 4, gui.canvas + y * pw + x0, (x1 - x0) * 4);
        FbCopyRect(x0, y0, x1 - x0, y1 - y0); FbDamage(y0, y1);
    }
    for (i = 0; i < gui.count; i++) {
        w = gui.windows[i];
        if (w->present_vct && w->presented != w->revision) {
            gui.latency[gui.latency_count++ % GUI_LATENCY] = ArchCntVct - w->present_vct; w->present_vct = 0;
        }
        w->presented = w->revision;
    }
    gui.damage = FALSE; gui.frames++; gui.compose_ticks += ArchCntVct - started;
}
U0 GuiMouse(I64 mx, I64 my, I64 buttons, I64 wheel)
{
    I64 x = mx / gui.scale, y = my / gui.scale, i;
    CGuiWindow *w; Bool active;
    if (x != gui.mx || y != gui.my) {
        gui.mx = x; gui.my = y;
        if (gui.drag && (buttons & 1)) {
            if (gui.resizing) GuiResize(gui.drag, MaxI64(160, x - gui.drag->x - 2 * GUI_PAD), MaxI64(64, y - gui.drag->y - GUI_TITLE - 2 * GUI_PAD - GUI_FOOTER));
            else GuiMove(gui.drag, x - gui.dx, y - gui.dy);
        }
    }
    if (fb.gpu) GpuPointerMove(mx, my);
    GuiPointerOver(x, y);
    if (GuiMenuMouse(x, y, buttons)) {gui.buttons = buttons; gui.wheel = wheel; return;}
    if ((buttons & 1) && !(gui.buttons & 1)) {
        for (i = gui.count - 1; i >= 0; i--) {
            w = gui.windows[i];
            if (w->x <= x < w->x + w->w + 2 * GUI_PAD + 2 && w->y <= y < w->y + w->h + 2 * GUI_PAD + GUI_TITLE + GUI_FOOTER + 2) {
                active = gui.focus == w; GuiFocus(w); gui.dx = x - w->x; gui.dy = y - w->y;
                if (gui.dy < GUI_TITLE) {
                    if (gui.dx < 20) {if (active) GuiClose(w);}
                    else if (gui.dx >= w->w + 2 * GUI_PAD - 18) {if (active) GuiZoom(w);}
                    else {gui.drag = w; gui.resizing = FALSE;}
                } else if (active && gui.dx >= w->w + 2 * GUI_PAD - 12 && gui.dy >= w->h + 2 * GUI_PAD + GUI_TITLE + GUI_FOOTER - 12) {gui.drag = w; gui.resizing = TRUE;}
                break;
            }
        }
    }
    if (!(buttons & 1)) gui.drag = NULL;
    w = gui.capture;
    if (!w && gui.focus && !gui.drag) {
        w = gui.focus;
        if (!(w->x + 1 + GUI_PAD <= x < w->x + 1 + GUI_PAD + w->w && w->y + GUI_TITLE + GUI_PAD <= y < w->y + GUI_TITLE + GUI_PAD + w->h)) w = NULL;
    }
    if (w && !w->closed && !w->pixel) GuiTermMouse(w, x, y, buttons);
    if (w && !w->closed) {
        CGuiEvent e; MemSet(&e, 0, sizeof(e)); e.type = GUI_EVENT_MOUSE;
        e.x = x - w->x - 1 - GUI_PAD; e.y = y - w->y - GUI_TITLE - GUI_PAD; e.buttons = buttons; e.wheel = wheel - gui.wheel;
        GuiEventPush(w, &e);
        if (buttons & 1) gui.capture = w;
    }
    if (!(buttons & 1)) gui.capture = NULL;
    gui.wheel = wheel; gui.buttons = buttons;
}
U0 GuiEnd()
{
    I64 i; U0 (*stop)();
    if (fb.gpu) GpuCursorHide; gui.cursor_visible = FALSE;
    if (stop = gui.stop_hook) (*stop)();
    gui.frame_hook = gui.stop_hook = NULL;
    for (i = 0; i < gui.count; i++) GuiStopWindow(gui.windows[i]);
    gui.focus = gui.drag = gui.capture = NULL; gui_active = FALSE; gui_key_hook = gui_mouse_hook = NULL;
    fb.redraw_all = TRUE; fb.pending = TRUE;
    FbRender;
}
U0 GuiRescale()
{// Logical geometry survives; backing buffers and GPU textures change atomically
    // on the compositor's core. Resize events request pixel-app repaints.
    I64 i; U0 (*stop)(), (*start)(); CGuiWindow *w;
    if (stop = gui.stop_hook) (*stop)(); gui.frame_hook = gui.stop_hook = NULL;
    gui.scale = font.scale; gui.w = fb.w / gui.scale; gui.h = fb.h / gui.scale;
    gui.mx = mouse.mx / gui.scale; gui.my = mouse.my / gui.scale;
    GuiMenuDismiss;
    for (i = 0; i < gui.count; i++) {
        w = gui.windows[i]; GuiResize(w, w->w, w->h); GuiMove(w, w->x, w->y);
    }
    GuiDesktop; GuiPointerApply; if (start = gui_start_hook) (*start)();
    GuiLog("GUI SCALE APPLIED\n");
}
Bool GuiShot(U8 *path)
{//Save the composed desktop (physical pixels, no pointer) as a 32-bit BMP.
    I64 w = fb.w, h = fb.h, size = 54 + w * h * 4, y; U8 *bmp; Bool ok;
    if (!gui_active || !gui.canvas) return FALSE;
    bmp = CAlloc(size); if (!bmp) return FALSE;
    bmp[0] = 'B'; bmp[1] = 'M'; *(bmp + 2)(U32 *) = size; *(bmp + 10)(U32 *) = 54;
    *(bmp + 14)(U32 *) = 40; *(bmp + 18)(I32 *) = w; *(bmp + 22)(I32 *) = -h;
    *(bmp + 26)(U16 *) = 1; *(bmp + 28)(U16 *) = 32; *(bmp + 34)(U32 *) = w * h * 4;
    for (y = 0; y < h; y++) MemCpy(bmp + 54 + y * w * 4, gui.canvas + y * w, w * 4);
    ok = FileWrite(path, bmp, size) > 0; Free(bmp);
    return ok;
}
U0 GuiShotNext()
{//Ctrl+Alt+P: C:/Shots/NNN.BMP after the pending composition; "GUI SHOT n" on the UART.
    U8 *path, *s;
    if (!FileFind("C:/Shots")) DirMk("C:/Shots");
    path = MStrPrint("C:/Shots/%03d.BMP", gui.shots);
    // Writing the file stalls core 0: samples spanning it would not be input latency.
    if (GuiShot(path)) {gui.latency_count = gui.present_count = 0; s = MStrPrint("GUI SHOT %d\n", gui.shots); GuiLog(s); Free(s);}
    else GuiLog("GUI SHOT FAILED\n");
    gui.shots++; Free(path);
}
I64 GuiLatency(Bool reset = FALSE)
{//Print input-to-composition samples (microseconds); returns the maximum.
    I64 n = MinI64(gui.latency_count, GUI_LATENCY), i, j, t, *v = MAlloc(MaxI64(n, 1) * sizeof(I64)), max = 0, sum = 0;
    for (i = 0; i < n; i++) {v[i] = gui.latency[i] * 1000000 / cnt_freq; sum += v[i]; if (v[i] > max) max = v[i];}
    for (i = 1; i < n; i++) {t = v[i]; for (j = i; j > 0 && v[j - 1] > t; j--) v[j] = v[j - 1]; v[j] = t;}
    U8 *s;
    if (n) s = MStrPrint("GUI LATENCY n=%d max=%d p50=%d p95=%d mean=%d us\n", n, max, v[n / 2], v[n * 95 / 100], sum / n);
    else s = MStrPrint("GUI LATENCY n=0\n");
    GuiLog(s); Free(s);
    n = MinI64(gui.present_count, GUI_LATENCY); sum = 0; t = 0;
    for (i = 0; i < n; i++) {j = gui.presented_at[i] * 1000000 / cnt_freq; sum += j; if (j > t) t = j;}
    if (n) {
        s = MStrPrint("GUI LATENCY input-to-present n=%d max=%d mean=%d us; compose mean=%d us over %d frames\n", n, t, sum / n,
                      gui.compose_ticks * 1000000 / cnt_freq / MaxI64(gui.frames, 1), gui.frames);
        GuiLog(s); Free(s);
        s = MStrPrint("GUI LATENCY present-to-compose mean=%d us over %d\n", gui.wake_gap * 1000000 / cnt_freq / MaxI64(gui.wake_gaps, 1), gui.wake_gaps);
        GuiLog(s); Free(s);
    }
    Free(v);
    if (reset) gui.latency_count = gui.present_count = 0;
    return max;
}
U0 GuiTask(U8 *data)
{
    I64 i, j, action; CGuiWindow *w;
    no_warn data;
    while (gui_active) {
        if (font.scale != gui.scale) GuiRescale;
        CGuiEvent input;
        while (GuiInputPop(&input)) {
            gui.input_vct = input.vct;
            if (input.type == GUI_EVENT_MOUSE) GuiMouse(input.x, input.y, input.buttons, input.wheel);
            else GuiDispatchKey(input.key, input.timestamp);
        }
        gui.input_vct = 0;
        if (gui.input_lost) {gui.input_lost = FALSE; if (gui.focus) VtKeyPush(gui.focus->term, KEY_INPUT_LOST);}
        action = gui.action; gui.action = 0;
        if (action == 1) GuiShell;
        else if (action == 7) GuiDraw;
        else if (action == 8) GuiWidgets;
        else if (action == 9) GuiFiles;
        else if (action == 10) GuiTop;
        else if (action == 11) GuiSettings;
        else if (action == 12) GuiCube;
        else if (action == 13) GuiGallery;
        else if (action == 2) {GuiEnd; break;}
        else if (action >= 3 && action <= 5 && gui.focus) {
            w = gui.focus; i = gui.w / 2;
            j = 0; if (action == 4) j = i;
            GuiMove(w, j, GUI_MENU);
            if (action == 5) i = gui.w;
            GuiResize(w, i - 2 * GUI_PAD - 3, gui.h - GUI_MENU - GUI_TITLE - 2 * GUI_PAD - GUI_FOOTER - 3);
        }
        // Let notified producers drain input/repaint before synchronous GPU work.
        if (gui.input_wake) {gui.input_wake = FALSE; Yield;}
        // A wake that lands while this pass runs would be lost to the Sleep below.
        gui.present_wake = FALSE;
        for (i = 0; i < gui.count; i++) {
            w = gui.windows[i];
            if (w->closing && TimerJiffies >= w->close_deadline) GuiStopWindow(w);
            if (w->closed && !w->owner) {
                if (gui.menu_window == w) GuiMenuDismiss;
                GuiWinDamage(w); if (gui.focus == w) gui.focus = NULL; if (gui.drag == w) gui.drag = NULL; if (gui.capture == w) gui.capture = NULL;
                // Terminal refs keep data alive until inherited tasks are reaped.
                for (j = i; j < gui.count - 1; j++) gui.windows[j] = gui.windows[j + 1];
                gui.count--; VtRelease(w->term); Free(w->vk_mirror); Free(w->pixels); Free(w->back); Free(w); i--;
                if (!gui.focus && gui.count) GuiFocus(gui.windows[gui.count - 1]); else if (!gui.count) GuiDesktop;
            } else if (!w->closed) {
                if (w->serial != font.serial) GuiResize(w, w->w, w->h);
                GuiRaster(w);
            }
        }
        if (gui.clock_minute != Now / (60 * CDATE_FREQ)) GuiDesktop;
        if (gui.damage) GuiCompose;
        if (gui.shot_pending) {gui.shot_pending = FALSE; GuiShotNext;}
        if (!gui.present_wake) Sleep(8);
    }
    // Reap detached windows after producer tasks acknowledge close.
    for (i = 0; i < gui.count; i++) {
        w = gui.windows[i]; while (w->owner) Sleep(1);
        VtRelease(w->term); Free(w->vk_mirror); Free(w->pixels); Free(w->back); Free(w);
    }
    gui.count = 0; Free(gui.desktop); Free(gui.canvas); Free(gui.overlay); gui.desktop = gui.canvas = gui.overlay = NULL; gui.task = NULL;
}
Bool Gui()
{
    I64 daif; U0 (*start)();
    if (!fb.base || Gs->num || gui_active || gui.task) return FALSE;
    daif = FbRenderLock;
    gui.scale = font.scale; gui.w = fb.w / gui.scale; gui.h = fb.h / gui.scale;
    gui.desktop = CAlloc(fb.w * fb.h * 4); gui.canvas = CAlloc(fb.w * fb.h * 4); gui.overlay = CAlloc(fb.w * fb.h * 4);
    if (!gui.desktop || !gui.canvas || !gui.overlay) {Free(gui.desktop); Free(gui.canvas); Free(gui.overlay); FbRenderUnlock(daif); return FALSE;}
    fb.top = 0; fb.cur_w = 0;
    if (fb.scanout) ArchMmioWrite32(fb.scanout, 0);
    if (fb.gpu) GpuCursorHide;
    gui.buttons = mouse.buttons; gui.wheel = mouse.wheel;
    gui.mx = mouse.mx / gui.scale; gui.my = mouse.my / gui.scale;
    gui.input_head = gui.input_tail = 0; gui.input_lost = gui.input_wake = FALSE;
    gui_active = TRUE; gui_key_hook = &GuiKey; gui_mouse_hook = &GuiMouseInput;
    gui.menu_open = FALSE; gui.menu_window = NULL; gui.overlay_revision++;
    GuiPointerInit; GuiPointerSet(gui.pointer, 12, 18); GuiDesktop;
    FbRenderUnlock(daif);
    if (fb.venus && (start = gui_start_hook)) (*start)();
    gui.task = Spawn(&GuiTask, NULL, "Compositor", 0, adam_task);
    GuiShell;
    Print("GUI READY\n");
    return TRUE;
}
