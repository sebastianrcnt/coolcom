// Task-owned surfaces and desktop. Structural operations run on core 0;
// producers on other cores use the terminal/surface locks, never a GUI IPC.
#define GUI_WINDOWS 16
#define GUI_TITLE 22
#define GUI_MENU 22
#define GUI_PAD 3
#define GUI_FOOTER 12
#define GUI_WHITE 0xFFFFFF
#define GUI_EVENT_MOUSE 1
#define GUI_EVENT_KEY 2
#define GUI_EVENT_RESIZE 3
#define GUI_EVENT_CLOSE 4
#define GUI_EVENT_MENU 5
#define GUI_INPUT 1024
#define GUI_MENUS 4
#define GUI_MENU_ITEMS 8
class CGuiMenuItem {I64 id; U8 label[64];};
class CGuiMenu {U8 title[32]; I64 count; CGuiMenuItem items[GUI_MENU_ITEMS];};
#define GUI_EVENTS 64
class CGuiEvent {I64 type, key, x, y, buttons, wheel, timestamp;};
class CGuiWindow
{
    CTask *owner;
    CVTerm *term;
    U32 *pixels;
    I64 x, y, w, h, pw, ph, scale, serial, revision, lock;
    I64 cursor_x, cursor_y, cursor_w;
    Bool closed, dirty, zoomed, pixel;
    CGuiEvent events[GUI_EVENTS];
    I64 event_head, event_tail; Bool event_lost;
    CGuiEvent last_event;
    CGuiMenu menus[GUI_MENUS]; I64 menu_count, id, close_deadline; Bool closing;
    I64 restore_x, restore_y, restore_w, restore_h;
    U8 title[64];
};
class CGui
{
    CGuiWindow *windows[GUI_WINDOWS], *focus, *drag, *capture;
    I64 count, scale, w, h, mx, my, buttons, dx, dy, action;
    Bool resizing, damage;
    I64 x0, y0, x1, y1, clock_minute;
    U32 *desktop, *canvas, *overlay, pointer[12 * 18];
    CTask *task;
    U8 *frame_hook, *stop_hook;
    I64 frames, raster_rows, desktop_revision, overlay_revision, wheel;
    Bool menu_open; I64 menu_index, menu_hover; CGuiWindow *menu_window;
    CGuiEvent input[GUI_INPUT];
    I64 input_head, input_tail, input_lock; Bool input_lost;
};
CGui gui;
I64 gui_window_id;
extern U0 GuiEventPush(CGuiWindow *w, CGuiEvent *e);
extern U0 GuiDesktop();
extern U0 GuiMenuDismiss();
extern Bool GuiMenuMouse(I64 x, I64 y, I64 buttons);
extern U0 GuiMenuSelect(I64 item);
extern U0 GuiMenuPaint();
extern I64 GuiMenuCount();
extern CTask *GuiDraw();
U8 *gui_start_hook; // resident Venus renderer, installed by Terminal.cool

U0 GuiDamage(I64 x, I64 y, I64 w, I64 h)
{
    if (!gui.damage) {gui.x0 = x; gui.y0 = y; gui.x1 = x + w; gui.y1 = y + h;}
    else {if (x < gui.x0) gui.x0 = x; if (y < gui.y0) gui.y0 = y;
        if (x + w > gui.x1) gui.x1 = x + w; if (y + h > gui.y1) gui.y1 = y + h;}
    gui.damage = TRUE;
}
U0 GuiWinDamage(CGuiWindow *w) {GuiDamage(w->x, w->y, w->w + 2 * GUI_PAD + 3, w->h + 2 * GUI_PAD + GUI_TITLE + GUI_FOOTER + 3);}
U0 GuiFill(U32 *p, I64 pw, I64 ph, I64 scale, I64 x, I64 y, I64 w, I64 h, I64 color)
{//Logical rectangles, clipped before any pointer arithmetic.
    I64 i, j;
    x *= scale; y *= scale; w *= scale; h *= scale;
    if (x < 0) {w += x; x = 0;} if (y < 0) {h += y; y = 0;}
    if (w > pw - x) w = pw - x; if (h > ph - y) h = ph - y;
    if (w <= 0 || h <= 0) return;
    for (j = y; j < y + h; j++) for (i = x; i < x + w; i++) p[j * pw + i] = color;
}
U0 GuiBox(U32 *p, I64 pw, I64 ph, I64 scale, I64 x, I64 y, I64 w, I64 h)
{
    GuiFill(p, pw, ph, scale, x, y, w, 1, 0); GuiFill(p, pw, ph, scale, x, y + h - 1, w, 1, 0);
    GuiFill(p, pw, ph, scale, x, y, 1, h, 0); GuiFill(p, pw, ph, scale, x + w - 1, y, 1, h, 0);
}
U0 GuiText(U32 *p, I64 pw, I64 ph, I64 scale, I64 x, I64 y, U8 *text)
{//Open-license Unifont for chrome; independent of the terminal's TrueType choice.
    U8 *glyph; I64 row, col, bits, cells;
    while (*text && x + 8 <= pw / scale) {
        glyph = FontGlyph(*text++, &cells);
        if (glyph) for (row = 0; row < 16; row++) {
                bits = glyph[row]; bits |= bits >> 1; // bitmap bold, no proprietary font
                for (col = 0; col < 8; col++) if (bits & (128 >> col)) GuiFill(p, pw, ph, scale, x + col, y + row, 1, 1, 0);
            }
        x += 8;
    }
}
U0 GuiDecorate(CGuiWindow *w)
{
    I64 i, s = w->scale, pw = w->pw, ph = w->ph;
    I64 bw = w->w + 2 * GUI_PAD, bh = w->h + 2 * GUI_PAD + GUI_FOOTER;
    // White client insets separate the black frame from ANSI-black terminal cells.
    GuiFill(w->pixels, pw, ph, s, 1, GUI_TITLE, bw, GUI_PAD, GUI_WHITE);
    GuiFill(w->pixels, pw, ph, s, 1, GUI_TITLE + GUI_PAD, GUI_PAD, w->h, GUI_WHITE);
    GuiFill(w->pixels, pw, ph, s, 1 + GUI_PAD + w->w, GUI_TITLE + GUI_PAD, GUI_PAD, w->h, GUI_WHITE);
    GuiFill(w->pixels, pw, ph, s, 1, GUI_TITLE + GUI_PAD + w->h, bw, GUI_PAD + GUI_FOOTER + 1, GUI_WHITE);
    GuiFill(w->pixels, pw, ph, s, 0, 0, bw + 2, GUI_TITLE, GUI_WHITE);
    if (gui.focus == w) for (i = 4; i < GUI_TITLE - 3; i += 3) GuiFill(w->pixels, pw, ph, s, 4, i, bw - 6, 1, 0);
    i = StrLen(w->title) * 8;
    GuiFill(w->pixels, pw, ph, s, (bw - i) / 2 - 3, 1, i + 6, GUI_TITLE - 2, GUI_WHITE);
    GuiText(w->pixels, pw, ph, s, (bw - i) / 2, 3, w->title);
    if (gui.focus == w) {
        GuiFill(w->pixels, pw, ph, s, 7, 6, 10, 10, GUI_WHITE); GuiBox(w->pixels, pw, ph, s, 7, 6, 10, 10);
        GuiFill(w->pixels, pw, ph, s, bw - 16, 6, 10, 10, GUI_WHITE); GuiBox(w->pixels, pw, ph, s, bw - 16, 6, 10, 10);
        GuiBox(w->pixels, pw, ph, s, bw - 10, bh + GUI_TITLE - 10, 11, 11);
        for (i = 0; i < 7; i += 2) GuiFill(w->pixels, pw, ph, s, bw - 7 + i, bh + GUI_TITLE - 7, 1, 7, 0);
    }
    GuiFill(w->pixels, pw, ph, s, 0, GUI_TITLE - 1, bw + 2, 1, 0);
    GuiBox(w->pixels, pw, ph, s, 0, 0, bw + 2, bh + GUI_TITLE + 2);
    GuiFill(w->pixels, pw, ph, s, bw + 2, 1, 1, bh + GUI_TITLE + 2, 0);
    GuiFill(w->pixels, pw, ph, s, 1, bh + GUI_TITLE + 2, bw + 2, 1, 0);
    w->revision++; GuiWinDamage(w);
}
U0 GuiFocus(CGuiWindow *w)
{
    I64 i, j; CGuiWindow *old = gui.focus;
    if (old == w) return;
    if (gui.menu_open) GuiMenuDismiss;
    gui.focus = w;
    if (old) GuiDecorate(old);
    if (w) {
        for (i = 0; i < gui.count; i++) if (gui.windows[i] == w) {
                for (j = i; j < gui.count - 1; j++) gui.windows[j] = gui.windows[j + 1];
                gui.windows[gui.count - 1] = w; break;
            }
        GuiDecorate(w);
    }
    GuiDesktop;
}
Bool GuiResize(CGuiWindow *w, I64 width, I64 height)
{
    U32 *pixels; I64 cols, rows;
    if (!w || width < 160 || height < 64 || width > 4096 || height > 4096) return FALSE;
    cols = width * gui.scale / font.cw; rows = height * gui.scale / font.ch;
    if (!w->pixel) {width = cols * font.cw / gui.scale; height = rows * font.ch / gui.scale;}
    pixels = CAlloc((width + 2 * GUI_PAD + 3) * (height + 2 * GUI_PAD + GUI_TITLE + GUI_FOOTER + 3) * gui.scale * gui.scale * 4);
    if (!pixels) return FALSE;
    MemSet(pixels, 0xFF, (width + 2 * GUI_PAD + 3) * (height + 2 * GUI_PAD + GUI_TITLE + GUI_FOOTER + 3) * gui.scale * gui.scale * 4);
    GuiWinDamage(w); Free(w->pixels); w->pixels = pixels;
    w->w = width; w->h = height; w->scale = gui.scale;
    w->pw = (width + 2 * GUI_PAD + 3) * gui.scale; w->ph = (height + 2 * GUI_PAD + GUI_TITLE + GUI_FOOTER + 3) * gui.scale;
    w->serial = font.serial; w->cursor_w = 0;
    if (w->term) VtResize(w->term, cols, rows);
    GuiDecorate(w); w->dirty = TRUE;
    return TRUE;
}
U0 GuiMove(CGuiWindow *w, I64 x, I64 y)
{
    if (!w) return;
    if (x < 0) x = 0; if (x > gui.w - 40) x = gui.w - 40;
    if (y < GUI_MENU) y = GUI_MENU; if (y > gui.h - GUI_TITLE) y = gui.h - GUI_TITLE;
    GuiWinDamage(w); w->x = x; w->y = y; GuiWinDamage(w);
}
U0 GuiZoom(CGuiWindow *w)
{
    if (!w) return;
    if (w->zoomed) {GuiMove(w, w->restore_x, w->restore_y); GuiResize(w, w->restore_w, w->restore_h);}
    else {
        w->restore_x = w->x; w->restore_y = w->y; w->restore_w = w->w; w->restore_h = w->h;
        GuiMove(w, 0, GUI_MENU); GuiResize(w, gui.w - 2 * GUI_PAD - 3, gui.h - GUI_MENU - GUI_TITLE - 2 * GUI_PAD - GUI_FOOTER - 3);
    }
    w->zoomed = !w->zoomed;
}
U0 GuiStopWindow(CGuiWindow *w)
{
    if (!w || w->closed) return;
    w->closed = TRUE;
    if (w->term) VtStop(w->term);
}
U0 GuiClose(CGuiWindow *w)
{
    if (!w || w->closed || w->closing) return;
    if (!w->pixel) {GuiStopWindow(w); return;}
    CGuiEvent e; MemSet(&e, 0, sizeof(e)); e.type = GUI_EVENT_CLOSE;
    w->closing = TRUE; w->close_deadline = TimerJiffies + 1000; GuiEventPush(w, &e);
}
U0 GuiTaskGone(CTask *t)
{
    CGuiWindow *w = t->gui_window;
    if (w) {w->owner = NULL; w->closed = TRUE; t->gui_window = NULL;}
}
U0 GuiShellSink(CVTerm *v, U8 c) {no_warn v; UartPut(c);}
CGuiWindow *GuiNew(U8 *title, I64 width = 480, I64 height = 256, Bool pixel = FALSE)
{
    CGuiWindow *w; I64 i;
    if (!gui_active || Gs->num || gui.count >= GUI_WINDOWS || Fs->gui_window) return NULL;
    w = CAlloc(sizeof(CGuiWindow)); if (!w) return NULL;
    for (i = 0; i < 63 && title[i]; i++) w->title[i] = title[i]; w->owner = Fs; w->pixel = pixel; w->id = ++gui_window_id;
    w->term = VtNew(1, 1); w->term->owner = Fs; w->term->sink = &GuiShellSink;
    if (!GuiResize(w, width, height)) {VtRelease(w->term); Free(w); return NULL;}
    w->x = 20 + gui.count * 24; w->y = GUI_MENU + 12 + gui.count * 24;
    VtBind(Fs, w->term); Fs->gui_window = w;
    gui.windows[gui.count++] = w; GuiFocus(w);
    return w;
}
U0 GuiLog(U8 *text) {while (*text) UartPut(*text++);}
U0 GuiShellTask(U8 *data)
{
    no_warn data;
    if (GuiNew("Shell")) {GuiLog("GUI SHELL OPEN\n"); if (gui.count == 2) GuiLog("GUI WINDOWS READY\n"); ShellTask(-1);}
}
CTask *GuiShell() {return Spawn(&GuiShellTask, NULL, "GUI Shell", 0, adam_task, SHELL_STACK);}
class CGuiProgram {U8 *program, *entry;};
U0 GuiProgramTask(CGuiProgram *app)
{// Each JIT compiler and its application live until the task exits.
    CVTerm *v = VtNew(80, 24); U8 *modules, *paths, *command;
    VtBind(Fs, v); v->owner = Fs; v->sink = &GuiShellSink; VtRelease(v);
    ShellTask(0);
    modules = FileRead("C:/GuiModules.txt");
    if (modules) {
        paths = MStrPrint("%s,%s", modules, app->program);
        command = MStrPrint("WarmRun(\"%s\", \"%s\");", paths, app->entry);
        ShellExe(command); Free(command); Free(paths); Free(modules);
    } else GuiLog("GUI APP: missing GuiModules.txt\n");
    Free(app->program); Free(app->entry); Free(app);
}
CTask *GuiRun(U8 *program, U8 *entry)
{
    CGuiProgram *app; CTask *task;
    if (!gui_active || Gs->num || !program || !entry) return NULL;
    app = CAlloc(sizeof(CGuiProgram)); app->program = StrNew(program); app->entry = StrNew(entry);
    task = Spawn(&GuiProgramTask, app, "GUI App", 0, adam_task, SHELL_STACK);
    if (!task) {Free(app->program); Free(app->entry); Free(app);} return task;
}
CTask *GuiWidgets() {return GuiRun("C:/Warm/Examples/gui/Widgets.warm", "Widgets:main");}
Bool GuiDispatchKey(I64 ev, I64 timestamp)
{//Called by the compositor in input order, after preceding mouse focus changes.
    Bool shortcut = TRUE;
    if (!gui_active) return FALSE;
    if (gui.menu_open) {
        if (ev == KEY_ESC) GuiMenuDismiss;
        else if (ev == KEY_UP || ev == KEY_DOWN) {
            I64 delta = 1; if (ev == KEY_UP) delta = -1;
            if (GuiMenuCount) gui.menu_hover = (gui.menu_hover + delta + GuiMenuCount) % GuiMenuCount;
            GuiMenuPaint;
        } else if (ev == KEY_ENTER) GuiMenuSelect(gui.menu_hover);
        return TRUE;
    }
    if ((ev & (KF_CTRL | KF_ALT)) == (KF_CTRL | KF_ALT)) {
        if ((ev & KEY_CODE) == 'n') gui.action = 1;
        else if ((ev & KEY_CODE) == 'q') gui.action = 2;
        else if ((ev & KEY_CODE) == KEY_LEFT) gui.action = 3;
        else if ((ev & KEY_CODE) == KEY_RIGHT) gui.action = 4;
        else if ((ev & KEY_CODE) == KEY_UP) gui.action = 5;
        else if ((ev & KEY_CODE) == KEY_TAB) gui.action = 6;
        else shortcut = FALSE;
        if (shortcut) return TRUE;
    }
    if (gui.focus && !gui.focus->closed) {
        if (gui.focus->pixel) {
            CGuiEvent e; MemSet(&e, 0, sizeof(e)); e.type = GUI_EVENT_KEY; e.key = ev; e.timestamp = timestamp;
            GuiEventPush(gui.focus, &e);
        } else VtKeyPush(gui.focus->term, ev);
    }
    return TRUE;
}
U0 GuiEventPush(CGuiWindow *w, CGuiEvent *e)
{
    I64 next = (w->event_tail + 1) % GUI_EVENTS;
    if (next == w->event_head) w->event_lost = TRUE;
    else {MemCpy(&w->events[w->event_tail], e, sizeof(CGuiEvent)); w->event_tail = next;}
    if (w->owner) TaskWake(w->owner);
}
U0 GuiInputPush(CGuiEvent *e)
{
    e->timestamp = TimerJiffies;
    I64 daif = SpinLockIrq(&gui.input_lock), next = (gui.input_tail + 1) % GUI_INPUT;
    if (next == gui.input_head) gui.input_lost = TRUE;
    else {MemCpy(&gui.input[gui.input_tail], e, sizeof(CGuiEvent)); gui.input_tail = next;}
    SpinUnlockIrq(&gui.input_lock, daif);
    if (gui.task) TaskWake(gui.task);
}
Bool GuiInputPop(CGuiEvent *e)
{
    I64 daif = SpinLockIrq(&gui.input_lock); Bool found = gui.input_head != gui.input_tail;
    if (found) {MemCpy(e, &gui.input[gui.input_head], sizeof(CGuiEvent)); gui.input_head = (gui.input_head + 1) % GUI_INPUT;}
    SpinUnlockIrq(&gui.input_lock, daif); return found;
}
Bool GuiKey(I64 ev)
{
    CGuiEvent e; if (!gui_active) return FALSE;
    MemSet(&e, 0, sizeof(e)); e.type = GUI_EVENT_KEY; e.key = ev; GuiInputPush(&e); return TRUE;
}
U0 GuiMouseInput(I64 x, I64 y, I64 buttons, I64 wheel)
{
    CGuiEvent e; MemSet(&e, 0, sizeof(e)); e.type = GUI_EVENT_MOUSE;
    e.x = x; e.y = y; e.buttons = buttons; e.wheel = wheel; GuiInputPush(&e);
}
Bool GuiPoll(CGuiEvent *e)
{
    CGuiWindow *w = Fs->gui_window; I64 key;
    if (!w || !e) return FALSE;
    MemSet(e, 0, sizeof(CGuiEvent));
    if (w->event_lost) {w->event_lost = FALSE; e->type = GUI_EVENT_KEY; e->key = KEY_INPUT_LOST; return TRUE;}
    if (w->event_head != w->event_tail) {MemCpy(e, &w->events[w->event_head], sizeof(CGuiEvent)); w->event_head = (w->event_head + 1) % GUI_EVENTS; return TRUE;}
    if (key = KeyPop) {e->type = GUI_EVENT_KEY; e->key = key; if (key == KEY_RESIZE) e->type = GUI_EVENT_RESIZE; return TRUE;}
    return FALSE;
}
CGuiWindow *GuiNewPixel(U8 *title, I64 width = 480, I64 height = 256)
{
    CGuiWindow *w = GuiNew(title, width, height, TRUE);
    if (w) {w->pixel = TRUE; GuiFill(w->pixels, w->pw, w->ph, w->scale, 1 + GUI_PAD, GUI_TITLE + GUI_PAD, w->w, w->h, GUI_WHITE); GuiDecorate(w);}
    return w;
}
U0 GuiRaster(CGuiWindow *w)
{//Only dirty terminal rows are rasterized into this window's BGRA texture backing.
    CVTerm *v = w->term; CVtCell *c; U32 *p;
    I64 daif, x, y, n, fg, bg, cw = font.cw, ch = font.ch, s = w->scale;
    if (!v || w->pixel) return;
    daif = SpinLockIrq(&v->lock);
    if (v->dirty || w->dirty) {
        for (y = 0; y < v->rows; y++) if (v->row_dirty[y] || w->dirty || y == w->cursor_y || y == v->cy) {
                for (x = 0; x < v->cols; x += n) {
                    c = &v->cells[y * v->cols + x]; n = 1;
                    if (c->width == 2 && x + 1 < v->cols) n = 2;
                    VtCellColors(c, &fg, &bg); p = w->pixels + ((GUI_TITLE + GUI_PAD) * s + y * ch) * w->pw + (1 + GUI_PAD) * s + x * cw;
                    FbGlyph(p, w->pw * 4, c->cp, n, FbRgb(fg), FbRgb(bg), c->attr & VT_ATTR_BOLD);
                }
                v->row_dirty[y] = 0; gui.raster_rows++;
            }
        if (!v->cursor_off && 0 <= v->cx < v->cols && 0 <= v->cy < v->rows) {
            x = v->cx; y = v->cy; n = v->cells[y * v->cols + x].width;
            if (!n || x + n > v->cols) n = 1;
            for (fg = 0; fg < ch; fg++) {
                p = w->pixels + ((GUI_TITLE + GUI_PAD) * s + y * ch + fg) * w->pw + (1 + GUI_PAD) * s + x * cw;
                for (bg = 0; bg < n * cw; bg++) p[bg] ^= 0xFFFFFF;
            }
        }
        w->cursor_x = v->cx; w->cursor_y = v->cy;
        v->dirty = FALSE; v->scrolled = 0; w->dirty = FALSE;
        GuiDecorate(w);
    }
    SpinUnlockIrq(&v->lock, daif);
}
U0 GuiDesktop()
{
    I64 x, y, s = gui.scale, pw = gui.w * s, ph = gui.h * s;
    U8 clock[32]; I64 i, left = 68;
    for (y = 0; y < ph; y++) for (x = 0; x < pw; x++) gui.desktop[y * pw + x] = ((x / s ^ y / s) & 1) * GUI_WHITE;
    GuiFill(gui.desktop, pw, ph, s, 0, 0, gui.w, GUI_MENU, GUI_WHITE);
    GuiFill(gui.desktop, pw, ph, s, 0, GUI_MENU - 1, gui.w, 1, 0);
    GuiText(gui.desktop, pw, ph, s, 8, 3, "System");
    if (gui.focus) for (i = 0; i < gui.focus->menu_count; i++) {GuiText(gui.desktop, pw, ph, s, left + 8, 3, gui.focus->menus[i].title); left += StrLen(gui.focus->menus[i].title) * 8 + 16;}
    StrPrint(clock, "%T", Now); clock[5] = 0;
    GuiText(gui.desktop, pw, ph, s, gui.w - 52, 3, clock);
    gui.desktop_revision++; gui.clock_minute = Now / (60 * CDATE_FREQ); GuiDamage(0, 0, gui.w, gui.h);
}
U0 GuiPointerInit()
{
    I64 x, y;
    for (y = 0; y < 18; y++) for (x = 0; x < 12; x++) {
            gui.pointer[y * 12 + x] = 0;
            if (y < 13 && x <= y / 2) gui.pointer[y * 12 + x] = 0xFF000000;
            if (y < 12 && x > 0 && x < y / 2) gui.pointer[y * 12 + x] |= GUI_WHITE;
            if (y >= 10 && y < 18 && x >= 4 && x <= 6) gui.pointer[y * 12 + x] = 0xFF000000;
            if (y >= 10 && y < 17 && x == 5) gui.pointer[y * 12 + x] |= GUI_WHITE;
        }
}
U0 GuiCompose()
{
    I64 x, y, i, sx, s = gui.scale, pw = gui.w * s;
    I64 x0 = MaxI64(0, gui.x0) * s, y0 = MaxI64(0, gui.y0) * s;
    I64 x1 = MinI64(gui.w, gui.x1) * s, y1 = MinI64(gui.h, gui.y1) * s;
    CGuiWindow *w; U32 p; U0 (*frame)();
    for (y = y0; y < y1; y++) MemCpy(gui.canvas + y * pw + x0, gui.desktop + y * pw + x0, (x1 - x0) * 4);
    for (i = 0; i < gui.count; i++) {
        w = gui.windows[i];
        for (y = MaxI64(y0, w->y * s); y < MinI64(y1, w->y * s + w->ph); y++) {
            x = MaxI64(x0, w->x * s); sx = MinI64(x1, w->x * s + w->pw);
            if (sx > x) MemCpy(gui.canvas + y * pw + x, w->pixels + (y - w->y * s) * w->pw + x - w->x * s, (sx - x) * 4);
        }
    }
    for (y = y0; y < y1; y++) for (x = x0; x < x1; x++) if (gui.overlay[y * pw + x] >> 24) gui.canvas[y * pw + x] = gui.overlay[y * pw + x];
    for (y = MaxI64(y0, gui.my * s); y < MinI64(y1, (gui.my + 18) * s); y++)
        for (x = MaxI64(x0, gui.mx * s); x < MinI64(x1, (gui.mx + 12) * s); x++) {
            p = gui.pointer[(y / s - gui.my) * 12 + x / s - gui.mx];
            if (p >> 24) gui.canvas[y * pw + x] = p;
        }
    if (frame = gui.frame_hook) (*frame)();
    else {
        for (y = y0; y < y1; y++) MemCpy(fb.back + y * fb.stride + x0 * 4, gui.canvas + y * pw + x0, (x1 - x0) * 4);
        FbCopyRect(x0, y0, x1 - x0, y1 - y0); FbDamage(y0, y1);
    }
    gui.damage = FALSE; gui.frames++;
}
U0 GuiMouse(I64 mx, I64 my, I64 buttons, I64 wheel)
{
    I64 x = mx / gui.scale, y = my / gui.scale, i;
    CGuiWindow *w; Bool active;
    if (x != gui.mx || y != gui.my) {
        GuiDamage(gui.mx, gui.my, 12, 18); GuiDamage(x, y, 12, 18);
        gui.mx = x; gui.my = y;
        if (gui.drag && (buttons & 1)) {
            if (gui.resizing) GuiResize(gui.drag, MaxI64(160, x - gui.drag->x - 2 * GUI_PAD), MaxI64(64, y - gui.drag->y - GUI_TITLE - 2 * GUI_PAD - GUI_FOOTER));
            else GuiMove(gui.drag, x - gui.dx, y - gui.dy);
        }
    }
    if (GuiMenuMouse(x, y, buttons)) {gui.buttons = buttons; gui.wheel = wheel; return;}
    if ((buttons & 1) && !(gui.buttons & 1)) {
        for (i = gui.count - 1; i >= 0; i--) {
            w = gui.windows[i];
            if (w->x <= x < w->x + w->w + 2 * GUI_PAD + 2 && w->y <= y < w->y + w->h + 2 * GUI_PAD + GUI_TITLE + GUI_FOOTER + 2) {
                active = gui.focus == w; GuiFocus(w); gui.dx = x - w->x; gui.dy = y - w->y;
                if (gui.dy < GUI_TITLE) {
                    if (gui.dx < 20) {if (active) GuiClose(w);}
                    else if (gui.dx >= w->w + 2 * GUI_PAD - 18) {if (active) GuiZoom(w);}
                    else {gui.drag = w; gui.resizing = FALSE;}
                } else if (active && gui.dx >= w->w + 2 * GUI_PAD - 12 && gui.dy >= w->h + 2 * GUI_PAD + GUI_TITLE + GUI_FOOTER - 12) {gui.drag = w; gui.resizing = TRUE;}
                break;
            }
        }
    }
    if (!(buttons & 1)) gui.drag = NULL;
    w = gui.capture;
    if (!w && gui.focus && !gui.drag) {
        w = gui.focus;
        if (!(w->x + 1 + GUI_PAD <= x < w->x + 1 + GUI_PAD + w->w && w->y + GUI_TITLE + GUI_PAD <= y < w->y + GUI_TITLE + GUI_PAD + w->h)) w = NULL;
    }
    if (w && !w->closed) {
        CGuiEvent e; MemSet(&e, 0, sizeof(e)); e.type = GUI_EVENT_MOUSE;
        e.x = x - w->x - 1 - GUI_PAD; e.y = y - w->y - GUI_TITLE - GUI_PAD; e.buttons = buttons; e.wheel = wheel - gui.wheel;
        GuiEventPush(w, &e);
        if (buttons & 1) gui.capture = w;
    }
    if (!(buttons & 1)) gui.capture = NULL;
    gui.wheel = wheel; gui.buttons = buttons;
}
U0 GuiEnd()
{
    I64 i; U0 (*stop)();
    if (stop = gui.stop_hook) (*stop)();
    gui.frame_hook = gui.stop_hook = NULL;
    for (i = 0; i < gui.count; i++) GuiStopWindow(gui.windows[i]);
    gui.focus = gui.drag = gui.capture = NULL; gui_active = FALSE; gui_key_hook = gui_mouse_hook = NULL;
    fb.redraw_all = TRUE; fb.pending = TRUE;
    FbRender;
}
U0 GuiTask(U8 *data)
{
    I64 i, j, action; CGuiWindow *w;
    no_warn data;
    while (gui_active) {
        CGuiEvent input;
        while (GuiInputPop(&input)) {
            if (input.type == GUI_EVENT_MOUSE) GuiMouse(input.x, input.y, input.buttons, input.wheel);
            else GuiDispatchKey(input.key, input.timestamp);
        }
        if (gui.input_lost) {gui.input_lost = FALSE; if (gui.focus) VtKeyPush(gui.focus->term, KEY_INPUT_LOST);}
        action = gui.action; gui.action = 0;
        if (action == 1) GuiShell;
        else if (action == 7) GuiDraw;
        else if (action == 8) GuiWidgets;
        else if (action == 2) {GuiEnd; break;}
        else if (action == 6 && gui.count) GuiFocus(gui.windows[0]);
        else if (action >= 3 && action <= 5 && gui.focus) {
            w = gui.focus; i = gui.w / 2;
            j = 0; if (action == 4) j = i;
            GuiMove(w, j, GUI_MENU);
            if (action == 5) i = gui.w;
            GuiResize(w, i - 2 * GUI_PAD - 3, gui.h - GUI_MENU - GUI_TITLE - 2 * GUI_PAD - GUI_FOOTER - 3);
        }
        for (i = 0; i < gui.count; i++) {
            w = gui.windows[i];
            if (w->closing && TimerJiffies >= w->close_deadline) GuiStopWindow(w);
            if (w->closed) {
                if (gui.menu_window == w) GuiMenuDismiss;
                GuiWinDamage(w); if (gui.focus == w) gui.focus = NULL; if (gui.drag == w) gui.drag = NULL; if (gui.capture == w) gui.capture = NULL;
                // Terminal refs keep data alive until inherited tasks are reaped.
                if (w->owner) w->owner->gui_window = NULL;
                for (j = i; j < gui.count - 1; j++) gui.windows[j] = gui.windows[j + 1];
                gui.count--; VtRelease(w->term); Free(w->pixels); Free(w); i--;
                if (!gui.focus && gui.count) GuiFocus(gui.windows[gui.count - 1]); else if (!gui.count) GuiDesktop;
            } else {
                if (w->serial != font.serial) GuiResize(w, w->w, w->h);
                GuiRaster(w);
            }
        }
        if (gui.clock_minute != Now / (60 * CDATE_FREQ)) GuiDesktop;
        if (gui.damage) GuiCompose;
        Sleep(8);
    }
    // Reap detached windows after producer tasks acknowledge close.
    for (i = 0; i < gui.count; i++) {
        w = gui.windows[i]; if (w->owner) w->owner->gui_window = NULL;
        VtRelease(w->term); Free(w->pixels); Free(w);
    }
    gui.count = 0; Free(gui.desktop); Free(gui.canvas); Free(gui.overlay); gui.desktop = gui.canvas = gui.overlay = NULL; gui.task = NULL;
}
Bool Gui()
{
    I64 daif; U0 (*start)();
    if (!fb.base || Gs->num || gui_active || gui.task) return FALSE;
    daif = FbRenderLock;
    gui.scale = font.scale; gui.w = fb.w / gui.scale; gui.h = fb.h / gui.scale;
    gui.desktop = CAlloc(fb.w * fb.h * 4); gui.canvas = CAlloc(fb.w * fb.h * 4); gui.overlay = CAlloc(fb.w * fb.h * 4);
    if (!gui.desktop || !gui.canvas || !gui.overlay) {Free(gui.desktop); Free(gui.canvas); Free(gui.overlay); FbRenderUnlock(daif); return FALSE;}
    fb.top = 0; fb.cur_w = 0;
    if (fb.scanout) ArchMmioWrite32(fb.scanout, 0);
    if (fb.gpu) GpuCursorHide;
    gui.buttons = mouse.buttons; gui.wheel = mouse.wheel;
    gui.mx = mouse.mx / gui.scale; gui.my = mouse.my / gui.scale;
    gui.input_head = gui.input_tail = 0; gui.input_lost = FALSE;
    gui_active = TRUE; gui_key_hook = &GuiKey; gui_mouse_hook = &GuiMouseInput;
    gui.menu_open = FALSE; gui.menu_window = NULL; gui.overlay_revision++;
    GuiPointerInit; GuiDesktop;
    FbRenderUnlock(daif);
    if (fb.venus && (start = gui_start_hook)) (*start)();
    gui.task = Spawn(&GuiTask, NULL, "Compositor", 0, adam_task);
    GuiShell; GuiShell;
    Print("GUI READY\n");
    return TRUE;
}
