// G2 immediate-mode drawing/input example, independent of the shell compiler.
U0 GuiDrawScene()
{
    CGuiWindow *w = GrWindow; U32 image[64]; I64 i;
    if (!w) return;
    GrRect(0, 0, w->w, w->h, GUI_WHITE);
    GrText(12, 10, "Drawing — GrRect / GrLine / GrText / GrBlit");
    GrRect(16, 40, 100, 70, 0x00AAFF); GrRect(40, 60, 100, 70, 0xFFAA00);
    GrLine(16, 160, w->w - 20, 40, 0);
    for (i = 0; i < 64; i++) image[i] = ((i / 8 ^ i) & 1) * GUI_WHITE;
    GrBlit(170, 60, 8, 8, image, 32);
    GrText(12, w->h - 26, "Click to draw; Q closes this window.");
}
U0 GuiDrawPresent()
{// Startup and painting markers acknowledge an actual completed frame.
    CGuiWindow *w = GrWindow; I64 revision;
    if (!w) return;
    revision = w->revision;
    while (gui_active && !w->closed && w->presented < revision) Sleep(1);
}
U0 GuiDrawTask(U8 *data)
{
    CGuiEvent e; U8 *message; Bool replied;
    no_warn data;
    if (!GuiNewPixel("Drawing", 480, 256)) return;
    GuiDrawScene; GuiDrawPresent; message = MStrPrint("GUI DRAW READY%d\n", gui.count); GuiLog(message); Free(message);
    while (TRUE) {
        replied = FALSE;
        while (GuiPoll(&e)) {
            if (e.type == GUI_EVENT_CLOSE) return;
            if (e.type == GUI_EVENT_KEY && e.key == 'q') return;
            if (e.type == GUI_EVENT_KEY && e.key == KEY_INPUT_LOST) GuiLog("GUI DRAW INPUT LOST\n");
            if (e.type == GUI_EVENT_KEY && e.key == 'p') {
                replied = TRUE;
                message = MStrPrint("GUI DRAW PONG %d %d\n", TimerJiffies, TimerJiffies - e.timestamp); GuiLog(message); Free(message);
            }
            if (e.type == GUI_EVENT_RESIZE) GuiDrawScene;
            if (e.type == GUI_EVENT_MOUSE && (e.buttons & 1)) {
                GrRect(e.x - 2, e.y - 2, 5, 5, 0); GuiDrawPresent;
                message = MStrPrint("GUI DRAW MOUSE %d %d\n", e.x, e.y); GuiLog(message); Free(message);
            }
        }
        if (replied) {GuiDrawPresent; GuiLog("GUI DRAW PRESENTED\n");}
        Sleep(1);
    }
}
CTask *GuiDraw() {if (!gui_active) return NULL; return Spawn(&GuiDrawTask, NULL, "Drawing", 0, adam_task);}

U0 GuiCubeNoticeTask(U8 *data)
{
    no_warn data; CGuiEvent e;
    if (!GuiNewPixel("Cube", 320, 96)) return;
    GrText(16, 20, "Cube needs the Venus terminal.");
    GrText(16, 48, "Use a VM with Venus enabled.");
    while (TRUE) {
        while (GuiPoll(&e)) if (e.type == GUI_EVENT_CLOSE || (e.type == GUI_EVENT_KEY && (e.key == 'q' || e.key == KEY_ESC))) return;
        Sleep(10);
    }
}
CTask *GuiCubeUnavailable() {return Spawn(&GuiCubeNoticeTask, NULL, "Cube", 0, adam_task);}
