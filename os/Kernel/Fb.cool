// Framebuffer console: the renderer for the console terminal's cell grid.
//
// The console is an ordinary terminal (Term.cool): FbPutC feeds every console byte to
// vt_screen, whose emulator keeps the cells (code point, colors, attributes), the rows
// that changed and the number of full-screen scrolls. Nothing is drawn then. The renderer
// (FbRender) runs from the timer on core 0 once a frame (FB_FRAME_JIFFIES) while output
// streams and as soon as it pauses (FB_IDLE_JIFFIES), or when asked (FbFlush). It takes
// the changed rows under the terminal's lock, moves its pixels for the scrolls, draws the
// cells that differ from what it drew last into a cached back buffer with GNU Unifont
// (Font.cool: 8x16 cells, wide glyphs take two), copies only the changed part of each
// row to the framebuffer and draws the block cursor there, once. The framebuffer is
// never read. The grid does not know about pixels, so another renderer (other fonts,
// scaling, windows) can show the same terminals.
//
// The framebuffer is the FDT's simple-framebuffer (32 bits per pixel, 0x00RRGGBB). It is
// outside /memory, but on real hardware it lies inside the DRAM aperture the boot tables
// map as Normal write-back. FbMapNC() uses the existing 16 KiB page tables and remaps
// just the framebuffer pages as Normal non-cacheable, so the display controller sees
// every store. Under coolvm the renderer reports the pixel rows it wrote (the finisher's
// FINISHER_FB_DAMAGE register), so the window redraws without comparing whole frames.
#define FB_FRAME_JIFFIES 16  // at most about 60 frames a second while output streams
#define FB_IDLE_JIFFIES  2   // and a frame this soon after output stops
#define FINISHER_FB_DAMAGE 0x18 // coolvm: write (end << 16) | start, the pixel rows just drawn

class CFb
{
    U8 *base;                 // the framebuffer (non-cacheable)
    U8 *back;                 // what it shows without the cursor: same size and stride, cached
    I64 w, h, stride, cols, rows;
    CVTerm *vt;               // the grid shown (vt_screen)
    CVtCell *drawn;           // per cell, what the back buffer shows (all bytes 0xFF: unknown)
    CVtCell *snap;            // the rows taken from the grid for this frame
    U8 *snap_row;             // 1: snap holds this row
    I64 *x0, *x1;             // per row, the columns of the back buffer to copy (x0 >= x1: none)
    I64 cur_x, cur_y, cur_w;  // the cursor on the framebuffer, cur_w pixels wide (0: none)
    I64 render_lock, put_owner;
    I64 last_put, last_render; // jiffies
    Bool pending;             // the grid changed since the last frame (set and cleared under vt->lock)
    Bool redraw_all;          // forget the back buffer (ConsClear)
    Bool ticking;             // the timer renders; before that, FbPutC does at each line
    Bool cursor_hidden;       // FbCursorHide
    U8 *damage;               // coolvm's damage register, NULL elsewhere
    U32 palette[256];
    U8 *ascii[128];           // glyphs of ASCII (all one cell wide)
};

CFb fb;

#define FB_BLK_SHIFT  25   // level-2 block: 32 MiB
#define FB_PAGE_SHIFT 14   // 16 KiB granule
#define FB_PAGES      2048 // pages per block

U0 FbMapNC(I64 start, I64 size)
{
    I64 addr, *l3, *l2 = ArchL2Table;
    for (addr = start & ~16383; addr < start + size; addr += 16384) {
        l3 = l2[addr >> 25] & ~16383;
        l3[(addr >> 14) & 2047] = 0;
        ArchTlbFlush;
        l3[(addr >> 14) & 2047] = addr | 3 | (2 << 2) | (3 << 8) | (1 << 10);
    }
    ArchTlbFlush;
}

I64 FbAnsiColor(I64 n)
{// Standard ANSI palette in 0xRRGGBB.
    switch (n & 15) {
        case 0: return 0x000000;
        case 1: return 0xAA0000;
        case 2: return 0x00AA00;
        case 3: return 0xAA5500;
        case 4: return 0x0000AA;
        case 5: return 0xAA00AA;
        case 6: return 0x00AAAA;
        case 7: return 0xAAAAAA;
        case 8: return 0x555555;
        case 9: return 0xFF5555;
        case 10: return 0x55FF55;
        case 11: return 0xFFFF55;
        case 12: return 0x5555FF;
        case 13: return 0xFF55FF;
        case 14: return 0x55FFFF;
        case 15: return 0xFFFFFF;
    }
    return 0;

}

I64 FbColor256(I64 n)
{//Color n of the xterm 256-color palette in 0xRRGGBB: 16 ANSI colors, a 6x6x6 cube, 24 grays.
    I64 r, g, b, v;
    n &= 255;
    if (n < 16)
        return FbAnsiColor(n);
    if (n >= 232) {
        v = 8 + 10 * (n - 232);
        return (v << 16) | (v << 8) | v;
    }
    n -= 16;
    r = n / 36;
    g = n / 6 % 6;
    b = n % 6;
    if (r) r = 55 + 40 * r;
    if (g) g = 55 + 40 * g;
    if (b) b = 55 + 40 * b;
    return (r << 16) | (g << 8) | b;
}

I64 FbRgb(I64 color)
{//An Ansi.cool color (a cell's) in 0xRRGGBB.
    if (color & ANSI_RGB_FLAG)
        return color & 0xFFFFFF;
    if (color < 0)
        return 0;
    return fb.palette[color & 255];
}

U8 *FbGlyph(I64 cp, I64 *_cells)
{
    if (cp >= 0 && cp < 128 && fb.ascii[cp]) {
        *_cells = 1;
        return fb.ascii[cp];
    }
    if (cp < 0 || cp >= 0x110000)
        return NULL;
    return FontGlyph(cp, _cells);
}

//---- drawing into the back buffer

U0 FbBackFill(I64 x, I64 y, I64 w, I64 h, I64 rgb)
{
    U8 *row = fb.back + y * fb.stride + x * 4;
    U32 *p;
    I64 i;
    while (h-- > 0) {
        p = row;
        for (i = 0; i < w; i++)
            p[i] = rgb;
        row += fb.stride;
    }
}

U0 FbBackGlyph(I64 col, I64 row, I64 cp, I64 cells, I64 fg, I64 bg)
{//Draw cp over cells cells at col,row. A code point the font lacks, or whose glyph
    //is not cells wide, is a '?' in each cell.
    U8 *g, *line = fb.back + row * FONT_CELL_H * fb.stride + col * FONT_CELL_W * 4;
    U32 *p;
    I64 y, x, bits, n = cells * FONT_CELL_W, gc;
    if (cp == ' ') {
        FbBackFill(col * FONT_CELL_W, row * FONT_CELL_H, n, FONT_CELL_H, bg);
        return;
    }
    g = FbGlyph(cp, &gc);
    if (!g || gc != cells) {
        for (x = 0; x < cells; x++)
            FbBackGlyph(col + x, row, '?', 1, fg, bg);
        return;
    }
    for (y = 0; y < FONT_CELL_H; y++) {
        if (cells == 2) {
            bits = (g[0] << 8) | g[1];
            g += 2;
        } else
            bits = *g++;
        p = line;
        for (x = n - 1; x >= 0; x--) {
            if ((bits >> x) & 1)
                *p++ = fg;
            else
                *p++ = bg;
        }
        line += fb.stride;
    }
}

U0 FbBackCell(I64 col, I64 row, CVtCell *c, I64 cells)
{
    I64 fg, bg;
    VtCellColors(c, &fg, &bg);
    fg = FbRgb(fg);
    bg = FbRgb(bg);
    if (!c->width)  // the right half of a wide glyph that is gone
        FbBackGlyph(col, row, ' ', 1, fg, bg);
    else
        FbBackGlyph(col, row, c->cp, cells, fg, bg);
}

Bool FbCellSame(CVtCell *a, CVtCell *b)
{
    I64 *x = a, *y = b;
    return x[0] == y[0] && x[1] == y[1];
}

//---- to the framebuffer

U0 FbCopyRect(I64 x, I64 y, I64 w, I64 h)
{//Back buffer to framebuffer, in pixels.
    I64 off = y * fb.stride + x * 4;
    if (w <= 0 || h <= 0)
        return;
    if (!x && w == fb.w && fb.stride == fb.w * 4) {
        MemCpy(fb.base + off, fb.back + off, h * fb.stride);
        return;
    }
    while (h-- > 0) {
        MemCpy(fb.base + off, fb.back + off, w * 4);
        off += fb.stride;
    }
}

U0 FbCursorDraw(I64 cx, I64 cy, I64 w)
{//The block cursor: the cell under it with every color inverted.
    I64 off = cy * FONT_CELL_H * fb.stride + cx * FONT_CELL_W * 4, y, x;
    U32 *s, *d;
    for (y = 0; y < FONT_CELL_H; y++) {
        s = fb.back + off;
        d = fb.base + off;
        for (x = 0; x < w; x++)
            d[x] = s[x] ^ 0xFFFFFF;
        off += fb.stride;
    }
}

U0 FbDamage(I64 y0, I64 y1)
{
    if (fb.damage && y1 > y0)
        ArchMmioWrite32(fb.damage, (y1 << 16) | y0);
}

U0 FbSpan(I64 row, I64 x0, I64 x1)
{
    if (x0 < fb.x0[row]) fb.x0[row] = x0;
    if (x1 > fb.x1[row]) fb.x1[row] = x1;
}

U0 FbRenderLocked()
{//One frame; the caller holds fb.render_lock with IRQs masked.
    CVTerm *v = fb.vt;
    CVtCell *p, *d;
    I64 x, y, n, cols = fb.cols, rows = fb.rows, scrolled, cx = 0, cy = 0, cw = 0, band;
    I64 dy0 = fb.h, dy1 = 0;
    Bool all;
    SpinLock(&v->lock);
    if (v->cols != cols || v->rows != rows) {  // the console grid is never resized
        fb.pending = FALSE;
        SpinUnlock(&v->lock);
        return;
    }
    scrolled = v->scrolled;
    v->scrolled = 0;
    all = fb.redraw_all;
    fb.redraw_all = FALSE;
    for (y = 0; y < rows; y++)
        if (v->row_dirty[y] || all) {
            v->row_dirty[y] = 0;
            fb.snap_row[y] = 1;
            MemCpy(fb.snap + y * cols, v->cells + y * cols, cols * sizeof(CVtCell));
        }
    if (!v->cursor_off && !fb.cursor_hidden && v->cx >= 0 && v->cx < cols && v->cy >= 0 && v->cy < rows) {
        cx = v->cx;
        cy = v->cy;
        cw = FONT_CELL_W;
        if (v->cells[cy * cols + cx].width == 2 && cx + 1 < cols)
            cw *= 2;
    }
    fb.pending = FALSE;
    SpinUnlock(&v->lock);

    // The scrolls: move the pixels (and what they show) up, in cached memory.
    if (all || scrolled >= rows) {
        MemSet(fb.drawn, 0xFF, rows * cols * sizeof(CVtCell));
        if (all)
            MemSet(fb.back, 0, fb.stride * fb.h);
    } else if (scrolled) {
        band = FONT_CELL_H * fb.stride;
        MemCpy(fb.back, fb.back + scrolled * band, (rows - scrolled) * band);
        MemCpy(fb.drawn, fb.drawn + scrolled * cols, (rows - scrolled) * cols * sizeof(CVtCell));
        MemSet(fb.drawn + (rows - scrolled) * cols, 0xFF, scrolled * cols * sizeof(CVtCell));
    }
    if (all || scrolled) {
        for (y = 0; y < rows; y++) {
            fb.x0[y] = 0;
            fb.x1[y] = cols;
        }
    }

    // The cells that differ from what the back buffer shows.
    for (y = 0; y < rows; y++)
        if (fb.snap_row[y]) {
            fb.snap_row[y] = 0;
            p = fb.snap + y * cols;
            d = fb.drawn + y * cols;
            for (x = 0; x < cols; x += n) {
                n = 1;
                if (p[x].width == 2 && x + 1 < cols)
                    n = 2;
                if (!FbCellSame(&p[x], &d[x]) || (n == 2 && !FbCellSame(&p[x + 1], &d[x + 1]))) {
                    FbBackCell(x, y, &p[x], n);
                    MemCpy(&d[x], &p[x], n * sizeof(CVtCell));
                    FbSpan(y, x, x + n);
                }
            }
        }

    // The old cursor goes with its row's copy.
    if (fb.cur_w)
        FbSpan(fb.cur_y, fb.cur_x, fb.cur_x + fb.cur_w / FONT_CELL_W);
    if (all) {
        MemCpy(fb.base, fb.back, fb.stride * fb.h);
        dy0 = 0;
        dy1 = fb.h;
    }
    for (y = 0; y < rows; y++) {
        if (fb.x0[y] < fb.x1[y]) {
            if (!all)
                FbCopyRect(fb.x0[y] * FONT_CELL_W, y * FONT_CELL_H,
                           (fb.x1[y] - fb.x0[y]) * FONT_CELL_W, FONT_CELL_H);
            if (y * FONT_CELL_H < dy0) dy0 = y * FONT_CELL_H;
            dy1 = (y + 1) * FONT_CELL_H;
        }
        fb.x0[y] = cols;
        fb.x1[y] = 0;
    }
    fb.cur_w = cw;
    if (cw) {
        fb.cur_x = cx;
        fb.cur_y = cy;
        FbCursorDraw(cx, cy, cw);
        if (cy * FONT_CELL_H < dy0) dy0 = cy * FONT_CELL_H;
        if ((cy + 1) * FONT_CELL_H > dy1) dy1 = (cy + 1) * FONT_CELL_H;
    }
    FbDamage(dy0, dy1);
}

U0 FbIntRestore(I64 daif)
{//ArchIntRestore, which unmasks for a moment even when daif is masked: not in the timer interrupt.
    if ((daif & 0xC0) != 0xC0)
        ArchIntRestore(daif);
}

I64 FbRenderLock()
{//Take the renderer, spinning; returns the DAIF for FbRenderUnlock.
    I64 daif = ArchDaif;
    ArchIrqOff;
    while (ArchXchg(&fb.render_lock, 1))
        while (fb.render_lock) {}
    return daif;
}

U0 FbRenderUnlock(I64 daif)
{
    fb.last_render = jiffies;
    ArchStoreRel(&fb.render_lock, 0);
    FbIntRestore(daif);
}

U0 FbRender()
{//Draw a frame now, unless another core is drawing one.
    I64 daif;
    if (!fb.base)
        return;
    daif = ArchDaif;
    ArchIrqOff;
    if (!ArchXchg(&fb.render_lock, 1)) {
        FbRenderLocked;
        FbRenderUnlock(daif);
        return;
    }
    FbIntRestore(daif);
}

U0 FbFlush()
{//Put everything written so far on the screen (before halting, powering off, ...).
    FbRender;
}

U0 FbTick()
{//From the timer interrupt on core 0.
    if (!fb.base)
        return;
    fb.ticking = TRUE;
    if (fb.pending && (jiffies - fb.last_put >= FB_IDLE_JIFFIES || jiffies - fb.last_render >= FB_FRAME_JIFFIES))
        FbRender;
}

//---- the console

U0 FbPutC(U8 c)
{//Console output: into the grid; the renderer draws it later.
    CVTerm *v = fb.vt;
    I64 daif, me = ArchCpuNum + 1;
    Bool nested = v->lock && fb.put_owner == me; // an exception while this core was writing
    if (!nested)
        daif = SpinLockIrq(&v->lock);
    fb.put_owner = me;
    VtPut(v, c);
    v->dirty = TRUE;
    fb.cursor_hidden = FALSE;
    fb.pending = TRUE;
    fb.last_put = jiffies;
    if (!nested) {
        fb.put_owner = 0;
        SpinUnlockIrq(&v->lock, daif);
    }
    if (!fb.ticking && c == '\n')
        FbRender;
}

U0 FbFillRect(I64 x, I64 y, I64 w, I64 h, I64 color)
{//Paint a rectangle over the console (pixels, 0xRRGGBB). Text drawn before it is
    //rendered first; the cells under it are drawn again when their text changes.
    I64 daif;
    if (!fb.base)
        return;
    if (x < 0) {
        w += x;
        x = 0;
    }
    if (y < 0) {
        h += y;
        y = 0;
    }
    if (x + w > fb.w)
        w = fb.w - x;
    if (y + h > fb.h)
        h = fb.h - y;
    if (w <= 0 || h <= 0)
        return;
    daif = FbRenderLock;
    FbRenderLocked;
    FbBackFill(x, y, w, h, color);
    FbCopyRect(x, y, w, h);
    if (fb.cur_w && y < (fb.cur_y + 1) * FONT_CELL_H && y + h > fb.cur_y * FONT_CELL_H &&
            x < fb.cur_x * FONT_CELL_W + fb.cur_w && x + w > fb.cur_x * FONT_CELL_W)
        fb.cur_w = 0;  // painted over
    FbDamage(y, y + h);
    FbRenderUnlock(daif);
}

U0 ConsClear()
{
    CVTerm *v = fb.vt;
    I64 daif;
    if (!fb.base)
        return;
    daif = SpinLockIrq(&v->lock);
    VtClear(v);
    fb.redraw_all = TRUE;
    fb.pending = TRUE;
    SpinUnlockIrq(&v->lock, daif);
}

U0 FbSetColor(I64 fg, I64 bg)
{//The console's colors for what is printed next, in 0xRRGGBB.
    CVTerm *v = fb.vt;
    I64 daif;
    if (!fb.base)
        return;
    daif = SpinLockIrq(&v->lock);
    v->fg = ANSI_RGB_FLAG | (fg & 0xFFFFFF);
    v->bg = ANSI_RGB_FLAG | (bg & 0xFFFFFF);
    SpinUnlockIrq(&v->lock, daif);
}

// Direct console operations (the Warm standard library's screen functions,
// warmc/standard/src/Kernel/Adapter.cool): the same grid changes as the escape
// sequences, without going through the byte stream.

U0 FbCursorHide()
{//Hide the cursor until the next console output or FbCursorShow.
    CVTerm *v = fb.vt;
    I64 daif;
    if (!fb.base)
        return;
    daif = SpinLockIrq(&v->lock);
    fb.cursor_hidden = TRUE;
    fb.pending = TRUE;
    SpinUnlockIrq(&v->lock, daif);
}

U0 FbCursorShow()
{//Show the cursor again (unless a program turned it off with CSI ?25l).
    CVTerm *v = fb.vt;
    I64 daif;
    if (!fb.base)
        return;
    daif = SpinLockIrq(&v->lock);
    fb.cursor_hidden = FALSE;
    fb.pending = TRUE;
    SpinUnlockIrq(&v->lock, daif);
}

U0 FbScroll()
{//Scroll the console up one line; the cursor goes to the last row.
    CVTerm *v = fb.vt;
    I64 daif;
    if (!fb.base)
        return;
    daif = SpinLockIrq(&v->lock);
    VtScroll(v);
    fb.pending = TRUE;
    fb.last_put = jiffies;
    SpinUnlockIrq(&v->lock, daif);
}

U0 FbPutCp(I64 cp)
{//A code point at the console's cursor, as if it came in UTF-8.
    CVTerm *v = fb.vt;
    I64 daif;
    if (!fb.base)
        return;
    daif = SpinLockIrq(&v->lock);
    VtPutCp(v, cp);
    fb.pending = TRUE;
    fb.last_put = jiffies;
    SpinUnlockIrq(&v->lock, daif);
}

U0 FbAlt(Bool on)
{//The console's alternate screen on or off (CSI ?1049h/l).
    CVTerm *v = fb.vt;
    I64 daif;
    if (!fb.base)
        return;
    daif = SpinLockIrq(&v->lock);
    VtAlt(v, on);
    fb.pending = TRUE;
    fb.last_put = jiffies;
    SpinUnlockIrq(&v->lock, daif);
}

Bool FbInit()
{//Map the framebuffer and add it as a console output. FALSE if the FDT has none.
    I64 i, cells, n;
    U8 *g;
    if (!fdt_fb_32bpp || !fdt_fb.base)
        return FALSE;
    fb.w = fdt_fb_w;
    fb.h = fdt_fb_h;
    fb.stride = fdt_fb_stride;
    fb.cols = fb.w / FONT_CELL_W;
    fb.rows = fb.h / FONT_CELL_H;
    if (fb.cols < 1 || fb.rows < 2 || fb.stride < fb.w * 4)
        return FALSE;
    n = fb.cols * fb.rows;
    fb.back = CAlloc(fb.stride * fb.h);
    fb.drawn = MAlloc(n * sizeof(CVtCell));
    fb.snap = MAlloc(n * sizeof(CVtCell));
    fb.snap_row = CAlloc(fb.rows);
    fb.x0 = MAlloc(fb.rows * sizeof(I64));
    fb.x1 = CAlloc(fb.rows * sizeof(I64));
    for (i = 0; i < fb.rows; i++)
        fb.x0[i] = fb.cols;
    for (i = 0; i < 256; i++)
        fb.palette[i] = FbColor256(i);
    for (i = 0; i < 128; i++)
        if ((g = FontGlyph(i, &cells)) && cells == 1)
            fb.ascii[i] = g;
    if (fdt_vm && fdt_finisher)
        fb.damage = fdt_finisher + FINISHER_FB_DAMAGE;
    fb.vt = vt_screen = VtAlloc(fb.cols, fb.rows);
    FbMapNC(fdt_fb.base, fb.stride * fb.h);
    fb.base = fdt_fb.base;
    fb.redraw_all = TRUE;
    FbRender;  // clears the screen and draws the cursor
    ConsAdd(&FbPutC);
    return TRUE;
}
