// Framebuffer console: the renderer for the console terminal's cell grid.
//
// The console is an ordinary terminal (Term.cool): FbPutC feeds every console byte to
// vt_screen, whose emulator keeps the cells (code point, colors, attributes), the rows
// that changed and the number of full-screen scrolls. Nothing is drawn then. The renderer
// (FbRender) runs from the timer on core 0 once a frame (FB_FRAME_JIFFIES) while output
// streams and as soon as it pauses (FB_IDLE_JIFFIES), or when asked (FbFlush). It takes
// the changed rows under the terminal's lock, advances its pixel ring for the scrolls, draws the
// cells that differ from what it drew last into a cached back buffer with GNU Unifont
// (Font.cool: 8x16 cells, wide glyphs take two), copies only the changed part of each
// row to the framebuffer and draws the block cursor there, once. The framebuffer is
// never read. The grid does not know about pixels, so another renderer (other fonts,
// scaling, windows) can show the same terminals.
//
// The framebuffer is the FDT's simple-framebuffer (32 bits per pixel, 0x00RRGGBB). It is
// outside /memory, but on real hardware it lies inside the DRAM aperture the boot tables
// map as Normal write-back. FbMapNC() uses the existing 16 KiB page tables and remaps
// just the framebuffer pages as Normal non-cacheable, so the display controller sees
// every store. Under coolvm the renderer reports the pixel rows it wrote (the finisher's
// FINISHER_FB_DAMAGE register), so the window redraws without comparing whole frames.
#define FB_FRAME_JIFFIES 16  // at most about 60 frames a second while output streams
#define FB_IDLE_JIFFIES  2   // and a frame this soon after output stops
#define FB_HIDDEN_JIFFIES 100 // while the program hides the cursor (it is redrawing: Vim, Tmux),
#define FB_HIDDEN_IDLE    20  // no frames mid-stream: only once output has stopped this long, or this often
#define FINISHER_FB_DAMAGE 0x18 // coolvm: write (end << 16) | start, the pixel rows just drawn

class CFb
{
    U8 *base;                 // the framebuffer (non-cacheable)
    U8 *back;                 // what it shows without the cursor: same size and stride, cached
    I64 w, h, stride, cols, rows;
    U8 *scanout;             // optional FDT scanout-y register (pixel rows)
    I64 scan_top;            // offset last committed to the display
    Bool gpu;                // virtio-gpu resource backing, with a mirrored second screen
    Bool venus;              // resident Vulkan app has installed its render hooks
    I64 top;                 // first visible pixel row in the text-area ring
    CVTerm *vt;               // the grid shown (vt_screen)
    CVtCell *drawn;           // per cell, what the back buffer shows (all bytes 0xFF: unknown)
    CVtCell *snap;            // the rows taken from the grid for this frame
    U8 *snap_row;             // 1: snap holds this row
    I64 *x0, *x1;             // per row, the columns of the back buffer to copy (x0 >= x1: none)
    I64 cur_x, cur_y, cur_w;  // the cursor on the framebuffer, cur_w pixels wide (0: none)
    I64 render_lock, put_owner;
    I64 last_put, last_render; // jiffies
    Bool pending;             // the grid changed since the last frame (set and cleared under vt->lock)
    Bool redraw_all;          // forget the back buffer (ConsClear)
    Bool ticking;             // the timer renders; before that, FbPutC does at each line
    Bool cursor_hidden;       // FbCursorHide
    U8 *damage;               // coolvm's damage register, NULL elsewhere
    U32 palette[256];
    U64i venus_frames, venus_rows, venus_cell_bytes; // actual guest cell writes / draws
    U8 *ascii[128];           // glyphs of ASCII (all one cell wide)
};

CFb fb;
// The generated Vulkan layer stays on disk, owned by a resident compiler task.
U8 *venus_frame_hook;  // U0 (*)(Bool all, I64 scroll, I64 cx, I64 cy, I64 cells)
U8 *venus_fill_hook;   // U0 (*)(I64 x, I64 y, I64 w, I64 h, I64 rgb)
U0 FbVenusHooks(U8 *frame, U8 *fill) {venus_frame_hook = frame; venus_fill_hook = fill;}
I64 venus_console_boot;  // 0 untried, 1 loading, 2 resident or unavailable

#define FB_BLK_SHIFT  25   // level-2 block: 32 MiB
#define FB_PAGE_SHIFT 14   // 16 KiB granule
#define FB_PAGES      2048 // pages per block

U0 FbMapNC(I64 start, I64 size)
{
    I64 addr, *l3, *l2 = ArchL2Table;
    for (addr = start & ~16383; addr < start + size; addr += 16384) {
        l3 = l2[addr >> 25] & ~16383;
        l3[(addr >> 14) & 2047] = 0;
        ArchTlbFlush;
        l3[(addr >> 14) & 2047] = addr | 3 | (2 << 2) | (3 << 8) | (1 << 10);
    }
    ArchTlbFlush;
}

I64 FbAnsiColor(I64 n)
{// Standard ANSI palette in 0xRRGGBB.
    switch (n & 15) {
        case 0: return 0x000000;
        case 1: return 0xAA0000;
        case 2: return 0x00AA00;
        case 3: return 0xAA5500;
        case 4: return 0x0000AA;
        case 5: return 0xAA00AA;
        case 6: return 0x00AAAA;
        case 7: return 0xAAAAAA;
        case 8: return 0x555555;
        case 9: return 0xFF5555;
        case 10: return 0x55FF55;
        case 11: return 0xFFFF55;
        case 12: return 0x5555FF;
        case 13: return 0xFF55FF;
        case 14: return 0x55FFFF;
        case 15: return 0xFFFFFF;
    }
    return 0;

}

I64 FbColor256(I64 n)
{//Color n of the xterm 256-color palette in 0xRRGGBB: 16 ANSI colors, a 6x6x6 cube, 24 grays.
    I64 r, g, b, v;
    n &= 255;
    if (n < 16)
        return FbAnsiColor(n);
    if (n >= 232) {
        v = 8 + 10 * (n - 232);
        return (v << 16) | (v << 8) | v;
    }
    n -= 16;
    r = n / 36;
    g = n / 6 % 6;
    b = n % 6;
    if (r) r = 55 + 40 * r;
    if (g) g = 55 + 40 * g;
    if (b) b = 55 + 40 * b;
    return (r << 16) | (g << 8) | b;
}

I64 FbRgb(I64 color)
{//An Ansi.cool color (a cell's) in 0xRRGGBB.
    if (color & ANSI_RGB_FLAG)
        return color & 0xFFFFFF;
    if (color < 0)
        return 0;
    return fb.palette[color & 255];
}

U8 *FbGlyph(I64 cp, I64 *_cells)
{
    if (cp >= 0 && cp < 128 && fb.ascii[cp]) {
        *_cells = 1;
        return fb.ascii[cp];
    }
    if (cp < 0 || cp >= 0x110000)
        return NULL;
    return FontGlyph(cp, _cells);
}

//---- drawing into the back buffer

I64 FbBackY(I64 y)
{//Only complete text rows rotate; the bottom pixel margin stays fixed.
    if (y < fb.rows * FONT_CELL_H)
        return (fb.top + y) % (fb.rows * FONT_CELL_H);
    return y;
}

U0 FbBackFill(I64 x, I64 y, I64 w, I64 h, I64 rgb)
{
    U8 *row;
    U32 *p;
    I64 i;
    while (h-- > 0) {
        row = fb.back + FbBackY(y++) * fb.stride + x * 4;
        p = row;
        for (i = 0; i < w; i++)
            p[i] = rgb;
    }
}

U0 FbBackGlyph(I64 col, I64 row, I64 cp, I64 cells, I64 fg, I64 bg)
{//Draw cp over cells cells at col,row. A code point the font lacks, or whose glyph
    //is not cells wide, is a '?' in each cell.
    U8 *g, *line = fb.back + FbBackY(row * FONT_CELL_H) * fb.stride + col * FONT_CELL_W * 4;
    U32 *p;
    I64 y, x, bits, n = cells * FONT_CELL_W, gc;
    if (cp == ' ') {
        FbBackFill(col * FONT_CELL_W, row * FONT_CELL_H, n, FONT_CELL_H, bg);
        return;
    }
    g = FbGlyph(cp, &gc);
    if (!g || gc != cells) {
        for (x = 0; x < cells; x++)
            FbBackGlyph(col + x, row, '?', 1, fg, bg);
        return;
    }
    for (y = 0; y < FONT_CELL_H; y++) {
        if (cells == 2) {
            bits = (g[0] << 8) | g[1];
            g += 2;
        } else
            bits = *g++;
        p = line;
        for (x = n - 1; x >= 0; x--) {
            if ((bits >> x) & 1)
                *p++ = fg;
            else
                *p++ = bg;
        }
        line += fb.stride;
    }
}

U0 FbBackCell(I64 col, I64 row, CVtCell *c, I64 cells)
{
    I64 fg, bg;
    VtCellColors(c, &fg, &bg);
    fg = FbRgb(fg);
    bg = FbRgb(bg);
    if (!c->width)  // the right half of a wide glyph that is gone
        FbBackGlyph(col, row, ' ', 1, fg, bg);
    else
        FbBackGlyph(col, row, c->cp, cells, fg, bg);
}

Bool FbCellSame(CVtCell *a, CVtCell *b)
{
    I64 *x = a, *y = b;
    return x[0] == y[0] && x[1] == y[1];
}

//---- to the framebuffer

U0 FbCopyRect(I64 x, I64 y, I64 w, I64 h)
{//Back buffer to framebuffer, in pixels.
    I64 src, dst, n, i, ring_h = fb.rows * FONT_CELL_H;
    if (w <= 0 || h <= 0)
        return;
    while (h > 0) {
        src = FbBackY(y);
        n = 1;
        if (fb.gpu || (!x && w == fb.w && fb.stride == fb.w * 4)) {
            n = fb.h - src;
            if (y < ring_h) {
                n = ring_h - src;
                if (n > ring_h - y) n = ring_h - y;
            }
            if (n > h) n = h;
        }
        if (fb.gpu) {
            for (i = 0; i < n; i++)
                MemCpy(fb.back + (fb.h + src + i) * fb.stride + x * 4,
                        fb.back + (src + i) * fb.stride + x * 4, w * 4);
            GpuTransfer(gpu.resource, fb.stride, x, src, w, n);
            GpuTransfer(gpu.resource, fb.stride, x, fb.h + src, w, n);
            goto fb_copy_next;
        }
        dst = y;
        if (fb.scanout) dst = src;
        MemCpy(fb.base + dst * fb.stride + x * 4,
                fb.back + src * fb.stride + x * 4, (n - 1) * fb.stride + w * 4);
fb_copy_next:
        y += n;
        h -= n;
    }
}

U0 FbCursorDraw(I64 cx, I64 cy, I64 w)
{//The block cursor: the cell under it with every color inverted.
    I64 off = cy * FONT_CELL_H * fb.stride + cx * FONT_CELL_W * 4, y, x;
    U32 *s, *d;
    if (fb.gpu) {
        GpuCursor(cx * FONT_CELL_W, cy * FONT_CELL_H, w,
                  fb.back + FbBackY(cy * FONT_CELL_H) * fb.stride + cx * FONT_CELL_W * 4, fb.stride);
        return;
    }
    for (y = 0; y < FONT_CELL_H; y++) {
        s = fb.back + FbBackY(cy * FONT_CELL_H + y) * fb.stride + cx * FONT_CELL_W * 4;
        d = fb.base + off;
        if (fb.scanout)
            d = fb.base + FbBackY(cy * FONT_CELL_H + y) * fb.stride + cx * FONT_CELL_W * 4;
        for (x = 0; x < w; x++)
            d[x] = s[x] ^ 0xFFFFFF;
        off += fb.stride;
    }
}

U0 FbDamage(I64 y0, I64 y1)
{
    if (fb.gpu) {
        GpuPresent(fb.top, fb.w, fb.h);
        return;
    }
    if (fb.damage && y1 > y0) {
        ArchDsb;
        ArchMmioWrite32(fb.damage, (y1 << 16) | y0);
    }
}

U0 FbSpan(I64 row, I64 x0, I64 x1)
{
    if (x0 < fb.x0[row]) fb.x0[row] = x0;
    if (x1 > fb.x1[row]) fb.x1[row] = x1;
}

U0 FbRenderLocked()
{//One frame; the caller holds fb.render_lock with IRQs masked.
    CVTerm *v = fb.vt;
    CVtCell *p, *d;
    I64 x, y, n, cols = fb.cols, rows = fb.rows, scrolled, cx = 0, cy = 0, cw = 0;
    I64 dy0 = fb.h, dy1 = 0;
    Bool all, hardware = fb.scanout || (fb.gpu && fb.h == rows * FONT_CELL_H && fb.w == cols * FONT_CELL_W);
    SpinLock(&v->lock);
    if (v->cols != cols || v->rows != rows) {  // buffer and grid resizing is serialized by this lock
        fb.pending = FALSE;
        SpinUnlock(&v->lock);
        return;
    }
    scrolled = v->scrolled;
    v->scrolled = 0;
    all = fb.redraw_all;
    fb.redraw_all = FALSE;
    for (y = 0; y < rows; y++)
        if (v->row_dirty[y] || all) {
            v->row_dirty[y] = 0;
            fb.snap_row[y] = 1;
            MemCpy(fb.snap + y * cols, v->cells + y * cols, cols * sizeof(CVtCell));
        }
    if (!v->cursor_off && !fb.cursor_hidden && v->cx >= 0 && v->cx < cols && v->cy >= 0 && v->cy < rows) {
        cx = v->cx;
        cy = v->cy;
        cw = FONT_CELL_W;
        if (v->cells[cy * cols + cx].width == 2 && cx + 1 < cols)
            cw *= 2;
    }
    fb.pending = FALSE;
    SpinUnlock(&v->lock);
    if (fb.venus && venus_frame_hook) {
        U0 (*frame)(Bool fresh, I64 scroll_rows, I64 col, I64 row, I64 span);
        frame = venus_frame_hook;
        (*frame)(all, scrolled, cx, cy, cw / FONT_CELL_W);
        return;
    }

    // Remove the cursor at its old physical location before rotating scanout.
    if (fb.scanout && fb.cur_w) {
        FbCopyRect(fb.cur_x * FONT_CELL_W, fb.cur_y * FONT_CELL_H, fb.cur_w, FONT_CELL_H);
        dy0 = fb.cur_y * FONT_CELL_H;
        dy1 = dy0 + FONT_CELL_H;
        fb.cur_w = 0;
    }
    // Rotate the pixel ring; only the small cell cache moves.
    if (all || scrolled >= rows || (scrolled && fb.gpu && !hardware)) {
        MemSet(fb.drawn, 0xFF, rows * cols * sizeof(CVtCell));
        if (all) {
            fb.top = 0;
            MemSet(fb.back, 0, fb.stride * fb.h * (1 + fb.gpu));
        }
    } else if (scrolled) {
        fb.top = (fb.top + scrolled * FONT_CELL_H) % (rows * FONT_CELL_H);
        MemCpy(fb.drawn, fb.drawn + scrolled * cols, (rows - scrolled) * cols * sizeof(CVtCell));
        MemSet(fb.drawn + (rows - scrolled) * cols, 0xFF, scrolled * cols * sizeof(CVtCell));
    }
    if (all || scrolled >= rows || (scrolled && !hardware)) {
        for (y = 0; y < rows; y++) {
            fb.x0[y] = 0;
            fb.x1[y] = cols;
        }
    }

    // The cells that differ from what the back buffer shows.
    for (y = 0; y < rows; y++)
        if (fb.snap_row[y]) {
            fb.snap_row[y] = 0;
            p = fb.snap + y * cols;
            d = fb.drawn + y * cols;
            for (x = 0; x < cols; x += n) {
                n = 1;
                if (p[x].width == 2 && x + 1 < cols)
                    n = 2;
                if (!FbCellSame(&p[x], &d[x]) || (n == 2 && !FbCellSame(&p[x + 1], &d[x + 1]))) {
                    FbBackCell(x, y, &p[x], n);
                    MemCpy(&d[x], &p[x], n * sizeof(CVtCell));
                    FbSpan(y, x, x + n);
                }
            }
        }

    // The old cursor goes with its row's copy.
    if (fb.cur_w && !fb.gpu)
        FbSpan(fb.cur_y, fb.cur_x, fb.cur_x + fb.cur_w / FONT_CELL_W);
    if (all || (scrolled && !hardware && fb.cols * FONT_CELL_W == fb.w)) {
        FbCopyRect(0, 0, fb.w, fb.h);
        dy0 = 0;
        dy1 = fb.h;
    }
    for (y = 0; y < rows; y++) {
        if (fb.x0[y] < fb.x1[y]) {
            if (!all && !(scrolled && !hardware && fb.cols * FONT_CELL_W == fb.w))
                FbCopyRect(fb.x0[y] * FONT_CELL_W, y * FONT_CELL_H,
                           (fb.x1[y] - fb.x0[y]) * FONT_CELL_W, FONT_CELL_H);
            if (y * FONT_CELL_H < dy0) dy0 = y * FONT_CELL_H;
            if ((y + 1) * FONT_CELL_H > dy1) dy1 = (y + 1) * FONT_CELL_H;
        }
        fb.x0[y] = cols;
        fb.x1[y] = 0;
    }
    fb.cur_w = cw;
    if (!cw && fb.gpu) GpuCursorHide;
    if (cw) {
        fb.cur_x = cx;
        fb.cur_y = cy;
        FbCursorDraw(cx, cy, cw);
        if (cy * FONT_CELL_H < dy0) dy0 = cy * FONT_CELL_H;
        if ((cy + 1) * FONT_CELL_H > dy1) dy1 = (cy + 1) * FONT_CELL_H;
    }
    if (fb.scanout && fb.scan_top != fb.top) {
        ArchDsb;  // the newly exposed pixels must be visible before scanout moves
        ArchMmioWrite32(fb.scanout, fb.top);
        fb.scan_top = fb.top;
        dy0 = 0;
        dy1 = fb.h;
    }
    FbDamage(dy0, dy1);
}

I64 FbRenderLock()
{//Take the renderer, spinning; returns the DAIF for FbRenderUnlock.
    I64 daif = ArchDaif;
    ArchIrqOff;
    while (ArchXchg(&fb.render_lock, 1))
        while (fb.render_lock) {}
    return daif;
}

U0 FbRenderUnlock(I64 daif)
{
    fb.last_render = jiffies;
    ArchStoreRel(&fb.render_lock, 0);
    ArchIntRestore(daif);
}

U0 FbRender()
{//Draw a frame now, unless another core is drawing one.
    I64 daif;
    if (!fb.base)
        return;
    daif = ArchDaif;
    ArchIrqOff;
    if (!ArchXchg(&fb.render_lock, 1)) {
        FbRenderLocked;
        FbRenderUnlock(daif);
        return;
    }
    ArchIntRestore(daif);
}

U0 FbFlush()
{//Put everything written so far on the screen (before halting, powering off, ...).
    FbRender;
}

Bool FbCursorOff()
{//The program hides the cursor: it is probably partway through a redraw (CSI ?25l ... ?25h),
    //so frames wait for it to finish, and a redraw reaches the screen in one piece.
    return fb.vt->cursor_off || fb.cursor_hidden;
}

I64 FbFrameJiffies()
{//Frame interval while output streams.
    if (FbCursorOff)
        return FB_HIDDEN_JIFFIES;
    return FB_FRAME_JIFFIES;
}

I64 FbIdleJiffies()
{//How long output must pause before a frame.
    if (FbCursorOff)
        return FB_HIDDEN_IDLE;
    return FB_IDLE_JIFFIES;
}

U0 FbTick()
{//From the timer interrupt on core 0.
    if (!fb.base)
        return;
    fb.ticking = TRUE;
    if (fb.pending && (jiffies - fb.last_put >= FbIdleJiffies || jiffies - fb.last_render >= FbFrameJiffies))
        FbRender;
}

//---- the console

I64 FbNextJiffy()
{//When the renderer next wants the core-0 tick (IdleWait, Sched.cool); JIFFY_NEVER if not.
    I64 a, b;
    if (!fb.base || !fb.pending)
        return JIFFY_NEVER;
    a = fb.last_put + FbIdleJiffies;
    b = fb.last_render + FbFrameJiffies;
    if (b < a)
        return b;
    return a;
}

U0 FbPutC(U8 c)
{//Console output: into the grid; the renderer draws it later.
    CVTerm *v = fb.vt;
    I64 daif, me = ArchCpuNum + 1;
    Bool nested = v->lock && fb.put_owner == me, // an exception while this core was writing
            was_pending;
    if (!nested)
        daif = SpinLockIrq(&v->lock);
    fb.put_owner = me;
    VtPut(v, c);
    v->dirty = TRUE;
    was_pending = fb.pending;
    fb.pending = TRUE;
    fb.last_put = TimerJiffies;
    if (!nested) {
        fb.put_owner = 0;
        SpinUnlockIrq(&v->lock, daif);
    }
    if (!fb.ticking && c == '\n')
        FbRender;
    else if (me != 1 && !was_pending && cpu_structs[0].tickless)
        CoreKick(&cpu_structs[0]);  // the renderer's tick is on core 0
}

U0 FbFillRect(I64 x, I64 y, I64 w, I64 h, I64 color)
{//Paint a rectangle over the console (pixels, 0xRRGGBB). Text drawn before it is
    //rendered first; the cells under it are drawn again when their text changes.
    I64 daif;
    if (!fb.base)
        return;
    if (x < 0) {
        w += x;
        x = 0;
    }
    if (y < 0) {
        h += y;
        y = 0;
    }
    if (x + w > fb.w)
        w = fb.w - x;
    if (y + h > fb.h)
        h = fb.h - y;
    if (w <= 0 || h <= 0)
        return;
    daif = FbRenderLock;
    FbRenderLocked;
    if (fb.venus && venus_fill_hook) {
        U0 (*fill)(I64 rx, I64 ry, I64 rw, I64 rh, I64 rgb);
        fill = venus_fill_hook;
        (*fill)(x, y, w, h, color);
        FbRenderUnlock(daif);
        return;
    }
    FbBackFill(x, y, w, h, color);
    FbCopyRect(x, y, w, h);
    if (fb.cur_w && y < (fb.cur_y + 1) * FONT_CELL_H && y + h > fb.cur_y * FONT_CELL_H &&
            x < fb.cur_x * FONT_CELL_W + fb.cur_w && x + w > fb.cur_x * FONT_CELL_W) {
        fb.cur_w = 0;  // painted over
        if (fb.gpu) GpuCursorHide;
    }
    FbDamage(y, y + h);
    FbRenderUnlock(daif);
}

U0 ConsClear()
{
    CVTerm *v = fb.vt;
    I64 daif;
    if (!fb.base)
        return;
    daif = SpinLockIrq(&v->lock);
    VtClear(v);
    fb.redraw_all = TRUE;
    fb.pending = TRUE;
    SpinUnlockIrq(&v->lock, daif);
}

U0 FbSetColor(I64 fg, I64 bg)
{//The console's colors for what is printed next, in 0xRRGGBB.
    CVTerm *v = fb.vt;
    I64 daif;
    if (!fb.base)
        return;
    daif = SpinLockIrq(&v->lock);
    v->fg = ANSI_RGB_FLAG | (fg & 0xFFFFFF);
    v->bg = ANSI_RGB_FLAG | (bg & 0xFFFFFF);
    SpinUnlockIrq(&v->lock, daif);
}

// Direct console operations (the Warm standard library's screen functions,
// warmc/OSKernel.cool): the same grid changes as the escape
// sequences, without going through the byte stream.

U0 FbCursorHide()
{//Hide the cursor until FbCursorShow.
    CVTerm *v = fb.vt;
    I64 daif;
    if (!fb.base)
        return;
    daif = SpinLockIrq(&v->lock);
    fb.cursor_hidden = TRUE;
    fb.pending = TRUE;
    SpinUnlockIrq(&v->lock, daif);
}

U0 FbCursorShow()
{//Show the cursor again (unless a program turned it off with CSI ?25l).
    CVTerm *v = fb.vt;
    I64 daif;
    if (!fb.base)
        return;
    daif = SpinLockIrq(&v->lock);
    fb.cursor_hidden = FALSE;
    fb.pending = TRUE;
    SpinUnlockIrq(&v->lock, daif);
}

U0 FbScroll()
{//Scroll the console up one line; the cursor goes to the last row.
    CVTerm *v = fb.vt;
    I64 daif;
    if (!fb.base)
        return;
    daif = SpinLockIrq(&v->lock);
    VtScroll(v);
    fb.pending = TRUE;
    fb.last_put = jiffies;
    SpinUnlockIrq(&v->lock, daif);
}

U0 FbPutCp(I64 cp)
{//A code point at the console's cursor, as if it came in UTF-8.
    CVTerm *v = fb.vt;
    I64 daif;
    if (!fb.base)
        return;
    daif = SpinLockIrq(&v->lock);
    VtPutCp(v, cp);
    fb.pending = TRUE;
    fb.last_put = jiffies;
    SpinUnlockIrq(&v->lock, daif);
}

U0 FbAlt(Bool on)
{//The console's alternate screen on or off (CSI ?1049h/l).
    CVTerm *v = fb.vt;
    I64 daif;
    if (!fb.base)
        return;
    daif = SpinLockIrq(&v->lock);
    VtAlt(v, on);
    fb.pending = TRUE;
    fb.last_put = jiffies;
    SpinUnlockIrq(&v->lock, daif);
}

Bool FbInit()
{//Map the framebuffer and add it as a console output. FALSE if the FDT has none.
    I64 i, cells, n;
    U8 *g;
    fb.gpu = GpuInit(&fb.w, &fb.h);
    if (fb.gpu)
        fb.stride = fb.w * 4;
    else {
        if (!fdt_fb_32bpp || !fdt_fb.base) return FALSE;
        fb.w = fdt_fb_w; fb.h = fdt_fb_h; fb.stride = fdt_fb_stride;
    }
    fb.cols = fb.w / FONT_CELL_W;
    fb.rows = fb.h / FONT_CELL_H;
    if (fb.cols < 1 || fb.rows < 2 || fb.stride < fb.w * 4)
        return FALSE;
    n = fb.cols * fb.rows;
    fb.back = CAlloc(fb.stride * fb.h * (1 + fb.gpu));
    if (fb.gpu) {
        gpu.resource = GpuResource(fb.back, fb.w, fb.h * 2, 2);
        if (!gpu.resource) return FALSE;
    }
    fb.drawn = MAlloc(n * sizeof(CVtCell));
    fb.snap = MAlloc(n * sizeof(CVtCell));
    fb.snap_row = CAlloc(fb.rows);
    fb.x0 = MAlloc(fb.rows * sizeof(I64));
    fb.x1 = CAlloc(fb.rows * sizeof(I64));
    for (i = 0; i < fb.rows; i++)
        fb.x0[i] = fb.cols;
    for (i = 0; i < 256; i++)
        fb.palette[i] = FbColor256(i);
    for (i = 0; i < 128; i++)
        if ((g = FontGlyph(i, &cells)) && cells == 1)
            fb.ascii[i] = g;
    if (fdt_vm && fdt_finisher)
        fb.damage = fdt_finisher + FINISHER_FB_DAMAGE;
    // Whole-frame scanout rotates margins too: keep the software path when
    // dimensions leave partial cells, preserving those fixed pixel margins.
    if (!fb.gpu && fdt_vm && fdt_fb_scanout && fb.h == fb.rows * FONT_CELL_H && fb.w == fb.cols * FONT_CELL_W)
        fb.scanout = fdt_fb_scanout;
    fb.vt = vt_screen = VtAlloc(fb.cols, fb.rows);
    if (fb.gpu) fb.base = fb.back;
    else {
        FbMapNC(fdt_fb.base, fb.stride * fb.h);
        fb.base = fdt_fb.base;
    }
    fb.redraw_all = TRUE;
    FbRender;  // clears the screen and draws the cursor
    ConsAdd(&FbPutC);
    return TRUE;
}

Bool FbResizeCells(I64 w, I64 h)
{//Vulkan resize: new cell snapshots; the app replaces its size-dependent resources.
    CVtCell *drawn, *snap;
    U8 *snap_row;
    I64 *x0, *x1, daif, cols = w / FONT_CELL_W, rows = h / FONT_CELL_H, i;
    drawn = MAlloc(cols * rows * sizeof(CVtCell)); snap = MAlloc(cols * rows * sizeof(CVtCell));
    snap_row = CAlloc(rows); x0 = MAlloc(rows * sizeof(I64)); x1 = CAlloc(rows * sizeof(I64));
    if (!drawn || !snap || !snap_row || !x0 || !x1) {
        Free(drawn); Free(snap); Free(snap_row); Free(x0); Free(x1);
        return FALSE;
    }
    daif = FbRenderLock;
    Free(fb.drawn); Free(fb.snap); Free(fb.snap_row); Free(fb.x0); Free(fb.x1);
    fb.w = w; fb.h = h; fb.stride = w * 4; fb.cols = cols; fb.rows = rows;
    fb.drawn = drawn; fb.snap = snap; fb.snap_row = snap_row; fb.x0 = x0; fb.x1 = x1;
    for (i = 0; i < rows; i++) fb.x0[i] = cols;
    VtResize(fb.vt, cols, rows);
    fb.redraw_all = TRUE; fb.pending = TRUE;
    FbRenderLocked;  // the Vulkan app gets the new size and every row
    FbRenderUnlock(daif);
    return TRUE;
}

Bool FbResize(I64 w, I64 h)
{//Prepare a replacement, then switch the grid and renderer under its lock.
    CFb next;
    I64 daif, n, i, id, old_id;
    U8 *old_back;
    if (!fb.gpu || (w == fb.w && h == fb.h)) return FALSE;
    if (fb.venus)
        return FbResizeCells(w, h);
    MemSet(&next, 0, sizeof(CFb));
    next.w = w; next.h = h; next.stride = w * 4;
    next.cols = w / FONT_CELL_W; next.rows = h / FONT_CELL_H;
    n = next.cols * next.rows;
    next.back = CAlloc(next.stride * h * 2);
    next.drawn = MAlloc(n * sizeof(CVtCell)); next.snap = MAlloc(n * sizeof(CVtCell));
    next.snap_row = CAlloc(next.rows); next.x0 = MAlloc(next.rows * sizeof(I64)); next.x1 = CAlloc(next.rows * sizeof(I64));
    if (!next.back || !next.drawn || !next.snap || !next.snap_row || !next.x0 || !next.x1) goto fb_resize_fail;
    id = GpuResource(next.back, w, h * 2, 2);
    if (!id) goto fb_resize_fail;
    daif = FbRenderLock;
    GpuCursorHide;
    old_back = fb.back; old_id = gpu.resource;
    Free(fb.drawn); Free(fb.snap); Free(fb.snap_row); Free(fb.x0); Free(fb.x1);
    fb.w = w; fb.h = h; fb.stride = next.stride; fb.cols = next.cols; fb.rows = next.rows;
    fb.back = fb.base = next.back; fb.drawn = next.drawn; fb.snap = next.snap;
    fb.snap_row = next.snap_row; fb.x0 = next.x0; fb.x1 = next.x1;
    for (i = 0; i < fb.rows; i++) fb.x0[i] = fb.cols;
    fb.top = 0; fb.cur_w = 0; gpu.resource = id;
    VtResize(fb.vt, fb.cols, fb.rows);
    fb.redraw_all = TRUE; fb.pending = TRUE;
    FbRenderLocked; // transfer/select the replacement before releasing old backing
    GpuUnref(old_id);
    Free(old_back);
    FbRenderUnlock(daif);
    return TRUE;
fb_resize_fail:
    Free(next.back); Free(next.drawn); Free(next.snap); Free(next.snap_row); Free(next.x0); Free(next.x1);
    return FALSE;
}

U0 FbDisplayTask(U8 *data)
{//Mode changes allocate in task context, not the rendering timer interrupt.
    I64 w, h;
    CVirtBlk *d = &gpu.q[0];
    no_warn data;
    while (gpu.active) {
        Sleep(50);
        if (VioRd(d, VIO_CONFIG) & 1) {
            // Clear first: changes during GET_DISPLAY_INFO remain pending.
            VioWr(d, VIO_CONFIG + 4, 1); VioWr(d, VIO_ISR_ACK, 2);
            if (GpuDisplayInfo(&w, &h)) FbResize(w, h);
        }
    }
}
