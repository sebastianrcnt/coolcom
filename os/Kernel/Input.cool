// Input: keyboard and mouse events from the VM-only input FIFO
// (coolcom,coolvm-input, not present on a real M1; USB HID will replace it).
//
// FIFO protocol (tools/coolvm/README.md): a read of INPUT+0 gives the number of
// complete records; three reads of INPUT+4 return type, code, value of the
// oldest and pop it. The IRQ stays asserted while records remain. Records use
// Linux input numbers. Key presses become key events (Key.cool), the same ones the
// UART terminal produces; modifier and lock keys alone produce none.
#define EV_SYN     0
#define EV_KEY     1
#define EV_REL     2
#define EV_ABS     3  // coolvm's window: ABS_X/ABS_Y 0..32767 across the screen
#define ABS_X      0
#define ABS_Y      1
#define REL_X      0
#define REL_Y      1
#define REL_WHEEL  8
#define BTN_LEFT   0x110
#define BTN_RIGHT  0x111
#define BTN_MIDDLE 0x112

// Linux key codes.
#define LK_ESC        1
#define LK_BACKSPACE  14
#define LK_TAB        15
#define LK_ENTER      28
#define LK_LEFTCTRL   29
#define LK_LEFTSHIFT  42
#define LK_RIGHTSHIFT 54
#define LK_C          46
#define LK_LEFTALT    56
#define LK_CAPSLOCK   58
#define LK_F1         59
#define LK_F10        68
#define LK_F11        87
#define LK_F12        88
#define LK_KPENTER    96
#define LK_RIGHTCTRL  97
#define LK_KPSLASH    98
#define LK_RIGHTALT   100
#define LK_HANGEUL    122

I64 kbd_caps;
U8 kbd_down[256], kbd_norm[128], kbd_shift[128];

class CMouse {I64 mx, my, wheel, buttons;};  // x, y: pixels (clamped to the screen when there is one)

CMouse mouse;
U8 *gui_mouse_hook; // U0 (*)(I64 x, I64 y, I64 buttons, I64 wheel), interrupt-safe

U0 KbdMapRow(I64 code, U8 *lo, U8 *up)
{
    while (*lo) {
        kbd_norm[code] = *lo++;
        kbd_shift[code++] = *up++;
    }
}

U0 KbdMapInit()
{//US layout for Linux key codes 1..57.
    KbdMapRow(2, "1234567890-=", "!@#!%^&*()_+");
    KbdMapRow(16, "qwertyuiop[]", "QWERTYUIOP{}");
    KbdMapRow(30, "asdfghjkl;'", "ASDFGHJKL:'");
    KbdMapRow(44, "zxcvbnm,./", "ZXCVBNM<>?");
    kbd_shift[5] = 36;   // dollar sign
    kbd_shift[40] = 34;  // double quote
    kbd_norm[41] = 96;   // backtick
    kbd_shift[41] = 126; // tilde
    kbd_norm[43] = 92;   // backslash
    kbd_shift[43] = '|';
    kbd_norm[LK_ESC] = kbd_shift[LK_ESC] = KEY_ESC;
    kbd_norm[LK_BACKSPACE] = kbd_shift[LK_BACKSPACE] = KEY_BACKSPACE;
    kbd_norm[LK_TAB] = kbd_shift[LK_TAB] = KEY_TAB;
    kbd_norm[LK_ENTER] = kbd_shift[LK_ENTER] = KEY_ENTER;
    kbd_norm[57] = kbd_shift[57] = ' ';
}

I64 KbdSpecial(I64 code)
{//Key code of a Linux key without a character (0 if none).
    if (code >= LK_F1 && code <= LK_F10)
        return KEY_F1 + code - LK_F1;
    switch (code) {
        case LK_F11: return KEY_F1 + 10;
        case LK_F12: return KEY_F1 + 11;
        case 102: return KEY_HOME;
        case 103: return KEY_UP;
        case 104: return KEY_PGUP;
        case 105: return KEY_LEFT;
        case 106: return KEY_RIGHT;
        case 107: return KEY_END;
        case 108: return KEY_DOWN;
        case 109: return KEY_PGDN;
        case 110: return KEY_INS;
        case 111: return KEY_DEL;
    }
    return 0;
}

Bool ImeHotkey(I64 code, I64 value)
{//Shift+Space, the Hangul key, or Right Alt pressed and released alone toggle Hangul input
    //(Ime.cool). TRUE if the key was used up.
    Bool shift = kbd_down[LK_LEFTSHIFT] || kbd_down[LK_RIGHTSHIFT];
    Bool ctrl = kbd_down[LK_LEFTCTRL] || kbd_down[LK_RIGHTCTRL];
    if (code == LK_RIGHTALT) {
        if (value == 1)
            ime_alt_clean = TRUE;
        else if (!value && ime_alt_clean) {
            ime_alt_clean = FALSE;
            Ime(!ime_on);
        }
        return FALSE;
    }
    if (value)
        ime_alt_clean = FALSE;  // another key: Right Alt was a modifier
    if (code == LK_HANGEUL && value) {
        if (value == 1)
            Ime(!ime_on);
        return TRUE;
    }
    if (code == 57 && shift && !ctrl && value) {
        if (value == 1)
            Ime(!ime_on);
        return TRUE;
    }
    return FALSE;
}

U0 KbdKey(I64 code, I64 value)
{//A key changed (value 0 up, 1 down, 2 repeat).
    I64 k = 0, f = 0, jamo;
    Bool shift, letter;
    if (code < 0 || code > 255)
        return;
    if (ImeHotkey(code, value))
        return;
    if (!value) {
        kbd_down[code] = FALSE;
        return;
    }
    if (value == 1) {
        kbd_down[code] = TRUE;
        if (code == LK_CAPSLOCK)
            kbd_caps = !kbd_caps;
    }
    shift = kbd_down[LK_LEFTSHIFT] || kbd_down[LK_RIGHTSHIFT];
    if (kbd_down[LK_LEFTCTRL] || kbd_down[LK_RIGHTCTRL])
        f |= KF_CTRL;
    if (kbd_down[LK_LEFTALT] || kbd_down[LK_RIGHTALT])
        f |= KF_ALT;
    if (code == LK_C && value == 1 && (f & KF_CTRL) && (f & KF_ALT)) {
        break_req = TRUE;  // TempleOS Ctrl+Alt+C: acted on in KExcept, which has the frame
        return;
    }
    if (ime_on && !(f & (KF_CTRL | KF_ALT))) {
        // Hangul input: the letter keys type jamo (the caps lock state does not matter)
        if (code < 128 && kbd_norm[code] >= 'a' && kbd_norm[code] <= 'z' && (jamo = ImeJamo(kbd_norm[code], shift))) {
            ImeType(jamo);
            return;
        }
        if (code == LK_BACKSPACE && ImeComposing) {
            ImeBackspace;
            return;
        }
    }
    if (code == LK_KPENTER)
        k = KEY_ENTER;
    else if (code == LK_KPSLASH)
        k = '/';
    else if (code < 128 && kbd_norm[code]) {
        if (shift)
            k = kbd_shift[code];
        else
            k = kbd_norm[code];
        letter = (k >= 'a' && k <= 'z') || (k >= 'A' && k <= 'Z');
        if (letter && kbd_caps)
            k ^= 0x20;
        if (letter && (f & KF_CTRL))
            k |= 0x20;  // Ctrl+letter is the lowercase letter, as from a terminal
        if (k == KEY_TAB && shift)
            f |= KF_SHIFT;
    } else {
        k = KbdSpecial(code);
        if (shift)
            f |= KF_SHIFT;
    }
    if (k == KEY_ESC || k == KEY_ENTER || k == KEY_BACKSPACE)
        f &= ~KF_CTRL;  // a terminal cannot send these with Ctrl
    if (k) {
        if (ImeComposing)
            ImeEnd;  // any other key ends the syllable being composed
        KeyPush(k | f);
    }
}

U0 MouseEvent(I64 type, I64 code, I64 value)
{
    I64 bit = 0;
    if (type == EV_REL) {
        if (code == REL_X)
            mouse.mx += value;
        else if (code == REL_Y)
            mouse.my += value;
        else if (code == REL_WHEEL)
            mouse.wheel += value;
        if (fb.base) {
            if (mouse.mx < 0) mouse.mx = 0;
            if (mouse.my < 0) mouse.my = 0;
            if (mouse.mx >= fb.w) mouse.mx = fb.w - 1;
            if (mouse.my >= fb.h) mouse.my = fb.h - 1;
        }
    } else if (type == EV_ABS) {
        if (fb.base && code == ABS_X)
            mouse.mx = ClampI64(value, 0, 32767) * (fb.w - 1) / 32767;
        else if (fb.base && code == ABS_Y)
            mouse.my = ClampI64(value, 0, 32767) * (fb.h - 1) / 32767;
    } else {
        if (code == BTN_LEFT) bit = 1;
        if (code == BTN_RIGHT) bit = 2;
        if (code == BTN_MIDDLE) bit = 4;
        if (value)
            mouse.buttons |= bit;
        else
            mouse.buttons &= ~bit;
    }
    U0 (*route)(I64, I64, I64, I64); route = gui_mouse_hook;
    if (route) (*route)(mouse.mx, mouse.my, mouse.buttons, mouse.wheel);
}

U0 InputIrq(I64 irq)
{//Drain the FIFO into the key events and mouse state.
    I64 type, code, value;
    while (ArchMmioRead32(fdt_input.base) > 0) {
        type = ArchMmioRead32(fdt_input.base + 4);
        code = ArchMmioRead32(fdt_input.base + 4);
        value = (ArchMmioRead32(fdt_input.base + 4) << 32) >> 32;  // sign-extend
        if (type == EV_KEY && code >= BTN_LEFT && code <= BTN_MIDDLE)
            MouseEvent(type, code, value);
        else if (type == EV_KEY)
            KbdKey(code, value);
        else if (type == EV_REL || type == EV_ABS)
            MouseEvent(type, code, value);
    }
}

Bool InputInit()
{//FALSE if the FDT has no input device.
    if (!fdt_input.base)
        return FALSE;
    KbdMapInit;
    if (fb.base) {
        mouse.mx = fb.w / 2;
        mouse.my = fb.h / 2;
    }
    IrqSet(fdt_input.irq, &InputIrq);
    return TRUE;
}
