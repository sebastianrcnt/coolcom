// Logos: the console's cell grid drawn by the GPU (docs/logos.md). Under coolvm the
// virtio-gpu offers the Logos commands (GPU_F_LOGOS); then Fb.cool's renderer hands its
// frame here instead of drawing pixels: the rows whose cells changed go to the device as
// cells (glyph, colors, attributes), a full-screen scroll is one command, and the device
// renders the grid with its own glyph atlas (coolvm: Metal). Glyphs are still rasterized
// here, from the same font as the CPU renderer (Unifont now), and uploaded once each.
// Without Logos (QEMU, a real M1, coolvm --no-logos) Fb.cool draws pixels as before.
//
// Every command names a target; 0 is the screen. Windows and layers will be other targets.
#define LOGOS_VERSION 1  // in GRID; a later version adds command numbers
#define LOGOS_GRID    0x4000
#define LOGOS_GLYPH   0x4001
#define LOGOS_ROWS    0x4002
#define LOGOS_SCROLL  0x4003
#define LOGOS_CURSOR  0x4004
#define LOGOS_FILL    0x4005
#define LOGOS_PRESENT 0x4006
#define LOGOS_BOLD      1
#define LOGOS_REVERSE   2
#define LOGOS_UNDERLINE 4
#define LOGOS_RIGHT     8  // the right half of a two-cell glyph
#define LOGOS_TARGET_SCREEN 0

class CLogosCell
{// As the device reads it: 16 bytes.
    U32 glyph, fg, bg, flags;
};

class CLogos
{
    CLogosCell *cells;        // the rows being sent: fb.rows * fb.cols
    I64 capacity;             // cells allocated
    U8 *have, *wide, *bad;    // per code point: glyph uploaded, two cells wide; no glyph
    I64 cur_col, cur_row, cur_cells;  // the cursor the device shows
};

CLogos logos;

Bool LogosCmd(I64 type, U32 *data, I64 words)
{
    return GpuCommand(0, type, data, words);
}

Bool LogosGrid(I64 w, I64 h, I64 cols, I64 rows)
{//(Re)start the screen target: w x h pixels, cols x rows cells. Also clears it. Allocates
    //only when the grid grows (not while a frame is drawn at the same size).
    U32 p[8];
    CLogosCell *cells = logos.cells;
    if (!cells || cols * rows > logos.capacity) {
        cells = CAlloc(cols * rows * sizeof(CLogosCell));
        if (!cells)
            return FALSE;
    }
    p[0] = LOGOS_TARGET_SCREEN; p[1] = LOGOS_VERSION; p[2] = w; p[3] = h; p[4] = cols; p[5] = rows;
    p[6] = FONT_CELL_W; p[7] = FONT_CELL_H;
    if (!LogosCmd(LOGOS_GRID, p, 8)) {
        if (cells != logos.cells)
            Free(cells);
        return FALSE;
    }
    if (cells != logos.cells) {
        Free(logos.cells);
        logos.cells = cells;
        logos.capacity = cols * rows;
    }
    logos.cur_cells = 0;
    return TRUE;
}

Bool LogosInit(I64 w, I64 h, I64 cols, I64 rows)
{
    if (!gpu.logos)
        return FALSE;
    if (!logos.have) {
        logos.have = CAlloc(0x110000 / 8);
        logos.wide = CAlloc(0x110000 / 8);
        logos.bad = CAlloc(0x110000 / 8);
    }
    return LogosGrid(w, h, cols, rows);
}

extern U8 *FbGlyph(I64 cp, I64 *_cells);

I64 LogosGlyph(I64 cp, I64 cells)
{//The glyph id of cp drawn over cells cells (uploading it the first time); 0 if the font
    //has no such glyph.
    U8 *g;
    U32 p[2 + 2 * FONT_CELL_W * FONT_CELL_H / 4];
    U8 *px = &p[2];
    I64 gc, x, y, bits, w;
    if (cp < 0 || cp >= 0x110000 || Bt(logos.bad, cp))
        return 0;
    if (Bt(logos.have, cp)) {
        if (Bt(logos.wide, cp) != (cells == 2))  // not cells wide: '?', as FbBackGlyph does
            return 0;
        return cp + 1;
    }
    g = FbGlyph(cp, &gc);
    if (!g) {
        Bts(logos.bad, cp);
        return 0;
    }
    if (gc != cells)
        return 0;
    w = cells * FONT_CELL_W;
    for (y = 0; y < FONT_CELL_H; y++) {
        if (cells == 2) {
            bits = (g[0] << 8) | g[1];
            g += 2;
        } else
            bits = *g++;
        for (x = 0; x < w; x++)
            px[y * w + x] = ((bits >> (w - 1 - x)) & 1) * 255;
    }
    p[0] = cp + 1;
    p[1] = cells;
    if (!LogosCmd(LOGOS_GLYPH, p, 2 + w * FONT_CELL_H / 4)) {
        Bts(logos.bad, cp);
        return 0;
    }
    Bts(logos.have, cp);
    if (cells == 2)
        Bts(logos.wide, cp);
    return cp + 1;
}

U0 LogosCell(CLogosCell *d, CVtCell *c, I64 glyph, I64 flags)
{
    d->glyph = glyph;
    d->fg = FbRgb(c->fg);
    d->bg = FbRgb(c->bg);
    d->flags = flags;
    if (c->attr & VT_ATTR_REVERSE)
        d->flags |= LOGOS_REVERSE;
    if (c->attr & VT_ATTR_BOLD)
        d->flags |= LOGOS_BOLD;
}

U0 LogosRow(CVtCell *p, CLogosCell *d, I64 cols)
{//One grid row as device cells, drawn as the CPU renderer would (FbBackCell).
    I64 x, g, q = LogosGlyph('?', 1);
    for (x = 0; x < cols; x++) {
        if (p[x].width == 2 && x + 1 < cols) {
            if ((g = LogosGlyph(p[x].cp, 2))) {
                LogosCell(&d[x], &p[x], g, 0);
                LogosCell(&d[x + 1], &p[x], g, LOGOS_RIGHT);
            } else {
                LogosCell(&d[x], &p[x], q, 0);
                LogosCell(&d[x + 1], &p[x], q, 0);
            }
            x++;
        } else if (!p[x].width || p[x].cp == ' ')  // blank, or the right half of a wide glyph that is gone
            LogosCell(&d[x], &p[x], 0, 0);
        else {
            if (!(g = LogosGlyph(p[x].cp, 1)))
                g = q;
            LogosCell(&d[x], &p[x], g, 0);
        }
    }
}

U0 LogosSend(I64 row, I64 count)
{
    U32 p[6];
    I64 addr = logos.cells + row * fb.cols;
    if (count <= 0)
        return;
    p[0] = LOGOS_TARGET_SCREEN; p[1] = row; p[2] = count; p[3] = 0;
    p[4] = addr & 0xFFFFFFFF; p[5] = addr >> 32;
    LogosCmd(LOGOS_ROWS, p, 6);
}

Bool LogosRowSame(I64 *a, I64 *b, I64 cols)
{//Two rows of cells alike (as FbCellSame: 16 bytes are two I64s; MemCmp goes bytewise).
    I64 i;
    for (i = 0; i < 2 * cols; i++)
        if (a[i] != b[i])
            return FALSE;
    return TRUE;
}

U0 LogosFrame(Bool all, I64 scrolled, I64 cx, I64 cy, I64 cells)
{//Fb.cool's frame (the rows taken from the grid are in fb.snap / fb.snap_row), for the
    //device. all: everything again; scrolled: full-screen scrolls; cells: cursor width (0: none).
    U32 p[4];
    I64 cols = fb.cols, rows = fb.rows, y, run = -1;
    Bool sent = FALSE, changed;
    CVtCell *s, *d;
    if (all) {  // a fresh target: also forgets rectangles painted over the cells
        LogosGrid(fb.w, fb.h, cols, rows);
        sent = TRUE;
    }
    if (all || scrolled >= rows)
        MemSet(fb.drawn, 0xFF, rows * cols * sizeof(CVtCell));
    else if (scrolled) {
        p[0] = LOGOS_TARGET_SCREEN; p[1] = scrolled;
        LogosCmd(LOGOS_SCROLL, p, 2);
        MemCpy(fb.drawn, fb.drawn + scrolled * cols, (rows - scrolled) * cols * sizeof(CVtCell));
        MemSet(fb.drawn + (rows - scrolled) * cols, 0xFF, scrolled * cols * sizeof(CVtCell));
        sent = TRUE;
    }
    for (y = 0; y <= rows; y++) {
        changed = FALSE;
        if (y < rows && fb.snap_row[y]) {
            fb.snap_row[y] = 0;
            s = fb.snap + y * cols;
            d = fb.drawn + y * cols;
            if (!LogosRowSame(s, d, cols)) {
                MemCpy(d, s, cols * sizeof(CVtCell));
                LogosRow(s, logos.cells + y * cols, cols);
                if (run < 0) run = y;
                changed = TRUE;
            }
        }
        if (!changed && run >= 0) {  // one command for each run of changed rows
            LogosSend(run, y - run);
            run = -1;
            sent = TRUE;
        }
    }
    if (cx != logos.cur_col || cy != logos.cur_row || cells != logos.cur_cells) {
        p[0] = LOGOS_TARGET_SCREEN; p[1] = cx; p[2] = cy; p[3] = cells;
        LogosCmd(LOGOS_CURSOR, p, 4);
        logos.cur_col = cx; logos.cur_row = cy; logos.cur_cells = cells;
        sent = TRUE;
    }
    if (sent) {
        p[0] = LOGOS_TARGET_SCREEN;
        LogosCmd(LOGOS_PRESENT, p, 1);
    }
}

U0 LogosFill(I64 x, I64 y, I64 w, I64 h, I64 rgb)
{//A rectangle painted over the cells (FbFillRect), until those cells are sent again.
    U32 p[6];
    p[0] = LOGOS_TARGET_SCREEN; p[1] = x; p[2] = y; p[3] = w; p[4] = h; p[5] = rgb & 0xFFFFFF;
    LogosCmd(LOGOS_FILL, p, 6);
    p[0] = LOGOS_TARGET_SCREEN;
    LogosCmd(LOGOS_PRESENT, p, 1);
}
