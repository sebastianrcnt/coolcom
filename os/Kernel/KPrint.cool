// Output: PutS, what TempleOS's Print() (coolc/Runtime/StrPrint.cool) ends in.
// One core prints at a time so lines don't interleave.

I64 print_lock, print_owner;  // print_owner: core number + 1 while printing

extern Bool IsSilent();

U0 PutS(U8 *s)
{
    I64 daif;
    if (!s || IsSilent)
        return;
    daif = SpinLockIrq(&print_lock);
    print_owner = ArchCpuNum + 1;
    ConsPutS(s);
    print_owner = 0;
    SpinUnlockIrq(&print_lock, daif);
}

U8 raw_print_buf[512];
I64 raw_print_lock;

U0 RawPrint(U8 *fmt, ...)
{//Print() without the heap, for the heap itself and exception handlers.
    //Short messages only (StrPrintJoin into a 512-byte buffer).
    I64 daif = SpinLockIrq(&raw_print_lock);
    StrPrintJoin(raw_print_buf, fmt, argc, argv);
    PutS(raw_print_buf);
    SpinUnlockIrq(&raw_print_lock, daif);
}

U0 PrintBreakLock()
{//An exception inside PutS on this core: take the lock back so the handler can print.
    if (print_lock && print_owner == ArchCpuNum + 1) {
        print_owner = 0;
        print_lock = 0;
    }
}
