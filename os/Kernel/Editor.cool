// Narrow editor boundary: opaque syntax state and copied symbol locations.
// No kernel-owned structure is exposed to Warm.
Bool EditorSrcBrace(U8 *p, I64 n) {I64 i; for (i = 0; i < n; i++) if (p[i] == '{') return TRUE; return FALSE;}
CHashSrcSym *EditorSrcHash(U8 *name)
{
    CHashSrcSym *h;
    if (!ShellCur || !ShellCur->hash) return NULL;
    h = HashFind(name, ShellCur->hash, HTT_FUN | HTT_CLASS | HTT_INTERNAL_TYPE | HTT_GLBL_VAR | HTT_DEFINE_STR);
    if (!h) h = HashFind(name, ShellCur->hash, HTT_EXPORT_SYS_SYM);
    return h;
}

I64 EditorSrcKind(CHashSrcSym *h)
{
    if (h->type & HTT_FUN) return 1;
    if (h->type & (HTT_CLASS | HTT_INTERNAL_TYPE)) return 2;
    if (h->type & HTT_GLBL_VAR) return 3;
    if (h->type & HTT_DEFINE_STR) return 4;
    return 0;
}

Bool EditorSrcSrcLink(CHashSrcSym *h, U8 *file, I64 *_line)
{//"FL:C:/WarmPrograms.cool,20" -> file (at least 200 bytes) and line, if it is a real file.
    U8 *s = h->src_link, *comma = NULL;
    if (!s || StrNCmp(s, "FL:", 3)) return FALSE;
    s += 3;
    while (*s) {
        if (*s == ',') comma = s;
        s++;
    }
    if (!comma || comma - h->src_link - 3 > 190) return FALSE;
    MemCpy(file, h->src_link + 3, comma - h->src_link - 3);
    file[comma - h->src_link - 3] = 0;
    *_line = Str2I64(comma + 1);
    return FileFind(file);
}

Bool EditorSrcIsId(I64 c)
{
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '@';
}

Bool EditorSrcDefLine(U8 *p, I64 n, U8 *name, I64 nl, I64 kind)
{//Is p[0..n) the definition of name (of that kind; 0: any)?
    I64 i, j, c;
    if (n < nl + 1 || p[0] == ' ' || p[0] == '\t' || p[0] == '/' || p[0] == '{' || p[0] == '}' || p[0] == '\r')
        return FALSE;
    if (p[0] == '#') {
        if ((kind && kind != 4) || n < 8 || StrNCmp(p, "#define", 7)) return FALSE;
        for (i = 7; i < n && (p[i] == ' ' || p[i] == '\t'); i++);
        return i + nl <= n && !MemCmp(p + i, name, nl) && (i + nl == n || !EditorSrcIsId(p[i + nl]));
    }
    if (!StrNCmp(p, "extern ", 7) || !StrNCmp(p, "public extern ", 14) || !StrNCmp(p, "import ", 7) ||
            !StrNCmp(p, "_extern ", 8) || !StrNCmp(p, "_import ", 8))
        return FALSE;
    // Assembly: a label at the start of the line, or the symbol after .global.
    if (!MemCmp(p, name, nl) && p[nl] == ':' && (!kind || kind == 1)) return TRUE;
    if (!kind || kind == 2) {
        i = 0;
        if (!StrNCmp(p, "public ", 7)) i = 7;
        if (!StrNCmp(p + i, "class ", 6) || !StrNCmp(p + i, "union ", 6)) {
            i += 6;
            while (i < n && p[i] == ' ') i++;
            if (i + nl <= n && !MemCmp(p + i, name, nl) && (i + nl == n || !EditorSrcIsId(p[i + nl]))) return TRUE;
        }
        if (kind == 2) return FALSE;
    }
    if (kind == 4) return FALSE;
    for (i = 1; i + nl <= n; i++) {
        c = p[i - 1];
        if ((c == ' ' || c == '*' || c == '\t') && !MemCmp(p + i, name, nl) && (i + nl == n || !EditorSrcIsId(p[i + nl]))) {
            for (j = 0; j < i; j++)
                if (p[j] == '(' || p[j] == '=' || p[j] == '"' || p[j] == ',') return FALSE;
            j = i + nl;
            while (j < n && p[j] == ' ') j++;
            if (kind == 1 || !kind) {
                if (j < n && p[j] == '(') {
                    j = n;
                    while (j > i && (p[j - 1] == ' ' || p[j - 1] == '\r')) j--;
                    if (p[j - 1] != ';' || EditorSrcBrace(p, n)) return TRUE;
                    return FALSE;
                }
            }
            if (kind == 3 || !kind) {
                if (j >= n || p[j] == ';' || p[j] == '=' || p[j] == '[' || p[j] == ',' || p[j] == '\r') return TRUE;
            }
            return FALSE;
        }
    }
    return FALSE;
}

// Search the kernel sources for the definition. Returns the number of places found;
// the first is in file (>= 200 bytes) and *_line.
I64 EditorSrcSearch(U8 *name, I64 kind, U8 *file, I64 *_line)
{
    CDirEntry *list, *de;
    U8 *buf, *p, *q, *end;
    I64 size, line, nl = StrLen(name), found = 0, r;
    for (r = 0; r < 2; r++) {
        if (r) list = FilesFind("C:/Cool/*", FUF_RECURSE | FUF_JUST_FILES | FUF_FLATTEN_TREE);
        else list = FilesFind("C:/Kernel/*", FUF_RECURSE | FUF_JUST_FILES | FUF_FLATTEN_TREE);
        for (de = list; de; de = de->next) {
            buf = FileRead(de->full_name, &size);
            if (size <= 0) {Free(buf); goto man_next;}
            end = buf + size;
            line = 1;
            for (p = buf; p < end; p = q + 1) {
                q = p;
                while (q < end && *q != '\n') q++;
                if (EditorSrcDefLine(p, q - p, name, nl, kind)) {
                    if (!found) {
                        StrCpy(file, de->full_name);
                        *_line = line;
                    }
                    found++;
                }
                line++;
            }
            Free(buf);
man_next:
        }
        DirTreeDel(list);
    }
    return found;
}

I64 EditorDefinition(U8 *name, U8 *file, I64 *line)
{
    CHashSrcSym *h = EditorSrcHash(name);
    I64 kind;
    if (!h) return FALSE;
    kind = EditorSrcKind(h);
    if (EditorSrcSrcLink(h, file, line)) return TRUE;
    if (EditorSrcSearch(name, kind, file, line)) return TRUE;
    if (kind && EditorSrcSearch(name, 0, file, line)) return TRUE;
    return FALSE;
}
I64 EditorSynNew() {return CAlloc(sizeof(CSyn))(I64);}
U0 EditorSynFree(I64 handle) {Free(handle(U8 *));}
U0 EditorSynStart(I64 handle, I64 lang, I64 fast) {SynStart(handle(CSyn *), lang, fast);}
U0 EditorSynLine(I64 handle, U8 *text, I64 n, U8 *groups) {SynLine(handle(CSyn *), text, n, groups);}
U0 EditorSynCopy(I64 into, I64 from) {MemCpy(into(U8 *), from(U8 *), sizeof(CSyn));}
U0 EditorSynFast(I64 handle, I64 fast) {CSyn *st = handle(CSyn *); st->fast = fast;}
U0 EditorSetColor(I64 group, I64 color) {if (group >= 0 && group < SYN_G_COUNT) syn_color[group] = color;}
I64 EditorIme() {return ime_on;}
I64 EditorFileSize(U8 *name) {CDirEntry de; de.full_name = NULL; if (!FileFind(name, &de)) return -1; Free(de.full_name); return de.size;}
U0 EditorFormat(U8 *into, U8 *format, I64 a, I64 b, I64 c, I64 d) {StrPrint(into, format, a, b, c, d);}
U0 EditorPrint(U8 *format, I64 a) {Print(format, a);}
