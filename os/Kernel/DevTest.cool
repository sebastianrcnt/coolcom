// Device tests, run by KMain when booted with coolcom.test=1 under coolvm.
// tools/kernel-test.sh supplies a 64 KiB disk (128 sectors, sector s byte j =
// s*31 + j*7 mod 256), a FAT32 disk, a scripted input queue (mouse +5,-3,
// wheel +2, left button, then the keys h x BACKSPACE i SHIFT+a ENTER, then
// sixteen shell lines) and a 640x480 framebuffer, and afterwards checks the
// disk files, the screenshot and that the shell printed 49.

U8 dt_line[64];

U0 DevTestBlk()
{
    U8 *a = MAlloc(2048), *b = MAlloc(2048);
    I64 i, j, f0 = kt_fails;
    Print("blk: %d device(s), dev0 %d sectors\n", BlkCount, BlkSectors(0));
    if (BlkCount < 1 || BlkSectors(0) != 128) {
        KTFail("blk device missing or wrong size");
        goto blk_done;
    }
    if (BlkRead(0, 5, 2, a)) {
        KTFail("BlkRead");
        goto blk_done;
    }
    for (j = 0; j < 1024; j++)
        if (a[j] != ((5 + j / 512) * 31 + (j % 512) * 7) & 0xFF) {
            KTFail("blk read contents");
            break;
        }
    if (BlkRead(0, 127, 2, a) >= 0 || BlkRead(0, -1, 1, a) >= 0 || BlkRead(3, 0, 1, a) >= 0)
        KTFail("blk range checks");
    for (j = 0; j < 1024; j++)
        a[j] = j * 3 + 17;
    if (BlkWrite(0, 9, 2, a) || BlkFlush(0))
        KTFail("BlkWrite/BlkFlush");
    MemSet(b, 0, 1024);
    if (BlkRead(0, 9, 2, b) || MemCmp(a, b, 1024))
        KTFail("blk write readback");
    for (i = 0; i < 20; i++)  // many requests reuse the ring
        if (BlkRead(0, i, 1, b)) {
            KTFail("blk ring reuse");
            break;
        }
blk_done:
    Free(a);
    Free(b);
    if (kt_fails == f0)
        Print("  blk: PASS\n");
}

U8 *DevTestFsData(I64 n, I64 seed)
{//Printable test file contents; tools/kernel-verify.py makes the same.
    U8 *s = MAlloc(n);
    I64 j;
    for (j = 0; j < n; j++)
        if (j % 64 == 63)
            s[j] = '\n';
        else
            s[j] = 'A' + (j * 7 + seed) % 26;
    return s;
}

U0 DevTestFatNames()
{
    U8 name[766], *s;
    I64 i, size;
    StrCpy(name, "Host-long-name-");
    for (i = StrLen(name); i < 251; i++) name[i] = 'h';
    StrCpy(name + 251, ".txt");
    s = FileRead(name, &size);
    if (!s || size != 20 || StrCmp(s, "Hello from the host\n")) KTFail("fat: host 255-unit name");
    Free(s);
    s = FileRead("호스트에서 만든 긴 한글 파일 이름입니다.txt", &size);
    if (!s || size != 20) KTFail("fat: host Hangul name");
    Free(s);
    for (i = 0; i < 251; i++) name[i] = 'k';
    StrCpy(name + 251, ".txt");
    if (FileWrite(name, "long", 4) == INVALID_CLUS) KTFail("fat: 255-unit write");
    s = FileRead(name, &size);
    if (!s || size != 4 || StrCmp(s, "long")) KTFail("fat: 255-unit read");
    Free(s);
    if (FileWrite("커널에서 만든 긴 한글 파일 이름입니다.txt", "hangul", 6) == INVALID_CLUS ||
            FileWrite("같은 이름 접두사 첫번째.txt", "one", 3) == INVALID_CLUS ||
            FileWrite("같은 이름 접두사 두번째.txt", "two", 3) == INVALID_CLUS ||
            FileWrite("Unicode-😀-surrogate-pair.txt", "emoji", 5) == INVALID_CLUS)
        KTFail("fat: unicode write");
    for (i = 0; i < 251; i++) MemCpy(name + i * 3, "한", 3);
    StrCpy(name + 753, ".txt");
    if (FileWrite(name, "wide", 4) == INVALID_CLUS) KTFail("fat: 255-unit Hangul write");
    s = FileRead(name, &size);
    if (!s || size != 4 || StrCmp(s, "wide")) KTFail("fat: 255-unit Hangul read");
    Free(s);
    for (i = 1; i <= 15; i++) {
        StrPrint(name, "Alias collision number %d.txt", i);
        if (FileWrite(name, "alias", 5) == INVALID_CLUS) KTFail("fat: alias collision write");
    }
    if (!FileFind("ALIASC~1.TXT") || !FileFind("ALIASC~2.TXT") || !FileFind("ALIAS~15.TXT"))
        KTFail("fat: unique short aliases");
    // Exact multiples of 13 have no terminator in their last LFN slot.
    for (i = 13; i <= 39; i += 13) {
        MemSet(name, 'z', i); name[i] = 0;
        if (FileWrite(name, "slots", 5) == INVALID_CLUS || Del(name) != 1 || FileFind(name))
            KTFail("fat: LFN slot boundary delete");
    }
    for (i = 0; i < 256; i++) name[i] = 'x';
    name[256] = 0;
    if (FileNameChk(name) || FileWrite(name, "bad", 3) != INVALID_CLUS) KTFail("fat: reject 256 units");
}

U0 DevTestFatFull(CDrv *dv)
{//Leave exactly one free cluster, request two, and require a complete rollback.
    I64 i, limit = FAT32Limit(dv), sectors = (limit + 127) / 128, single = 0, saved_free = dv->fis->free_clus;
    U32 *saved = MAlloc(sectors * 512), *full = MAlloc(sectors * 512);
    DrvFATBlkClean(dv);
    DrvBlkRead(dv, saved, dv->fat1, sectors); MemCpy(full, saved, sectors * 512);
    for (i = 2; i < limit; i++)
        if (!(full[i] & 0x0FFFFFFF)) {
            if (!single) single = i;
            else full[i] = 0x0FFFFFF7;
        }
    DrvBlkWrite(dv, full, dv->fat1, sectors); DrvBlkWrite(dv, full, dv->fat2, sectors);
    DrvFATBlkAlloc(dv); dv->fis->free_clus = 1; dv->fis->most_recently_alloced = single - 1;
    if (ClusAlloc(dv, 0, 2) != INVALID_CLUS || DiskInfo(Drv2Let(dv)) != dv->spc * 512)
        KTFail("fat: full allocation rollback");
    DrvBlkWrite(dv, saved, dv->fat1, sectors); DrvBlkWrite(dv, saved, dv->fat2, sectors);
    DrvFATBlkAlloc(dv); dv->fis->free_clus = saved_free;
    FAT32FreeCntAdd(dv, 0);
    Free(saved); Free(full);
}

U0 DevTestFatTools()
{
    I64 i, free, c, first, count, size;
    U8 path[4096], *s;
    CDrv *dv;
    CDirEntry de;
    CFAT32DirEntry *dir;
    U32 sector[128];
    if (!FatFormat('D')) {KTFail("fat: format"); return;}
    if (Fsck('D') || DiskInfo('D') <= 0) KTFail("fat: fresh format check");
    StrCpy(path, "C:/Tree");
    if (!DirMk(path)) KTFail("fat: tree root");
    for (i = 0; i < 20; i++) {
        StrCat(path, "/깊은폴더");
        if (!DirMk(path)) KTFail("fat: deep mkdir");
    }
    StrCat(path, "/긴 파일 이름과 한글 내용을 가진 파일.txt");
    if (FileWrite(path, "tree-data", 9) == INVALID_CLUS) KTFail("fat: deep file");
    if (!Copy("Tree", "D:/Copied") || !Move("D:/Copied", "D:/Moved")) KTFail("fat: recursive copy/move");
    if (Copy("Tree", "Tree/inside") || FileFind("Tree/inside")) KTFail("fat: descendant rejection");
    if (Del("Tree") != 22 || FileFind("Tree")) KTFail("fat: recursive delete");
    StrCpy(path, "D:/Moved");
    for (i = 0; i < 20; i++) StrCat(path, "/깊은폴더");
    StrCat(path, "/긴 파일 이름과 한글 내용을 가진 파일.txt");
    s = FileRead(path, &size);
    if (!s || size != 9 || StrCmp(s, "tree-data")) KTFail("fat: deep copy contents");
    Free(s);
    DirMk("C:/PartialSrc"); DirMk("D:/PartialDst"); DirMk("D:/PartialDst/blocked.txt");
    FileWrite("C:/PartialSrc/good.txt", "good", 4); FileWrite("C:/PartialSrc/blocked.txt", "keep", 4);
    if (Move("C:/PartialSrc/*", "D:/PartialDst") || !FileFind("D:/PartialDst/good.txt") ||
            !FileFind("C:/PartialSrc/good.txt") || !FileFind("C:/PartialSrc/blocked.txt"))
        KTFail("fat: partial move retains sources");
    Del("C:/PartialSrc"); Del("D:/PartialDst");
    // Inject a lost cluster, a cyclic file, a bad parent, a FAT mirror mismatch,
    // and a stale free count on the disposable D: volume.
    dv = Let2Drv('D');
    free = DiskInfo('D');
    c = ClusAlloc(dv, 0, 1);
    if (c == INVALID_CLUS || Fsck('D') <= 0 || Fsck('D', TRUE) <= 0 || Fsck('D') || DiskInfo('D') != free)
        KTFail("fat: lost cluster repair");
    FileWrite("D:/Broken.txt", "broken", 6);
    if (!FileFind("D:/Broken.txt", &de)) KTFail("fat: broken fixture");
    Free(de.full_name);
    DrvFATBlkSet(dv, de.clus);
    dv->cur_fat_blk[de.clus & 127] = de.clus;
    LBts(&dv->fat_blk_dirty, 0); DrvFATBlkClean(dv);
    if (!FileFind("D:/Moved", &de)) KTFail("fat: directory fixture");
    Free(de.full_name);
    first = de.clus;
    dir = FAT32DirLoad(dv, first, &count);
    dir[1].clus_lo = first;
    FAT32DirStore(dv, first, dir, count); Free(dir);
    DrvBlkRead(dv, sector, dv->fat2, 1);
    sector[100] ^= 1;
    DrvBlkWrite(dv, sector, dv->fat2, 1);
    dv->fis->free_clus = 0;
    DrvBlkWrite(dv, dv->fis, dv->file_system_info_sect, 1);
    if (Fsck('D') <= 0 || Fsck('D', TRUE) <= 0 || Fsck('D')) KTFail("fat: chain/directory/mirror repair");
    DevTestFatFull(dv);
    if (Fsck('D') || Fsck('C')) KTFail("fat: source consistency");
}

U0 DevTestFs()
{//Disk 1 is a FAT32 image made on the host (newfs_msdos) holding HostNote.txt.
    //Read it, write FromCoolcom.txt (twice, so the first copy is freed) and
    //Sub/Inner.TXT; the host checks them afterwards with mtools and fsck_msdos.
    I64 size, f0 = kt_fails;
    U8 *s, *a = DevTestFsData(3000, 0), *b = DevTestFsData(700, 5);
    DrvRep;
    if (sizeof(CFAT32Boot) != 512 || sizeof(CFAT32DirEntry) != 32 || sizeof(CFAT32DirEntryLong) != 32 ||
            offset(CFAT32Boot.root_clus) != 44)
        KTFail("fs: FAT structure layout");
    if (!Cd("C:/")) {
        KTFail("fs: no drive C:");
        goto fs_done;
    }
    s = FileRead("hostnote.txt", &size);
    if (!s || size != 20 || StrCmp(s, "Hello from the host\n"))
        KTFail("fs: FileRead of the host's file");
    Free(s);
    FileWrite("FromCoolcom.txt", b, 100);
    FileWrite("FromCoolcom.txt", a, 3000);
    if (!DirMk("Sub") || !Cd("Sub"))
        KTFail("fs: DirMk/Cd");
    FileWrite("Inner.TXT", b, 700);
    s = DirCur;
    Print("cur dir: %s\n", s);
    if (StrCmp(s, "C:/Sub"))
        KTFail("fs: DirCur in Sub");
    Free(s);
    Cd("..");
    if (Dir != 6)
        KTFail("fs: Dir count");
    s = FileRead("FromCoolcom.txt", &size);
    if (!s || size != 3000 || MemCmp(s, a, 3000))
        KTFail("fs: read back FromCoolcom.txt");
    Free(s);
    s = FileRead("C:/Sub/Inner.TXT", &size);
    if (!s || size != 700 || MemCmp(s, b, 700))
        KTFail("fs: read back Sub/Inner.TXT");
    Free(s);
    if (!Copy("C:/Sub/Inner.TXT", "C:/Copy.TXT") || !Move("Copy.TXT", "Moved.TXT") || FileFind("Copy.TXT") ||
            Del("Moved.TXT") != 1 || FileFind("Moved.TXT") || !IsDir("Sub") || IsDir("HostNote.txt"))
        KTFail("fs: Copy/Move/Del/IsDir");
    DevTestFatNames;
    DevTestFatTools;
    s = FileRead("Missing.TXT");
    if (s)
        KTFail("fs: FileRead of a missing file");
fs_done:
    Free(a);
    Free(b);
    if (kt_fails == f0)
        Print("  fs: PASS\n");
}

U0 DevTestInput()
{
    I64 deadline = ArchCntVct + 3 * ArchCntFrq, f0 = kt_fails;
    while (KeyPending < 6 && ArchCntVct < deadline)
        Sleep(10);
    if (KeyPending < 6) {
        KTFail("scripted keys not received");
        return;
    }
    GetStr(dt_line, 64);
    Print("input: [%s]\n", dt_line);
    if (StrCmp(dt_line, "hiA"))
        KTFail("GetStr line");
    Print("mouse: x=%d y=%d b=%d w=%d\n", mouse.mx, mouse.my, mouse.buttons, mouse.wheel);
    if (mouse.mx != fb.w / 2 + 5 || mouse.my != fb.h / 2 - 3 || mouse.buttons != 1 || mouse.wheel != 2)
        KTFail("mouse state");
    if (kt_fails == f0)
        Print("  input: PASS\n");
}

U0 DevTestShell()
{//The shell reads the scripted lines, including the memory safety probes:
    //  I64 Sq(I64 x) { return x * x; }
    //  Print("%d\n", Sq(7));
    //  while (TRUE) {}               broken by Ctrl+Alt+C
    //  Sleep(60000);                 broken by Ctrl+Alt+C
    //  Print("%d\n", 51);
    //  Print("%d\n", 7); edited to print 42 (Left, Left, Backspace, 4, 2)
    //  Up, Up recalls the 51 line, which prints 51 again
    //  #include "Test.cool" (from the FAT32 disk) and Print("%d\n", Tripled(21)); print 63
    //  (Test.cool's Doubled is inlined into Tripled); Doubled redefined, Tripled(21) is still 63
    //  escapes: "\101" is "A" and '\101' + '\e' is 65 + 27: prints A92
    //  I64 bad = ;                   a compile error: ERROR, the line and a caret
    //  memsafe: heap overrun, deep recursion, kernel text write, then Sq(9)=81
    //then runs Sq(7) itself, so Sq must have persisted.
    I64 deadline = ArchCntVct + 20 * ArchCntFrq, f0 = kt_fails;
    ShellStart(19);
    while (shell_state < 2 && shell_state >= 0 && ArchCntVct < deadline)
        Sleep(10);
    if (shell_state != 2)
        KTFail("shell did not finish");
    else if (shell_check != 49)
        KTFail("shell: Sq(7) after the scripted lines");
    if (kt_fails == f0)
        Print("  shell: PASS\n");
}

U0 DevTestScreen()
{//Leave a known picture: 5 text rows (the last with Hangul and CJK), then color bars and a gradient.
    I64 i;
    ConsClear;
    "COOLCOM FB TEST\n";
    "input: %s\n", dt_line;
    "mouse: x=%d y=%d b=%d\n", mouse.mx, mouse.my, mouse.buttons;
    "0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz\n";
    "한글 테스트 漢字 Ünï\n";
    FbFillRect(16, 112, 32, 32, 0xFF0000);
    FbFillRect(64, 112, 32, 32, 0x00FF00);
    FbFillRect(112, 112, 32, 32, 0x0000FF);
    for (i = 0; i < 256; i++)
        FbFillRect(16 + i, 160, 1, 16, i * 0x010101);
}

U0 DevTest()
{
    if (!fb.base)
        KTFail("no framebuffer");
    if (!fdt_input.base)
        KTFail("no input device");
    if (fb.base && fdt_input.base) {
        DevTestInput;
        DevTestBlk;
        DevTestFs;
        DevTestTerm;
        DevTestShell;
        if (net_nic)
            DevTestNet;  // before the screen test: it prints
        DevTestScreen;
    }
}
