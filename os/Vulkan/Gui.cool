// Loaded by the resident terminal; one nearest-sampled texture per surface.
// The shared FbGlyph renderer rasterizes cells into these window textures,
// giving exactly the same glyph coverage, colors and integer scale as Fb.
class CGuiTexture
{
    CGfxImage image;
    CGfxBuffer upload;
    U64i set;
    CGuiWindow *window;
    I64 revision;
};
class CGuiGpu
{
    CGuiTexture textures[GUI_WINDOWS + 2];
    CGfxImage target;
    CGfxBuffer readback;
    U64i sampler, set_layout, pool, layout, pipeline, shaders[2], cmd;
    Bool ready;
};
CGuiGpu ggui;
U0 GuiGpuTexture(CGuiTexture *t, U32 *pixels, I64 w, I64 h)
{
    VkDescriptorSetAllocateInfo alloc; VkDescriptorImageInfo image; VkWriteDescriptorSet write;
    if (t->image.w != w || t->image.h != h) {
        if (t->image.image) {GfxBufferDestroy(&t->upload); GfxImageDestroy(&t->image);}
        GfxImageCreate(&t->image, w, h, VK_FORMAT_B8G8R8A8_UNORM, VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT);
        GfxBufferCreate(&t->upload, (w * h * 4 + 16383) & ~16383, VK_BUFFER_USAGE_TRANSFER_SRC_BIT);
        if (!t->set) {
            MemSet(&alloc, 0, sizeof(alloc)); alloc.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
            alloc.descriptorPool = ggui.pool; alloc.descriptorSetCount = 1; alloc.pSetLayouts = &ggui.set_layout; t->set = GfxId;
            GfxBegin; vn_encode_vkAllocateDescriptorSets(&gfx.enc, 0, gfx.device, &alloc, &t->set); GfxSubmit;
            GfxResult(vn_decode_vkAllocateDescriptorSets_reply(&gfx.reply, gfx.device, &alloc, &t->set), "GUI set");
        }
        MemSet(&image, 0, sizeof(image)); image.sampler = ggui.sampler; image.imageView = t->image.view;
        image.imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
        MemSet(&write, 0, sizeof(write)); write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
        write.dstSet = t->set; write.descriptorCount = 1; write.descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER; write.pImageInfo = &image;
        GfxBegin; vn_encode_vkUpdateDescriptorSets(&gfx.enc, 0, gfx.device, 1, &write, 0, NULL); GfxSubmit;
        GfxRecord;
        GfxImageBarrier(&t->image, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, 0, VK_ACCESS_SHADER_READ_BIT);
        GfxExecute;
    }
    MemCpy(t->upload.mapping, pixels, w * h * 4); ArchDsb;
    GfxRecord;
    GfxImageBarrier(&t->image, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_SHADER_READ_BIT, VK_ACCESS_TRANSFER_WRITE_BIT);
    GfxUpload(&t->image, &t->upload, 4, 0, h);
    GfxImageBarrier(&t->image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT);
    GfxExecute;
}
U0 GuiGpuRect(CGuiTexture *t, I64 x, I64 y, Bool transparent = FALSE)
{
    I32i rect[5]; rect[0] = x; rect[1] = y; rect[2] = t->image.w; rect[3] = t->image.h; rect[4] = transparent;
    vn_encode_vkCmdBindDescriptorSets(&gfx.enc, 0, gfx.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, ggui.layout, 0, 1, &t->set, 0, NULL);
    vn_encode_vkCmdPushConstants(&gfx.enc, 0, gfx.cmd, ggui.layout, VK_SHADER_STAGE_FRAGMENT_BIT, 0, 20, rect);
    vn_encode_vkCmdDraw(&gfx.enc, 0, gfx.cmd, 3, 1, 0, 0);
}
U0 GuiGpuFrame()
{
    I64 i, j; CGuiWindow *w; CGuiTexture *t;
    VkRenderingAttachmentInfo attachment; VkRenderingInfo rendering; VkBufferImageCopy copy;
    // Texture identity follows the window across focus/Z-order changes.
    for (j = 1; j <= GUI_WINDOWS; j++) {
        t = &ggui.textures[j];
        if (t->window) {
            for (i = 0; i < gui.count; i++) if (gui.windows[i] == t->window) break;
            if (i == gui.count) {GfxBufferDestroy(&t->upload); GfxImageDestroy(&t->image); MemSet(&t->image, 0, sizeof(CGfxImage)); t->window = NULL;}
        }
    }
    if (ggui.textures[0].revision != gui.desktop_revision) {
        GuiGpuTexture(&ggui.textures[0], gui.desktop, fb.w, fb.h); ggui.textures[0].revision = gui.desktop_revision;
    }
    for (i = 0; i < gui.count; i++) {
        w = gui.windows[i]; t = NULL;
        for (j = 1; j <= GUI_WINDOWS; j++) if (ggui.textures[j].window == w) {t = &ggui.textures[j]; break;}
        if (!t) for (j = 1; j <= GUI_WINDOWS; j++) if (!ggui.textures[j].window) {t = &ggui.textures[j]; t->window = w; t->revision = -1; break;}
        GfxCheck(t != NULL, "GUI texture slots");
        if (t->revision != w->revision) {GuiGpuTexture(t, w->pixels, w->pw, w->ph); t->revision = w->revision;}
    }
    MemSet(&attachment, 0, sizeof(attachment)); attachment.sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO;
    attachment.imageView = ggui.target.view; attachment.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
    attachment.loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE; attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
    MemSet(&rendering, 0, sizeof(rendering)); rendering.sType = VK_STRUCTURE_TYPE_RENDERING_INFO;
    rendering.renderArea.extent.width = fb.w; rendering.renderArea.extent.height = fb.h;
    rendering.layerCount = 1; rendering.colorAttachmentCount = 1; rendering.pColorAttachments = &attachment;
    GfxRecord;
    GfxImageBarrier(&ggui.target, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, VK_ACCESS_MEMORY_READ_BIT, VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT);
    vn_encode_vkCmdBeginRendering(&gfx.enc, 0, gfx.cmd, &rendering);
    vn_encode_vkCmdBindPipeline(&gfx.enc, 0, gfx.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, ggui.pipeline);
    GuiGpuRect(&ggui.textures[0], 0, 0);
    for (i = 0; i < gui.count; i++) for (j = 1; j <= GUI_WINDOWS; j++) if (ggui.textures[j].window == gui.windows[i]) GuiGpuRect(&ggui.textures[j], gui.windows[i]->x * gui.scale, gui.windows[i]->y * gui.scale);
    GuiGpuRect(&ggui.textures[GUI_WINDOWS + 1], gui.mx * gui.scale, gui.my * gui.scale, TRUE);
    vn_encode_vkCmdEndRendering(&gfx.enc, 0, gfx.cmd);
    GfxImageBarrier(&ggui.target, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT);
    MemSet(&copy, 0, sizeof(copy)); copy.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT; copy.imageSubresource.layerCount = 1;
    copy.imageExtent.width = fb.w; copy.imageExtent.height = fb.h; copy.imageExtent.depth = 1;
    vn_encode_vkCmdCopyImageToBuffer(&gfx.enc, 0, gfx.cmd, ggui.target.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, ggui.readback.buffer, 1, &copy);
    GfxImageBarrier(&ggui.target, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_GENERAL, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_MEMORY_READ_BIT);
    GfxExecute;
    GfxCheck(GpuScanoutBlob(ggui.readback.blob, fb.w, fb.h, fb.w * 4), "GUI scanout");
}
U0 GuiGpuStop()
{
    I64 i;
    if (!ggui.ready) return;
    for (i = 0; i < GUI_WINDOWS + 2; i++) if (ggui.textures[i].image.image) {GfxBufferDestroy(&ggui.textures[i].upload); GfxImageDestroy(&ggui.textures[i].image);}
    GfxBufferDestroy(&ggui.readback); GfxImageDestroy(&ggui.target);
    GfxBegin; vn_encode_vkDestroyPipeline(&gfx.enc, 0, gfx.device, ggui.pipeline, NULL);
    vn_encode_vkDestroyPipelineLayout(&gfx.enc, 0, gfx.device, ggui.layout, NULL);
    vn_encode_vkDestroyDescriptorPool(&gfx.enc, 0, gfx.device, ggui.pool, NULL);
    vn_encode_vkDestroyDescriptorSetLayout(&gfx.enc, 0, gfx.device, ggui.set_layout, NULL);
    vn_encode_vkDestroySampler(&gfx.enc, 0, gfx.device, ggui.sampler, NULL);
    for (i = 0; i < 2; i++) vn_encode_vkDestroyShaderModule(&gfx.enc, 0, gfx.device, ggui.shaders[i], NULL);
    vn_encode_vkFreeCommandBuffers(&gfx.enc, 0, gfx.device, gfx.pool, 1, &ggui.cmd);
    GfxSubmit; MemSet(&ggui, 0, sizeof(CGuiGpu));
}
U0 GuiGpuStart()
{
    I64 x, y, s = gui.scale; U32 *pointer;
    VkSamplerCreateInfo sampler; VkDescriptorSetLayoutBinding binding; VkDescriptorSetLayoutCreateInfo layout;
    VkDescriptorPoolSize size; VkDescriptorPoolCreateInfo pool;
    VenusFinish; ggui.cmd = GfxCommandNew; gfx.cmd = ggui.cmd;
    MemSet(&sampler, 0, sizeof(sampler)); sampler.sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO;
    ggui.sampler = GfxId; GfxBegin; vn_encode_vkCreateSampler(&gfx.enc, 0, gfx.device, &sampler, NULL, &ggui.sampler); GfxSubmit;
    GfxResult(vn_decode_vkCreateSampler_reply(&gfx.reply, gfx.device, &sampler, NULL, &ggui.sampler), "GUI sampler");
    MemSet(&binding, 0, sizeof(binding)); binding.descriptorCount = 1; binding.descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER; binding.stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT;
    MemSet(&layout, 0, sizeof(layout)); layout.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO; layout.bindingCount = 1; layout.pBindings = &binding;
    ggui.set_layout = GfxId; GfxBegin; vn_encode_vkCreateDescriptorSetLayout(&gfx.enc, 0, gfx.device, &layout, NULL, &ggui.set_layout); GfxSubmit;
    GfxResult(vn_decode_vkCreateDescriptorSetLayout_reply(&gfx.reply, gfx.device, &layout, NULL, &ggui.set_layout), "GUI layout");
    size.type = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER; size.descriptorCount = GUI_WINDOWS + 2;
    MemSet(&pool, 0, sizeof(pool)); pool.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO; pool.maxSets = GUI_WINDOWS + 2; pool.poolSizeCount = 1; pool.pPoolSizes = &size;
    ggui.pool = GfxId; GfxBegin; vn_encode_vkCreateDescriptorPool(&gfx.enc, 0, gfx.device, &pool, NULL, &ggui.pool); GfxSubmit;
    GfxResult(vn_decode_vkCreateDescriptorPool_reply(&gfx.reply, gfx.device, &pool, NULL, &ggui.pool), "GUI pool");
    ggui.shaders[0] = GfxShader("C:/Vulkan/terminal.vert.spv"); ggui.shaders[1] = GfxShader("C:/Vulkan/gui.frag.spv");
    GfxPipeline(fb.w, fb.h, ggui.set_layout, ggui.shaders, &ggui.layout, &ggui.pipeline);
    GfxImageCreate(&ggui.target, fb.w, fb.h, VK_FORMAT_B8G8R8A8_UNORM, VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT);
    GfxBufferCreate(&ggui.readback, (fb.w * fb.h * 4 + 16383) & ~16383, VK_BUFFER_USAGE_TRANSFER_DST_BIT);
    GfxRecord; GfxImageBarrier(&ggui.target, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, VK_ACCESS_MEMORY_READ_BIT); GfxExecute;
    pointer = CAlloc(12 * 18 * s * s * 4);
    for (y = 0; y < 18 * s; y++) for (x = 0; x < 12 * s; x++) pointer[y * 12 * s + x] = gui.pointer[y / s * 12 + x / s];
    GuiGpuTexture(&ggui.textures[GUI_WINDOWS + 1], pointer, 12 * s, 18 * s); Free(pointer);
    ggui.ready = TRUE; gui.frame_hook = &GuiGpuFrame; gui.stop_hook = &GuiGpuStop;
    Print("GUI VENUS READY\n");
}
