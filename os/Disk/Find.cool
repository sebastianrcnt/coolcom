// Find("text", mask): search the files that match mask (recursively, from the current
// directory) for text, and print one line per match: file,line: the line's text.
//   Find("Vim", "*.cool");   Find("todo", "C:/Kernel/*", TRUE);   (TRUE: ignore case)
// Files with a NUL byte near the start are taken for binary and skipped. Returns the
// number of matching lines.

I64 Find(U8 *text, U8 *mask = "*", Bool icase = FALSE)
{
    CDirEntry *list, *de;
    U8 *buf, *p, *q, *end;
    I64 size, line, n = StrLen(text), hits = 0;
    if (!n) return 0;
    list = FilesFind(mask, FUF_RECURSE | FUF_JUST_FILES | FUF_FLATTEN_TREE);
    for (de = list; de; de = de->next) {
        size = TextRead(de->full_name, &buf);
        if (size <= 0) {Free(buf); goto next_file;}
        if (TextIsBinary(buf, size)) {Free(buf); goto next_file;}
        end = buf + size;
        line = 1;
        for (p = buf; p < end; p = q + 1) {
            q = p;
            while (q < end && *q != '\n') q++;
            if (TextFind(p, 0, q - p, text, n, icase) >= 0) {
                Print("%s,%d: ", de->full_name, line);
                TextPutLine(p, q - p, 200);
                ConsPut('\n');
                hits++;
            }
            line++;
        }
        Free(buf);
next_file:
    }
    DirTreeDel(list);
    return hits;
}
