// Startup commands for each independent shell/compiler task.
#include "C:/Vim.cool"
#include "C:/Nyan.cool"
#include "C:/Tmux.cool"
#include "C:/Text.cool"
#include "C:/Find.cool"
#include "C:/HexDump.cool"
#include "C:/Less.cool"
#include "C:/Man.cool"
#include "C:/Diff.cool"
#include "C:/Top.cool"
#include "C:/Warm/Warm.cool"
#include "C:/Lua.cool"

// The console font (docs/fonts.md): Sarasa Mono K when make disk-install found it on the
// Mac, else the built-in Unifont. Once per boot; FontSet(NULL) goes back to Unifont.
if (!font.chosen && FileFind("C:/Fonts/SarasaMonoK-Regular.ttf"))
    FontSet("C:/Fonts/SarasaMonoK-Regular.ttf", 14);

U0 Cls()
{//TempleOS's clear screen, as ANSI so the screen and the host terminal both clear.
    AnsiClear;
    AnsiHome;
}
