// Interactive GPU 3D scene. Load once: #include "C:/Cube.cool", then Cube;
// Requires the resident Venus device. GuiCube; launches a task-owned window.
#include "C:/Vulkan/Gfx.cool"
#include "C:/Vulkan/Render.cool"
class CCubeParams {U32i w, h; I32i ms, yaw, pitch, distance, pan_x, pan_y;};
class CCubeDemo
{
    CGfxImage target;
    CGfxBuffer readback;
    U64i shaders[2], layout, pipeline;
    U8 *frame_hook, *fill_hook, *finish_hook;
    Bool active, locked, hooks, paused;
    I64 daif, w, h, frames;
    CCubeParams params;
    CGuiWindow *window; CTask *owner; U32 *overlay; Bool direct, sampled;
    I64 mouse_x, mouse_y; Bool mouse_down;
};
CCubeDemo cube;
U64i cube_ids;

// Quiet hooks reserve the display while the normal console continues accepting text.
U0 CubeConsole(Bool all, I64 scroll, I64 cx, I64 cy, I64 cells) {}
U0 CubeFinish() {}
U0 CubeLock() {cube.daif = FbRenderLock; cube.locked = TRUE;}
U0 CubeUnlock() {cube.locked = FALSE; FbRenderUnlock(cube.daif);}

Bool CubeDevice()
{//One Vulkan instance per Venus context. Copy the resident device's handles and
    //properties through the existing shell symbol table, never retaining a CTask
    //or compiler pointer. The renderer lock protects GPU state; each core lock
    //protects task/symbol lookup. This app owns neither the device nor the context.
    I64 i, daif; CCPU *c; CTask *t; CShell *shell; CHashGlblVar *symbol; CGfx *resident;
    Bool found = FALSE;
    for (i = 0; i < mp_cnt && !found; i++) {
        c = &cpu_structs[i]; daif = SpinLockIrq(&c->lock); t = c->seth_task;
        do {
            shell = t->shell_ctx;
            if (shell && shell->resident && shell->hash) {
                symbol = HashFind("gfx", shell->hash, HTT_GLBL_VAR);
                if (symbol && symbol->size == sizeof(CGfx) && symbol->data_addr) {
                    resident = symbol->data_addr;
                    gfx.device = resident->device; gfx.physical = resident->physical;
                    gfx.queue = resident->queue; gfx.family = resident->family;
                    MemCpy(&gfx.memory, &resident->memory, sizeof(VkPhysicalDeviceMemoryProperties));
                    found = gfx.device != 0;
                }
            }
            t = t->next_task;
        } while (t != c->seth_task && !found);
        SpinUnlockIrq(&c->lock, daif);
    }
    return found;
}
U0 CubeGpuInit()
{
    VkCommandPoolCreateInfo pool; VkCommandBufferAllocateInfo command;
    GfxCheck(CubeDevice, "resident Vulkan device");
    gfx.commands = CAlloc(16384); GfxCheck(gfx.commands != NULL, "cube command allocation");
    gfx.enc.data = gfx.commands; gfx.enc.capacity = 16384;
    gfx.reply_blob = GpuBlobCreate(16384, GPU_BLOB_HOST3D);
    GfxCheck(gfx.reply_blob && GpuBlobMap(gfx.reply_blob), "cube reply mapping");
    gfx.reply.data = gfx.reply_blob->mapping; gfx.reply.capacity = gfx.reply_blob->size;
    MemSet(&pool, 0, sizeof(pool)); pool.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
    pool.queueFamilyIndex = gfx.family; pool.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
    gfx.pool = GfxId;
    GfxBegin; vn_encode_vkCreateCommandPool(&gfx.enc, 0, gfx.device, &pool, NULL, &gfx.pool); GfxSubmit;
    GfxResult(vn_decode_vkCreateCommandPool_reply(&gfx.reply, gfx.device, &pool, NULL, &gfx.pool), "cube command pool");
    MemSet(&command, 0, sizeof(command)); command.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
    command.commandPool = gfx.pool; command.commandBufferCount = 1; gfx.cmd = GfxId;
    GfxBegin; vn_encode_vkAllocateCommandBuffers(&gfx.enc, 0, gfx.device, &command, &gfx.cmd); GfxSubmit;
    GfxResult(vn_decode_vkAllocateCommandBuffers_reply(&gfx.reply, gfx.device, &command, &gfx.cmd), "cube command buffer");
    gfx.fence = GfxFenceNew;
}

U0 CubePipeline(I64 w, I64 h, U64i *shaders, U64i *_layout, U64i *_pipeline)
{
    U64i layout = GfxId, pipeline = GfxId; I64 x; I32i format = VK_FORMAT_B8G8R8A8_UNORM;
    VkPipelineLayoutCreateInfo layout_info; VkGraphicsPipelineCreateInfo pipeline_info;
    VkPipelineRenderingCreateInfo rendering_pipeline;
    VkPipelineShaderStageCreateInfo stages[2]; VkPipelineVertexInputStateCreateInfo vertex;
    VkPipelineInputAssemblyStateCreateInfo assembly; VkPipelineViewportStateCreateInfo viewport_state;
    VkViewport viewport; VkRect2D scissor; VkPipelineRasterizationStateCreateInfo raster;
    VkPipelineMultisampleStateCreateInfo multisample; VkPipelineColorBlendAttachmentState blend;
    VkPipelineColorBlendStateCreateInfo blend_state;
    MemSet(&layout_info, 0, sizeof(layout_info)); layout_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
    VkPushConstantRange push; MemSet(&push, 0, sizeof(push)); push.stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT; push.size = 32;
    layout_info.setLayoutCount = 0;
    layout_info.pushConstantRangeCount = 1; layout_info.pPushConstantRanges = &push;
    GfxBegin; vn_encode_vkCreatePipelineLayout(&gfx.enc, 0, gfx.device, &layout_info, NULL, &layout); GfxSubmit;
    GfxResult(vn_decode_vkCreatePipelineLayout_reply(&gfx.reply, gfx.device, &layout_info, NULL, &layout), "pipeline layout");
    *_layout = layout;
    MemSet(stages, 0, sizeof(stages));
    for (x = 0; x < 2; x++) {stages[x].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO; stages[x].module = shaders[x]; stages[x].pName = "main";}
    stages[0].stage = VK_SHADER_STAGE_VERTEX_BIT; stages[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
    MemSet(&vertex, 0, sizeof(vertex)); vertex.sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO;
    MemSet(&assembly, 0, sizeof(assembly)); assembly.sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO;
    assembly.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
    MemSet(&viewport, 0, sizeof(viewport)); viewport.width = GfxFloat(w); viewport.height = GfxFloat(h); viewport.maxDepth = 0x3F800000;
    MemSet(&scissor, 0, sizeof(scissor)); scissor.extent.width = w; scissor.extent.height = h;
    MemSet(&viewport_state, 0, sizeof(viewport_state)); viewport_state.sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO;
    viewport_state.viewportCount = 1; viewport_state.pViewports = &viewport; viewport_state.scissorCount = 1; viewport_state.pScissors = &scissor;
    MemSet(&raster, 0, sizeof(raster)); raster.sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO;
    raster.lineWidth = 0x3F800000;
    MemSet(&multisample, 0, sizeof(multisample)); multisample.sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO;
    multisample.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
    MemSet(&blend, 0, sizeof(blend)); blend.colorWriteMask = 15;
    MemSet(&blend_state, 0, sizeof(blend_state)); blend_state.sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO;
    blend_state.attachmentCount = 1; blend_state.pAttachments = &blend;
    MemSet(&rendering_pipeline, 0, sizeof(rendering_pipeline)); rendering_pipeline.sType = VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO;
    rendering_pipeline.colorAttachmentCount = 1; rendering_pipeline.pColorAttachmentFormats = &format;
    MemSet(&pipeline_info, 0, sizeof(pipeline_info)); pipeline_info.sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO;
    pipeline_info.pNext = &rendering_pipeline; pipeline_info.stageCount = 2; pipeline_info.pStages = stages;
    pipeline_info.pVertexInputState = &vertex; pipeline_info.pInputAssemblyState = &assembly;
    pipeline_info.pViewportState = &viewport_state; pipeline_info.pRasterizationState = &raster;
    pipeline_info.pMultisampleState = &multisample; pipeline_info.pColorBlendState = &blend_state;
    pipeline_info.layout = layout; pipeline_info.basePipelineIndex = -1;
    GfxBegin; vn_encode_vkCreateGraphicsPipelines(&gfx.enc, 0, gfx.device, 0, 1, &pipeline_info, NULL, &pipeline); GfxSubmit;
    GfxResult(vn_decode_vkCreateGraphicsPipelines_reply(&gfx.reply, gfx.device, 0, 1, &pipeline_info, NULL, &pipeline), "graphics pipeline");
    *_layout = layout; *_pipeline = pipeline;
}

U64i CubeShader(U8 *code, I64 size)
{//Files are read before taking the renderer lock: filesystem operations may yield.
    U64i shader = GfxId; VkShaderModuleCreateInfo ci;
    MemSet(&ci, 0, sizeof(ci)); ci.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
    ci.codeSize = size; ci.pCode = code;
    GfxBegin; vn_encode_vkCreateShaderModule(&gfx.enc, 0, gfx.device, &ci, NULL, &shader); GfxSubmit;
    GfxResult(vn_decode_vkCreateShaderModule_reply(&gfx.reply, gfx.device, &ci, NULL, &shader), "cube shader");
    return shader;
}
U0 CubeTargetClose()
{
    if (cube.window) GuiVulkanDetach(cube.window);
    Free(cube.overlay); cube.overlay = NULL; cube.sampled = FALSE;
    // Handle partially constructed targets too (for example, exhausted blob slots).
    if (cube.readback.blob) GfxCheck(GpuBlobDestroy(cube.readback.blob), "cube readback unmap");
    GfxBegin;
    if (cube.pipeline) vn_encode_vkDestroyPipeline(&gfx.enc, 0, gfx.device, cube.pipeline, NULL);
    if (cube.layout) vn_encode_vkDestroyPipelineLayout(&gfx.enc, 0, gfx.device, cube.layout, NULL);
    if (cube.target.view) vn_encode_vkDestroyImageView(&gfx.enc, 0, gfx.device, cube.target.view, NULL);
    if (cube.target.image) vn_encode_vkDestroyImage(&gfx.enc, 0, gfx.device, cube.target.image, NULL);
    if (cube.target.memory) vn_encode_vkFreeMemory(&gfx.enc, 0, gfx.device, cube.target.memory, NULL);
    if (cube.readback.buffer) vn_encode_vkDestroyBuffer(&gfx.enc, 0, gfx.device, cube.readback.buffer, NULL);
    if (cube.readback.memory) vn_encode_vkFreeMemory(&gfx.enc, 0, gfx.device, cube.readback.memory, NULL);
    GfxSubmit;
    cube.pipeline = cube.layout = 0;
    MemSet(&cube.target, 0, sizeof(CGfxImage)); MemSet(&cube.readback, 0, sizeof(CGfxBuffer));
}
U0 CubeTarget()
{
    // Recreate only on resize. Object ids never repeat, including across runs.
    CubeTargetClose;
    cube.w = fb.w; cube.h = fb.h;
    if (cube.window) {cube.w = cube.window->w * cube.window->scale; cube.h = cube.window->h * cube.window->scale;}
    GfxCheck(cube.w >= 160 && cube.h >= 120 && cube.w <= 4096 && cube.h <= 4096, "cube display size");
    cube.params.w = cube.w; cube.params.h = cube.h;
    GfxImageCreate(&cube.target, cube.w, cube.h, VK_FORMAT_B8G8R8A8_UNORM,
                   VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_SAMPLED_BIT);
    GfxBufferCreate(&cube.readback, cube.w * cube.h * 4, VK_BUFFER_USAGE_TRANSFER_DST_BIT);
    if (cube.direct) {cube.overlay = CAlloc(cube.w * cube.h * 4); GfxCheck(cube.overlay != NULL, "cube overlay");}
    CubePipeline(cube.w, cube.h, cube.shaders, &cube.layout, &cube.pipeline);
    if (cube.window) Print("CUBE WINDOW SIZE %dx%d\n", cube.w, cube.h);
}
U0 CubeClose()
{//Called normally, after a caught GPU failure, or by the shell on Ctrl+Alt+C.
    I64 i; U0 (*finish)();
    if (!cube.active) return;
    if (!cube.locked) CubeLock;
    if (cube.hooks) {
        FbVenusHooks(cube.frame_hook, cube.fill_hook, cube.finish_hook);
        cube.hooks = FALSE; fb.redraw_all = TRUE; fb.pending = TRUE;
        // Restore scanout before unmapping the demo's visible buffer.
        FbRenderLocked;
        finish = cube.finish_hook; if (finish) (*finish)();
    }
    try {
        if (gfx.device && gfx.reply_blob && gfx.reply_blob->mapping) {
            CubeTargetClose;
            GfxBegin;
            for (i = 0; i < 2; i++) if (cube.shaders[i]) vn_encode_vkDestroyShaderModule(&gfx.enc, 0, gfx.device, cube.shaders[i], NULL);
            if (gfx.fence) vn_encode_vkDestroyFence(&gfx.enc, 0, gfx.device, gfx.fence, NULL);
            if (gfx.pool) vn_encode_vkDestroyCommandPool(&gfx.enc, 0, gfx.device, gfx.pool, NULL);
            GfxSubmit;
        }
        // The resident terminal owns the shared Venus context: never GfxDestroy it.
        if (gfx.reply_blob) GpuBlobDestroy(gfx.reply_blob);
    } catch {Fs->catch_except = TRUE;}
    cube_ids = gfx.next_id;
    Free(gfx.commands); MemSet(&gfx, 0, sizeof(CGfx));
    CubeUnlock; cube.active = FALSE; if (Fs == cube.owner) shell_stmt_cleanup = NULL;
}

U0 CubeTaskExit(U8 *data) {no_warn data; CubeClose;}

U0 CubePixel(I64 x, I64 y, I64 rgb)
{
    if (x >= 0 && y >= 0 && x < cube.w && y < cube.h) {
        *(cube.readback.mapping + (y * cube.w + x) * 4)(U32i *) = 0xFF000000 | rgb;
        if (cube.overlay) cube.overlay[y * cube.w + x] = 0xFF000000 | rgb;
    }
}

I64 CubeGlyph(I64 c)
{
    switch (c) {
        case 'A': return 0x4631FC62E;
        case 'B': return 0x7A31F463E;
        case 'C': return 0x3E108420F;
        case 'D': return 0x7A318C63E;
        case 'E': return 0x7E10F421F;
        case 'F': return 0x4210F421F;
        case 'G': return 0x3E31BC20F;
        case 'H': return 0x4631FC631;
        case 'I': return 0x7C842109F;
        case 'K': return 0x4654C5251;
        case 'L': return 0x7E1084210;
        case 'M': return 0x4631AD771;
        case 'N': return 0x4673AE731;
        case 'O': return 0x3A318C62E;
        case 'P': return 0x4210F463E;
        case 'Q': return 0x36558C62E;
        case 'R': return 0x4654F463E;
        case 'S': return 0x78217420F;
        case 'T': return 0x10842109F;
        case 'U': return 0x3A318C631;
        case 'V': return 0x11518C631;
        case 'W': return 0x2AB5AC631;
        case 'Y': return 0x108422A31;
        case 'Z': return 0x7E082083F;
        case '0': return 0x3A39ACE2E;
        case '3': return 0x78217043E;
        case '1': return 0x388421184;
        case '/': return 0x420820821;
        case '+': return 0x84F9080;
        case '-': return 0xF8000;
    }
    return 0;
}
U0 CubeText(U8 *text, I64 x, I64 y, I64 scale, I64 rgb)
{
    I64 i, xx, yy, dx, dy, glyph;
    for (i = 0; text[i]; i++) {
        glyph = CubeGlyph(text[i]);
        for (yy = 0; yy < 7; yy++) for (xx = 0; xx < 5; xx++)
                if (glyph & (1 << (yy * 5 + 4 - xx)))
                    for (dy = 0; dy < scale; dy++) for (dx = 0; dx < scale; dx++)
                            CubePixel(x + (i * 6 + xx) * scale + dx, y + yy * scale + dy, rgb);
    }
}
U0 CubeDraw()
{//The caller holds FbRenderLock; all GPU work completes before the next frame.
    VkRenderingAttachmentInfo attachment; VkRenderingInfo rendering;
    VkBufferImageCopy copy; VkMemoryBarrier barrier;
    I64 scale = 2;
    if (cube.window) {if (cube.w != cube.window->w * cube.window->scale || cube.h != cube.window->h * cube.window->scale) CubeTarget;}
    else if (cube.w != fb.w || cube.h != fb.h) CubeTarget;
    MemSet(&attachment, 0, sizeof(attachment)); attachment.sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO;
    attachment.imageView = cube.target.view; attachment.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
    attachment.loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE; attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
    MemSet(&rendering, 0, sizeof(rendering)); rendering.sType = VK_STRUCTURE_TYPE_RENDERING_INFO;
    rendering.renderArea.extent.width = cube.w; rendering.renderArea.extent.height = cube.h;
    rendering.layerCount = 1; rendering.colorAttachmentCount = 1; rendering.pColorAttachments = &attachment;
    MemSet(&copy, 0, sizeof(copy)); copy.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
    copy.imageSubresource.layerCount = 1; copy.imageExtent.width = cube.w; copy.imageExtent.height = cube.h; copy.imageExtent.depth = 1;
    MemSet(&barrier, 0, sizeof(barrier)); barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
    GfxRecord;
    if (cube.sampled) GfxImageBarrier(&cube.target, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
                                      VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, VK_ACCESS_SHADER_READ_BIT, VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT);
    else GfxImageBarrier(&cube.target, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
                         VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, 0, VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT);
    vn_encode_vkCmdBeginRendering(&gfx.enc, 0, gfx.cmd, &rendering);
    vn_encode_vkCmdBindPipeline(&gfx.enc, 0, gfx.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, cube.pipeline);
    vn_encode_vkCmdPushConstants(&gfx.enc, 0, gfx.cmd, cube.layout, VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof(CCubeParams), &cube.params);
    vn_encode_vkCmdDraw(&gfx.enc, 0, gfx.cmd, 3, 1, 0, 0);
    vn_encode_vkCmdEndRendering(&gfx.enc, 0, gfx.cmd);
    GfxImageBarrier(&cube.target, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
                    VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT);
    barrier.srcAccessMask = VK_ACCESS_HOST_WRITE_BIT; barrier.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
    vn_encode_vkCmdPipelineBarrier(&gfx.enc, 0, gfx.cmd, VK_PIPELINE_STAGE_HOST_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &barrier, 0, NULL, 0, NULL);
    vn_encode_vkCmdCopyImageToBuffer(&gfx.enc, 0, gfx.cmd, cube.target.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, cube.readback.buffer, 1, &copy);
    barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT; barrier.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
    vn_encode_vkCmdPipelineBarrier(&gfx.enc, 0, gfx.cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &barrier, 0, NULL, 0, NULL);
    if (cube.direct) {
        GfxImageBarrier(&cube.target, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
                        VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_SHADER_READ_BIT);
        cube.sampled = TRUE;
    }
    GfxExecute;
    if (cube.overlay) MemSet(cube.overlay, 0, cube.w * cube.h * 4);
    // HUD is composited into the coherent readback; the 3D scene itself is GPU rendered.
    if (cube.w < 720) scale = 1;
    CubeText("CUBE / 01", 26, 24, 3, 0xD7F4FF);
    CubeText("GPU 3D", 27, 54, 2, 0x5EB2C7);
    if (cube.paused) CubeText("PAUSED", cube.w - 110, 26, 2, 0xF2B56A);
    CubeText("WASD MOVE  ARROWS LOOK  +/- ZOOM", 26, cube.h - 54, scale, 0xA0BAC7);
    CubeText("SPACE PAUSE  R RESET  Q QUIT", 26, cube.h - 30, scale, 0xA0BAC7);
    ArchDsb;
    if (cube.window) {
        I64 stride, row; U32 *pixels = GrPixels(&stride);
        GfxCheck(pixels != NULL, "cube window surface");
        if (cube.direct) {
            for (row = 0; row < cube.h; row++) MemCpy(pixels(U8 *) + row * stride, cube.overlay + row * cube.w, cube.w * 4);
            GfxCheck(GuiVulkanPresent(gfx.device, cube.target.view, cube.w, cube.h, cube.readback.mapping, cube.w * 4), "cube Vulkan window");
        } else {
            for (row = 0; row < cube.h; row++) MemCpy(pixels(U8 *) + row * stride, cube.readback.mapping + row * cube.w * 4, cube.w * 4);
            GrDirty(0, 0, cube.window->w, cube.window->h);
        }
    } else GfxCheck(GpuScanoutBlob(cube.readback.blob, cube.w, cube.h, cube.w * 4), "cube scanout");
    cube.frames++;
}
U0 CubeReset()
{
    cube.params.ms = 0; cube.params.yaw = 450; cube.params.pitch = 280;
    cube.params.distance = 6500; cube.params.pan_x = cube.params.pan_y = 0; cube.paused = FALSE;
}
Bool CubeKey(I64 c)
{
    if (c == 'q' || c == 'Q' || c == KEY_ESC) return FALSE;
    if (c == ' ') cube.paused = !cube.paused;
    else if (c == 'r' || c == 'R') CubeReset;
    else if (c == KEY_LEFT) cube.params.yaw = cube.params.yaw - 90;
    else if (c == KEY_RIGHT) cube.params.yaw = cube.params.yaw + 90;
    else if (c == KEY_UP) cube.params.pitch = cube.params.pitch + 70;
    else if (c == KEY_DOWN) cube.params.pitch = cube.params.pitch - 70;
    else if (c == 'w' || c == 'W' || c == '+' || c == '=') cube.params.distance = cube.params.distance - 220;
    else if (c == 's' || c == 'S' || c == '-') cube.params.distance = cube.params.distance + 220;
    else if (c == 'a' || c == 'A') cube.params.pan_x = cube.params.pan_x - 150;
    else if (c == 'd' || c == 'D') cube.params.pan_x = cube.params.pan_x + 150;
    if (cube.params.distance < 2800) cube.params.distance = 2800;
    if (cube.params.distance > 18000) cube.params.distance = 18000;
    if (cube.params.pitch < 50) cube.params.pitch = 50;
    if (cube.params.pitch > 1200) cube.params.pitch = 1200;
    if (cube.params.pan_x < -8000) cube.params.pan_x = -8000;
    if (cube.params.pan_x > 8000) cube.params.pan_x = 8000;
    cube.params.yaw = cube.params.yaw % 6283;
    return TRUE;
}
U0 Cube(I64 max_frames = 0, Bool direct = TRUE)
{
    U8 *vert = NULL, *frag = NULL; I64 vert_size, frag_size, now, last, deadline;
    Bool running = TRUE; U0 (*finish)();
    if (cube.active) {Print("Cube is already running\n"); return;}
    if (!fb.venus || !venus_frame_hook || !venus_fill_hook) {
        Print("Cube needs the Venus terminal and its local framebuffer (make cube-run).\n"); return;
    }
    if (!GrWindow && Fs->terminal != vt_screen) {Print("Run Cube in the main framebuffer shell, outside Tmux.\n"); return;}
    vert = FileRead("C:/Vulkan/cube.vert.spv", &vert_size);
    frag = FileRead("C:/Vulkan/cube.frag.spv", &frag_size);
    if (!vert || !frag || vert_size < 20 || frag_size < 20 || (vert_size & 3) || (frag_size & 3) ||
            *vert(U32i *) != 0x07230203 || *frag(U32i *) != 0x07230203) {
        Free(vert); Free(frag); Print("Cube shaders missing or invalid; run make cube-disk.\n"); return;
    }
    MemSet(&cube, 0, sizeof(CCubeDemo)); MemSet(&gfx, 0, sizeof(CGfx));
    cube.window = GrWindow; cube.owner = Fs; cube.direct = cube.window && direct;
    if (cube.window) Fs->exit_hook = &CubeTaskExit;
    cube.active = TRUE; shell_stmt_cleanup = &CubeClose;
    gfx.next_id = cube_ids; if (!gfx.next_id) gfx.next_id = (Fs->task_num + 1) << 32;
    gfx.no_sleep = TRUE; gfx.soft_fail = TRUE;
    CubeReset;
    try {
        CubeLock;
        // Recheck ownership while serialized with other framebuffer clients.
        GfxCheck(fb.venus && venus_fill_hook != NULL, "cube display already in use");
        cube.frame_hook = venus_frame_hook; cube.fill_hook = venus_fill_hook; cube.finish_hook = venus_finish_hook;
        if (!cube.window) {
            finish = cube.finish_hook; if (finish) (*finish)();
            FbVenusHooks(&CubeConsole, NULL, &CubeFinish); cube.hooks = TRUE;
        }
        CubeGpuInit;
        cube.shaders[0] = CubeShader(vert, vert_size); cube.shaders[1] = CubeShader(frag, frag_size);
        CubeTarget; CubeDraw; CubeUnlock;
        Free(vert); vert = NULL; Free(frag); frag = NULL;
        if (cube.direct) Print("CUBE VULKAN WINDOW READY\n");
        if (cube.window) {Print("CUBE WINDOW READY\n"); GuiAddMenu(cube.window, "File"); GuiAddMenuItem(cube.window, 0, 0, "Close");}
        Print("CUBE READY\n"); last = ArchCntVct;
        while (running && (!max_frames || cube.frames < max_frames)) {
            deadline = ArchCntVct + cnt_freq / 30;
            if (cube.window) {
                CGuiEvent event;
                while (GuiPoll(&event) && running) {
                    if (event.type == GUI_EVENT_CLOSE || (event.type == GUI_EVENT_MENU && !event.key)) running = FALSE;
                    else if (event.type == GUI_EVENT_KEY) {running = CubeKey(event.key & KEY_CODE); Print("CUBE WINDOW KEY\n");}
                    else if (event.type == GUI_EVENT_MOUSE) {
                        if ((event.buttons & 1) && cube.mouse_down) {cube.params.yaw += (event.x - cube.mouse_x) * 10; cube.params.pitch += (event.y - cube.mouse_y) * 5;}
                        cube.mouse_down = event.buttons & 1; cube.mouse_x = event.x; cube.mouse_y = event.y;
                        cube.params.distance = ClampI64(cube.params.distance - event.wheel * 220, 2800, 18000);
                        cube.params.pitch = ClampI64(cube.params.pitch, 50, 1200);
                    }
                }
            } else while (KeyPending && running) running = CubeKey(GetKey & KEY_CODE);
            if (!running) break;
            now = ArchCntVct;
            if (!cube.paused) cube.params.ms = (cube.params.ms + (now - last) * 1000 / cnt_freq) % 600000;
            last = now;
            CubeLock; CubeDraw; CubeUnlock;
            now = ArchCntVct;
            if (deadline > now) Sleep((deadline - now) * 1000 / cnt_freq + 1);
            else Yield;
        }
    } catch {Fs->catch_except = TRUE; Print("Cube stopped after a graphics error.\n");}
    Free(vert); Free(frag); CubeClose;
    Print("CUBE CLOSED frames=%d\n", cube.frames);
}

U0 CubeWindow(I64 max_frames = 0, Bool direct = TRUE)
{
    if (!GuiNewPixel("Cube", 480, 300)) {Print("CubeWindow needs an independent GUI task. Use GuiCube;\n"); return;}
    Cube(max_frames, direct);
}
