    pragma Foreign_Export(External_Name => "WvimDestroy");
    function destroy(s: Int64): Unit is
        let state: &![State, Static] := @embed(&![State, Static], "$1", s);
        freeMemory(state->scratch_VimGotoDefinition);
        freeMemory(state->scratch_VimNormal);
        freeMemory(state->scratch_VimKey);
        freeMemory(state->scratch_VimDraw);
        freeMemory(state->scratch_VimDispatch);
        freeMemory(state->vim_name);
        freeMemory(state->vim_cmd);
        freeMemory(state->vim_search);
        freeMemory(state->vim_keys);
        freeMemory(state->vim_dot);
        freeMemory(state->vim_hpos);
        freeMemory(state->vim_hent);
        freeMemory(state->vim_har);
        freeMemory(state->vim_jfile);
        freeMemory(state->vim_jpos);
        freeMemory(state->vim_jtop);
        freeMemory(state->vim_jleft);
        deallocate(@embed(Pointer[State], "$1", s)); return nil;
    end;
    pragma Foreign_Export(External_Name => "WvimOpen");
    function exportedOpen(s: Int64, arg_name: Int64): Int64 is
        return VimOpen(s, arg_name);
    end;
    pragma Foreign_Export(External_Name => "WvimClose");
    function exportedClose(s: Int64): Unit is
        VimClose(s); return nil;
    end;
    pragma Foreign_Export(External_Name => "WvimRun");
    function exportedRun(s: Int64, arg_name: Int64, arg_line: Int64): Unit is
        Vim(s, arg_name, arg_line); return nil;
    end;
    pragma Foreign_Export(External_Name => "WvimPos");
    function getpos(s: Int64): Int64 is let state: &![State, Static] := @embed(&![State, Static], "$1", s); return state->vim_pos; end;
    pragma Foreign_Export(External_Name => "WvimTop");
    function gettop(s: Int64): Int64 is let state: &![State, Static] := @embed(&![State, Static], "$1", s); return state->vim_top; end;
    pragma Foreign_Export(External_Name => "WvimLeft");
    function getleft(s: Int64): Int64 is let state: &![State, Static] := @embed(&![State, Static], "$1", s); return state->vim_left; end;
    pragma Foreign_Export(External_Name => "WvimKey");
    function exportedKey(s: Int64, event: Int64): Int64 is return VimKey(s, event); end;
    pragma Foreign_Export(External_Name => "WvimPaint");
    function exportedPaint(s: Int64): Unit is VimDraw(s); return nil; end;
    function main(): ExitCode is return ExitSuccess(); end;
end module body.
