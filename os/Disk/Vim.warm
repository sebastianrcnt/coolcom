        let state: &![State, Static] := @embed(&![State, Static], "$1", s);
        var p: Int64 := input_p;
        var arg_s: Int64 := input_arg_s;
        var n: Int64 := input_n;
        var e: Int64 := 0;
        e := 0;
        if (not (VimLogRoom(s, n) /= 0)) then
            let temp1: Int64 := 0;
            return temp1;
        end if;
        if (state->vim_en > state->vim_tx_e) then
            let temp2: Int64 := (state->vim_el + (((state->vim_en - 1) * 4) * 8));
            e := temp2;
            if ((not (@embed(Int64, "*($1)", @embed(Pointer[Int64], "$1", (e + 1 * 8))) /= 0)) and ((@embed(Int64, "*($1)", @embed(Pointer[Int64], "$1", (e + 0 * 8))) + @embed(Int64, "*($1)", @embed(Pointer[Int64], "$1", (e + 2 * 8)))) = p)) then
                MemCpy((state->vim_ea + (state->vim_an * 1)), arg_s, n);
                let temp3: Int64 := (@embed(Int64, "*($1)", @embed(Pointer[Int64], "$1", (e + 2 * 8))) + n);
                @embed(Unit, "AU_STORE($1, $2)", @embed(Pointer[Int64], "$1", (e + 2 * 8)), temp3);
                let temp4: Int64 := (state->vim_an + n);
                state->vim_an := temp4;
                let temp5: Int64 := 1;
                return temp5;
            end if;
        end if;
        let temp6: Int64 := (state->vim_el + ((state->vim_en * 4) * 8));
        e := temp6;
        let temp7: Int64 := p;
        @embed(Unit, "AU_STORE($1, $2)", @embed(Pointer[Int64], "$1", (e + 0 * 8)), temp7);
        let temp8: Int64 := 0;
        @embed(Unit, "AU_STORE($1, $2)", @embed(Pointer[Int64], "$1", (e + 1 * 8)), temp8);
        let temp9: Int64 := n;
        @embed(Unit, "AU_STORE($1, $2)", @embed(Pointer[Int64], "$1", (e + 2 * 8)), temp9);
        let temp10: Int64 := state->vim_an;
        @embed(Unit, "AU_STORE($1, $2)", @embed(Pointer[Int64], "$1", (e + 3 * 8)), temp10);
        MemCpy((state->vim_ea + (state->vim_an * 1)), arg_s, n);
        let temp11: Int64 := (state->vim_an + n);
        state->vim_an := temp11;
        let temp12: Int64 := state->vim_en;
        state->vim_en := temp12 + 1;
