    function literal(value: Span[Nat8, Static]): Int64 is return @embed(Int64, "($1).data", value); end;
    function VimLen(s: Int64): Int64 is
        let state: &![State, Static] := @embed(&![State, Static], "$1", s);
        let gap: Int64 := @embed(Int64, "$1 - $2", state->vim_ge, state->vim_gs);
        return @embed(Int64, "$1 - $2", state->vim_cap, gap);
    end;
    -- Offsets are bounded by the gap-buffer capacity before the byte load.
    function VimAt(s: Int64, i: Int64): Int64 is
        let state: &![State, Static] := @embed(&![State, Static], "$1", s);
        if i < 0 then return 0; end if;
        var offset: Int64 := i;
        if i >= state->vim_gs then
            let gap: Int64 := @embed(Int64, "$1 - $2", state->vim_ge, state->vim_gs);
            offset := @embed(Int64, "$1 + $2", i, gap);
        end if;
        if offset >= state->vim_cap then return 0; end if;
        let address: Int64 := @embed(Int64, "$1 + $2", state->vim_buf, offset);
        return @embed(Int64, "*($1)", @embed(Pointer[Nat8], "$1", address));
    end;
    -- Copy logical bytes across the gap without flattening the file.
    function VimCopy(s: Int64, input_dst: Int64, input_a: Int64, input_n: Int64): Unit is
        let state: &![State, Static] := @embed(&![State, Static], "$1", s);
        var dst: Int64 := input_dst;
        var a: Int64 := input_a;
        var n: Int64 := input_n;
        var k: Int64 := 0;
        k := 0;
        if (a < state->vim_gs) then
            let temp1: Int64 := (state->vim_gs - a);
            k := temp1;
            if (k > n) then
                let temp2: Int64 := n;
                k := temp2;
            end if;
            MemCpy(dst, (state->vim_buf + (a * 1)), k);
            let temp3: Int64 := (dst + k);
            dst := temp3;
            let temp4: Int64 := (a + k);
            a := temp4;
            let temp5: Int64 := (n - k);
            n := temp5;
        end if;
        if (n > 0) then
            MemCpy(dst, (((state->vim_buf + (a * 1)) + (state->vim_ge * 1)) - (state->vim_gs * 1)), n);
        end if;
        return nil;
    end;
    function VimSame(s: Int64, input_arg_s: Int64, input_n: Int64): Int64 is
        let state: &![State, Static] := @embed(&![State, Static], "$1", s);
        var arg_s: Int64 := input_arg_s;
        var n: Int64 := input_n;
        if (n /= VimLen(s)) then
            let temp1: Int64 := 0;
            return temp1;
        end if;
        if (MemCmp(state->vim_buf, arg_s, state->vim_gs) /= 0) then
            let temp2: Int64 := 0;
            return temp2;
        end if;
        let temp3: Int64 := (if (not (MemCmp((state->vim_buf + (state->vim_ge * 1)), (arg_s + (state->vim_gs * 1)), (n - state->vim_gs)) /= 0)) then 1 else 0);
        return temp3;
    end;
    -- Count line separators on each side of the gap.
    function VimNewlines(s: Int64, input_a: Int64, b: Int64): Int64 is
        let state: &![State, Static] := @embed(&![State, Static], "$1", s);
        var a: Int64 := input_a;
        var e: Int64 := b;
        var count: Int64 := 0;
        if e > state->vim_gs then e := state->vim_gs; end if;
        var cursor: Int64 := @embed(Int64, "$1 + $2", state->vim_buf, a);
        var limit: Int64 := @embed(Int64, "$1 + $2", state->vim_buf, e);
        while cursor < limit do
            if @embed(Int64, "*($1)", @embed(Pointer[Nat8], "$1", cursor)) = 10 then
                count := @embed(Int64, "$1 + $2", count, 1);
            end if;
            cursor := @embed(Int64, "$1 + $2", cursor, 1);
        end while;
        if a < state->vim_gs then a := state->vim_gs; end if;
        let gap: Int64 := @embed(Int64, "$1 - $2", state->vim_ge, state->vim_gs);
        let base: Int64 := @embed(Int64, "$1 + $2", state->vim_buf, gap);
        cursor := @embed(Int64, "$1 + $2", base, a);
        limit := @embed(Int64, "$1 + $2", base, b);
        while cursor < limit do
            if @embed(Int64, "*($1)", @embed(Pointer[Nat8], "$1", cursor)) = 10 then
                count := @embed(Int64, "$1 + $2", count, 1);
            end if;
            cursor := @embed(Int64, "$1 + $2", cursor, 1);
        end while;
        return count;
    end;
    function VimTouch(s: Int64, input_p: Int64): Unit is
        let state: &![State, Static] := @embed(&![State, Static], "$1", s);
        var p: Int64 := input_p;
        if (p < state->vim_syn_off) then
            let temp1: Int64 := 0;
            state->vim_syn_ok := temp1;
        end if;
        return nil;
    end;
    function VimRoom(s: Int64, input_n: Int64): Int64 is
        let state: &![State, Static] := @embed(&![State, Static], "$1", s);
        var n: Int64 := input_n;
        var tail: Int64 := 0;
        var cap: Int64 := 0;
        var nb: Int64 := 0;
        tail := (state->vim_cap - state->vim_ge);
        cap := 0;
        nb := 0;
        if ((state->vim_ge - state->vim_gs) >= n) then
            let temp1: Int64 := 1;
            return temp1;
        end if;
        let temp2: Int64 := ((((VimLen(s) + n) * 3) / 2) + 4096);
        cap := temp2;
        let temp3: Int64 := MAlloc(cap, 0);
        nb := temp3;
        if (not (nb /= 0)) then
            let temp4: Int64 := ((VimLen(s) + n) + 64);
            cap := temp4;
            let temp5: Int64 := MAlloc(cap, 0);
            nb := temp5;
        end if;
        if (not (nb /= 0)) then
            let temp6: Int64 := 0;
            return temp6;
        end if;
        MemCpy(nb, state->vim_buf, state->vim_gs);
        MemCpy(((nb + (cap * 1)) - (tail * 1)), (state->vim_buf + (state->vim_ge * 1)), tail);
        freeMemory(state->vim_buf);
        let temp7: Int64 := nb;
        state->vim_buf := temp7;
        let temp8: Int64 := (cap - tail);
        state->vim_ge := temp8;
        let temp9: Int64 := cap;
        state->vim_cap := temp9;
        let temp10: Int64 := 1;
        return temp10;
    end;
    function VimGapAt(s: Int64, input_p: Int64): Unit is
        let state: &![State, Static] := @embed(&![State, Static], "$1", s);
        var p: Int64 := input_p;
        var g: Int64 := 0;
        g := (state->vim_ge - state->vim_gs);
        if (p < state->vim_gs) then
            MemCpy(((state->vim_buf + (p * 1)) + (g * 1)), (state->vim_buf + (p * 1)), (state->vim_gs - p));
        else
            if (p > state->vim_gs) then
                MemCpy((state->vim_buf + (state->vim_gs * 1)), (state->vim_buf + (state->vim_ge * 1)), (p - state->vim_gs));
            end if;
        end if;
        let temp1: Int64 := p;
        state->vim_gs := temp1;
        let temp2: Int64 := (p + g);
        state->vim_ge := temp2;
        return nil;
    end;
    function VimRawInsert(s: Int64, input_p: Int64, input_arg_s: Int64, input_n: Int64): Unit is
        let state: &![State, Static] := @embed(&![State, Static], "$1", s);
        var p: Int64 := input_p;
        var arg_s: Int64 := input_arg_s;
        var n: Int64 := input_n;
        VimGapAt(s, p);
        MemCpy((state->vim_buf + (state->vim_gs * 1)), arg_s, n);
        let temp1: Int64 := (state->vim_gs + n);
        state->vim_gs := temp1;
        VimTouch(s, p);
        return nil;
    end;
    function VimRawDelete(s: Int64, input_p: Int64, input_n: Int64): Unit is
        let state: &![State, Static] := @embed(&![State, Static], "$1", s);
        var p: Int64 := input_p;
        var n: Int64 := input_n;
        VimGapAt(s, p);
        let temp1: Int64 := (state->vim_ge + n);
        state->vim_ge := temp1;
        VimTouch(s, p);
        return nil;
    end;
    -- Undo records keep offsets into the append-only edit arena.
    function VimLogRoom(s: Int64, input_bytes: Int64): Int64 is
        let state: &![State, Static] := @embed(&![State, Static], "$1", s);
        var bytes: Int64 := input_bytes;
        var cap: Int64 := 0;
        var ne: Int64 := 0;
        var na: Int64 := 0;
        cap := 0;
        ne := 0;
        na := 0;
        if (state->vim_en >= state->vim_ecap) then
            let temp1: Int64 := ((state->vim_ecap * 2) + 64);
            cap := temp1;
            let temp2: Int64 := ReAlloc(state->vim_el, ((cap * 4) * 8));
            ne := temp2;
            if (not (ne /= 0)) then
                let temp3: Int64 := 0;
                return temp3;
            end if;
            let temp4: Int64 := ne;
            state->vim_el := temp4;
            let temp5: Int64 := cap;
            state->vim_ecap := temp5;
