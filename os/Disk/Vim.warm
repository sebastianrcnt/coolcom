-- Modal UTF-8 editor. The gap buffer, undo journal, jumps and all edit logic
-- belong to this module. Only opaque syntax state and terminal/file services
-- cross the kernel boundary. Raw offsets below refer to editor-owned memory.
pragma Unsafe_Module;
import OS.CoolOS.Editor (MemCpy, MemCmp, MAlloc, freeMemory, ReAlloc, Utf8Len, Utf8Width, StrLen, FileFind, FileRead, CAlloc, SynLang, StrCpy, StrCmp, EditorSynNew, EditorSynStart, EditorSynLine, HCTIsId, HCTStrEq, HCTIsKwSp, HCTIsKw2, EditorDefinition, FileWrite, EditorFileSize, StrNCmp, SynGroupName, Str2I64, EditorSetColor, Utf8Enc, AnsiTermSize, Utf8Cp, ConsPut, EditorSynCopy, EditorSynFast, AnsiCursorHide, AnsiCursor, AnsiReset, AnsiClearEol, SynColor, AnsiFg, EditorFormat, ConsPutS, AnsiSet, LineWidth, StrCat, EditorIme, AnsiCursorShow, EditorSynFree, AnsiAltScreen, EditorPrint, GetKey, KeyPending, LinePrev);
