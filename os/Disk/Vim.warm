                state->filetypePrefix := literal("set ft=");
                state->coolType := literal("cool");
                state->warmType := literal("warm");
                state->asmType := literal("asm");
                state->textType := literal("text");
                state->filetypeErrorMessage := literal("Unknown filetype (cool, warm, asm, text)");
                state->filetypeMessage := literal("Filetype set");
