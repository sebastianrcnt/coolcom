// Translated from Aiwnios c/arm64_asm.c (nrootconauto, BSD-3), commit e155e87.
//
// AArch64 instruction encoder. Every ARM_* function returns the 32-bit
// instruction word (or ARM_ERR_INV_OFF / ARM_ERR_INV_REG).
//
// PORT-NOTE: C's `(1 << 31)` is a negative 32-bit int that sign-extends to
// 64 bits; HolyC computes it as +0x80000000. Only bits 32..63 of the returned
// I64 differ; callers store the result into an I32/U32 slot so the emitted
// instruction word is identical.
//
// PORT-NOTE: HolyC operator precedence differs from C (shifts and the bitwise
// operators & ^ | bind tighter than + - * / and comparisons). All mixed
// expressions here are fully parenthesised.
//
// PORT-NOTE: `reg` is a HolyC keyword, so UncondBr1Reg's parameter `reg` is
// named `rreg`.
//
// PORT-NOTE: binary literals (0b11) were rewritten as hex; the C macros
// BMASKn, ARM_FORCE_ALIGN and ARM_FORCE_REG became functions (the latter two
// return TRUE on failure: `if (ArmForceAlignBad(..)) return ARM_ERR_INV_OFF;`).

I64 BMASKn(I64 v, I64 bits, I64 off)
{
    return (v & ((1 << bits) - 1)) << off;
}

// https://math.stackexchange.com/questions/490813/range-twos-complement
// ARM_FORCE_ALIGN(v, bits, chop): returns TRUE where the C macro would
// `return ARM_ERR_INV_OFF`.
Bool ArmForceAlignBad(I64 v, I64 bits, I64 chop)
{
    if (v & ((1 << chop) - 1))
        return TRUE;
    if (v >= 0) {
        if ((v >> chop) > ((1 << (bits - 1)) - 1))
            return TRUE;
    } else if (((-v) >> chop) > (1 << (bits - 1)))
        return TRUE;
    return FALSE;
}

// ARM_FORCE_REG(r): returns TRUE where the C macro would
// `return ARM_ERR_INV_REG`.
Bool ArmForceRegBad(I64 r)
{
    if (r < 0)
        return TRUE;
    if (r > 32)
        return TRUE;
    return FALSE;
}

// The CARMAdr* classes (local types of arm64_asm.c) are defined in BackendA.coolh.
// PORT-NOTE: __builtin_ctzl/__builtin_clzl are declared in BackendA.coolh and
// implemented in IRBind.cool (the argument is never zero at the call sites).

I64 LdStRegExt(I64 sz, I64 opc, I64 rt, I64 n,
               I64 m, I64 mod) {
    I64 s = 1;
    I64 v = 0;
    return (sz << 30) | (7 << 27) | (v << 26) | (opc << 22) | (1 << 21) |
            (m << 16) | (mod << 13) | (s << 12) | (2 << 10) | (n << 5) | rt;
}

I64 BMvWideImmX(U32 opc, I64 d, I64 imm, I64 shift) {
    if (imm & ~0xffff)
        return ARM_ERR_INV_OFF;
    if (ArmForceRegBad(d))
        return ARM_ERR_INV_REG;
    U32 hw = (shift >> 4) & 0x3;
    U32 imm16 = imm & 0xffff;
    return (1 << 31) | (opc << 29) | (0x25 << 23) | (hw << 21) | (imm16 << 5) | d;
}
I64 BDataProc2Src(U32 opcode, I64 rd, I64 rn,
                  I64 rm) {
    if (ArmForceRegBad(rn))
        return ARM_ERR_INV_REG;
    if (ArmForceRegBad(rm))
        return ARM_ERR_INV_REG;
    if (ArmForceRegBad(rd))
        return ARM_ERR_INV_REG;
    U32 sf = 1;
    U32 S = 0;
    return (sf << 31) | (S << 29) | (0xd6 << 21) | (rm << 16) | (opcode << 10) |
            (rn << 5) | rd;
}

I64 BFpComp(U32 M, U32 S, U32 type, U32 op,
            U32 opcode2, I64 vn, I64 vm) {
    if (ArmForceRegBad(vn))
        return ARM_ERR_INV_REG;
    if (ArmForceRegBad(vm))
        return ARM_ERR_INV_REG;
    return (M << 31) | (S << 29) | (0xf << 25) | (type << 22) | (1 << 21) |
            (vm << 16) | (op << 14) | (1 << 13) | (vn << 5) | opcode2;
}

I64 BFpDataProc1Reg(U32 M, U32 S, U32 type,
                    U32 opcode, I64 vd, I64 vn) {
    if (ArmForceRegBad(vn))
        return ARM_ERR_INV_REG;
    if (ArmForceRegBad(vd))
        return ARM_ERR_INV_REG;
    return (M << 31) | (S << 29) | (0xf << 25) | (type << 22) | (1 << 21) |
            (opcode << 15) | (1 << 14) | (vn << 5) | vd;
}

I64 LdStRegPairPostImm(I64 opc, I64 l, I64 r, I64 r2,
                       CBARMAdrPostImm *pre) {
    I64 imm = pre->off;
    I64 times = 1;
    if (opc == 2)
        times = 2;
    if (ArmForceAlignBad(imm, 7, times + 1))
        return ARM_ERR_INV_OFF;
    I64 imm7 = BMASKn(imm >> (times + 1), 7, 15);
    return (opc << 30) | (0x5 << 27) | (1 << 23) | (l << 22) | imm7 | (r2 << 10) |
            (pre->n << 5) | r;
}
I64 LdStRegPairPre(I64 opc, I64 L, I64 rt1, I64 rt2,
                   CBARMAdrPreImm *adr) {
    I64 imm = adr->off;
    I64 times = 1;
    if (opc == 2)
        times = 2;
    if (ArmForceAlignBad(imm, 7, times + 1))
        return ARM_ERR_INV_OFF;
    U32 imm7 = BMASKn(imm >> (times + 1), 7, 15);
    return (opc << 30) | (0x5 << 27) | (3 << 23) | (L << 22) | imm7 |
            (rt2 << 10) | (adr->n << 5) | rt1;
}

// For 64bit
I64 LdStSimdFpUnImm(I32 opc, I64 vt, I64 n,
                    I64 imm) {
    U32 imm12 = BMASKn(imm >> 3, 12, 10);
    if (ArmForceAlignBad(imm, 12, 3))
        return ARM_ERR_INV_OFF;
    if (imm < 0)
        return ARM_ERR_INV_OFF;
    return (3 << 30) | (0x7 << 27) | (1 << 26) | (1 << 24) | (opc << 22) | imm12 |
            (n << 5) | vt;
}

I64 LdRegSimdFpLiteralEnc(I64 vt, I64 imm) {
    U32 imm19 = BMASKn(imm >> 2, 19, 5);
    if (ArmForceAlignBad(imm, 19, 2))
        return ARM_ERR_INV_OFF;
    return (1 << 30) | (0x3 << 27) | (1 << 26) | imm19 | vt;
}

I64 LdStRegPre(I64 sz, I64 opc, I64 r,
               CBARMAdrPreImm *adr) {
    if (ArmForceAlignBad(adr->off, 9, 0))
        return ARM_ERR_INV_OFF;
    return (sz << 30) | (0x7 << 27) | (0xf << 27) | (opc << 22) |
            BMASKn(adr->off, 9, 12) | (3 << 10) | (adr->n << 5) | r;
}

I64 LdStRegPostImm(I64 sz, I64 opc, I64 r,
                   CBARMAdrPostImm *adr) {
    if (ArmForceAlignBad(adr->off, 9, 0))
        return ARM_ERR_INV_OFF;
    return (sz << 30) | (0xf << 27) | (0xf << 27) | (opc << 22) |
            BMASKn(adr->off, 9, 12) | (1 << 10) | (adr->n << 5) | r;
}

I64 BFpDataProc2Reg(I64 M, I64 s, I64 type,
                    I64 opcode, I64 d, I64 n, I64 m) {
    return (M << 31) | (s << 29) | (0xf << 25) | (type << 22) | (1 << 21) |
            (m << 16) | (opcode << 12) | (2 << 10) | (n << 5) | d;
}

I64 BLdRegLiteralEnc(I64 opc, I64 v, I64 r,
                     I64 label) {
    if (ArmForceAlignBad(label, 19, 2))
        return ARM_ERR_INV_OFF;
    return (opc << 30) | (0x3 << 27) | (v << 26) | BMASKn(label >> 2, 19, 5) | r;
}
I64 ConversionFpIntIF(I64 sf, I64 s, I64 type,
                      I64 rmode, I64 opcode, I64 d,
                      I64 n) {
    return (sf << 31) | (s << 29) | (0xf << 25) | (type << 22) | (1 << 21) |
            (rmode << 19) | (opcode << 16) | (n << 5) | d;
}
I64 ConversionFpIntFI(U32 sf, U32 S, U32 type,
                      U32 rmode, U32 opcode, I32 vd,
                      I32 rn) {
    return (sf << 31) | (S << 29) | (0xf << 25) | (type << 22) | (1 << 21) |
            (rmode << 19) | (opcode << 16) | (rn << 5) | (vd);
}
I64 BLdStRegUnImm(I64 sz, I64 opc, I64 r,
                  CBARMAdrRegImm *adr) {
    if (ArmForceAlignBad(adr->off, 12, sz))
        return ARM_ERR_INV_OFF;
    return BMASKn(adr->off >> sz, 12, 10) | (sz << 30) | (0x7 << 27) | (1 << 24) |
            (opc << 22) | (adr->n << 5) | (r);
}

I64 BLdStRegReg(I64 size, I64 opc, I64 rt, I64 m,
                I64 n, I64 shift) {
    //(1<<12) triggers shift
    I64 S = shift;
    return (size << 30) | (0x7 << 27) | (opc << 22) | (1 << 21) | (n << 16) |
            (3 << 13) | (S << 12) | (2 << 10) | (m << 5) | rt;
}

I64 CompareBr(I64 op, I64 r, I64 imm) {
    if (ArmForceAlignBad(imm, 19, 2))
        return ARM_ERR_INV_OFF;
    return (0x1a << 25) | (op << 24) | BMASKn(imm >> 2, 19, 5) | r;
}

I64 CompareBrX(I64 op, I64 r, I64 imm) {
    if (ArmForceAlignBad(imm, 19, 2))
        return ARM_ERR_INV_OFF;
    return (1 << 31) | (0x1a << 25) | (op << 24) | BMASKn(imm >> 2, 19, 5) | r;
}

I64 BUncondBrNoReg(I64 opc, I64 op2, I64 op3, I64 rn,
                   I64 op4) {
    return (0x6b << 25) | (opc << 21) | (op2 << 16) | (op3 << 10) | (rn << 5) |
            op4;
}

I64 UncondBrImm(I64 op, I64 label) {
    if (ArmForceAlignBad(label, 26, 2))
        return ARM_ERR_INV_OFF;
    return (op << 31) | (5 << 26) | BMASKn(label >> 2, 26, 0);
}

I64 UncondBr1Reg(I64 opc, I64 op2, I64 op3, I64 rreg,
                 I64 op4) {
    return (0x6b << 25) | (opc << 21) | (op2 << 16) | (op3 << 10) | (rreg << 5) |
            op4;
}

I64 CondBrImm(I64 cond, I64 imm) {
    if (ArmForceAlignBad(imm, 19, 2))
        return ARM_ERR_INV_OFF;
    return (0x2a << 25) | BMASKn(imm >> 2, 19, 5) | cond;
}
I64 AddSubImm(I64 op, I64 s, I64 d, I64 n,
              I64 imm, I64 sh) {
    if (ArmForceAlignBad(imm, 12, 0))
        return ARM_ERR_INV_OFF;
    I32 imm12 = BMASKn(imm, 12, 10);
    I32 shift = BMASKn(sh, 1, 22);
    return imm12 | shift | BMASKn(d, 6, 0) | BMASKn(n, 6, 5) | (0x11 << 24) |
            (s << 29) | (op << 30);
}

I64 TestBr(I64 op, I64 rt, I64 imm, I64 off) {
    I64 d5 = (imm >> 5) & 1;
    I64 d40 = BMASKn(imm, 5, 0);
    I64 imm14 = BMASKn(off >> 2, 14, 5);
    if (ArmForceAlignBad(off, 14, 2))
        return ARM_ERR_INV_OFF;
    return (d5 << 31) | (0x1b << 25) | (op << 24) | (d40 << 19) | imm14 | rt;
}

I64 Bitfield(I64 op, I64 d, I64 n, U64 immr,
             U64 imms) {
    return (op << 29) | (0x26 << 23) | (0 << 22) | BMASKn(immr, 6, 16) |
            BMASKn(imms, 6, 10) | (n << 5) | d;
}

I64 BBitfieldX(I64 op, I64 d, I64 n, U64 immr,
               U64 imms) {
    return (1 << 31) | (op << 29) | (0x26 << 23) | (1 << 22) |
            BMASKn(immr, 6, 16) | BMASKn(imms, 6, 10) | (n << 5) | d;
}

I64 BAddSubImmX(I64 op, I64 s, I64 d, I64 n,
                I64 imm, I64 sh) {
    if (imm < 0)
        return ARM_ERR_INV_OFF;
    if (ArmForceAlignBad(imm, 12, 0))
        return ARM_ERR_INV_OFF;
    I32 imm12 = BMASKn(imm, 12, 10);
    I32 shift = BMASKn(sh, 1, 22);
    return (1 << 31) | imm12 | shift | BMASKn(d, 6, 0) | BMASKn(n, 6, 5) |
            (0x11 << 24) | (s << 29) | (op << 30);
}

I64 AddSubExtReg(I64 opc, I64 s, I64 d, I64 n,
                 I64 m, I64 emod, I64 sh) {
    return (opc << 30) | (s << 29) | (0xb << 24) | (1 << 21) | (m << 16) |
            (emod << 13) | BMASKn(sh, 3, 10) | (n << 5) | d;
}

I64 BAddSubExtRegX(I64 opc, I64 s, I64 d, I64 n,
                   I64 m, I64 emod, I64 sh) {
    U32 option = emod;
    if (emod == 12)
        option = 3;
    return (1 << 31) | (opc << 30) | (s << 29) | (0xb << 24) | (1 << 21) |
            (m << 16) | (option << 13) | BMASKn(sh, 3, 10) | (n << 5) | d;
}

I64 AddSubShiftReg(I64 opc, I64 s, I64 d, I64 n,
                   I64 m, I64 shmod, I64 sh,
                   I64 alias) {
    I64 rd_sp = d == 31;
    I64 rn_sp = d == 31;
    if (((rd_sp + rn_sp) >= 1 + alias) && shmod == LSL) {
        return AddSubExtReg(opc, s, d, n, m, 12, sh);
    }
    return (opc << 30) | (s << 29) | (0xb << 24) | (shmod << 22) | (m << 16) |
            BMASKn(sh, 6, 10) | (n << 5) | d;
}

I64 LdStSimdFpRegPostImm(I64 opc, I64 d, I64 p,
                         I64 off) {
    if (ArmForceAlignBad(off, 9, 0))
        return ARM_ERR_INV_OFF;
    return (3 << 30) | (0x7 << 27) | (1 << 26) | (opc << 22) | BMASKn(off, 9, 12) |
            (1 << 10) | (p << 5) | d;
}

I64 LdStSimdFpRegPreImm(I64 opc, I64 d, I64 p,
                        I64 off) {
    if (ArmForceAlignBad(off, 9, 0))
        return ARM_ERR_INV_OFF;
    return (3 << 30) | (0x7 << 27) | (1 << 26) | (opc << 22) | BMASKn(off, 9, 12) |
            (3 << 10) | (p << 5) | d;
}

I64 BAddSubShiftRegX(I64 opc, I64 s, I64 d, I64 n,
                     I64 m, I64 shmod, I64 sh,
                     I64 alias) {
    I64 rd_sp = d == 31;
    I64 rn_sp = n == 31;
    if (((rd_sp + rn_sp) >= 1 + alias) && shmod == LSL) {
        return BAddSubExtRegX(opc, s, d, n, m, 12, sh);
    }
    return (1 << 31) | (opc << 30) | (s << 29) | (0xb << 24) | (shmod << 22) |
            (m << 16) | BMASKn(sh, 6, 10) | (n << 5) | d;
}

I64 DataProc3RegX(I64 op54, I64 op31, I64 o0, I64 d,
                  I64 n, I64 m, I64 ra) {
    return (1 << 31) | (op54 << 29) | (0x1b << 24) | (op31 << 21) | (m << 16) |
            (o0 << 15) | (ra << 10) | (n << 5) | (d);
}

I64 LogicalShiftReg(I64 opc, I64 N, I64 rd, I64 rn,
                    I64 rm, I64 shmod, U32 sh) {
    return (opc << 29) | (0xa << 24) | (shmod << 22) | (N << 21) | (rm << 16) |
            BMASKn(sh, 6, 10) | BMASKn(rn, 6, 5) | rd;
}

I64 BLogicalShiftRegX(I64 opc, I64 N, I64 rd, I64 rn,
                      I64 rm, I64 shmod, U32 sh) {
    return (1 << 31) | (opc << 29) | (0xa << 24) | (shmod << 22) | (N << 21) |
            (rm << 16) | BMASKn(sh, 6, 10) | BMASKn(rn, 6, 5) | rd;
}

I64 BCondSel(I64 op, I64 s, I64 op2, I64 d, I64 n,
             I64 m, I64 cond) {
    return (op << 30) | (s << 29) | (m << 16) | (cond << 12) | (op2 << 10) |
            (n << 5) | (d);
}

I64 CondSelX(I64 op, I64 s, I64 op2, I64 d,
             I64 n, I64 m, I64 cond) {
    return (1 << 31) | (op << 30) | (s << 29) | (0xd4 << 21) | (m << 16) |
            (cond << 12) | (op2 << 10) | (n << 5) | (d);
}

I64 MvReg(I64 d, I64 n) {
    if (d == 31 || n == 31) {
        return AddSubImm(0, 0, d, n, 0, 0);
    } else
        return LogicalShiftReg(1, 0, d, 31, n, LSL, 0);
}

I64 BMvRegX(I64 d, I64 n) {
    if (d == 31 || n == 31) {
        return BAddSubImmX(0, 0, d, n, 0, 0);
    } else
        return BLogicalShiftRegX(1, 0, d, 31, n, LSL, 0);
}

I64 LdStSimdFpRegRegShift(U32 opc, I64 vt, I64 rn,
                          I64 rm) {
    U32 size = 3;
    U32 option = 3;
    U32 S = 1;
    U32 V = 1;
    return (size << 30) | (0x7 << 27) | (V << 26) | (opc << 22) | (1 << 21) |
            (rm << 16) | (option << 13) | (S << 12) | (2 << 10) | (rn << 5) | vt;
}

// dst+=label
I64 ARM_adrX(I64 d, I64 pc_off) {
    I32 inst = 0x10 << 24;
    if (ArmForceAlignBad(pc_off, 21, 0))
        return ARM_ERR_INV_OFF;
    inst |= BMASKn(d, 6, 0);
    inst |= BMASKn(pc_off >> 2, 19, 5);
    inst |= BMASKn(pc_off, 2, 29);
    return inst;
}

I64 ARM_addImmX(I64 d, I64 n, I64 imm) {
    return BAddSubImmX(0, 0, d, n, imm, 0);
}

I64 ARM_subImmX(I64 d, I64 n, I64 imm) {
    return BAddSubImmX(1, 0, d, n, imm, 0);
}

I64 ARM_subsImmX(I64 d, I64 n, I64 imm) {
    return BAddSubImmX(1, 1, d, n, imm, 0);
}

I64 ARM_cmpImmX(I64 n, I64 imm) {
    return BAddSubImmX(1, 1, 31, n, imm, 0);
}

I64 ARM_andRegX(I64 rd, I64 rn, I64 rm) {
    return BLogicalShiftRegX(0, 0, rd, rn, rm, LSL, 0);
}

I64 ARM_orrRegX(I64 rd, I64 rn, I64 rm) {
    return BLogicalShiftRegX(1, 0, rd, rn, rm, LSL, 0);
}

// MVN move negative
I64 ARM_mvnShift(I64 rd, I64 rm, I64 shmod, I64 sh) {
    return LogicalShiftReg(1, 1, rd, 31, rm, shmod, sh);
}

I64 ARM_mvnShiftX(I64 rd, I64 rm, I64 shmod, I64 sh) {
    return BLogicalShiftRegX(1, 1, rd, 31, rm, shmod, sh);
}

// Psuedo inst i invented
I64 ARM_mvnReg(I64 rd, I64 rm) {
    return LogicalShiftReg(1, 1, rd, 31, rm, LSL, 0);
}

I64 ARM_mvnRegX(I64 rd, I64 rm) {
    return BLogicalShiftRegX(1, 1, rd, 31, rm, LSL, 0);
}

// exclusive xor
I64 ARM_eorShiftX(I64 rd, I64 rn, I64 rm, I64 shmod,
                  I64 sh) {
    return BLogicalShiftRegX(2, 0, rd, rn, rm, shmod, sh);
}

I64 ARM_eorRegX(I64 rd, I64 rn, I64 rm) {
    return ARM_eorShiftX(rd, rn, rm, LSL, 0);
}

I64 ARM_andsRegX(I64 rd, I64 rn, I64 rm) {
    return BLogicalShiftRegX(3, 0, rd, rn, rm, LSL, 0);
}

I64 ARM_movReg(I64 d, I64 n) {
    return MvReg(d, n);
}

I64 ARM_movRegX(I64 d, I64 n) {
    return BMvRegX(d, n);
}

I64 ARM_addShiftRegX(I64 d, I64 n, I64 m, I64 sh) {
    return BAddSubShiftRegX(0, 0, d, n, m, LSL, sh, 0);
}

I64 ARM_subShiftRegX(I64 d, I64 n, I64 m, I64 sh) {
    return BAddSubShiftRegX(1, 0, d, n, m, LSL, sh, 0);
}

I64 ARM_addShiftRegXs(I64 d, I64 n, I64 m, I64 sh) {
    return BAddSubShiftRegX(0, 1, d, n, m, LSL, sh, 0);
}

I64 ARM_subShiftRegXs(I64 d, I64 n, I64 m, I64 sh) {
    return BAddSubShiftRegX(1, 1, d, n, m, LSL, sh, 0);
}

I64 ARM_addRegX(I64 d, I64 n, I64 m) {
    return BAddSubShiftRegX(0, 0, d, n, m, LSL, 0, 0);
}

I64 ARM_addsRegX(I64 d, I64 n, I64 m) {
    return BAddSubShiftRegX(0, 1, d, n, m, LSL, 0, 0);
}

I64 ARM_addsImmX(I64 rd, I64 rn, I64 imm) {
    return BAddSubImmX(0, 1, rd, rn, imm, 0);
}

I64 ARM_subRegX(I64 d, I64 n, I64 m) {
    return BAddSubShiftRegX(1, 0, d, n, m, LSL, 0, 0);
}

I64 ARM_subsRegX(I64 d, I64 n, I64 m) {
    return BAddSubShiftRegX(1, 1, d, n, m, LSL, 0, 0);
}

I64 ARM_negsRegX(I64 d, I64 m) {
    return BAddSubShiftRegX(1, 1, d, 31, m, LSL, 0, 1);
}

I64 ARM_cmpRegX(I64 n, I64 m) {
    return BAddSubShiftRegX(1, 1, 31, n, m, LSL, 0, 1);
}

I64 ARM_csel(I64 d, I64 n, I64 m, I64 cond) {
    return BCondSel(0, 0, 0, d, n, m, cond);
}

I64 ARM_cselX(I64 d, I64 n, I64 m, I64 cond) {
    return CondSelX(0, 0, 0, d, n, m, cond);
}

I64 ARM_cset(I64 d, I64 cond) {
    return BCondSel(0, 0, 1, d, 31, 31, cond ^ 1);
}

I64 ARM_csetX(I64 d, I64 cond) {
    return CondSelX(0, 0, 1, d, 31, 31, cond ^ 1);
}

I64 ARM_mulRegX(I64 d, I64 n, I64 m) {
    return DataProc3RegX(0, 0, 0, d, n, m, 31);
}

I64 ARM_uxtb(I64 d, I64 n) {
    return Bitfield(2, d, n, 0, 7);
}

I64 ARM_uxtbX(I64 d, I64 n) {
    return BBitfieldX(2, d, n, 0, 7);
}

I64 ARM_uxth(I64 d, I64 n) {
    return Bitfield(2, d, n, 0, 15);
}

I64 ARM_uxthX(I64 d, I64 n) {
    return BBitfieldX(2, d, n, 0, 15);
}

I64 ARM_uxtwX(I64 d, I64 n) {
    return BBitfieldX(2, d, n, 0, 31);
}

I64 ARM_sxtb(I64 d, I64 n) {
    return BBitfieldX(0, d, n, 0, 7);
}

I64 ARM_sxtbX(I64 d, I64 n) {
    return BBitfieldX(0, d, n, 0, 7);
}

I64 ARM_sxth(I64 d, I64 n) {
    return Bitfield(0, d, n, 0, 15);
}

