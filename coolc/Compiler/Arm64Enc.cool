I64 ARM_stur(I64 r, I64 a, I64 off) {
    return LdStRegUnsImm(3, 0, r, a, off);
}
I64 ARM_ldur(I64 r, I64 a, I64 off) {
    return LdStRegUnsImm(3, 1, r, a, off);
}

