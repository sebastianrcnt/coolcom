                                    } else code_off = AIWNIOS_ADD_CODE(bin, code_off, ARM_bcc(ARM_GE, 0));
                                    if (bin) {
                                        ref = CodeMiscAddRef(rpn->code_misc, bin + code_off - 4);
                                        ref->patch_cond_br = &ARM_bcc;
                                        if (reverse) ref->user_data1 = ARM_GE ^ 1;
                                        else ref->user_data1 = ARM_GE;
