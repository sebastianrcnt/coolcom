// Owned frontend bootstrap unit. The native runtime and backend are included
// here as they are brought up. The checked-in native compiler BIN is the seed.
#define TARGET_AARCH64 1
#define TEXT_MODE 1
#define NATIVE_CANONICAL_AOT 1
#include "KernelA.coolh"
#include "CompilerA.coolh"
#include "CExts.cool"
#include "CompilerB.coolh"
#include "KGlbls.cool"
#include "KMisc.cool"
#include "CQue.cool"
#include "KDataTypes.cool"
#include "StrA.cool"
#include "KHashA.cool"
#include "KMath.cool"
#include "KMathB.cool"
#include "StrPrint.cool"
#include "KHashB.cool"
#include "StrB.cool"
#include "KDefine.cool"
#include "StrScan.cool"
#include "QSort.cool"
#include "NativeExcept.cool"
// The host supplies task access and allocation until the owned runtime is live.
U0 NativeInit()
{
    I64 i, j, count, reversed;
    adam_task = CAlloc(sizeof(CTask));
    SetFs(adam_task);
    Fs->addr = Fs;
    Fs->hash_table = HashTableNew(0x4000);
    QueInit(&Fs->next_cc);
    QueInit(&Fs->next_except);
    blkdev.tmp_filename = StrNew("NativeTmp.cool");
    set_bits_table = MAlloc(256);
    rev_bits_table = MAlloc(256);
    for (i = 0; i < 256; i++) {
        count = 0;
        reversed = 0;
        for (j = 0; j < 8; j++) {
            count += ((i >> j) & 1);
            reversed = (reversed << 1) | ((i >> j) & 1);
        }
        set_bits_table[i] = count;
        rev_bits_table[i] = reversed;
    }
}
NativeInit;
#include "Compiler.cool"

I64 CoolCMain(U8 *entry, U8 *output)
{
    return Cmp(entry, NULL, output);
}

I64 CoolCMainCompat(U8 *entry, U8 *output)
{
    return Cmp(entry, NULL, output, 0, TRUE);
}

I64 CoolCVet(U8 *entry)
{
    return Vet(entry);
}

I64 CoolCVetCompat(U8 *entry)
{
    return Vet(entry, TRUE);
}

I64 CoolCMainTarget(U8 *entry, U8 *output, I64 target, Bool compat)
{
    BTargetX86 = target == 1;
    return Cmp(entry, NULL, output, 0, compat);
}
