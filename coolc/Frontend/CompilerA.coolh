#define PEF_END_EXPR 0x1 //Same as TRUE
#define PEF_PAREN 0x2
#define PEF_ARRAY 0x4
#define PEF_ADDR_OF 0x8
#define PEF_FUN_BEFORE 0x10
#define PEF_NO_COMMA 0x20
extern Bool PrsExpression(CCmpCtrl *cc, U8 **ul = NULL, I64 flags = 0, CPrsStk *_ps = NULL);
extern U8 *COCCompile(CCmpCtrl *cc, I64 *_code_size, CDbgInfo **_dbg, I64 *_type);
extern CCodeMisc *CodeMiscHashNew(CCmpCtrl *cc, CHash *h);
// Compiler options beyond KernelA.coolh's: Vet's style checks (Vet, coolc --vet).
#define OPTf_VET 0x29
#define VET_ASSIGN_COND 0 //if (a = b) without extra parentheses
#define VET_EMPTY_STMT 1 //if (x); for (...); while (x);
#define VET_UNREACHABLE 2 //a statement right after return, break or goto in the same block
#define VET_UNUSED_ARG 3 //an argument the function never uses (callbacks have them)
#define VET_NO_WARN 4 //no_warn on a variable that is used
#define VET_DUP_TYPE 5 //a local declared in its own statement with a type another local has
#define VET_UNUSED_EXTERN 6 //an extern variable that is never used
#define VET_U0_PTR 7 //U0 * where U8 * is meant
#define VET_ARG_NAME 8 //a definition names an argument differently than its declaration
#define VET_CHECKS 9
