// Small-function inlining (docs/coolc-inline.md). tools/native/codegen.py compiles this
// with inlining on arm64 and x86_64 and with COOLC_NO_INLINE, requires Inline.expected
// from all three, and checks the COOLC_INLINE_TRACE lines in Inline.trace.
#include "TestBase.coolh"
#define COOLC_INLINE_TRACE 1
extern U8 *MemSet(U8 *dst, I64 value, I64 n);
I64 calls;
I64 Note(I64 v) {calls++; return v;}

// Leaf functions, inlined anywhere; a chain nested one level (Nth -> Off, Load).
I64 Add(I64 a, I64 b) {return a + b;}
I64 *Off(I64 *p, U64 i) {return p + i;}
I64 Load(I64 *p) {return *p;}
I64 Nth(I64 *p, I64 n, U64 i)
{
    if (i >= n) {
        Print("Nth: %d out of range\n", i);
        return -1;
    }
    I64 *q;
    q = Off(p, i);
    I64 e;
    e = Load(q);
    return e;
}
I64 Sum(I64 *p, I64 n)
{
    I64 i, t = 0;
    for (i = 0; i < n; i++)
        t = t + Nth(p, n, i);
    return t;
}

// Each argument once, before the body; at most one with a side effect.
I64 Twice(I64 a) {I64 r = a; r += a; return r;}
I64 Sub3(I64 a, I64 b, I64 c) {return a - b - c;}
U0 ArgOrder()
{
    I64 i = 5, x, y;
    x = Twice(i++);
    Print("order %d %d\n", x, i);
    x = Sub3(Note(10), 2, 3);
    y = Sub3(Note(10), Note(2), 3); // two side effects: not inlined
    Print("order %d %d %d\n", x, y, calls);
    x = 7;
    x = Twice(x); // the result goes straight to x, which is also the argument
    Print("order %d\n", x);
}

// Locals with the caller's names, labels, gotos, early returns, several copies.
I64 Steps(I64 n)
{
    I64 i = 0, r = 0;
again:
    if (i >= 3) goto done;
    r += n;
    i++;
    goto again; // a loop: Steps is not inlined
done:
    return r;
}
I64 Sign(I64 v)
{
    I64 i;
    if (v < 0) {i = -1; goto out;}
    if (v == 0) return 0;
    i = 1;
out:
    return i;
}
U0 Labels()
{
    I64 i = 100, s = 0, k;
    for (k = -2; k <= 2; k++)
        s = s * 10 + Sign(k) + 1;
    Print("labels %d %d %d %d\n", s, Sign(-5) + Sign(0) + Sign(9), i, Steps(4));
}

// Narrow types: values that might not fit are not inlined (the backend narrows them
// only when they are stored in memory).
U8 RetU8(I64 x) {return x;}
U8 IsBig(I64 x) {return x > 100;}
I64 ArgU8(U8 x) {return x + 1;}
I32 RetI32(I64 x) {return x;}
U0 Narrow()
{
    U8 b = 7;
    I64 k = 300, r1, r2, r3, r4, r5, r6;
    r1 = RetU8(k); // not inlined
    r2 = IsBig(k);
    r3 = ArgU8(b);
    r4 = ArgU8(k); // not inlined
    r5 = RetI32(0x180000005); // not inlined
    r6 = ArgU8(200);
    Print("narrow %d %d %d %d %d %d\n", r1, r2, r3, r4, r5, r6);
}

// F64 arguments and results, with integer conversions at the call.
F64 Lerp(F64 a, F64 b, F64 t) {return a + (b - a) * t;}
F64 Half(I64 x) {return x / 2.0;}
U0 Floats()
{
    F64 f = Lerp(1, 3, 0.25);
    I64 i = Half(7) * 4;
    Print("floats %.3f %d %.3f\n", f, i, Lerp(f, 10.0, Half(1)));
}

// Pointers to caller locals; a class-valued local in the callee; a class argument by
// value is not inlined.
class CPair {I64 a, b;};
U0 Bump(I64 *p) {*p += 5;}
I64 PairSum(CPair *p) {CPair tmp; tmp.a = p->b; tmp.b = p->a; return tmp.a * 10 + tmp.b;}
U0 Locals()
{
    I64 v = 1, s;
    CPair q;
    Bump(&v);
    Bump(&v);
    q.a = 3;
    q.b = 4;
    s = PairSum(&q);
    Print("locals %d %d\n", v, s);
}

// Conditional operands, statements of every kind, U0 functions, default arguments,
// string constants, a function pointer, noinline, recursion.
I64 Inc(I64 *p) {*p += 1; return 1;}
I64 Dft(I64 a, I64 b = 40) {return a + b;}
U0 Hello(U8 *who) {Print("hello %s\n", who);}
noinline I64 Opaque(I64 x) {return x * 3;}
I64 Fib(I64 n) {if (n < 2) return n; return Fib(n - 1) + Fib(n - 2);}
extern I64 IsOdd(I64 n);
I64 IsEven(I64 n) {if (n == 0) return 1; return IsOdd(n - 1);}
I64 IsOdd(I64 n) {if (n == 0) return 0; return IsEven(n - 1);}
I64 Cond()
{
    I64 n = 0, a = 0, r = 0, (*fp)(I64 x, I64 y);
    fp = &Add;
    if (a && Inc(&n)) r++; // the right operand stays conditional: not inlined
    if (Inc(&n) || Inc(&n)) r++;
    if (Inc(&n)) r--;
    while (Inc(&n) && n < 6) r += 10;
    switch (Add(1, 1)) {
        case 2: r += 100; break;
        default: r += 1000;
    }
    Hello("cool");
    r += Dft(2) + (*fp)(3, 4) + Opaque(5) + Fib(10) + IsEven(10);
    Print("cond %d %d\n", n, r);
    return Add(r, 1);
}

// In a loop, bodies up to INL_MAX_NODES with calls are inlined too: a class-valued local,
// a default argument, a U0 function with a string, one level of a recursive function.
I64 Loopy()
{
    I64 i, s = 0, t;
    CPair q;
    for (i = 0; i < 3; i++) {
        q.a = i;
        q.b = i + 1;
        t = PairSum(&q);
        s += t;
        t = Dft(i);
        s += t;
        t = Fib(i + 5);
        s += t;
        t = IsEven(i + 4);
        s += t;
        Hello("loop");
        t = Steps(i); // a loop of its own: not inlined
        s += t;
    }
    return s;
}

// Many inlined copies push a function past 64 locals (liveness word boundaries).
I64 Mix(I64 a, I64 b) {I64 t = a * 31; t ^= b; return t + (a >> 3);}
I64 Many(I64 s)
{
    I64 i;
    for (i = 0; i < 4; i++) {
        s = Mix(s, i); s = Mix(s, 1); s = Mix(s, 2); s = Mix(s, 3); s = Mix(s, 4);
        s = Mix(s, 5); s = Mix(s, 6); s = Mix(s, 7); s = Mix(s, 8); s = Mix(s, 9);
        s = Mix(s, i + 1); s = Mix(s, i + 2); s = Mix(s, i + 3); s = Mix(s, i + 4);
        s = Mix(s, i + 5); s = Mix(s, i + 6); s = Mix(s, i + 7); s = Mix(s, i + 8);
        s = Mix(s, i + 9); s = Mix(s, i + 10); s = Mix(s, i + 11); s = Mix(s, i + 12);
        s = Mix(s, Mix(i, s)); s = Mix(Mix(s, i), Mix(i, 1)); s &= 0xFFFFFFFFFFFF;
    }
    return s;
}

// A function defined twice in one unit: AOT calls use the last definition, so the first
// must not be inlined (InlFun reports an error otherwise).
noinline I64 Version() {return 1;}
I64 OldVersion() {return Version();}
I64 Version() {return 2;}
I64 NewVersion() {return Version();}

// try/catch, static locals, varargs and switch keep their functions out of line.
I64 Caught(I64 x) {I64 r = 0; try {if (x) throw('Inl');} catch {r = 1;} return r;}
I64 Counter() {static I64 c = 0; return ++c;}
I64 VSum(...) {I64 i, s = 0; for (i = 0; i < argc; i++) s += argv[i]; return s;}
I64 Pick(I64 k) {switch (k) {case 0: return 5; case 1: return 6;} return 7;}
U0 OutOfLine()
{
    Print("outofline %d %d %d %d %d %d\n", Caught(1), Caught(0), Counter() + Counter(), VSum(1, 2, 3), Pick(1), Pick(9));
}

I64 arr[10];
U0 Run()
{
    I64 i;
    for (i = 0; i < 10; i++)
        arr[i] = i * i;
    Print("sum %d %d %d\n", Sum(arr, 10), Nth(arr, 10, 11), Add(Load(Off(arr, 3)), 1));
    ArgOrder;
    Labels;
    Narrow;
    Floats;
    Locals;
    Print("cond2 %d\n", Cond());
    Print("loopy %d\n", Loopy());
    Print("many %d\n", Many(12345));
    Print("version %d %d\n", OldVersion(), NewVersion());
    OutOfLine;
}
Run;
