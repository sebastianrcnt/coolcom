I64 S10(I64 n) {F64 s = 0; I64 i; for (i = 1; i <= n; i++) s += 1.0 / i; return s * 1000;}
F64 S11(I64 n) {F64 x = 1; while (n--) x *= 1.5; return x;}
I64 S12(F64 x) {I64 n = 0; while (x > 1) {x /= 2; n++;} return n;}
F64 S13(F64 x, I64 n) {F64 r = 1; I64 i; for (i = 0; i < n; i++) r *= x; return r;}
