I64 P36(I64 a,I64 b,I64 c){return a&&b^^c;}
I64 P37(I64 a,I64 b,I64 c){return a^^b||c;}
I64 P38(I64 a,I64 b,I64 c){return a||b^^c;}
I64 P39(I64 a,I64 b,I64 c){return a==b&&b==c;}
