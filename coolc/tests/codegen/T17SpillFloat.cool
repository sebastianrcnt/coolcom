F64 X1(I64 a, F64 b, I64 c, F64 d, I64 e, F64 f, I64 g, F64 h) {I64 i0 = a * 2, i1 = c * 3, i2 = e * 4, i3 = g * 5; F64 f0 = b * d, f1 = d * f, f2 = f * h, f3 = h * b; return i0 + i1 + i2 + i3 + f0 + f1 + f2 + f3 + i0 * f0 + i1 * f1 + i2 * f2 + i3 * f3;}
F64 X2(F64 *p, I64 n) {I64 i, c0 = 0, c1 = 1, c2 = 2, c3 = 3, c4 = 4, c5 = 5; F64 s0 = 0, s1 = 1, s2 = 2, s3 = 3, s4 = 4, s5 = 5, s6 = 6, s7 = 7, s8 = 8, s9 = 9, s10 = 10, s11 = 11; for (i = 0; i < n; i++) {s0 += p[i]; s1 *= s0; s2 += s1; s3 *= s2; s4 += s3; s5 *= s4; s6 += s5; s7 *= s6; s8 += s7; s9 *= s8; s10 += s9; s11 *= s10; c0 += i; c1 ^= c0; c2 += c1; c3 ^= c2; c4 += c3; c5 ^= c4; gsink = Ext(s0);} return s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8 + s9 + s10 + s11 + c0 + c1 + c2 + c3 + c4 + c5;}
F64 X3(F64 a, F64 b) {F64 t[16]; I64 i; for (i = 0; i < 16; i++) t[i] = a * i + b; F64 s = 0; for (i = 0; i < 16; i++) s += t[i] * t[15 - i]; return s;}
I64 X4(F64 a, F64 b, F64 c, F64 d, F64 e, F64 f, F64 g, F64 h, F64 i, F64 j, F64 k, F64 l) {return a < b && c < d || e < f && g < h || i < j && k < l;}
F64 X5(F64 a, I64 b) {F64 x = a, y = a * 2, z = a * 3; I64 p = b, q = b * 2, r = b * 3; return x * p + y * q + z * r - Ext(x) * Ext(p);}
